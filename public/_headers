# Astro's build output: file names carry a content hash, so a changed file
# always gets a new URL and these can be cached for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Resized copies of the Agra highlight photos: a changed photo gets a new id.
/agra-highlights/*
  Cache-Control: public, max-age=31536000, immutable

/tour-images/*
  Cache-Control: public, max-age=31536000, immutable

# Country flag images for the phone field: they never change.
/flags/*
  Cache-Control: public, max-age=31536000, immutable

# The admin service worker must always be fetched fresh so updates reach the phone.
/admin/sw.js
  Cache-Control: no-cache
