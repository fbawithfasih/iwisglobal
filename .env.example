# Razorpay (test-mode keys for local dev; live keys set as Cloudflare Pages secrets)
PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Stripe (Phase 1 leaves the payment layer ready for this later)
# STRIPE_SECRET_KEY=
# PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Transactional email for booking confirmations (src/lib/email.ts), sent via
# Resend's HTTP API. The `from` address's domain must be a verified domain
# in the Resend account, or sends will fail.
RESEND_API_KEY=
BOOKING_EMAIL_FROM=IWIS Global <info@iwisglobal.com>

# Admin CRM login (/admin/*) — generate via a PBKDF2-SHA256 (100k iterations —
# the max Cloudflare Workers' Web Crypto supports, see src/lib/adminAuth.ts —
# 32-byte output) hash of your password with a random 16-byte salt, both hex.
# ADMIN_SESSION_SECRET is a random 32-byte hex string used to sign session cookies.
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Customer SSO login (/login, /account/bookings) — see src/lib/customerAuth.ts
# and src/lib/oauth/*.ts. CUSTOMER_SESSION_SECRET is a random 32-byte hex
# string used to sign customer session cookies (separate from the admin one).
CUSTOMER_SESSION_SECRET=

# Google: create a "Web application" OAuth client at
# https://console.cloud.google.com/apis/credentials with
# <your-domain>/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple "Sign in with Apple": requires a paid Apple Developer account.
# APPLE_CLIENT_ID is your Services ID; APPLE_TEAM_ID your Team ID;
# APPLE_KEY_ID and APPLE_PRIVATE_KEY come from a Sign in with Apple key
# (the .p8 file's contents, PEM format, newlines preserved). Configure
# <your-domain>/auth/apple/callback as the return URL for that Services ID.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Server-side `purchase` event on payment.captured (backlog 2.8), via a
# Razorpay webhook — src/pages/api/webhooks/razorpay.ts. RAZORPAY_WEBHOOK_SECRET
# comes from Razorpay Dashboard → Settings → Webhooks (separate from
# RAZORPAY_KEY_SECRET above). GA4_MEASUREMENT_ID/GA4_API_SECRET come from
# GA4 Admin → Data Streams → your stream → Measurement Protocol API secrets.
# Without these three, the webhook still verifies and acks (so Razorpay
# doesn't retry forever) but skips sending anything to GA4.
RAZORPAY_WEBHOOK_SECRET=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
