---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ShowPasswordButton from '../components/ShowPasswordButton.astro';
import { resolveEnv } from '../lib/env';
import OAuthButtons from '../components/OAuthButtons.astro';
import { getSessionCustomerId, CUSTOMER_COOKIE, safeRedirectPath } from '../lib/requireCustomer';
import { startOAuthSignIn } from '../lib/oauth/start';
import { getCustomerByEmail, createCustomerWithPassword } from '../lib/customers';
import { hashPassword, generateSaltHex } from '../lib/passwordHash';
import { createCustomerSessionToken } from '../lib/customerAuth';
import { checkSignupLimit, recordSignup } from '../lib/customerLoginAttempts';
import { createEmailVerificationLink } from '../lib/emailVerification';
import { sendEmailVerificationEmail } from '../lib/email';

const env = resolveEnv(Astro.locals);

const existingCustomerId = await getSessionCustomerId(Astro.cookies, env.CUSTOMER_SESSION_SECRET);
if (existingCustomerId) {
  return Astro.redirect('/account/bookings');
}

const redirectTarget = safeRedirectPath(Astro.url.searchParams.get('redirect'));
const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

let error: string | null = null;
let accountExists = false; // shows a Sign in link with the error
let name = '';
let email = '';

if (Astro.request.method === 'POST') {
  const db = env.DB;
  const form = await Astro.request.formData();
  name = String(form.get('name') ?? '').trim();
  email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');

  const ip = Astro.request.headers.get('cf-connecting-ip') ?? 'unknown';
  const waitMs = db ? await checkSignupLimit(db, ip) : null;
  if (!db || !env.CUSTOMER_SESSION_SECRET) {
    error = 'Accounts are not available right now.';
  } else if (waitMs) {
    error = `Too many new accounts from this connection. Try again in ${Math.ceil(waitMs / 60000)} minute(s).`;
  } else if (!name) {
    error = 'Please enter your name.';
  } else if (!EMAIL_RE.test(email)) {
    error = 'Please enter a valid email address.';
  } else if (password.length < 8) {
    error = 'Password must be at least 8 characters.';
  } else {
    const existing = await getCustomerByEmail(db, email);
    if (existing && existing.provider !== 'email') {
      error = `This email is already linked to ${existing.provider === 'google' ? 'Google' : 'Apple'} sign-in — use "Continue with ${existing.provider === 'google' ? 'Google' : 'Apple'}" on the sign-in page instead.`;
    } else if (existing) {
      error = 'An account with this email already exists.';
      accountExists = true;
    } else {
      const passwordSalt = generateSaltHex();
      const passwordHash = await hashPassword(password, passwordSalt);
      const customer = await createCustomerWithPassword(db, { email, name, passwordHash, passwordSalt });
      await recordSignup(db, ip);
      // "Confirm your email": once confirmed, bookings made with this email
      // (before or after signing up) show in My Bookings. Sent in the
      // background so it doesn't hold up the redirect.
      const link = await createEmailVerificationLink(db, customer.id, Astro.url.origin);
      if (link) {
        const sending = sendEmailVerificationEmail(env, { to: customer.email, name: customer.name, link });
        const ctx = (Astro.locals as { runtime?: { ctx?: { waitUntil(p: Promise<unknown>): void } } }).runtime?.ctx;
        if (ctx) ctx.waitUntil(sending);
        else await sending;
      }

      const token = await createCustomerSessionToken(customer.id, env.CUSTOMER_SESSION_SECRET);
      Astro.cookies.set(CUSTOMER_COOKIE, token, {
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        path: '/',
        maxAge: 60 * 60 * 24 * 30,
      });
      return Astro.redirect(redirectTarget);
    }
  }
}

// Google (and Apple, once set up) create an account on first sign-in too.
const { googleUrl, appleUrl } = startOAuthSignIn(env, Astro.cookies, Astro.url.origin, redirectTarget);
---

<BaseLayout floatingWhatsApp={false} title="Create an account — IWIS Global" description="Create an IWIS Global account to view your booking history." noindex>
  <section class="max-w-sm mx-auto px-6 pt-10 pb-20 md:pt-20 text-center">
    <h1 class="text-3xl font-serif font-semibold mb-2">Create an account</h1>
    <p class="text-stone-600 mb-3">You don't need an account to book a tour — this is just to see your booking history for tours you book while signed in.</p>
    <p class="text-sm text-stone-600 mb-8 rounded-lg bg-brand-50 border border-brand-100 px-3 py-2">
      Booked without an account? Use the <strong>View your booking</strong> link in your confirmation email — bookings made
      without signing in don't appear in an account.
    </p>

    <OAuthButtons googleUrl={googleUrl} appleUrl={appleUrl} />

    <form method="POST" class="space-y-3 text-left">
      {error && (
        <div role="alert" class="text-red-600 text-sm">
          <p>{error}</p>
          {accountExists && (
            <p class="flex flex-wrap gap-x-4">
              <a href={`/login?redirect=${encodeURIComponent(redirectTarget)}`} class="inline-flex min-h-11 items-center font-medium text-brand-800 underline">Sign in instead</a>
              <!-- Sends the reset email straight away. The email travels in the
                   form, not the link, so it never appears in a page address. -->
              <button type="submit" form="reset-from-signup" class="inline-flex min-h-11 items-center font-medium text-brand-800 underline cursor-pointer">Email me a reset link</button>
            </p>
          )}
        </div>
      )}
      <div>
        <label for="name" class="block text-xs font-medium text-stone-500 mb-1">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          autocomplete="name"
          value={name}
          class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-brand-500"
        />
      </div>
      <div>
        <label for="email" class="block text-xs font-medium text-stone-500 mb-1">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          value={email}
          class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-brand-500"
        />
      </div>
      <div>
        <label for="password" class="block text-xs font-medium text-stone-500 mb-1">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          required
          minlength="8"
          autocomplete="new-password"
          aria-describedby="password-hint"
          class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-brand-500"
        />
        <div class="flex items-center justify-between gap-3">
          <p id="password-hint" class="text-xs text-stone-500">At least 8 characters.</p>
          <ShowPasswordButton for="password" />
        </div>
      </div>
      <p class="text-xs text-stone-500">
        By creating an account you agree to our <a href="/terms" class="-my-3 inline-block py-3 text-brand-800 underline">Terms</a> and
        <a href="/privacy" class="-my-3 inline-block py-3 text-brand-800 underline">Privacy Policy</a>.
      </p>
      <button
        type="submit"
        class="w-full rounded-lg bg-brand-800 text-white px-4 py-3 font-medium hover:bg-brand-900 transition"
      >
        Create account
      </button>
    </form>

    {accountExists && (
      <form id="reset-from-signup" method="POST" action="/forgot-password" class="hidden">
        <input type="hidden" name="email" value={email} />
      </form>
    )}

    <p class="text-sm text-stone-500 mt-4">
      Already have an account? <a href={`/login?redirect=${encodeURIComponent(redirectTarget)}`} class="inline-flex min-h-11 items-center text-brand-700 font-medium hover:underline">Sign in</a>
    </p>
  </section>
</BaseLayout>
