---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ShowPasswordButton from '../components/ShowPasswordButton.astro';
import { resolveEnv } from '../lib/env';
import { pageI18n, fmt } from '../i18n/dictionaries';
import OAuthButtons from '../components/OAuthButtons.astro';
import PhoneInput from '../components/PhoneInput';
import { getSessionCustomerId, CUSTOMER_COOKIE, safeRedirectPath } from '../lib/requireCustomer';
import { startOAuthSignIn } from '../lib/oauth/start';
import { getCustomerByEmail, createCustomerWithPassword, normalizeAccountPhone, updateCustomerPhone } from '../lib/customers';
import { hashPassword, generateSaltHex } from '../lib/passwordHash';
import { createCustomerSessionToken } from '../lib/customerAuth';
import { checkSignupLimit, recordSignup } from '../lib/customerLoginAttempts';
import { createEmailVerificationLink } from '../lib/emailVerification';
import { sendEmailVerificationEmail } from '../lib/email';

const env = resolveEnv(Astro.locals);
const { t } = pageI18n(Astro);

const existingCustomerId = await getSessionCustomerId(Astro.cookies, env.CUSTOMER_SESSION_SECRET);
if (existingCustomerId) {
  return Astro.redirect('/account/bookings');
}

const redirectTarget = safeRedirectPath(Astro.url.searchParams.get('redirect'));
const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

let error: string | null = null;
let accountExists = false; // shows a Sign in link with the error
let name = '';
let email = '';
let phoneInput = ''; // kept so a failed attempt doesn't clear the box

if (Astro.request.method === 'POST') {
  const db = env.DB;
  const form = await Astro.request.formData();
  name = String(form.get('name') ?? '').trim();
  email = String(form.get('email') ?? '').trim();
  phoneInput = String(form.get('phone') ?? '').trim();
  const phone = normalizeAccountPhone(phoneInput);
  const password = String(form.get('password') ?? '');

  const ip = Astro.request.headers.get('cf-connecting-ip') ?? 'unknown';
  const waitMs = db ? await checkSignupLimit(db, ip) : null;
  if (!db || !env.CUSTOMER_SESSION_SECRET) {
    error = t.auth.unavailable;
  } else if (waitMs) {
    error = fmt(t.auth.tooManyNew, { n: Math.ceil(waitMs / 60000) });
  } else if (!name) {
    error = t.auth.errName;
  } else if (!EMAIL_RE.test(email)) {
    error = t.auth.errEmail;
  } else if (phone === undefined) {
    error = t.auth.errPhone;
  } else if (password.length < 8) {
    error = t.auth.errPassword;
  } else {
    const existing = await getCustomerByEmail(db, email);
    if (existing && existing.provider !== 'email') {
      error = fmt(t.auth.existsProvider, { provider: existing.provider === 'google' ? 'Google' : 'Apple' });
    } else if (existing) {
      error = t.auth.exists;
      accountExists = true;
    } else {
      const passwordSalt = generateSaltHex();
      const passwordHash = await hashPassword(password, passwordSalt);
      const customer = await createCustomerWithPassword(db, { email, name, passwordHash, passwordSalt });
      if (phone) await updateCustomerPhone(db, customer.id, phone);
      await recordSignup(db, ip);
      // "Confirm your email": once confirmed, bookings made with this email
      // (before or after signing up) show in My Bookings. Sent in the
      // background so it doesn't hold up the redirect.
      const link = await createEmailVerificationLink(db, customer.id, Astro.url.origin);
      if (link) {
        const sending = sendEmailVerificationEmail(env, { to: customer.email, name: customer.name, link });
        const ctx = (Astro.locals as { runtime?: { ctx?: { waitUntil(p: Promise<unknown>): void } } }).runtime?.ctx;
        if (ctx) ctx.waitUntil(sending);
        else await sending;
      }

      const token = await createCustomerSessionToken(customer.id, env.CUSTOMER_SESSION_SECRET);
      Astro.cookies.set(CUSTOMER_COOKIE, token, {
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        path: '/',
        maxAge: 60 * 60 * 24 * 30,
      });
      return Astro.redirect(redirectTarget);
    }
  }
}

// Google (and Apple, once set up) create an account on first sign-in too.
const { googleUrl, appleUrl } = startOAuthSignIn(env, Astro.cookies, Astro.url.origin, redirectTarget);
---

<BaseLayout floatingWhatsApp={false} title={t.auth.signupTitle} description={t.auth.signupDesc} noindex>
  <section class="max-w-md mx-auto px-6 pt-8 pb-20 md:pt-16 text-center">
    <span class="inline-block rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-800 mb-3">{t.auth.yourAccount}</span>
    <h1 class="text-3xl font-serif font-semibold mb-2">{t.auth.createAccount}</h1>
    <p class="text-stone-600 mb-5">{t.auth.signupIntro}</p>
    <p class="text-sm text-brand-900 mb-6 rounded-xl bg-gradient-to-br from-brand-50 to-white border border-brand-100 px-4 py-3 text-left">
      Booked without an account? Use the <strong class="font-semibold text-brand-800">View your booking</strong> link in your confirmation email — bookings made
      without signing in don't appear in an account.
    </p>

    <div class="rounded-2xl border border-brand-100 bg-white p-5 text-left shadow-sm shadow-brand-900/5 sm:p-7">
    <OAuthButtons googleUrl={googleUrl} appleUrl={appleUrl} />

    <form method="POST" class="space-y-3 text-left">
      {error && (
        <div role="alert" class="text-red-600 text-sm">
          <p>{error}</p>
          {accountExists && (
            <p class="flex flex-wrap gap-x-4">
              <a href={`/login?redirect=${encodeURIComponent(redirectTarget)}`} class="inline-flex min-h-11 items-center font-medium text-brand-800 underline">{t.auth.signInInstead}</a>
              <!-- Sends the reset email straight away. The email travels in the
                   form, not the link, so it never appears in a page address. -->
              <button type="submit" form="reset-from-signup" class="inline-flex min-h-11 items-center font-medium text-brand-800 underline cursor-pointer">{t.auth.emailReset}</button>
            </p>
          )}
        </div>
      )}
      <div>
        <label for="name" class="block text-sm font-medium text-stone-700 mb-1">{t.auth.name}</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          autocomplete="name"
          value={name}
          class="w-full rounded-lg border border-stone-300 bg-white px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-brand-400"
        />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-stone-700 mb-1">{t.auth.email}</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          value={email}
          class="w-full rounded-lg border border-stone-300 bg-white px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-brand-400"
        />
      </div>
      <div>
        <label for="phone" class="block text-sm font-medium text-stone-700 mb-1">{t.auth.phone} <span class="font-normal">{t.auth.optional}</span></label>
        <PhoneInput client:load roomy id="phone" name="phone" defaultValue={phoneInput || undefined} />
      </div>
      <div>
        <label for="password" class="block text-sm font-medium text-stone-700 mb-1">{t.auth.password}</label>
        <input
          id="password"
          name="password"
          type="password"
          required
          minlength="8"
          autocomplete="new-password"
          aria-describedby="password-hint"
          class="w-full rounded-lg border border-stone-300 bg-white px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-brand-400"
        />
        <div class="flex items-center justify-between gap-3">
          <p id="password-hint" class="text-xs text-stone-500">{t.auth.pwHint}</p>
          <ShowPasswordButton for="password" />
        </div>
      </div>
      <p class="text-xs text-stone-500" set:html={t.auth.agreeHtml} />
      <button
        type="submit"
        class="w-full min-h-12 rounded-full bg-gradient-to-r from-brand-900 via-brand-700 to-brand-600 px-4 py-3 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:brightness-110 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300 cursor-pointer"
      >
        {t.auth.createBtn}
      </button>
    </form>
    </div>

    {accountExists && (
      <form id="reset-from-signup" method="POST" action="/forgot-password" class="hidden">
        <input type="hidden" name="email" value={email} />
      </form>
    )}

    <p class="text-sm text-stone-500 mt-4">
      {t.auth.haveAccount} <a href={`/login?redirect=${encodeURIComponent(redirectTarget)}`} class="inline-flex min-h-11 items-center text-brand-700 font-medium hover:underline">{t.auth.signIn}</a>
    </p>
  </section>
</BaseLayout>
