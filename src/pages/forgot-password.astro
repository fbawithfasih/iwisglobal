---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveEnv } from '../lib/env';
import { createPasswordResetLink } from '../lib/passwordReset';
import { sendPasswordResetEmail } from '../lib/email';

// Step 1 of "forgot password": ask for the email, send a one-time link.
// The reply is the same whether or not the email has an account, and the
// email goes out in the background so the response time doesn't tell either.
const env = resolveEnv(Astro.locals);
const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

let email = Astro.url.searchParams.get('email') ?? '';
let sent = false;
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim();
  if (!EMAIL_RE.test(email)) {
    error = 'Please enter a valid email address.';
  } else if (!env.DB) {
    error = 'Accounts are not available right now.';
  } else {
    const reset = await createPasswordResetLink(env.DB, email, Astro.url.origin);
    if (reset) {
      const sending = sendPasswordResetEmail(env, reset);
      const ctx = (Astro.locals as { runtime?: { ctx?: { waitUntil(p: Promise<unknown>): void } } }).runtime?.ctx;
      if (ctx) ctx.waitUntil(sending);
      else await sending;
    }
    sent = true;
  }
}
---

<BaseLayout title="Forgot your password — IWIS Global" noindex>
  <section class="max-w-sm mx-auto px-6 pt-10 pb-20 md:pt-20 text-center">
    <h1 class="text-3xl font-serif font-semibold mb-2">Forgot your password?</h1>
    {sent ? (
      <>
        <p class="text-stone-600 mb-6">
          If <span class="font-medium text-stone-800 break-all">{email}</span> has an IWIS Global account with a password,
          we've emailed it a link to choose a new one. The link works once, within the next hour. Check your spam folder
          if it isn't there in a few minutes.
        </p>
        <p class="text-sm text-stone-500">
          Signed up with Google? Use <a href="/login" class="text-brand-800 font-medium hover:underline">Continue with Google</a> instead — there's no password to reset.
        </p>
      </>
    ) : (
      <>
        <p class="text-stone-600 mb-8">Enter the email you signed up with and we'll send you a link to choose a new password.</p>
        <form method="POST" class="space-y-3 text-left">
          {error && <p class="text-red-600 text-sm" role="alert">{error}</p>}
          <div>
            <label for="email" class="block text-xs font-medium text-stone-500 mb-1">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              value={email}
              class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-brand-500"
            />
          </div>
          <button type="submit" class="w-full rounded-lg bg-brand-800 text-white px-4 py-3 font-medium hover:bg-brand-900 transition">
            Email me a link
          </button>
        </form>
      </>
    )}
    <p class="text-sm text-stone-500 mt-6">
      <a href="/login" class="inline-flex min-h-11 items-center text-brand-700 font-medium hover:underline">Back to sign in</a>
    </p>
  </section>
</BaseLayout>
