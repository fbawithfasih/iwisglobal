---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveEnv } from '../lib/env';
import { pageI18n, fmt } from '../i18n/dictionaries';
import { createPasswordResetLink } from '../lib/passwordReset';
import { sendPasswordResetEmail } from '../lib/email';

// Step 1 of "forgot password": ask for the email, send a one-time link.
// The reply is the same whether or not the email has an account, and the
// email goes out in the background so the response time doesn't tell either.
const env = resolveEnv(Astro.locals);
const { t } = pageI18n(Astro);
// The address is escaped before it goes into the translated sentence.
const esc = (v: string) => v.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

let email = '';
let sent = false;
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim();
  if (!EMAIL_RE.test(email)) {
    error = t.auth.errEmail;
  } else if (!env.DB) {
    error = t.auth.unavailable;
  } else {
    const reset = await createPasswordResetLink(env.DB, email, Astro.url.origin);
    if (reset) {
      const sending = sendPasswordResetEmail(env, reset);
      const ctx = (Astro.locals as { runtime?: { ctx?: { waitUntil(p: Promise<unknown>): void } } }).runtime?.ctx;
      if (ctx) ctx.waitUntil(sending);
      else await sending;
    }
    sent = true;
  }
}
const sentHtml = fmt(t.auth.sentHtml, { email: `<span class="font-medium text-stone-800 break-all">${esc(email)}</span>` });
---

<BaseLayout floatingWhatsApp={false} title={t.auth.forgotTitle} noindex>
  <section class="max-w-md mx-auto px-6 pt-8 pb-20 md:pt-16 text-center">
    <span class="inline-block rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-800 mb-3">{t.auth.yourAccount}</span>
    {sent ? (
      <>
        <h1 class="text-3xl font-serif font-semibold mb-2">{t.auth.checkEmail}</h1>
        <p class="text-stone-600 mb-6 rounded-xl border border-brand-100 bg-brand-50/60 px-4 py-3 text-left"><Fragment set:html={sentHtml} /></p>
        <p class="text-sm text-stone-500" set:html={t.auth.googleNoPwHtml} />
        <p class="mt-4">
          <a href="/forgot-password" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-800 hover:underline">{t.auth.tryDifferent}</a>
        </p>
      </>
    ) : (
      <>
        <h1 class="text-3xl font-serif font-semibold mb-2">{t.auth.forgotH1}</h1>
        <p class="text-stone-600 mb-6">{t.auth.forgotIntro}</p>
        <div class="rounded-2xl border border-brand-100 bg-white p-5 text-left shadow-sm shadow-brand-900/5 sm:p-7">
        <form method="POST" class="space-y-3 text-left">
          {error && <p class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">{error}</p>}
          <div>
            <label for="email" class="block text-sm font-medium text-stone-700 mb-1">{t.auth.email}</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              value={email}
              class="w-full rounded-lg border border-stone-300 bg-white px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-brand-400"
            />
          </div>
          <button type="submit" class="w-full min-h-12 rounded-full bg-gradient-to-r from-brand-900 via-brand-700 to-brand-600 px-4 py-3 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:brightness-110 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300 cursor-pointer">
            {t.auth.emailLink}
          </button>
        </form>
        </div>
        <p class="text-sm text-stone-500 mt-4" set:html={t.auth.googleNoPw2Html} />
      </>
    )}
    <p class="text-sm text-stone-500 mt-6">
      <a href="/login" class="inline-flex min-h-11 items-center text-brand-700 font-medium hover:underline">{t.auth.backToSignIn}</a>
    </p>
  </section>
</BaseLayout>
