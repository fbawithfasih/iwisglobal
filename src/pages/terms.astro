---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalNotice from '../components/LegalNotice.astro';
import GrievanceOfficer from '../components/GrievanceOfficer.astro';
import { pageI18n } from '../i18n/dictionaries';

// Dynamic (not prerendered) because BaseLayout's nav/footer depend on
// live per-request session and locale state via Astro.cookies.
export const prerender = false;

// Written from the business's actual booking, payment, and cancellation
// practices; not yet reviewed by a lawyer. Have it reviewed, particularly
// the liability and governing-law sections. This used to be a public
// banner, removed 26 Sep 2026 because payment-network reviewers read it as
// an incomplete policy.
// Apple sign-in is built but not switched on, so only Google and email are
// named under Accounts (same in privacy.astro); add Apple back when it is.
// The business details in the intro match /about and /contact.
const lastUpdated = '28 September 2026';
const { t } = pageI18n(Astro);
---


<BaseLayout title={t.termsPage.k35} description={t.termsPage.k36}>
  <!-- The [&_…] classes style every section heading and list on the page,
         including the shared GrievanceOfficer block, without touching /contact. -->
  <section class="max-w-2xl mx-auto px-6 py-12 md:py-16 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:border-l-4 [&_h2]:border-brand-500 [&_h2]:pl-3 [&_h2]:font-serif [&_h2]:text-xl [&_h2]:text-brand-900 [&_li]:marker:text-brand-500 [&_p]:leading-relaxed">
    <span class="inline-block rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-800" set:html={t.termsPage.k32} />
    <h1 class="mt-3 text-3xl md:text-4xl font-serif font-semibold mb-2" set:html={t.termsPage.k1} />
    <LegalNotice updated={lastUpdated} />

    <p class="mb-2 rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50 to-white p-5 text-stone-700 shadow-sm shadow-brand-900/5" set:html={t.termsPage.k2} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.termsPage.k3} />
    <ul class="list-disc pl-5 text-stone-700 space-y-1 mb-6">
      <li set:html={t.termsPage.k4} />
      <li set:html={t.termsPage.k5} />
      <li set:html={t.termsPage.k6} />
      <li set:html={t.termsPage.k7} />
      <li set:html={t.termsPage.k8} />
    </ul>

    <h2 class="text-lg font-semibold mb-2" set:html={t.termsPage.k9} />
    <ul class="list-disc pl-5 text-stone-700 space-y-1 mb-6">
      <li set:html={t.termsPage.k10} />
      <li set:html={t.termsPage.k11} />
      <li set:html={t.termsPage.k12} />
      <li set:html={t.termsPage.k13} />
      <li set:html={t.termsPage.k14} />
    </ul>

    <h2 class="text-lg font-semibold mb-2" set:html={t.termsPage.k15} />
    <p class="text-stone-700 mb-6" set:html={t.termsPage.k16} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.termsPage.k17} />
    <p class="text-stone-700 mb-6" set:html={t.termsPage.k18} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.termsPage.k19} />
    <ul class="list-disc pl-5 text-stone-700 space-y-1 mb-6">
      <li set:html={t.termsPage.k20} />
      <li set:html={t.termsPage.k21} />
      <li set:html={t.termsPage.k22} />
    </ul>

    <h2 class="text-lg font-semibold mb-2" set:html={t.termsPage.k23} />
    <p class="text-stone-700 mb-6" set:html={t.termsPage.k24} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.termsPage.k25} />
    <p class="text-stone-700 mb-6" set:html={t.termsPage.k26} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.termsPage.k27} />
    <p class="text-stone-700 mb-6" set:html={t.termsPage.k28} />

    <GrievanceOfficer />

    <h2 class="text-lg font-semibold mb-2" set:html={t.termsPage.k29} />
    <p class="text-stone-700 mb-6" set:html={t.termsPage.k30} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.termsPage.k31} />
    <p class="rounded-2xl border border-brand-100 bg-brand-50/60 p-5 text-stone-700">
      Questions about these terms, or to cancel a booking, contact us at
      <a href="mailto:info@iwisglobal.com" class="text-brand-800 hover:underline" set:html={t.termsPage.k33} /> or via
      <a href={`https://wa.me/916399226633?text=${encodeURIComponent('Hi! (ref: TERMS)')}`} target="_blank" rel="noopener noreferrer" data-wa-ref="TERMS" class="text-brand-800 hover:underline" set:html={t.termsPage.k34} />.
    </p>
  </section>
</BaseLayout>
