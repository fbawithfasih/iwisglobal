---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalNotice from '../components/LegalNotice.astro';
import { pageI18n } from '../i18n/dictionaries';

// Dynamic (not prerendered) because BaseLayout's nav/footer depend on
// live per-request session and locale state via Astro.cookies.
export const prerender = false;

// Written from how the site actually handles data; not yet reviewed by a
// lawyer. Have it reviewed before relying on it for compliance (e.g. GDPR
// for EU visitors). This used to be a public banner, removed 26 Sep 2026
// because payment-network reviewers read it as an incomplete policy.
// Apple sign-in is built but not switched on, so only Google is named
// below (same in terms.astro); add Apple back when it is.
const lastUpdated = '2 October 2026';
const { t } = pageI18n(Astro);
---


<BaseLayout title={t.privacyPage.k55} description={t.privacyPage.k56}>
  <!-- Same [&_…] heading and list styling as /terms. -->
  <section class="max-w-2xl mx-auto px-6 py-12 md:py-16 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:border-l-4 [&_h2]:border-brand-500 [&_h2]:pl-3 [&_h2]:font-serif [&_h2]:text-xl [&_h2]:text-brand-900 [&_li]:marker:text-brand-500 [&_p]:leading-relaxed">
    <span class="inline-block rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-800" set:html={t.privacyPage.k52} />
    <h1 class="mt-3 text-3xl md:text-4xl font-serif font-semibold mb-2" set:html={t.privacyPage.k1} />
    <LegalNotice updated={lastUpdated} />

    <p class="mb-2 rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50 to-white p-5 text-stone-700 shadow-sm shadow-brand-900/5" set:html={t.privacyPage.k2} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.privacyPage.k3} />
    <ul class="list-disc pl-5 text-stone-700 space-y-1 mb-6">
      <li set:html={t.privacyPage.k4} />
      <li set:html={t.privacyPage.k5} />
      <li set:html={t.privacyPage.k6} />
      <li set:html={t.privacyPage.k7} />
      <li set:html={t.privacyPage.k8} />
      <li set:html={t.privacyPage.k9} />
      <li set:html={t.privacyPage.k10} />
      <li set:html={t.privacyPage.k11} />
      <li set:html={t.privacyPage.k12} />
      <li set:html={t.privacyPage.k13} />
      <li set:html={t.privacyPage.k57} />
    </ul>

    <h2 class="text-lg font-semibold mb-2" set:html={t.privacyPage.k14} />
    <ul class="list-disc pl-5 text-stone-700 space-y-1 mb-2">
      <li set:html={t.privacyPage.k15} />
      <li set:html={t.privacyPage.k16} />
      <li set:html={t.privacyPage.k17} />
      <li set:html={t.privacyPage.k18} />
      <li set:html={t.privacyPage.k19} />
      <li set:html={t.privacyPage.k20} />
    </ul>
    <p class="text-stone-700 mb-6" set:html={t.privacyPage.k21} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.privacyPage.k22} />
    <ul class="list-disc pl-5 text-stone-700 space-y-1 mb-2">
      <li set:html={t.privacyPage.k23} />
      <li set:html={t.privacyPage.k24} />
      <li set:html={t.privacyPage.k25} />
      <li set:html={t.privacyPage.k26} />
      <li set:html={t.privacyPage.k27} />
      <li set:html={t.privacyPage.k28} />
      <li set:html={t.privacyPage.k29} />
      <li set:html={t.privacyPage.k30} />
      <li set:html={t.privacyPage.k31} />
      <li set:html={t.privacyPage.k32} />
      <li set:html={t.privacyPage.k33} />
      <li set:html={t.privacyPage.k58} />
    </ul>
    <p class="text-stone-700 mb-6" set:html={t.privacyPage.k34} />

    <h2 id="cookies" class="text-lg font-semibold mb-2 scroll-mt-24" set:html={t.privacyPage.k35} />
    <p class="text-stone-700 mb-2" set:html={t.privacyPage.k36} />
    <ul class="list-disc pl-5 text-stone-700 space-y-1 mb-6">
      <li set:html={t.privacyPage.k37} />
      <li set:html={t.privacyPage.k38} />
      <li set:html={t.privacyPage.k39} />
      <li set:html={t.privacyPage.k40} />
      <li set:html={t.privacyPage.k41} />
      <li set:html={t.privacyPage.k42} />
      <li set:html={t.privacyPage.k43} />
      <li set:html={t.privacyPage.k44} />
      <li set:html={t.privacyPage.k45} />
    </ul>
    <p class="text-stone-700 mb-6" set:html={t.privacyPage.k46} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.privacyPage.k47} />
    <p class="text-stone-700 mb-6" set:html={t.privacyPage.k48} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.privacyPage.k49} />
    <p class="text-stone-700 mb-6" set:html={t.privacyPage.k50} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.privacyPage.k51} />
    <p class="rounded-2xl border border-brand-100 bg-brand-50/60 p-5 text-stone-700">
      Questions about this policy or your data can be sent to
      <a href="mailto:info@iwisglobal.com" class="text-brand-800 hover:underline" set:html={t.privacyPage.k53} /> or via
      <a href={`https://wa.me/916399226633?text=${encodeURIComponent('Hi! (ref: PRIVACY)')}`} target="_blank" rel="noopener noreferrer" data-wa-ref="PRIVACY" class="text-brand-800 hover:underline" set:html={t.privacyPage.k54} />.
    </p>
  </section>
</BaseLayout>
