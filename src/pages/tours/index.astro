---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const tours = await getCollection('tours');
---
<BaseLayout title="Agra Tours — IWIS Global" description="Browse private, professionally guided Agra tours: same-day trips from Delhi and multi-day itineraries.">
  <section class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-serif font-semibold mb-8">All tours</h1>
    <div class="grid md:grid-cols-2 gap-6">
      {tours.map((tour) => (
        <a href={`/tours/${tour.slug}`} class="block rounded-xl border border-stone-200 p-6 hover:shadow-md transition">
          <h2 class="text-xl font-semibold mb-2">{tour.data.title}</h2>
          <p class="text-stone-600 text-sm mb-3">{tour.data.summary}</p>
          <div class="flex items-center justify-between text-sm">
            <span class="text-amber-800 font-medium">{tour.data.durationLabel}</span>
            <span class="text-stone-500">From {tour.data.startPoint}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
