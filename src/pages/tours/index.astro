---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TourCard from '../../components/TourCard.astro';
import MobileActionBar from '../../components/MobileActionBar.astro';
import { listTours } from '../../lib/tours';
import { resolveEnv } from '../../lib/env';
import { resolveCurrency, resolveFromPrice } from '../../lib/currency';

export const prerender = false;

const env = resolveEnv(Astro.locals);
const publishedTours = env.DB ? await listTours(env.DB, { status: 'published' }) : [];

const currency = resolveCurrency(Astro.url.searchParams, Astro.cookies.get('currency')?.value);
if (Astro.url.searchParams.get('currency')) {
  Astro.cookies.set('currency', currency, { path: '/', maxAge: 60 * 60 * 24 * 365 });
}

// Cheapest first, by the same "From" price each card shows (in the visitor's
// currency), so the entry-level tour is the first thing a visitor sees.
const tours = [...publishedTours].sort(
  (a, b) => resolveFromPrice(a, currency).amount - resolveFromPrice(b, currency).amount
);
---
<BaseLayout
  title="Taj Mahal Tours — Private, Guided Agra Trips | IWIS Global"
  description="Taj Mahal tours from a real Agra-based operator: private same-day trips from Delhi, booked online with transparent pricing and no hidden commissions."
>
  <section class="max-w-6xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-serif font-semibold mb-2">Taj Mahal tours</h1>
    <p class="text-stone-600 mb-8 max-w-2xl">
      Private, professionally guided same-day Taj Mahal &amp; Agra tours from Delhi, run and
      guided by IWIS Global directly (not a marketplace re-listing). Not sure what a ticket costs first?
      <a href="/guides/taj-mahal-ticket-price-2026" class="text-brand-700 hover:underline">See the full Taj Mahal ticket price breakdown</a>.
    </p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tours.map((tour, i) => <TourCard tour={tour} currency={currency} loading={i === 0 ? "eager" : "lazy"} />)}
    </div>
  </section>

  <!-- Phones: WhatsApp moves into this bar so the floating button doesn't
       sit on top of the tour cards' prices. -->
  <MobileActionBar waRef="TOURSBAR-TOURS" waMessage="Hi! I'm not sure which tour to choose — can you help?">
    <Fragment slot="info">
      <p class="text-[11px] font-medium uppercase tracking-wide text-stone-500">Not sure which tour?</p>
      <p class="text-sm font-semibold leading-tight text-stone-900">Ask us on WhatsApp</p>
    </Fragment>
  </MobileActionBar>
</BaseLayout>
