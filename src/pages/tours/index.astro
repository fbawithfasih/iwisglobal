---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TourCard from '../../components/TourCard.astro';
import TourFinder from '../../components/TourFinder';
import { toFinderTours } from '../../lib/tourFinderData';
import MobileActionBar from '../../components/MobileActionBar.astro';
import { listTours, sharedTourFacts } from '../../lib/tours';
import FoundingGuestNote from '../../components/FoundingGuestNote.astro';
import { resolveEnv } from '../../lib/env';
import { pageI18n, languageName } from '../../i18n/dictionaries';
import { resolveCurrency, sortByFromPrice } from '../../lib/currency';
import SharedTourFacts from '../../components/SharedTourFacts.astro';

export const prerender = false;

const env = resolveEnv(Astro.locals);
const { locale, t } = pageI18n(Astro);
const publishedTours = env.DB ? await listTours(env.DB, { status: 'published' }, locale) : [];

const currency = resolveCurrency(Astro.url.searchParams, Astro.cookies.get('currency')?.value);
if (Astro.url.searchParams.get('currency')) {
  Astro.cookies.set('currency', currency, { path: '/', maxAge: 60 * 60 * 24 * 365 });
}

// Cheapest first, counting tickets a tour leaves out (see sortByFromPrice).
const tours = sortByFromPrice(publishedTours, currency);

// Facts every tour shares are listed once above the cards, which then show
// only what differs (see sharedTourFacts).
const sharedFacts = sharedTourFacts(tours, t.shared, (l) => languageName(t, l));
const sharedFactsShown = sharedFacts.length > 0;
---
<BaseLayout
  title={t.toursPage.metaTitle}
  description={t.toursPage.metaDesc}
>
  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="mb-8 rounded-2xl bg-gradient-to-br from-brand-900 via-brand-700 to-brand-600 p-6 text-white shadow-lg shadow-brand-900/20 sm:p-8">
      <span class="inline-block rounded-full bg-white/15 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-100">{t.toursPage.badge}</span>
      <h1 class="mt-3 text-3xl md:text-4xl font-serif font-semibold mb-3">{t.toursPage.h1}</h1>
    <p class="max-w-2xl text-white/90" set:html={t.toursPage.introHtml} />
    </div>
    <SharedTourFacts facts={sharedFacts} class="mb-6" />
    <FoundingGuestNote class="mb-8" />
    <div class="mb-8 max-w-3xl"><TourFinder client:visible tours={toFinderTours(tours, currency)} t={t.finder} /></div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tours.map((tour, i) => <TourCard tour={tour} currency={currency} loading={i === 0 ? "eager" : "lazy"} sharedFactsShown={sharedFactsShown} />)}
    </div>
  </section>

  <!-- Plain-language guidance under the cards: helps visitors choose, and
       gives search engines text to read on a page that is mostly cards. -->
  <section class="max-w-3xl mx-auto px-6 pb-16">
    <h2 class="mb-4 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900">{t.toursPage.whichTitle}</h2>
    <p class="text-stone-700 mb-4">{t.toursPage.whichIntro}</p>
    <ul class="list-disc pl-5 text-stone-700 space-y-2 mb-8 marker:text-brand-500">
      <li set:html={t.toursPage.byCar} />
      <li set:html={t.toursPage.byTrain} />
      <li set:html={t.toursPage.sunrise} />
      <li set:html={t.toursPage.luxury} />
      <li set:html={t.toursPage.gallery} />
    </ul>
    <h2 class="mb-4 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900">{t.toursPage.goodTitle}</h2>
    <ul class="list-disc pl-5 text-stone-700 space-y-2 mb-6 marker:text-brand-500">
      <li>{t.toursPage.good1}</li>
      <li>{t.toursPage.good2}</li>
      <li set:html={t.toursPage.good3Html} />
    </ul>
    <p class="rounded-2xl border border-brand-100 bg-brand-50/60 p-5 text-stone-700" set:html={t.toursPage.stillHtml} />
  </section>

  <!-- Phones: WhatsApp moves into this bar so the floating button doesn't
       sit on top of the tour cards' prices. -->
  <MobileActionBar waRef="TOURSBAR-TOURS" waMessage="Hi! I'm not sure which tour to choose — can you help?">
    <Fragment slot="info">
      <p class="text-[11px] font-medium uppercase tracking-wide text-stone-500">{t.toursPage.barQuestion}</p>
      <p class="text-sm font-semibold leading-tight text-stone-900">{t.toursPage.barAsk}</p>
    </Fragment>
  </MobileActionBar>
</BaseLayout>
