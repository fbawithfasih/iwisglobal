---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingWidget from '../../components/BookingWidget.tsx';
import { getTourBySlug } from '../../lib/tours';
import { getAvailability } from '../../lib/availability';
import { resolveEnv } from '../../lib/env';
import { countBookings } from '../../lib/db';
import { FOUNDING_GUEST_SLOT_CAP } from '../../lib/catalog';
import { resolveCurrency, resolvePrice, resolveAddOns, resolvePricingTiers, resolveFromPrice, CURRENCY_SYMBOLS } from '../../lib/currency';

export const prerender = false;

const env = resolveEnv(Astro.locals);
const { slug } = Astro.params;
const tour = env.DB && slug ? await getTourBySlug(env.DB, slug) : null;

if (!tour || tour.status !== 'published') {
  return Astro.redirect('/tours');
}

const availability = getAvailability();

const requestedCurrency = resolveCurrency(Astro.url.searchParams, Astro.cookies.get('currency')?.value);
if (Astro.url.searchParams.get('currency')) {
  Astro.cookies.set('currency', requestedCurrency, { path: '/', maxAge: 60 * 60 * 24 * 365 });
}
const price = resolvePrice(tour, requestedCurrency);
const resolvedAddOns = resolveAddOns(tour.addOns, price.currency);
const resolvedTiers = resolvePricingTiers(tour.pricingTiers, price.currency);
// "From ₹X" uses the cheapest available rate (the largest-group tier when
// tiers are set) rather than the flat per-traveler amount, which would
// understate a solo traveler's price and overstate a group of 4's.
const fromPrice = resolveFromPrice(tour, requestedCurrency);

// Backlog 1.1 — Founding Guest offer display only; the real eligibility
// decision (and the actual discount applied) happens server-side at
// payment time in razorpay.ts's createOrder, from a fresh count at that
// exact moment. This is just for showing the banner/estimate.
const bookingCount = env.DB ? await countBookings(env.DB) : 0;
const foundingGuestSlotsLeft = Math.max(0, FOUNDING_GUEST_SLOT_CAP - bookingCount);

// Some tour descriptions end with short labeled paragraphs (e.g. "What to
// bring: ..."). Pull those out of the prose block so they render as their
// own "Good to know" cards instead of getting buried in a wall of text.
const INFO_LABELS = ['What to bring', 'Not allowed', 'Know before you go'];
function extractInfoBlocks(description: string): { main: string; blocks: { label: string; text: string }[] } {
  const paragraphs = description.split(/\n\n+/);
  const blocks: { label: string; text: string }[] = [];
  const mainParas: string[] = [];
  for (const para of paragraphs) {
    const trimmed = para.trim();
    const label = INFO_LABELS.find((l) => trimmed.toLowerCase().startsWith(`${l.toLowerCase()}:`));
    if (label) {
      blocks.push({ label, text: trimmed.slice(label.length + 1).trim() });
    } else if (trimmed) {
      mainParas.push(trimmed);
    }
  }
  return { main: mainParas.join('\n\n'), blocks };
}
const { main: mainDescription, blocks: infoBlocks } = extractInfoBlocks(tour.description);

// Backlog 2.1: Product + Offer + TouristTrip. Both share one Offer built
// from the already-resolved `price` (the same amount/currency shown to the
// visitor and charged server-side) — the previous version used the raw
// flat tour.amount/tour.currency, which drifted from the real price once
// currency toggling and group-size tiers existed.
const tourUrl = `https://www.iwisglobal.com/tours/${tour.slug}`;
const tourOfferJsonLd = {
  '@type': 'Offer',
  price: price.amount,
  priceCurrency: price.currency,
  availability: 'https://schema.org/InStock',
  url: tourUrl,
};
const tripJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: tour.title,
      description: tour.summary,
      url: tourUrl,
      image: tour.image ? new URL(tour.image, Astro.url.origin).toString() : undefined,
      brand: { '@type': 'Organization', name: 'IWIS Global' },
      offers: tourOfferJsonLd,
    },
    {
      '@type': 'TouristTrip',
      name: tour.title,
      description: tour.summary,
      url: tourUrl,
      touristType: 'Leisure',
      offers: tourOfferJsonLd,
    },
  ],
};
---
<BaseLayout title={`${tour.title} — IWIS Global`} description={tour.summary} breadcrumbs={[{ name: 'Tours', path: '/tours' }]}>
  <script type="application/ld+json" set:html={JSON.stringify(tripJsonLd)} />

  <section class="max-w-5xl mx-auto px-6 py-16 grid md:grid-cols-3 gap-10 items-start">
    <div class="md:col-span-2">
      {tour.image ? (
        <img src={tour.image} alt={tour.title} class="w-full rounded-2xl mb-6 object-cover max-h-96 shadow-lg shadow-stone-200/60" />
      ) : (
        <div class="w-full aspect-[16/7] rounded-2xl mb-6 bg-gradient-to-br from-brand-100 via-brand-50 to-accent-50 flex items-center justify-center text-brand-300 text-sm">
          No image yet
        </div>
      )}
      <h1 class="text-3xl md:text-4xl font-serif font-semibold mb-2">{tour.title}</h1>
      <div class="h-1 w-16 rounded-full bg-gradient-to-r from-brand-600 to-accent-500 mb-4"></div>
      {requestedCurrency === 'USD' && price.currency === 'INR' && (
        <p class="text-xs text-stone-500 mb-2">USD price not set for this tour — showing INR</p>
      )}
      <p class="text-stone-600 mb-4">{tour.summary}</p>

      <div class="flex flex-wrap gap-2 mb-6">
        <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full bg-brand-50 text-brand-800">
          ✓ Free cancellation until 24h before
        </span>
        <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full bg-brand-50 text-brand-800">
          ✓ Instant confirmation
        </span>
        {tour.pickupIncluded && (
          <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full bg-brand-50 text-brand-800">
            ✓ Hotel pickup included
          </span>
        )}
        {tour.privateTour && (
          <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full bg-brand-50 text-brand-800">
            ✓ Private tour
          </span>
        )}
        <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full bg-accent-50 text-accent-700">
          {availability.label}
        </span>
      </div>

      <div class="flex gap-6 text-sm text-stone-500 mb-4">
        <span>{tour.durationLabel}</span>
        <span>From {tour.startPoint}</span>
        {tour.guideLanguage && <span>{tour.guideLanguage} guide</span>}
      </div>

      <div class="mb-8 pb-8 border-b border-stone-200">
        <p class="text-2xl font-semibold text-stone-900">
          From {CURRENCY_SYMBOLS[fromPrice.currency]}{fromPrice.amount.toLocaleString(fromPrice.currency === 'USD' ? 'en-US' : 'en-IN')}
          <span class="text-sm font-normal text-stone-500">/person</span>
        </p>
        {resolvedTiers.length > 0 && (
          <p class="text-sm text-stone-500 mt-1">for groups of {Math.max(...resolvedTiers.map((t) => t.travelers))}+ — solo or smaller groups pay more per person</p>
        )}
      </div>

      {tour.highlights.length > 0 && (
        <div class="mb-8 rounded-xl border border-stone-200 bg-white p-6">
          <h2 class="text-lg font-serif font-semibold mb-4">Highlights</h2>
          <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-3">
            {tour.highlights.map((h) => (
              <li class="flex items-start gap-2.5 text-sm text-stone-700">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-brand-600 shrink-0 mt-0.5" aria-hidden="true">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M8.5 12.5l2.5 2.5 5-5"></path>
                </svg>
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {tour.itinerary.length > 0 && (
        <div class="mb-8 rounded-xl border border-stone-200 bg-white p-6">
          <h2 class="text-lg font-serif font-semibold mb-5">Itinerary</h2>
          <ol class="relative border-l-2 border-brand-100 pl-6 space-y-6">
            {tour.itinerary.map((step) => (
              <li class="relative">
                <span class="absolute -left-[26px] top-0.5 h-3.5 w-3.5 rounded-full bg-brand-600 ring-4 ring-brand-50"></span>
                <p class="font-semibold text-stone-900 text-sm">{step.time}</p>
                <p class="text-stone-600 text-sm mt-0.5">{step.activity}</p>
              </li>
            ))}
          </ol>
        </div>
      )}

      {mainDescription && (
        <div class="mb-8 rounded-xl border border-stone-200 bg-white p-6">
          <h2 class="text-lg font-serif font-semibold mb-3">About this tour</h2>
          <div class="prose prose-stone max-w-none whitespace-pre-line text-sm leading-relaxed text-stone-700">
            {mainDescription}
          </div>
        </div>
      )}

      {infoBlocks.length > 0 && (
        <div class="mb-8 rounded-xl border border-brand-100 bg-brand-50/50 p-6">
          <h2 class="text-lg font-serif font-semibold mb-4">Good to know</h2>
          <div class="grid sm:grid-cols-3 gap-6">
            {infoBlocks.map((block) => (
              <div>
                <div class="flex items-center gap-2 mb-1.5 text-brand-800">
                  {block.label === 'What to bring' && (
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 shrink-0" aria-hidden="true">
                      <path d="M8 7V5a4 4 0 018 0v2"></path>
                      <rect x="4" y="7" width="16" height="14" rx="2"></rect>
                      <path d="M9 11h6"></path>
                    </svg>
                  )}
                  {block.label === 'Not allowed' && (
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 shrink-0" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"></circle>
                      <path d="M6 6l12 12"></path>
                    </svg>
                  )}
                  {block.label === 'Know before you go' && (
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 shrink-0" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"></circle>
                      <path d="M12 11v5"></path>
                      <path d="M12 8h.01"></path>
                    </svg>
                  )}
                  <p class="font-semibold text-sm">{block.label}</p>
                </div>
                <p class="text-sm text-stone-600 leading-relaxed">{block.text}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      {(tour.includes.length > 0 || tour.excludes.length > 0) && (
        <div class="grid sm:grid-cols-2 gap-6">
          {tour.includes.length > 0 && (
            <div class="rounded-xl border border-stone-200 bg-white p-6">
              <h2 class="text-lg font-serif font-semibold mb-3 text-brand-800">Included</h2>
              <ul class="space-y-2.5">
                {tour.includes.map((i) => (
                  <li class="flex items-start gap-2 text-sm text-stone-700">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-brand-600 shrink-0 mt-0.5" aria-hidden="true">
                      <path d="M5 12l5 5 9-9"></path>
                    </svg>
                    <span>{i}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {tour.excludes.length > 0 && (
            <div class="rounded-xl border border-stone-200 bg-white p-6">
              <h2 class="text-lg font-serif font-semibold mb-3 text-stone-500">Not included</h2>
              <ul class="space-y-2.5">
                {tour.excludes.map((e) => (
                  <li class="flex items-start gap-2 text-sm text-stone-500">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-stone-400 shrink-0 mt-0.5" aria-hidden="true">
                      <path d="M6 6l12 12M18 6L6 18"></path>
                    </svg>
                    <span>{e}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}
    </div>

    <div class="md:sticky md:top-24 self-start">
      <BookingWidget
        client:load
        tourId={tour.id}
        tourTitle={tour.title}
        pricePerTraveler={price.amount}
        pricingTiers={resolvedTiers}
        currency={price.currency}
        addOns={resolvedAddOns}
        minDate={availability.minBookableDate}
        availabilityLabel={availability.label}
        foundingGuestSlotsLeft={foundingGuestSlotsLeft}
      />
    </div>
  </section>
</BaseLayout>

<script define:vars={{ tourId: tour.id, tourName: tour.title, currency: price.currency, value: price.amount }}>
  // Backlog 2.8 — product-marketing-context.md §9's "Key events" list.
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({ event: 'tour_viewed', tour_id: tourId, tour_name: tourName, currency, value });
</script>
