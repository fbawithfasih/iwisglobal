---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingWidget from '../../components/BookingWidget.tsx';
import WeatherCard from '../../components/WeatherCard';
import Icon, { type IconName } from '../../components/Icon.astro';
import MobileActionBar from '../../components/MobileActionBar.astro';
import ReviewList from '../../components/ReviewList.astro';
import { listApprovedReviews, averageRating, hasApprovedReviewsForRequest } from '../../lib/reviews';
import { getTourBySlug } from '../../lib/tours';
import { resizedSrcset, uploadedImageSize } from '../../lib/resizedImages';
import { getAvailability, todayIst } from '../../lib/availability';
import { listLiveAutomaticOffers, offerLiveFor, offerValueLabel, offerConditions, offerBadgeValue } from '../../lib/offers';
import { resolveEnv } from '../../lib/env';
import { pageI18n, fmt, languageName } from '../../i18n/dictionaries';
import { intlLocale } from '../../lib/i18n';
import { countBookingsForRequest } from '../../lib/db';
import { getSessionCustomerId } from '../../lib/requireCustomer';
import { getCustomerById } from '../../lib/customers';
import ShortlistButton from '../../components/ShortlistButton';
import AgraMap from '../../components/AgraMap';
import { sitesInText } from '../../lib/agraSites';
import { isNightViewingTour, nightViewingDatesFrom } from '../../lib/nightViewing';
import { FOUNDING_GUEST_SLOT_CAP, FOUNDING_GUEST_DISCOUNT_RATE } from '../../lib/catalog';
import { resolveCurrency, resolvePrice, resolveAddOns, resolvePricingTiers, resolveFromPrice, CURRENCY_SYMBOLS } from '../../lib/currency';

export const prerender = false;

const env = resolveEnv(Astro.locals);
const { locale, t } = pageI18n(Astro);
const { slug } = Astro.params;
// A signed-in customer's details pre-fill the booking form. The page then
// carries personal data, so it must never be cached for others.
const customerId = await getSessionCustomerId(Astro.cookies, env.CUSTOMER_SESSION_SECRET);
const account = customerId && env.DB ? await getCustomerById(env.DB, customerId) : null;
if (account) Astro.response.headers.set('Cache-Control', 'private, no-store');
// Every lookup that doesn't need the tour starts alongside it (each is a
// round trip to D1); reviews follow once the tour's id is known. The layout
// reads the review flag from the same per-request result.
const [tour, bookingCount, liveOffers] = env.DB && slug
  ? await Promise.all([
      getTourBySlug(env.DB, slug, locale),
      countBookingsForRequest(env.DB, Astro.request).catch(() => 0),
      listLiveAutomaticOffers(env.DB, todayIst()).catch(() => []),
      hasApprovedReviewsForRequest(env.DB, Astro.request),
    ])
  : [null, 0, []];

if (!tour || tour.status !== 'published') {
  return Astro.redirect('/tours');
}

const availability = getAvailability();
const tp = t.tourPage;
// Offer wording and date style in the visitor's language.
const offerText = { ...t.offers, dateTag: intlLocale(locale) };
const availabilityLabel = availability.isTomorrow
  ? t.availability.tomorrow
  : fmt(t.availability.bookFor, { day: new Date(`${availability.minBookableDate}T00:00:00Z`).toLocaleDateString(intlLocale(locale), { weekday: 'long', timeZone: 'UTC' }) });

const requestedCurrency = resolveCurrency(Astro.url.searchParams, Astro.cookies.get('currency')?.value);
if (Astro.url.searchParams.get('currency')) {
  Astro.cookies.set('currency', requestedCurrency, { path: '/', maxAge: 60 * 60 * 24 * 365 });
}
const price = resolvePrice(tour, requestedCurrency);
const resolvedAddOns = resolveAddOns(tour.addOns, price.currency);
const resolvedTiers = resolvePricingTiers(tour.pricingTiers, price.currency);
// "From ₹X" uses the cheapest available rate (the largest-group tier when
// tiers are set) rather than the flat per-traveler amount, which would
// understate a solo traveler's price and overstate a group of 4's.
const fromPrice = resolveFromPrice(tour, requestedCurrency);

// Backlog 1.1 — Founding Guest offer display only; the real eligibility
// decision (and the actual discount applied) happens server-side at
// payment time in razorpay.ts's createOrder, from a fresh count at that
// exact moment. This is just for showing the banner/estimate.
const foundingGuestSlotsLeft = Math.max(0, FOUNDING_GUEST_SLOT_CAP - bookingCount);
const foundingGuestPercent = Math.round(FOUNDING_GUEST_DISCOUNT_RATE * 100);
// Automatic offers running on this tour today (src/lib/offers.ts) — shown
// here and applied in the widget's estimate; create-order decides the charge.
const tourOffers = liveOffers.filter((o) => offerLiveFor(o, tour.id, todayIst()));
// Phones: the offer banners sit far down the page, so the title area and the
// bottom Book bar also carry the first automatic offer.
const offerTag = tourOffers[0] ? offerValueLabel(tourOffers[0], price.currency, offerText) : null;

// Approved guest reviews (src/lib/reviews.ts); nothing shows until there's one.
const reviews = env.DB ? await listApprovedReviews(env.DB, tour.id) : [];
const avgRating = averageRating(reviews);

// Mobile book bar's WhatsApp button. Ref follows BaseLayout's
// "<location>-<page>" format so its clicks are attributed separately.
const whatsappBarRef = `BOOKBAR-TOURS-${tour.slug.toUpperCase()}`;

const fromPriceLabel = `${CURRENCY_SYMBOLS[fromPrice.currency]}${fromPrice.amount.toLocaleString(fromPrice.currency === 'USD' ? 'en-US' : 'en-IN')}`;
const reviewCount = (n: number) => fmt(n === 1 ? tp.reviewOne : tp.reviewMany, { n });

// Key-facts tiles under the title. Each is shown only when the tour data
// backs it, so nothing here claims more than the tour actually offers.
const factTiles: { icon: IconName; label: string; value: string }[] = [
  tour.durationLabel && { icon: 'clock', label: tp.duration, value: tour.durationLabel },
  tour.startPoint && { icon: 'map-pin', label: tp.startsFrom, value: tour.startPoint },
  tour.privateTour && { icon: 'users', label: tp.tourType, value: tp.privateValue },
  tour.guideLanguage && { icon: 'languages', label: tp.guide, value: fmt(tp.guideValue, { lang: languageName(t, tour.guideLanguage) }) },
  tour.pickupIncluded && { icon: 'car', label: tp.pickup, value: tp.included },
  { icon: 'calendar-check', label: tp.cancellation, value: tp.freeUpTo },
  { icon: 'zap', label: tp.confirmation, value: tp.instant },
].filter((t): t is { icon: IconName; label: string; value: string } => Boolean(t));

// Itinerary stops get an icon picked from their wording (first match wins).
// Matched against time + activity, since some tours label stops with words
// ("Taj Mahal visit") rather than clock times. Fort comes before Taj so an
// add-on like "Agra Fort or ... (Baby Taj)" reads as the fort.
const STEP_ICONS: [RegExp, IconName][] = [
  [/fort|sikri/i, 'castle'],
  [/taj/i, 'taj'],
  [/lunch|breakfast|dinner|meal/i, 'utensils'],
  [/train|gatimaan|station/i, 'train'],
  [/sunrise/i, 'sunrise'],
  [/pickup|pick-up|pick up|drop|depart|drive|return/i, 'car'],
];
function stepIcon(step: { time: string; activity: string }): IconName {
  const text = `${step.time} ${step.activity}`;
  return STEP_ICONS.find(([pattern]) => pattern.test(text))?.[1] ?? 'map-pin';
}

// Some tour descriptions end with short labeled paragraphs (e.g. "What to
// bring: ..."). Pull those out of the prose block so they render as their
// own "Good to know" cards instead of getting buried in a wall of text.
// A translated description keeps these labels in its own language, so both the
// visitor's language and English are recognised.
type InfoKey = 'bring' | 'notAllowed' | 'know';
const INFO_LABELS: { key: InfoKey; labels: string[] }[] = [
  { key: 'bring', labels: [tp.infoBring, 'What to bring'] },
  { key: 'notAllowed', labels: [tp.infoNotAllowed, 'Not allowed'] },
  { key: 'know', labels: [tp.infoKnow, 'Know before you go'] },
];
function extractInfoBlocks(description: string): { main: string; blocks: { key: InfoKey; text: string }[] } {
  const paragraphs = description.split(/\n\n+/);
  const blocks: { key: InfoKey; text: string }[] = [];
  const mainParas: string[] = [];
  for (const para of paragraphs) {
    const trimmed = para.trim();
    let hit: { key: InfoKey; label: string } | null = null;
    for (const entry of INFO_LABELS) {
      const label = entry.labels.find((l) => trimmed.toLowerCase().startsWith(`${l.toLowerCase()}:`));
      if (label) {
        hit = { key: entry.key, label };
        break;
      }
    }
    if (hit) {
      blocks.push({ key: hit.key, text: trimmed.slice(hit.label.length + 1).trim() });
    } else if (trimmed) {
      mainParas.push(trimmed);
    }
  }
  return { main: mainParas.join('\n\n'), blocks };
}
const { main: mainDescription, blocks: infoBlocks } = extractInfoBlocks(tour.description);

// Some tour descriptions use "## Heading" lines to break up sub-topics
// (what's included, what to expect, etc.) — rendered as bullet points
// instead of literal "## " text, since the description field is plain
// text (no markdown renderer) and headings that size would be visually
// heavier than this section warrants anyway.
function extractHeadedSections(text: string): { intro: string; sections: { heading: string; body: string }[] } {
  const sections: { heading: string; body: string }[] = [];
  const introParas: string[] = [];
  let current: { heading: string; bodyParas: string[] } | null = null;
  for (const para of text.split(/\n\n+/)) {
    const trimmed = para.trim();
    const headingMatch = trimmed.match(/^##\s+(.+)$/);
    if (headingMatch) {
      if (current) sections.push({ heading: current.heading, body: current.bodyParas.join(' ') });
      current = { heading: headingMatch[1].trim(), bodyParas: [] };
    } else if (trimmed) {
      if (current) current.bodyParas.push(trimmed);
      else introParas.push(trimmed);
    }
  }
  if (current) sections.push({ heading: current.heading, body: current.bodyParas.join(' ') });
  return { intro: introParas.join('\n\n'), sections };
}
const { intro: descriptionIntro, sections: descriptionSections } = extractHeadedSections(mainDescription);

// The description field is plain text, so a markdown-style [text](url) link
// (e.g. cross-linking to another tour) would otherwise show up as literal
// brackets — render it as a real link instead. Escape first so this can't
// inject arbitrary HTML from the (staff-authored, but still) description field.
function escapeHtml(text: string): string {
  return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
function renderDescriptionHtml(text: string): string {
  // whitespace-pre-line on the container handles line breaks — this only
  // needs to turn the escaped [text](url) syntax into a real link.
  return escapeHtml(text).replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-brand-700 hover:underline">$1</a>');
}
const descriptionIntroHtml = renderDescriptionHtml(descriptionIntro);

// Backlog 2.1: Product + Offer + TouristTrip. Both share one Offer built
// from the already-resolved `price` (the same amount/currency shown to the
// visitor and charged server-side) — the previous version used the raw
// flat tour.amount/tour.currency, which drifted from the real price once
// currency toggling and group-size tiers existed.
const tourUrl = `https://www.iwisglobal.com/tours/${tour.slug}`;
// The price is the same "From" amount the page and tour cards show (the
// cheapest group-size rate), so Google never displays a higher figure than
// the visitor sees on the page.
const tourOfferJsonLd = {
  '@type': 'Offer',
  price: fromPrice.amount,
  priceCurrency: fromPrice.currency,
  availability: 'https://schema.org/InStock',
  url: tourUrl,
};
const tripJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: tour.title,
      description: tour.summary,
      url: tourUrl,
      image: tour.image ? new URL(tour.image, Astro.url.origin).toString() : undefined,
      brand: { '@type': 'Organization', name: 'IWIS Global' },
      offers: tourOfferJsonLd,
    },
    {
      '@type': 'TouristTrip',
      name: tour.title,
      description: tour.summary,
      url: tourUrl,
      touristType: 'Leisure',
      offers: tourOfferJsonLd,
    },
  ],
};
// Google shows about 60 characters of a title: drop the brand suffix when it
// would push a long tour name past that, so the tour name is never cut off.
const BRAND_SUFFIX = ' — IWIS Global';
// Which Agra sites the itinerary visits, for the little map under it.
const itinerarySites = sitesInText(tour.itinerary.map((st) => st.activity).join(' '));
---
<BaseLayout title={tour.title.length + BRAND_SUFFIX.length > 60 ? tour.title : `${tour.title}${BRAND_SUFFIX}`} description={tour.summary} breadcrumbs={[{ name: tp.breadcrumb, path: '/tours' }]}>
  <script type="application/ld+json" set:html={JSON.stringify(tripJsonLd)} />

  <!-- Ultrawide screens: the whole section scales up together with CSS zoom (photo,
       tiles, text and booking form), so nothing stays small in the middle of a wide
       window. A browser without zoom simply keeps the 2xl size. -->
  <section class="max-w-5xl 2xl:max-w-6xl mx-auto px-3 min-[300px]:px-6 pt-8 pb-16 md:pt-16 [@media(max-height:500px)]:pt-3 2xl:pt-20 grid grid-cols-[minmax(0,1fr)] lg:grid-cols-3 gap-10 2xl:gap-14 items-start min-[2200px]:[zoom:1.25] min-[3000px]:[zoom:1.5] tv-scale">
    <div class="min-w-0 lg:col-span-2">
      <!-- The photo is the page's largest element: sized up front (no jump
           when it loads), fetched first, and phones get a copy sized for the
           screen. -->
      {tour.image ? (
        <img
          src={tour.image}
          srcset={resizedSrcset(tour.image)}
          sizes="(min-width: 1024px) 640px, (min-width: 768px) 66vw, 100vw"
          {...uploadedImageSize(tour.image)}
          alt={tour.title}
          fetchpriority="high"
          class="w-full h-auto rounded-2xl mb-6 object-cover max-h-96 [@media(max-height:500px)]:max-h-[36vh] [@media(max-height:500px)]:mb-4 2xl:max-h-[30rem] shadow-lg shadow-brand-900/15"
        />
      ) : (
        <div class="w-full aspect-[16/7] rounded-2xl mb-6 bg-gradient-to-br from-brand-100 via-brand-50 to-accent-50 flex items-center justify-center text-brand-300 text-sm">
          {tp.noImage}
        </div>
      )}
      <h1 class="text-3xl md:text-4xl 2xl:text-5xl font-serif font-semibold text-brand-950 mb-2">{tour.title}</h1>
      <div class="h-1 w-16 rounded-full bg-gradient-to-r from-brand-600 to-accent-500 mb-4"></div>
      <div class="mb-3"><ShortlistButton client:visible slug={tour.slug} title={tour.title} t={t.shortlist} label /></div>
      <!-- Location and live weather on a line of their own: the weather text
           loads (or fails) after the page, and must not reflow the badges. -->
      <div class="flex items-center gap-2 text-sm text-stone-600 mb-2 min-h-6">
        <span class="inline-flex items-center gap-1"><Icon name="map-pin" class="h-4 w-4 text-brand-600" /> {tp.location}</span>
        <span aria-hidden="true">·</span>
        <WeatherCard client:load t={t.weather} locale={locale} variant="inline" />
      </div>
      <div class="flex flex-wrap items-center gap-2 text-sm text-stone-600 mb-4">
        <span class="inline-flex items-center gap-1 text-xs font-medium px-2.5 py-1 rounded-full bg-accent-50 text-accent-700">
          {availability.label}
        </span>
        {avgRating && (
          <a href="#reviews" class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-50 text-amber-800">
            <span aria-hidden="true" class="text-amber-500">★</span> {avgRating.toFixed(1)} · {reviewCount(reviews.length)}
          </a>
        )}
        {tourOffers[0] && offerTag && (
          <a href="#booking" class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-100 text-amber-800">
            <Icon name="gift" class="h-3.5 w-3.5" /> {tourOffers[0].name} · {offerTag}
          </a>
        )}
      </div>
      {requestedCurrency === 'USD' && price.currency === 'INR' && (
        <p class="text-xs text-stone-500 mb-2">{tp.usdNotSet}</p>
      )}
      <p class="text-stone-700 text-lg 2xl:text-xl leading-relaxed mb-6">{tour.summary}</p>

      <ul class="grid grid-cols-1 min-[300px]:grid-cols-2 sm:grid-cols-3 gap-3 mb-6" aria-label={tp.keyFacts}>
        {factTiles.map((tile, i) => (
          <li class:list={[
            'flex items-start gap-2 rounded-xl border border-brand-100 bg-white p-2.5 transition hover:border-brand-300 hover:shadow-sm min-[400px]:gap-3 min-[400px]:p-3',
            // A lone tile on the last row stretches across it: two columns on a
            // phone or foldable cover screen, three from 640px up.
            i === factTiles.length - 1 && factTiles.length % 2 === 1 && 'min-[300px]:col-span-2 sm:col-span-1',
            i === factTiles.length - 1 && factTiles.length % 3 === 1 && 'sm:col-span-3',
            i === factTiles.length - 1 && factTiles.length % 3 === 2 && 'sm:col-span-2',
          ]}>
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-700 min-[400px]:h-9 min-[400px]:w-9">
              <Icon name={tile.icon} class="h-5 w-5" />
            </span>
            <span class="min-w-0">
              <span class="block text-[10px] font-medium uppercase tracking-normal text-stone-500 [overflow-wrap:anywhere] min-[400px]:text-[11px] min-[400px]:tracking-wide">{tile.label}</span>
              <span class="block text-sm font-semibold text-stone-900 leading-snug [overflow-wrap:anywhere]">{tile.value}</span>
            </span>
          </li>
        ))}
      </ul>

      <div class="mb-8 rounded-2xl bg-gradient-to-br from-brand-700 via-brand-600 to-brand-800 p-6 text-white shadow-lg shadow-brand-900/20">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm text-brand-100">{tp.pricedPerPerson}</p>
            <p class="text-3xl font-semibold">
              {tp.from} {fromPriceLabel}
              <span class="text-base font-normal text-brand-100">{tp.perPerson}</span>
            </p>
            {resolvedTiers.length > 0 && (
              <p class="text-sm text-brand-100 mt-1">{fmt(tp.groupsOf, { n: Math.max(...resolvedTiers.map((x) => x.travelers)) })}</p>
            )}
          </div>
          <a href="#booking" class="inline-flex min-h-11 items-center justify-center rounded-full bg-white px-6 font-semibold text-brand-800 shadow transition hover:bg-brand-50 focus:outline-none focus-visible:ring-4 focus-visible:ring-white/60">
            {tp.check}
          </a>
        </div>
        {foundingGuestSlotsLeft > 0 && (
          <div class="mt-4 flex items-center gap-3 rounded-xl bg-white/10 px-3 py-2.5 ring-1 ring-white/15">
            <span class="flex h-11 w-11 shrink-0 flex-col items-center justify-center rounded-full bg-amber-300 leading-none text-brand-950 shadow-md">
              <span class="text-sm font-extrabold">{foundingGuestPercent}%</span>
              <span class="mt-0.5 text-[8px] font-bold tracking-widest">{tp.off}</span>
            </span>
            <p class="text-sm leading-snug text-brand-50">
              <strong class="font-serif text-base font-semibold text-white">{tp.foundingTitle}</strong><br />
              {tp.foundingBody} <span class="font-semibold text-amber-200">{fmt(tp.foundingLeft, { n: foundingGuestSlotsLeft, cap: FOUNDING_GUEST_SLOT_CAP })}</span>
            </p>
          </div>
        )}
        {tourOffers.map((offer) => {
          const badgeValue = offerBadgeValue(offer, price.currency);
          const conditions = offerConditions(offer, {}, offerText);
          return (
            <div class="mt-4 flex items-center gap-3 rounded-xl bg-white/10 px-3 py-2.5 ring-1 ring-white/15">
              <span class="flex h-11 w-11 shrink-0 flex-col items-center justify-center rounded-full bg-amber-300 leading-none text-brand-950 shadow-md">
                <span class:list={['font-extrabold', badgeValue.length > 5 ? 'text-[10px]' : 'text-sm']}>{badgeValue}</span>
                <span class="mt-0.5 text-[8px] font-bold tracking-widest">{tp.off}</span>
              </span>
              <p class="text-sm leading-snug text-brand-50">
                <strong class="font-serif text-base font-semibold text-white">{offer.name}</strong><br />
                {conditions ? `${conditions}. ` : ''}{t.offers.applied}
              </p>
            </div>
          );
        })}
      </div>

      {tour.highlights.length > 0 && (
        <div class="mb-8 rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50 to-white p-6">
          <h2 class="flex items-center gap-2.5 text-xl font-serif font-semibold mb-4">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-brand-700 to-brand-500 text-white shadow-sm"><Icon name="sparkles" class="h-[18px] w-[18px]" /></span>
            {tp.highlights}
          </h2>
          <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-3">
            {tour.highlights.map((h) => (
              <li class="flex items-start gap-2.5 text-sm text-stone-700">
                <Icon name="circle-check" class="h-5 w-5 text-brand-600 shrink-0 mt-0.5" strokeWidth={2} />
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {tour.itinerary.length > 0 && (
        <div class="mb-8 rounded-2xl border border-brand-100 bg-white p-6 shadow-sm shadow-brand-900/5">
          <h2 class="flex items-center gap-2.5 text-xl font-serif font-semibold mb-1">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-brand-700 to-brand-500 text-white shadow-sm"><Icon name="route" class="h-[18px] w-[18px]" /></span>
            {tp.itinerary}
          </h2>
          {tour.itinerary.some((s) => s.details) && (
            <p class="text-xs text-stone-500 mb-4 ml-[42px]">{tp.tapStop}</p>
          )}
          <ol class="itin-story relative mt-4">
            {tour.itinerary.map((step, index) => (
              <li class="relative flex gap-4 pb-5 last:pb-0" data-sites={sitesInText(step.activity).join(",")}>
                {index < tour.itinerary.length - 1 && (
                  <span class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-brand-100" aria-hidden="true"><span class="story-fill block h-full w-full origin-top bg-brand-500"></span></span>
                )}
                <span class="story-dot relative z-10 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-600 text-white ring-4 ring-brand-50">
                  <Icon name={stepIcon(step)} class="h-[18px] w-[18px]" />
                </span>
                {step.details ? (
                  <details class="group min-w-0 flex-1 rounded-xl border border-transparent transition open:border-brand-100 open:bg-brand-50/60">
                    <summary class="flex min-h-11 cursor-pointer list-none items-start justify-between gap-3 rounded-xl px-3 py-1.5 hover:bg-brand-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 [&::-webkit-details-marker]:hidden">
                      <span>
                        <span class="block text-xs font-semibold uppercase tracking-wide text-brand-700">{step.time}</span>
                        <span class="block text-sm font-medium text-stone-900">{step.activity}</span>
                      </span>
                      <Icon name="chevron-down" class="mt-2 h-5 w-5 shrink-0 text-brand-600 transition-transform group-open:rotate-180" />
                    </summary>
                    <p class="px-3 pb-3 text-sm leading-relaxed text-stone-700" set:html={renderDescriptionHtml(step.details)} />
                  </details>
                ) : (
                  <div class="min-w-0 flex-1 px-3 py-1.5">
                    <p class="text-xs font-semibold uppercase tracking-wide text-brand-700">{step.time}</p>
                    <p class="text-sm font-medium text-stone-900">{step.activity}</p>
                  </div>
                )}
              </li>
            ))}
          </ol>
          {itinerarySites.length >= 2 && (
            <div class="mt-6 border-t border-brand-100 pt-4">
              <p class="mb-2 text-sm font-semibold text-brand-900">{t.agraMap.stopsTitle}</p>
              <AgraMap client:visible t={t.agraMap} compact inTour={itinerarySites} />
            </div>
          )}
        </div>
      )}

      {(descriptionIntro || descriptionSections.length > 0) && (
        <div class="mb-8 rounded-2xl border border-brand-100 bg-white p-6 shadow-sm shadow-brand-900/5">
          <h2 class="flex items-center gap-2.5 text-xl font-serif font-semibold mb-4">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-brand-700 to-brand-500 text-white shadow-sm"><Icon name="book-open" class="h-[18px] w-[18px]" /></span>
            {tp.about}
          </h2>
          {descriptionIntro && (
            <div class="prose prose-stone max-w-none whitespace-pre-line text-sm leading-relaxed text-stone-700 mb-4" set:html={descriptionIntroHtml} />
          )}
          {descriptionSections.length > 0 && (
            <ul class="space-y-3">
              {descriptionSections.map((section) => (
                <li class="flex items-start gap-2.5 text-sm text-stone-700 leading-relaxed">
                  <Icon name="circle-check" class="h-5 w-5 text-brand-600 shrink-0 mt-0.5" strokeWidth={2} />
                  <span><span class="font-semibold text-stone-900">{section.heading}:</span> <span set:html={renderDescriptionHtml(section.body)} /></span>
                </li>
              ))}
            </ul>
          )}
        </div>
      )}

      {infoBlocks.length > 0 && (
        <div class="mb-8 rounded-2xl border border-brand-100 bg-brand-50/50 p-6">
          <h2 class="flex items-center gap-2.5 text-xl font-serif font-semibold mb-4">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-brand-700 to-brand-500 text-white shadow-sm"><Icon name="info" class="h-[18px] w-[18px]" /></span>
            {tp.goodToKnow}
          </h2>
          <ul class="space-y-4">
            {infoBlocks.map((block) => (
              <li class="flex items-start gap-2.5">
                <Icon
                  name={block.key === 'bring' ? 'backpack' : block.key === 'notAllowed' ? 'ban' : 'info'}
                  class="h-5 w-5 shrink-0 mt-0.5 text-brand-700"
                />
                <p class="text-sm text-stone-700 leading-relaxed">
                  <span class="font-semibold text-brand-800">{block.key === 'bring' ? tp.infoBring : block.key === 'notAllowed' ? tp.infoNotAllowed : tp.infoKnow}:</span> <span set:html={renderDescriptionHtml(block.text)} />
                </p>
              </li>
            ))}
          </ul>
        </div>
      )}

      {(tour.includes.length > 0 || tour.excludes.length > 0) && (
        <div class="grid sm:grid-cols-2 gap-6">
          {tour.includes.length > 0 && (
            <div class="rounded-2xl border border-brand-200 bg-white p-6 shadow-sm shadow-brand-100">
              <h2 class="flex items-center gap-2.5 text-xl font-serif font-semibold mb-4 text-brand-800">
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-brand-700 to-brand-500 text-white shadow-sm"><Icon name="check" class="h-[18px] w-[18px]" strokeWidth={2.25} /></span>
                {tp.includedTitle}
              </h2>
              <ul class="space-y-2.5">
                {tour.includes.map((i) => (
                  <li class="flex items-start gap-2.5 text-sm text-stone-700">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700"><Icon name="check" class="h-3.5 w-3.5" strokeWidth={2.5} /></span>
                    <span>{i}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {tour.excludes.length > 0 && (
            <div class="rounded-2xl border border-stone-200 bg-stone-50/60 p-6">
              <h2 class="flex items-center gap-2.5 text-xl font-serif font-semibold mb-4 text-stone-500">
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-stone-200 text-stone-500"><Icon name="x" class="h-[18px] w-[18px]" strokeWidth={2.25} /></span>
                {tp.notIncluded}
              </h2>
              <ul class="space-y-2.5">
                {tour.excludes.map((e) => (
                  <li class="flex items-start gap-2.5 text-sm text-stone-500">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-stone-100 text-stone-400"><Icon name="x" class="h-3.5 w-3.5" strokeWidth={2.5} /></span>
                    <span>{e}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}

      {reviews.length > 0 && (
        <div id="reviews" class="mt-10 scroll-mt-24">
          <h2 class="mb-1 border-l-4 border-brand-500 pl-3 text-xl font-serif font-semibold text-brand-900">{tp.reviews}</h2>
          <p class="text-sm text-stone-600 mb-4">
            <span class="text-amber-500" aria-hidden="true">★</span> {fmt(tp.ratingSummary, { rating: avgRating!.toFixed(1), count: reviewCount(reviews.length) })}
          </p>
          <ReviewList reviews={reviews} />
        </div>
      )}
    </div>

    <div id="booking" class="min-w-0 lg:sticky lg:top-24 self-start scroll-mt-24 md:mx-auto md:w-full md:max-w-xl lg:max-w-none">
      <BookingWidget
        client:load
        tourId={tour.id}
        tourTitle={tour.title}
        pricePerTraveler={price.amount}
        pricingTiers={resolvedTiers}
        currency={price.currency}
        addOns={resolvedAddOns}
        minDate={availability.minBookableDate}
        allowedDates={isNightViewingTour(tour.id) ? nightViewingDatesFrom(availability.minBookableDate) : undefined}
        availabilityLabel={availabilityLabel}
        foundingGuestSlotsLeft={foundingGuestSlotsLeft}
        offers={tourOffers}
        initialName={account?.name}
        initialEmail={account?.email}
        initialPhone={account?.phone ?? undefined}
        tr={t.booking}
        offerText={offerText}
        locale={locale}
      />
    </div>
  </section>

  <!-- Phones only: the booking form sits below all the tour content there,
       so keep the price and a way to it in reach; the bar slides away while
       the form itself is on screen. -->
  <MobileActionBar
    waRef={whatsappBarRef}
    waMessage={`Hi! I have a question about the ${tour.title}.`}
    hideWhenVisible="booking"
    hideFrom="lg"
  >
    <Fragment slot="info">
      <p class="text-[11px] font-medium uppercase tracking-wide text-stone-500">
        {tp.from}
        {offerTag && <span class="ml-1 rounded-full bg-amber-100 px-1.5 py-0.5 normal-case tracking-normal font-semibold text-amber-800">{offerTag}</span>}
      </p>
      <p class="text-lg font-semibold leading-tight text-stone-900">
        {fromPriceLabel} <span class="text-xs font-normal text-stone-500">{tp.perPerson}</span>
      </p>
    </Fragment>
    <a slot="action" href="#booking" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-6 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:bg-brand-800 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300">
      {tp.bookNow}
    </a>
  </MobileActionBar>
</BaseLayout>

<script define:vars={{ tourId: tour.id, tourName: tour.title, currency: price.currency, value: price.amount }}>
  // Backlog 2.8 — product-marketing-context.md §9's "Key events" list.
  window.gtag?.('event', 'tour_viewed', { tour_id: tourId, tour_name: tourName, currency, value });
  // Meta Pixel, sent only if the visitor accepts cookies (CookieConsent.astro).
  (window.iwisPixelQueue = window.iwisPixelQueue || []).push([
    'ViewContent',
    { content_ids: [tourId], content_name: tourName, content_type: 'product', currency, value },
  ]);
</script>

<!-- Day story: as each stop scrolls into view its dot lights up and the line
     to the next stop fills. Only switched on when JavaScript runs and the
     visitor has not asked for reduced motion; otherwise every stop simply
     shows in its finished state. -->
<style is:global>
  .itin-story.story-js .story-fill {
    transform: scaleY(0);
    transition: transform 0.7s ease;
  }
  .itin-story.story-js li.story-reached .story-fill {
    transform: scaleY(1);
  }
  .itin-story.story-js .story-dot {
    opacity: 0.45;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .itin-story.story-js li.story-reached .story-dot {
    opacity: 1;
    transform: scale(1.08);
  }
</style>
<script>
  const story = document.querySelector('.itin-story');
  if (story && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    story.classList.add('story-js');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          // A stop already scrolled past (page opened part-way down) counts as reached.
          if (entry.isIntersecting || entry.boundingClientRect.top < 0) {
            entry.target.classList.add('story-reached');
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -30% 0px' },
    );
    story.querySelectorAll('li').forEach((li) => io.observe(li));
  }

  // Itinerary stop <-> map: hovering, focusing or opening a stop lights the
  // matching pin(s) on the map under the list (AgraMap listens for this).
  if (story) {
    const light = (sites: string[]) => window.dispatchEvent(new CustomEvent('iwis:site', { detail: sites }));
    story.querySelectorAll('li').forEach((li) => {
      const sites = (li.getAttribute('data-sites') ?? '').split(',').filter(Boolean);
      if (sites.length === 0) return;
      li.addEventListener('mouseenter', () => light(sites));
      li.addEventListener('mouseleave', () => light([]));
      li.addEventListener('focusin', () => light(sites));
      li.addEventListener('focusout', () => light([]));
      li.querySelector('details')?.addEventListener('toggle', (e) => light((e.target as HTMLDetailsElement).open ? sites : []));
    });
  }
</script>
