---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingWidget from '../../components/BookingWidget.tsx';
import { getTourBySlug } from '../../lib/tours';
import { resolveEnv } from '../../lib/env';

export const prerender = false;

const env = resolveEnv(Astro.locals);
const { slug } = Astro.params;
const tour = env.DB && slug ? await getTourBySlug(env.DB, slug) : null;

if (!tour || tour.status !== 'published') {
  return Astro.redirect('/tours');
}

const tripJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: tour.title,
  description: tour.summary,
  offers: {
    '@type': 'Offer',
    price: tour.amount,
    priceCurrency: tour.currency,
  },
};
---
<BaseLayout title={`${tour.title} — IWIS Global`} description={tour.summary}>
  <script type="application/ld+json" set:html={JSON.stringify(tripJsonLd)} />

  <section class="max-w-5xl mx-auto px-6 py-16 grid md:grid-cols-3 gap-10">
    <div class="md:col-span-2">
      {tour.image && <img src={tour.image} alt={tour.title} class="w-full rounded-xl mb-6 object-cover max-h-80" />}
      <h1 class="text-3xl font-serif font-semibold mb-2">{tour.title}</h1>
      <p class="text-stone-600 mb-6">{tour.summary}</p>

      <div class="flex gap-6 text-sm text-stone-500 mb-8">
        <span>{tour.durationLabel}</span>
        <span>From {tour.startPoint}</span>
      </div>

      {tour.highlights.length > 0 && (
        <div class="mb-8">
          <h2 class="text-lg font-semibold mb-2">Highlights</h2>
          <ul class="list-disc list-inside text-stone-700 space-y-1">
            {tour.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </div>
      )}

      {tour.itinerary.length > 0 && (
        <div class="mb-8">
          <h2 class="text-lg font-semibold mb-2">Itinerary</h2>
          <ol class="space-y-2">
            {tour.itinerary.map((step) => (
              <li class="flex gap-3 text-sm">
                <span class="font-medium w-20 shrink-0">{step.time}</span>
                <span class="text-stone-700">{step.activity}</span>
              </li>
            ))}
          </ol>
        </div>
      )}

      {tour.description && (
        <div class="prose prose-stone max-w-none mb-8 whitespace-pre-line">
          {tour.description}
        </div>
      )}

      {tour.includes.length > 0 && (
        <div class="mb-4">
          <h2 class="text-lg font-semibold mb-2">Includes</h2>
          <ul class="list-disc list-inside text-stone-700 space-y-1">
            {tour.includes.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      )}
    </div>

    <div>
      <BookingWidget
        client:load
        tourId={tour.id}
        tourTitle={tour.title}
        pricePerTraveler={tour.amount}
        currency={tour.currency}
        addOns={tour.addOns}
      />
    </div>
  </section>
</BaseLayout>
