---
// D1-backed (see src/lib/blog.ts) — replaces the git-based content
// collection this route originally used, so posts can be published from
// /admin/blog without a redeploy. Only 'published' posts are shown here;
// drafts stay admin-only.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveEnv } from '../../lib/env';
import { listBlogPosts } from '../../lib/blog';
import MobileActionBar from '../../components/MobileActionBar.astro';
import { pageI18n } from '../../i18n/dictionaries';
import { intlLocale } from '../../lib/i18n';
import { localizedEntry, overlayFields } from '../../lib/localizedContent';

const env = resolveEnv(Astro.locals);


const { locale, t } = pageI18n(Astro);
const posts = env.DB
  ? await Promise.all(
      (await listBlogPosts(env.DB, { status: 'published' })).map(async (p) => overlayFields(p, await localizedEntry('blog_post', locale, p.slug)))
    )
  : [];
const CATEGORY_LABELS: Record<string, string> = {
  news: t.blogCats.news,
  'travel-tips': t.blogCats.travelTips,
  seasonal: t.blogCats.seasonal,
};
const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString(intlLocale(locale), { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' });
---


<BaseLayout title={t.blogIndex.k19} description={t.blogIndex.k20}>
  <section class="max-w-3xl mx-auto px-6 py-16">
    <div class="mb-6 rounded-2xl bg-gradient-to-br from-brand-900 via-brand-700 to-brand-600 p-6 text-white shadow-lg shadow-brand-900/20 sm:p-8">
      <span class="inline-block rounded-full bg-white/15 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-100" set:html={t.blogIndex.k16} />
      <h1 class="mt-3 text-3xl md:text-4xl font-serif font-semibold mb-2" set:html={t.blogIndex.k1} />
      <p class="text-white/90" set:html={t.blogIndex.k2} />
    </div>

    <!-- Google "Preferred Sources" button — lets readers mark IWIS Global as
         a preferred source in Google Search. Official widget, per
         https://developers.google.com/search/docs/appearance/preferred-sources
         Scoped to /blog only (script isn't loaded site-wide). -->
    <script async src="https://news.google.com/swg/js/v1/publisher.js"></script>
    <div class="mb-6 flex flex-wrap items-center gap-3 rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50 to-white px-4 py-3 shadow-sm shadow-brand-900/5">
      <span class="text-sm font-medium text-brand-900" set:html={t.blogIndex.k17} />
      <div google-add-preferred-source-btn data-theme="light"></div>
    </div>

    {posts.length === 0 ? (
      <p class="rounded-2xl border border-brand-100 bg-brand-50/60 p-6 text-stone-600" set:html={t.blogIndex.k3} />
    ) : (
      <div class="space-y-5">
        {posts.map((post, i) => (
          <a href={`/blog/${post.slug}`} class="group block overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-sm shadow-brand-900/5 hover:border-brand-300 hover:shadow-md transition">
            {post.image && (
              <div class="relative">
                <img
                  src={post.imageThumb ?? post.image}
                  srcset={post.imageThumb ? `${post.imageThumb} 800w, ${post.image} 1200w` : undefined}
                  sizes="(min-width: 768px) 672px, calc(100vw - 48px)"
                  width="800"
                  height="450"
                  alt=""
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="w-full aspect-[16/9] object-cover transition group-hover:opacity-90"
                />
                {/* Generated or drawn covers are labelled so they aren't taken for real photos. */}
                {post.imageIsIllustration && (
                  <span class="absolute left-3 bottom-3 rounded-full bg-black/60 px-2.5 py-0.5 text-xs font-medium text-white">Illustration</span>
                )}
              </div>
            )}
            <div class="p-6">
              <p class="text-xs mb-2">
                <span class="rounded-full bg-brand-100 px-2.5 py-0.5 font-semibold tracking-wide text-brand-800 uppercase">{CATEGORY_LABELS[post.category] ?? post.category}</span>
                {post.datePublished && (
                  <>
                    <span class="text-stone-400" aria-hidden="true"> · </span>
                    <time datetime={post.datePublished} class="text-stone-500">{formatDate(post.datePublished)}</time>
                  </>
                )}
              </p>
              <h2 class="mb-1 font-serif text-xl font-semibold text-brand-900 group-hover:underline">{post.title}</h2>
              <p class="text-sm text-stone-600">{post.description}</p>
            </div>
          </a>
        ))}
      </div>
    )}

    <h2 class="mt-14 mb-3 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900" set:html={t.blogIndex.k4} />
    <p class="text-stone-700 mb-4" set:html={t.blogIndex.k5} />
    <ul class="list-disc pl-5 text-stone-700 space-y-2 mb-8 marker:text-brand-500">
      <li set:html={t.blogIndex.k6} />
      <li set:html={t.blogIndex.k7} />
      <li set:html={t.blogIndex.k8} />
    </ul>
    <p class="text-stone-700 mb-8" set:html={t.blogIndex.k9} />
    <h2 class="mb-3 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900" set:html={t.blogIndex.k10} />
    <p class="text-stone-700 mb-8" set:html={t.blogIndex.k11} />
    <h2 class="mb-3 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900" set:html={t.blogIndex.k12} />
    <p class="rounded-2xl border border-brand-100 bg-brand-50/60 p-5 text-stone-700" set:html={t.blogIndex.k13} />
  </section>

  <!-- Phones: WhatsApp moves into this bar so the floating button doesn't
       sit on top of the post cards; plus a way on to the tours. -->
  <MobileActionBar waRef="BLOGBAR-BLOG" waMessage="Hi! I read your blog and have a question.">
    <Fragment slot="info">
      <p class="text-[11px] font-medium uppercase tracking-wide text-stone-500" set:html={t.blogIndex.k14} />
      <p class="text-sm font-semibold leading-tight text-stone-900" set:html={t.blogIndex.k15} />
    </Fragment>
    <a slot="action" href="/tours" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-5 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:bg-brand-800 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300" set:html={t.blogIndex.k18} />
  </MobileActionBar>
</BaseLayout>
