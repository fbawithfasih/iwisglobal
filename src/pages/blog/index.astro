---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime()
);

const CATEGORY_LABELS: Record<string, string> = {
  news: 'News',
  'travel-tips': 'Travel Tips',
  seasonal: 'Seasonal',
};
---

<BaseLayout title="Blog — IWIS Global" description="Company news, travel stories and tips, and seasonal Agra updates from IWIS Global.">
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-serif font-semibold mb-2">Blog</h1>
    <p class="text-stone-600 mb-10">Company news, travel stories and tips, and seasonal Agra updates.</p>

    {posts.length === 0 ? (
      <p class="text-stone-600 border border-stone-200 rounded-xl bg-white p-6">
        We don't have any posts published yet — check back soon. In the meantime, see our
        <a href="/guides" class="text-brand-800 hover:underline">Guides</a> for practical, sourced answers about
        visiting the Taj Mahal.
      </p>
    ) : (
      <div class="space-y-6">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="block rounded-xl border border-stone-200 bg-white p-6 hover:shadow-md transition">
            <span class="inline-block text-xs font-semibold tracking-wide text-brand-700 uppercase mb-2">
              {CATEGORY_LABELS[post.data.category] ?? post.data.category}
            </span>
            <h2 class="text-lg font-semibold mb-1">{post.data.title}</h2>
            <p class="text-sm text-stone-600">{post.data.description}</p>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
