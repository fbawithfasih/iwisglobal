---
// D1-backed (see src/lib/blog.ts) — replaces the git-based content
// collection this route originally used, so posts can be published from
// /admin/blog without a redeploy. Only 'published' posts are shown here;
// drafts stay admin-only.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveEnv } from '../../lib/env';
import { listBlogPosts } from '../../lib/blog';
import MobileActionBar from '../../components/MobileActionBar.astro';

const env = resolveEnv(Astro.locals);
const posts = env.DB ? await listBlogPosts(env.DB, { status: 'published' }) : [];

const CATEGORY_LABELS: Record<string, string> = {
  news: 'News',
  'travel-tips': 'Travel Tips',
  seasonal: 'Seasonal',
};

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' });
---

<BaseLayout title="Blog — IWIS Global" description="Company news, travel stories and tips, and seasonal Agra updates from IWIS Global.">
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-serif font-semibold mb-2">Blog</h1>
    <p class="text-stone-600 mb-4">Company news, travel stories and tips, and seasonal Agra updates.</p>

    <!-- Google "Preferred Sources" button — lets readers mark IWIS Global as
         a preferred source in Google Search. Official widget, per
         https://developers.google.com/search/docs/appearance/preferred-sources
         Scoped to /blog only (script isn't loaded site-wide). -->
    <script async src="https://news.google.com/swg/js/v1/publisher.js"></script>
    <div google-add-preferred-source-btn data-theme="light" class="mb-6"></div>

    {posts.length === 0 ? (
      <p class="text-stone-600 border border-stone-200 rounded-xl bg-white p-6">
        We don't have any posts published yet — check back soon. In the meantime, see our
        <a href="/guides" class="text-brand-800 hover:underline">Guides</a> for practical, sourced answers about
        visiting the Taj Mahal.
      </p>
    ) : (
      <div class="space-y-6">
        {posts.map((post, i) => (
          <a href={`/blog/${post.slug}`} class="group block overflow-hidden rounded-xl border border-stone-200 bg-white hover:shadow-md transition">
            {post.image && (
              <img
                src={post.imageThumb ?? post.image}
                srcset={post.imageThumb ? `${post.imageThumb} 800w, ${post.image} 1200w` : undefined}
                sizes="(min-width: 768px) 672px, calc(100vw - 48px)"
                alt=""
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class="w-full aspect-[16/9] object-cover transition group-hover:opacity-90"
              />
            )}
            <div class="p-6">
              <p class="text-xs mb-2">
                <span class="font-semibold tracking-wide text-brand-700 uppercase">{CATEGORY_LABELS[post.category] ?? post.category}</span>
                {post.datePublished && (
                  <>
                    <span class="text-stone-400" aria-hidden="true"> · </span>
                    <time datetime={post.datePublished} class="text-stone-500">{formatDate(post.datePublished)}</time>
                  </>
                )}
              </p>
              <h2 class="text-lg font-semibold mb-1">{post.title}</h2>
              <p class="text-sm text-stone-600">{post.description}</p>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

  <!-- Phones: WhatsApp moves into this bar so the floating button doesn't
       sit on top of the post cards; plus a way on to the tours. -->
  <MobileActionBar waRef="BLOGBAR-BLOG" waMessage="Hi! I read your blog and have a question.">
    <Fragment slot="info">
      <p class="text-[11px] font-medium uppercase tracking-wide text-stone-500">Visiting Agra?</p>
      <p class="text-sm font-semibold leading-tight text-stone-900">Private Taj Mahal tours</p>
    </Fragment>
    <a slot="action" href="/tours" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-5 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:bg-brand-800 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300">
      View tours
    </a>
  </MobileActionBar>
</BaseLayout>
