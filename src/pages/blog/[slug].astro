---
// D1-backed — see src/pages/blog/index.astro's header comment for why.
// Renders the markdown `body` via `marked` at request time (the D1
// equivalent of what Astro's content-collection `.render()`/`<Content />`
// did at build time for the original git-based version of this route).
// A draft post 404s here even if you know its slug — same rule the
// index page follows, only 'published' is public.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import MobileActionBar from '../../components/MobileActionBar.astro';
import { resolveEnv } from '../../lib/env';
import { getBlogPostBySlug, listBlogPosts, renderBlogBody } from '../../lib/blog';
import { getCollection } from 'astro:content';
import { sortGuides } from '../../lib/guides';

const { slug } = Astro.params;
const env = resolveEnv(Astro.locals);
const post = env.DB && slug ? await getBlogPostBySlug(env.DB, slug) : null;

if (!post || post.status !== 'published') {
  return Astro.redirect('/blog');
}

const bodyHtml = renderBlogBody(post.body);

// "More from the blog": the newest other posts this one doesn't already link
// to, so every post gets links from (and to) its neighbours.
const morePosts = env.DB
  ? (await listBlogPosts(env.DB, { status: 'published' }))
      .filter((p) => p.slug !== post.slug && !bodyHtml.includes(`/blog/${p.slug}`))
      .slice(0, 3)
  : [];

// "Keep reading": the first guides in the site's reading order that this
// post doesn't already link to.
const keepReading = sortGuides(await getCollection('guides'))
  .filter((g) => !bodyHtml.includes(`/guides/${g.slug}`))
  .slice(0, 3);

const CATEGORY_LABELS: Record<string, string> = {
  news: 'News',
  'travel-tips': 'Travel Tips',
  seasonal: 'Seasonal',
};

// India time, like the /blog list (a late-evening IST post is still that day).
const dateFmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' });
// "Updated" only when it's a different day: updatedAt is always a little
// later than datePublished, even for a post never edited after publishing.
const updatedLabel =
  post.datePublished && dateFmt(post.updatedAt) !== dateFmt(post.datePublished) ? dateFmt(post.updatedAt) : null;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  author: { '@type': 'Organization', name: post.authorName },
  datePublished: post.datePublished ? new Date(post.datePublished).toISOString() : undefined,
  dateModified: new Date(post.updatedAt).toISOString(),
  image: post.image ? new URL(post.image, Astro.site ?? 'https://www.iwisglobal.com').toString() : undefined,
  publisher: { '@type': 'Organization', name: 'IWIS Global', logo: { '@type': 'ImageObject', url: 'https://www.iwisglobal.com/logo.png' } },
};
// Google shows about 60 characters of a title: drop the brand suffix when it
// would push a long post title past that, so the title is never cut off.
const BRAND_SUFFIX = ' — IWIS Global';
---

<BaseLayout title={post.title.length + BRAND_SUFFIX.length > 60 ? post.title : `${post.title}${BRAND_SUFFIX}`} description={post.description} image={post.image ?? undefined} breadcrumbs={[{ name: 'Blog', path: '/blog' }]}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <article class="max-w-3xl mx-auto px-6 py-16">
    <a href="/blog" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-800 hover:underline">&larr; All posts</a>
    <span class="mt-3 block w-fit rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold tracking-wide text-brand-800 uppercase">
      {CATEGORY_LABELS[post.category] ?? post.category}
    </span>
    <h1 class="text-3xl md:text-4xl font-serif font-semibold mt-2 mb-3">{post.title}</h1>
    <p class="mb-4 inline-block rounded-full border border-brand-100 bg-white px-3 py-1 text-sm text-stone-500">
      By {post.authorName}
      {post.datePublished && <> · Published {dateFmt(post.datePublished)}</>}
      {updatedLabel && <> · Updated {updatedLabel}</>}
    </p>

    <!-- Google "Preferred Sources" button — see /blog/index.astro's comment
         for the source. Loaded per-page since it's blog-scoped, not site-wide. -->
    <script async src="https://news.google.com/swg/js/v1/publisher.js"></script>
    <div google-add-preferred-source-btn data-theme="light" class="mb-8"></div>

    {/* Phones get the 800px copy made for the /blog list (imageThumb). */}
    {post.image && (
      <figure class="mb-10">
        <img
          src={post.image}
          srcset={post.imageThumb ? `${post.imageThumb} 800w, ${post.image} 1200w` : undefined}
          sizes="(min-width: 768px) 672px, calc(100vw - 48px)"
          width="1200"
          height="675"
          alt={post.imageIsIllustration ? `Illustration for: ${post.title}` : post.title}
          fetchpriority="high"
          decoding="async"
          class="w-full aspect-video object-cover rounded-2xl shadow-lg shadow-brand-900/15"
        />
        {post.imageIsIllustration && (
          <figcaption class="mt-2 text-xs text-stone-500">Illustration — not a photograph.</figcaption>
        )}
      </figure>
    )}
    <div class="prose prose-stone max-w-none prose-headings:font-serif prose-headings:text-brand-900 prose-h2:border-l-4 prose-h2:border-brand-500 prose-h2:pl-3 prose-a:text-brand-700 prose-li:marker:text-brand-500" set:html={bodyHtml} />

    {morePosts.length > 0 && (
      <section class="mt-12 border-t border-stone-200 pt-8" aria-labelledby="more-posts">
        <h2 id="more-posts" class="mb-4 border-l-4 border-brand-500 pl-3 text-xl font-serif font-semibold text-brand-900">More from the blog</h2>
        <ul class="space-y-3">
          {morePosts.map((p) => (
            <li>
              <a href={`/blog/${p.slug}`} class="block rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50/60 to-white p-4 shadow-sm shadow-brand-900/5 hover:border-brand-300 hover:shadow-md transition">
                <span class="block font-serif font-semibold text-brand-900">{p.title}</span>
                <span class="mt-1 block text-sm text-stone-600">{p.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {keepReading.length > 0 && (
      <section class="mt-12 border-t border-stone-200 pt-8" aria-labelledby="keep-reading">
        <h2 id="keep-reading" class="mb-4 border-l-4 border-brand-500 pl-3 text-xl font-serif font-semibold text-brand-900">Keep reading</h2>
        <ul class="space-y-3">
          {keepReading.map((g) => (
            <li>
              <a href={`/guides/${g.slug}`} class="block rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50/60 to-white p-4 shadow-sm shadow-brand-900/5 hover:border-brand-300 hover:shadow-md transition">
                <span class="block font-serif font-semibold text-brand-900">{g.data.title}</span>
                <span class="mt-1 block text-sm text-stone-600">{g.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

  <!-- Phones: WhatsApp moves into this bar so the floating button doesn't
       sit on top of the article text; plus a way on to the tours. -->
  <MobileActionBar waRef={`BLOGBAR-BLOG-${post.slug.toUpperCase()}`} waMessage="Hi! I read your blog and have a question.">
    <Fragment slot="info">
      <p class="text-[11px] font-medium uppercase tracking-wide text-stone-500">Visiting Agra?</p>
      <p class="text-sm font-semibold leading-tight text-stone-900">Private Taj Mahal tours</p>
    </Fragment>
    <a slot="action" href="/tours" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-5 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:bg-brand-800 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300">
      View tours
    </a>
  </MobileActionBar>
</BaseLayout>

<style is:global>
  /* Phone numbers in posts (e.g. the Tourist Police post) are tapped on a
     phone, often in a hurry: give them a full 44px tap area. */
  .prose a[href^='tel:'] {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
