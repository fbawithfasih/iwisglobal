---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ShowPasswordButton from '../components/ShowPasswordButton.astro';
import { resolveEnv } from '../lib/env';
import { CUSTOMER_COOKIE } from '../lib/requireCustomer';
import { createCustomerSessionToken } from '../lib/customerAuth';
import { clearCustomerLoginAttempts } from '../lib/customerLoginAttempts';
import { customerForResetToken, resetPassword, MIN_PASSWORD_LENGTH } from '../lib/passwordReset';
import { sendPasswordChangedEmail } from '../lib/email';

// Step 2 of "forgot password": the emailed link lands here to set a new
// password, then signs the guest in.
const env = resolveEnv(Astro.locals);
const db = env.DB;

// The emailed link's token moves straight into a short-lived cookie and the
// address loses it, so it never reaches analytics (which records page
// addresses), the browser history or a Referer header.
const RESET_COOKIE = 'pw_reset';
const fromLink = Astro.url.searchParams.get('t');
if (fromLink) {
  Astro.cookies.set(RESET_COOKIE, fromLink, { httpOnly: true, secure: true, sameSite: 'lax', path: '/reset-password', maxAge: 60 * 60 });
  return Astro.redirect('/reset-password', 303);
}
const token = Astro.cookies.get(RESET_COOKIE)?.value ?? '';

let error: string | null = null;
if (Astro.request.method === 'POST' && db && env.CUSTOMER_SESSION_SECRET) {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  if (password.length < MIN_PASSWORD_LENGTH) {
    error = `Password must be at least ${MIN_PASSWORD_LENGTH} characters.`;
  } else {
    const customer = await resetPassword(db, token, password);
    if (customer) {
      Astro.cookies.delete(RESET_COOKIE, { path: '/reset-password' });
      await clearCustomerLoginAttempts(db, Astro.request.headers.get('cf-connecting-ip') ?? 'unknown');
      Astro.cookies.set(CUSTOMER_COOKIE, await createCustomerSessionToken(customer.id, env.CUSTOMER_SESSION_SECRET), {
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        path: '/',
        maxAge: 60 * 60 * 24 * 30,
      });
      // Tell the account's inbox, in case this wasn't its owner (sent in the
      // background so it doesn't hold up the redirect).
      const alert = sendPasswordChangedEmail(env, { to: customer.email, name: customer.name });
      const ctx = (Astro.locals as { runtime?: { ctx?: { waitUntil(p: Promise<unknown>): void } } }).runtime?.ctx;
      if (ctx) ctx.waitUntil(alert);
      else await alert;
      return Astro.redirect('/account/bookings?password=changed');
    }
  }
}

const account = db ? await customerForResetToken(db, token) : null;
---

<BaseLayout floatingWhatsApp={false} title={account ? 'Choose a new password — IWIS Global' : 'Link expired — IWIS Global'} noindex>
  <section class="max-w-sm mx-auto px-6 pt-10 pb-20 md:pt-20 text-center">
    {account ? (
      <>
        <h1 class="text-3xl font-serif font-semibold mb-2">Choose a new password</h1>
        <p class="text-stone-600 mb-8">For <span class="font-medium text-stone-800 break-all">{account.email}</span></p>
        <form method="POST" class="space-y-3 text-left">
          {error && <p class="text-red-600 text-sm" role="alert">{error}</p>}
          <input type="email" name="username" autocomplete="username" value={account.email} class="hidden" readonly aria-hidden="true" tabindex="-1" />
          <div>
            <label for="password" class="block text-xs font-medium text-stone-500 mb-1">New password (at least {MIN_PASSWORD_LENGTH} characters)</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              minlength={MIN_PASSWORD_LENGTH}
              autocomplete="new-password"
              class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-brand-500"
            />
            <div class="flex justify-end"><ShowPasswordButton for="password" /></div>
          </div>
          <button type="submit" class="w-full rounded-lg bg-brand-800 text-white px-4 py-3 font-medium hover:bg-brand-900 transition">
            Save and sign in
          </button>
        </form>
      </>
    ) : (
      <>
        <h1 class="text-3xl font-serif font-semibold mb-2">This link has expired or was already used</h1>
        <p class="text-stone-600 mb-6">Password links work once, within an hour of being sent. Ask for a new one and use the link in the latest email.</p>
        <a href="/forgot-password" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-800 px-6 font-semibold text-white hover:bg-brand-900 transition">
          Send a new link
        </a>
      </>
    )}
  </section>
</BaseLayout>
