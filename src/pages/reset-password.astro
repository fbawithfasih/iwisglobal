---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ShowPasswordButton from '../components/ShowPasswordButton.astro';
import { resolveEnv } from '../lib/env';
import { pageI18n, fmt } from '../i18n/dictionaries';
import { CUSTOMER_COOKIE } from '../lib/requireCustomer';
import { createCustomerSessionToken } from '../lib/customerAuth';
import { clearCustomerLoginAttempts } from '../lib/customerLoginAttempts';
import { customerForResetToken, resetPassword, MIN_PASSWORD_LENGTH } from '../lib/passwordReset';
import { sendPasswordChangedEmail } from '../lib/email';

// Step 2 of "forgot password": the emailed link lands here to set a new
// password, then signs the guest in.
const env = resolveEnv(Astro.locals);
const { t } = pageI18n(Astro);
const db = env.DB;

// The emailed link's token moves straight into a short-lived cookie and the
// address loses it, so it never reaches analytics (which records page
// addresses), the browser history or a Referer header.
const RESET_COOKIE = 'pw_reset';
const fromLink = Astro.url.searchParams.get('t');
if (fromLink) {
  Astro.cookies.set(RESET_COOKIE, fromLink, { httpOnly: true, secure: true, sameSite: 'lax', path: '/reset-password', maxAge: 60 * 60 });
  return Astro.redirect('/reset-password', 303);
}
const token = Astro.cookies.get(RESET_COOKIE)?.value ?? '';

let error: string | null = null;
if (Astro.request.method === 'POST' && db && env.CUSTOMER_SESSION_SECRET) {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  if (password.length < MIN_PASSWORD_LENGTH) {
    error = fmt(t.auth.errPasswordN, { n: MIN_PASSWORD_LENGTH });
  } else {
    const customer = await resetPassword(db, token, password);
    if (customer) {
      Astro.cookies.delete(RESET_COOKIE, { path: '/reset-password' });
      await clearCustomerLoginAttempts(db, Astro.request.headers.get('cf-connecting-ip') ?? 'unknown');
      Astro.cookies.set(CUSTOMER_COOKIE, await createCustomerSessionToken(customer.id, env.CUSTOMER_SESSION_SECRET), {
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        path: '/',
        maxAge: 60 * 60 * 24 * 30,
      });
      // Tell the account's inbox, in case this wasn't its owner (sent in the
      // background so it doesn't hold up the redirect).
      const alert = sendPasswordChangedEmail(env, { to: customer.email, name: customer.name });
      const ctx = (Astro.locals as { runtime?: { ctx?: { waitUntil(p: Promise<unknown>): void } } }).runtime?.ctx;
      if (ctx) ctx.waitUntil(alert);
      else await alert;
      return Astro.redirect('/account/bookings?password=changed');
    }
  }
}

const account = db ? await customerForResetToken(db, token) : null;
---

<BaseLayout floatingWhatsApp={false} title={account ? t.auth.resetTitle : t.auth.expiredTitle} noindex>
  <section class="max-w-md mx-auto px-6 pt-8 pb-20 md:pt-16 text-center">
    <span class="inline-block rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-800 mb-3">{t.auth.yourAccount}</span>
    {account ? (
      <>
        <h1 class="text-3xl font-serif font-semibold mb-2">{t.auth.resetH1}</h1>
        <p class="text-stone-600 mb-6">{t.auth.forEmail.split('{email}')[0]}<span class="font-medium text-stone-800 break-all">{account.email}</span>{t.auth.forEmail.split('{email}')[1]}</p>
        <div class="rounded-2xl border border-brand-100 bg-white p-5 text-left shadow-sm shadow-brand-900/5 sm:p-7">
        <form method="POST" class="space-y-3 text-left">
          {error && <p class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">{error}</p>}
          <input type="email" name="username" autocomplete="username" value={account.email} class="hidden" readonly aria-hidden="true" tabindex="-1" />
          <div>
            <label for="password" class="block text-sm font-medium text-stone-700 mb-1">{fmt(t.auth.newPassword, { n: MIN_PASSWORD_LENGTH })}</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              minlength={MIN_PASSWORD_LENGTH}
              autocomplete="new-password"
              class="w-full rounded-lg border border-stone-300 bg-white px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-brand-400"
            />
            <div class="flex justify-end"><ShowPasswordButton for="password" /></div>
          </div>
          <button type="submit" class="w-full min-h-12 rounded-full bg-gradient-to-r from-brand-900 via-brand-700 to-brand-600 px-4 py-3 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:brightness-110 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300 cursor-pointer">
            {t.auth.saveSignIn}
          </button>
        </form>
        </div>
      </>
    ) : (
      <>
        <h1 class="text-3xl font-serif font-semibold mb-2">{t.auth.expiredH1}</h1>
        <p class="text-stone-600 mb-6">{t.auth.expiredBody}</p>
        <a href="/forgot-password" class="inline-flex min-h-12 items-center justify-center rounded-full bg-gradient-to-r from-brand-900 via-brand-700 to-brand-600 px-6 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:brightness-110">
          {t.auth.sendNew}
        </a>
      </>
    )}
  </section>
</BaseLayout>
