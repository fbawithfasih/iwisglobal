---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ShowPasswordButton from '../components/ShowPasswordButton.astro';
import { resolveEnv } from '../lib/env';
import OAuthButtons from '../components/OAuthButtons.astro';
import { getSessionCustomerId, CUSTOMER_COOKIE, safeRedirectPath, signInErrorMessage } from '../lib/requireCustomer';
import { startOAuthSignIn } from '../lib/oauth/start';
import { getCustomerByEmail } from '../lib/customers';
import { verifyPassword } from '../lib/passwordHash';
import { createCustomerSessionToken } from '../lib/customerAuth';
import { checkCustomerLoginLock, recordFailedCustomerLogin, clearCustomerLoginAttempts } from '../lib/customerLoginAttempts';

const env = resolveEnv(Astro.locals);

const existingCustomerId = await getSessionCustomerId(Astro.cookies, env.CUSTOMER_SESSION_SECRET);
if (existingCustomerId) {
  return Astro.redirect('/account/bookings');
}

// Google/Apple failures arrive as a code (see SIGN_IN_ERRORS), never as text.
const errorParam = signInErrorMessage(Astro.url.searchParams.get('error'));
const redirectTarget = safeRedirectPath(Astro.url.searchParams.get('redirect'));

// Email/password sign-in. Google/Apple use their own callback routes
// (src/pages/auth/*/callback.ts); this form posts back to this same page.
let emailLoginError: string | null = null;
// Kept after a failed attempt so a mistyped password doesn't mean retyping it.
let emailValue = '';
if (Astro.request.method === 'POST') {
  const db = env.DB;
  const ip = Astro.request.headers.get('cf-connecting-ip') ?? 'unknown';
  const lockedForMs = db ? await checkCustomerLoginLock(db, ip) : null;

  if (lockedForMs) {
    emailLoginError = `Too many failed attempts. Try again in ${Math.ceil(lockedForMs / 60000)} minute(s).`;
  } else if (!db || !env.CUSTOMER_SESSION_SECRET) {
    emailLoginError = 'Accounts are not available right now.';
  } else {
    const form = await Astro.request.formData();
    const email = String(form.get('email') ?? '').trim();
    emailValue = email;
    const password = String(form.get('password') ?? '');

    const customer = email ? await getCustomerByEmail(db, email) : null;
    const valid =
      customer?.provider === 'email' && customer.password_hash && customer.password_salt
        ? await verifyPassword(password, customer.password_salt, customer.password_hash)
        : false;

    if (valid && customer) {
      await clearCustomerLoginAttempts(db, ip);
      const token = await createCustomerSessionToken(customer.id, env.CUSTOMER_SESSION_SECRET);
      Astro.cookies.set(CUSTOMER_COOKIE, token, {
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        path: '/',
        maxAge: 60 * 60 * 24 * 30,
      });
      return Astro.redirect(redirectTarget);
    }

    await recordFailedCustomerLogin(db, ip);
    emailLoginError =
      customer && customer.provider !== 'email'
        ? `This email is linked to ${customer.provider === 'google' ? 'Google' : 'Apple'} sign-in — use "Continue with ${customer.provider === 'google' ? 'Google' : 'Apple'}" above instead.`
        : 'Incorrect email or password.';
  }
}

const { googleUrl, appleUrl } = startOAuthSignIn(env, Astro.cookies, Astro.url.origin, redirectTarget);
---

<BaseLayout floatingWhatsApp={false} title="Sign in — IWIS Global" description="Sign in to your IWIS Global account to view and manage your Taj Mahal and Agra tour bookings." noindex>
  <section class="max-w-md mx-auto px-6 pt-8 pb-20 md:pt-16 text-center">
    <span class="inline-block rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-800 mb-3">Your account</span>
    <h1 class="text-3xl font-serif font-semibold mb-2">Sign in</h1>
    <p class="text-stone-600 mb-5">Sign in to view your booking history. You don't need an account to book a tour.</p>
    <p class="text-sm text-brand-900 mb-6 rounded-xl bg-gradient-to-br from-brand-50 to-white border border-brand-100 px-4 py-3 text-left">
      Booked without an account? Use the <strong class="font-semibold text-brand-800">View your booking</strong> link in your confirmation email — bookings made
      without signing in don't appear in an account.
    </p>

    {errorParam && <p class="text-red-600 text-sm mb-4" role="alert">{errorParam}</p>}

    <div class="rounded-2xl border border-brand-100 bg-white p-5 text-left shadow-sm shadow-brand-900/5 sm:p-7">
    <OAuthButtons googleUrl={googleUrl} appleUrl={appleUrl} />

    <form method="POST" class="space-y-3 text-left">
      {emailLoginError && <p class="text-red-600 text-sm" role="alert">{emailLoginError}</p>}
      <div>
        <label for="email" class="block text-sm font-medium text-stone-700 mb-1">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          value={emailValue}
          class="w-full rounded-lg border border-stone-300 bg-white px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-brand-400"
        />
      </div>
      <div>
        <div class="flex items-baseline justify-between mb-1">
          <label for="password" class="block text-xs font-medium text-stone-500">Password</label>
          <a href="/forgot-password" class="-my-2 py-2 pl-3 text-xs font-medium text-brand-800 hover:underline">Forgot password?</a>
        </div>
        <input
          id="password"
          name="password"
          type="password"
          required
          autocomplete="current-password"
          class="w-full rounded-lg border border-stone-300 bg-white px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-brand-400"
        />
        <div class="flex justify-end"><ShowPasswordButton for="password" /></div>
      </div>
      <button
        type="submit"
        class="w-full min-h-12 rounded-full bg-gradient-to-r from-brand-900 via-brand-700 to-brand-600 px-4 py-3 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:brightness-110 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300 cursor-pointer"
      >
        Sign in with email
      </button>
    </form>
    </div>

    <p class="text-sm text-stone-500 mt-4">
      New here? <a href={`/signup?redirect=${encodeURIComponent(redirectTarget)}`} class="inline-flex min-h-11 items-center text-brand-700 font-medium hover:underline">Create an account</a>
    </p>
  </section>
</BaseLayout>
