---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveEnv } from '../lib/env';
import OAuthButtons from '../components/OAuthButtons.astro';
import { getSessionCustomerId, CUSTOMER_COOKIE, safeRedirectPath } from '../lib/requireCustomer';
import { startOAuthSignIn } from '../lib/oauth/start';
import { getCustomerByEmail } from '../lib/customers';
import { verifyPassword } from '../lib/passwordHash';
import { createCustomerSessionToken } from '../lib/customerAuth';
import { checkCustomerLoginLock, recordFailedCustomerLogin, clearCustomerLoginAttempts } from '../lib/customerLoginAttempts';

const env = resolveEnv(Astro.locals);

const existingCustomerId = await getSessionCustomerId(Astro.cookies, env.CUSTOMER_SESSION_SECRET);
if (existingCustomerId) {
  return Astro.redirect('/account/bookings');
}

const errorParam = Astro.url.searchParams.get('error');
const redirectTarget = safeRedirectPath(Astro.url.searchParams.get('redirect'));

// Email/password sign-in. Google/Apple use their own callback routes
// (src/pages/auth/*/callback.ts); this form posts back to this same page.
let emailLoginError: string | null = null;
if (Astro.request.method === 'POST') {
  const db = env.DB;
  const ip = Astro.request.headers.get('cf-connecting-ip') ?? 'unknown';
  const lockedForMs = db ? await checkCustomerLoginLock(db, ip) : null;

  if (lockedForMs) {
    emailLoginError = `Too many failed attempts. Try again in ${Math.ceil(lockedForMs / 60000)} minute(s).`;
  } else if (!db || !env.CUSTOMER_SESSION_SECRET) {
    emailLoginError = 'Accounts are not available right now.';
  } else {
    const form = await Astro.request.formData();
    const email = String(form.get('email') ?? '').trim();
    const password = String(form.get('password') ?? '');

    const customer = email ? await getCustomerByEmail(db, email) : null;
    const valid =
      customer?.provider === 'email' && customer.password_hash && customer.password_salt
        ? await verifyPassword(password, customer.password_salt, customer.password_hash)
        : false;

    if (valid && customer) {
      await clearCustomerLoginAttempts(db, ip);
      const token = await createCustomerSessionToken(customer.id, env.CUSTOMER_SESSION_SECRET);
      Astro.cookies.set(CUSTOMER_COOKIE, token, {
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        path: '/',
        maxAge: 60 * 60 * 24 * 30,
      });
      return Astro.redirect(redirectTarget);
    }

    await recordFailedCustomerLogin(db, ip);
    emailLoginError =
      customer && customer.provider !== 'email'
        ? `This email is linked to ${customer.provider === 'google' ? 'Google' : 'Apple'} sign-in — use "Continue with ${customer.provider === 'google' ? 'Google' : 'Apple'}" above instead.`
        : 'Incorrect email or password.';
  }
}

const { googleUrl, appleUrl } = startOAuthSignIn(env, Astro.cookies, Astro.url.origin, redirectTarget);
---

<BaseLayout title="Sign in — IWIS Global" description="Sign in to your IWIS Global account to view and manage your Taj Mahal and Agra tour bookings." noindex>
  <section class="max-w-sm mx-auto px-6 py-20 text-center">
    <h1 class="text-3xl font-serif font-semibold mb-2">Sign in</h1>
    <p class="text-stone-600 mb-3">Sign in to view your booking history. You don't need an account to book a tour.</p>
    <p class="text-sm text-stone-600 mb-8 rounded-lg bg-brand-50 border border-brand-100 px-3 py-2">
      Booked without an account? Use the <strong>View your booking</strong> link in your confirmation email — bookings made
      without signing in don't appear in an account.
    </p>

    {(emailLoginError || errorParam) && <p class="text-red-600 text-sm mb-4">{emailLoginError || errorParam}</p>}

    <OAuthButtons googleUrl={googleUrl} appleUrl={appleUrl} />

    <form method="POST" class="space-y-3 text-left">
      <div>
        <label for="email" class="block text-xs font-medium text-stone-500 mb-1">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-brand-500"
        />
      </div>
      <div>
        <label for="password" class="block text-xs font-medium text-stone-500 mb-1">Password</label>
        <div class="relative">
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="w-full rounded-lg border border-stone-300 pl-3 pr-16 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-brand-500"
          />
          <button type="button" data-toggle-password="password" aria-pressed="false" aria-label="Show password" class="absolute inset-y-0 right-0 flex min-w-14 items-center justify-center px-3 text-sm font-medium text-brand-800">Show</button>
        </div>
      </div>
      <button
        type="submit"
        class="w-full rounded-lg bg-brand-800 text-white px-4 py-3 font-medium hover:bg-brand-900 transition"
      >
        Sign in with email
      </button>
    </form>

    <p class="text-sm text-stone-500 mt-4">
      New here? <a href={`/signup?redirect=${encodeURIComponent(redirectTarget)}`} class="inline-flex min-h-11 items-center text-brand-700 font-medium hover:underline">Create an account</a>
    </p>
  </section>
</BaseLayout>

<script>
  // "Show" toggle inside the password field — hard to spot typos on a phone keyboard.
  document.querySelectorAll<HTMLButtonElement>('[data-toggle-password]').forEach((btn) => {
    const input = document.getElementById(btn.dataset.togglePassword!) as HTMLInputElement | null;
    if (!input) return;
    btn.addEventListener('click', () => {
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      btn.textContent = show ? 'Hide' : 'Show';
      btn.setAttribute('aria-pressed', String(show));
      btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
    });
  });
</script>
