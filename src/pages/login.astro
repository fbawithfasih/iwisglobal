---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveEnv } from '../lib/env';
import { getSessionCustomerId, OAUTH_STATE_COOKIE } from '../lib/requireCustomer';
import { buildGoogleAuthorizeUrl } from '../lib/oauth/google';
import { buildAppleAuthorizeUrl } from '../lib/oauth/apple';

const env = resolveEnv(Astro.locals);

const existingCustomerId = await getSessionCustomerId(Astro.cookies, env.CUSTOMER_SESSION_SECRET);
if (existingCustomerId) {
  return Astro.redirect('/account/bookings');
}

const errorParam = Astro.url.searchParams.get('error');
const redirectTarget = Astro.url.searchParams.get('redirect') || '/account/bookings';

// CSRF nonce for the OAuth `state` param, paired with where to send the
// customer back to once sign-in completes. SameSite=None because Apple's
// callback is a cross-site POST (form_post) — Lax cookies aren't sent on
// cross-site POST navigations, only top-level GETs like Google's callback.
const nonce = crypto.randomUUID();
Astro.cookies.set(OAUTH_STATE_COOKIE, JSON.stringify({ nonce, redirect: redirectTarget }), {
  httpOnly: true,
  secure: true,
  sameSite: 'none',
  path: '/auth',
  maxAge: 60 * 10,
});

const origin = Astro.url.origin;

let googleUrl: string | null = null;
let googleError: string | null = null;
try {
  googleUrl = buildGoogleAuthorizeUrl(env, `${origin}/auth/google/callback`, nonce);
} catch (e: any) {
  googleError = e.message;
}

let appleUrl: string | null = null;
let appleError: string | null = null;
try {
  appleUrl = buildAppleAuthorizeUrl(env, `${origin}/auth/apple/callback`, nonce);
} catch (e: any) {
  appleError = e.message;
}
---

<BaseLayout title="Sign in — IWIS Global" description="Sign in to view your IWIS Global booking history.">
  <section class="max-w-sm mx-auto px-6 py-20 text-center">
    <h1 class="text-3xl font-serif font-semibold mb-2">Sign in</h1>
    <p class="text-stone-600 mb-8">Sign in to view your booking history. You don't need an account to book a tour.</p>

    {errorParam && <p class="text-red-600 text-sm mb-4">{errorParam}</p>}

    <div class="space-y-3">
      {googleUrl ? (
        <a
          href={googleUrl}
          class="flex items-center justify-center gap-3 w-full rounded-lg border border-stone-300 px-4 py-3 font-medium hover:bg-stone-50 transition"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
            <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z" />
            <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z" />
            <path fill="#FBBC05" d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29A11.96 11.96 0 0 0 0 12c0 1.94.46 3.77 1.29 5.38l3.98-3.09z" />
            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75z" />
          </svg>
          Continue with Google
        </a>
      ) : (
        <p class="text-xs text-stone-400 border border-dashed border-stone-300 rounded-lg px-4 py-3">{googleError}</p>
      )}

      {appleUrl ? (
        <a
          href={appleUrl}
          class="flex items-center justify-center gap-3 w-full rounded-lg bg-black text-white px-4 py-3 font-medium hover:bg-stone-800 transition"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M16.365 1.43c0 1.14-.43 2.207-1.16 3.002-.831.905-2.195 1.606-3.34 1.51-.15-1.09.42-2.26 1.16-3.02.84-.87 2.29-1.51 3.34-1.49zM20.94 17.1c-.52 1.2-.77 1.74-1.44 2.79-.94 1.47-2.27 3.31-3.91 3.32-1.46.02-1.84-.95-3.83-.94-1.99.01-2.4.96-3.86.94-1.64-.02-2.9-1.67-3.84-3.14C1.9 16.1.9 12.47 2.4 9.99c1.05-1.75 2.86-2.85 4.61-2.87 1.5-.02 2.9.99 3.83.99.92 0 2.63-1.23 4.44-1.05.76.03 2.9.31 4.27 2.32-.11.07-2.55 1.49-2.52 4.44.03 3.54 3.1 4.71 3.13 4.72-.03.08-.5 1.7-1.66 3.38z" />
          </svg>
          Continue with Apple
        </a>
      ) : (
        <p class="text-xs text-stone-400 border border-dashed border-stone-300 rounded-lg px-4 py-3">{appleError}</p>
      )}
    </div>
  </section>
</BaseLayout>
