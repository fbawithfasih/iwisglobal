---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import GrievanceOfficer from '../components/GrievanceOfficer.astro';
import { pageI18n } from '../i18n/dictionaries';

// Required page for Razorpay card-network activation. Same contact details
// as /about (registered address, GSTIN, email, phone) — keep them in sync.
export const prerender = false;

const waHref = `https://wa.me/916399226633?text=${encodeURIComponent('Hi! I have a question. (ref: CONTACT)')}`;
const { t } = pageI18n(Astro);
---


<BaseLayout floatingWhatsApp={false}
  title={t.contactPage.k30}
  description={t.contactPage.k31}
>
  <!-- [&_h2] styles every section heading, including the shared GrievanceOfficer block. -->
  <section class="max-w-2xl mx-auto px-6 pt-8 pb-16 md:pt-16 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:border-l-4 [&_h2]:border-brand-500 [&_h2]:pl-3 [&_h2]:font-serif [&_h2]:text-xl [&_h2]:text-brand-900 [&_li]:marker:text-brand-500 [&_p]:leading-relaxed">
    <div class="mb-8 rounded-2xl bg-gradient-to-br from-brand-900 via-brand-700 to-brand-600 p-6 text-white shadow-lg shadow-brand-900/20 sm:p-8">
      <span class="inline-block rounded-full bg-white/15 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-100" set:html={t.contactPage.k29} />
      <h1 class="mt-3 text-3xl md:text-4xl font-serif font-semibold mb-3" set:html={t.contactPage.k1} />
      <p class="text-white/90" set:html={t.contactPage.k2} />
    </div>
    <p class="text-stone-700 mb-8" set:html={t.contactPage.k3} />

    <!-- Separate Call and WhatsApp cards: one card used to say "WhatsApp /
         Phone" but only ever opened WhatsApp, never the dialer. -->
    <!-- WhatsApp full width, then Call + Email side by side: three columns
         squeezed info@iwisglobal.com out of its card (sideways scroll on tablets). -->
    <div class="grid sm:grid-cols-2 gap-4 mb-10">
      <a href={waHref} target="_blank" rel="noopener noreferrer" data-wa-ref="CONTACT" class="sm:col-span-2 block rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50 to-white p-5 shadow-sm shadow-brand-900/5 hover:border-brand-300 hover:shadow-md transition">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-600" set:html={t.contactPage.k4} />
        <p class="text-lg font-semibold text-brand-800" set:html={t.contactPage.k5} />
        <p class="text-sm text-stone-600 mt-1" set:html={t.contactPage.k6} />
      </a>
      <a href="tel:+916399226633" class="block rounded-2xl border border-brand-100 bg-white p-5 shadow-sm shadow-brand-900/5 hover:border-brand-300 hover:shadow-md transition">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-600" set:html={t.contactPage.k7} />
        <p class="text-lg font-semibold text-brand-800">+91 6399226633</p>
        <p class="text-sm text-stone-600 mt-1" set:html={t.contactPage.k8} />
      </a>
      <a href="mailto:info@iwisglobal.com" class="block rounded-2xl border border-brand-100 bg-white p-5 shadow-sm shadow-brand-900/5 hover:border-brand-300 hover:shadow-md transition">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-600" set:html={t.contactPage.k9} />
        <p class="text-lg font-semibold text-brand-800" set:html={t.contactPage.k10} />
        <p class="text-sm text-stone-600 mt-1" set:html={t.contactPage.k11} />
      </a>
    </div>

    <h2 class="text-lg font-semibold mb-2" set:html={t.contactPage.k12} />
    <p class="text-stone-700 mb-2" set:html={t.contactPage.k13} />
    <ul class="list-disc pl-5 text-stone-700 space-y-1 mb-4">
      <li set:html={t.contactPage.k14} />
      <li set:html={t.contactPage.k15} />
    </ul>
    <p class="text-stone-700 mb-8" set:html={t.contactPage.k16} />
    <p class="text-stone-700 mb-8" set:html={t.contactPage.k17} />

    <p class="text-stone-700 mb-8" set:html={t.contactPage.k18} />

    <h2 class="text-lg font-semibold mb-1" set:html={t.contactPage.k19} />
    <SocialLinks showNames class="mb-8" />

    <h2 class="text-lg font-semibold mb-2" set:html={t.contactPage.k20} />
    <p class="mb-6 rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50/70 to-white p-5 text-stone-700" set:html={t.contactPage.k21} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.contactPage.k22} />
    <p class="text-stone-700 mb-6" set:html={t.contactPage.k23} />

    <GrievanceOfficer />

    <h2 class="text-lg font-semibold mb-2" set:html={t.contactPage.k24} />
    <ul class="list-disc pl-5 text-stone-700">
      <li set:html={t.contactPage.k25} />
      <li set:html={t.contactPage.k26} />
      <li set:html={t.contactPage.k27} />
      <li set:html={t.contactPage.k28} />
    </ul>
  </section>
</BaseLayout>
