---
// Approved guest reviews (src/lib/reviews.ts), written through the private
// link in the "How was your tour?" email, so each comes from a real booking.
// No AggregateRating schema: CLAUDE.md hard rule 2, and Google doesn't show
// review stars for a business's reviews of itself anyway.
//
// noindex while there are no approved reviews: as a search entry point,
// "no reviews yet" doesn't help anyone deciding whether to book. The sitemap
// lists it once there's an approved review (astro.config.mjs).
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ReviewList from '../components/ReviewList.astro';
import { resolveEnv } from '../lib/env';
import { listApprovedReviews, averageRating, GOOGLE_REVIEW_URL } from '../lib/reviews';
import { listTours } from '../lib/tours';
import { pageI18n } from '../i18n/dictionaries';
import { fmt } from '../i18n/fmt';

const db = resolveEnv(Astro.locals).DB;
const reviews = db ? await listApprovedReviews(db) : [];
const avg = averageRating(reviews);
const tourNames = new Map((db && reviews.length ? await listTours(db) : []).map((t) => [t.id, t.title]));
const { t } = pageI18n(Astro);
---


<BaseLayout floatingWhatsApp={false}
  title={t.reviewsPage.k10}
  description={reviews.length
    ? fmt(t.reviewsExtra.metaDesc, { avg: avg!.toFixed(1), count: reviews.length })
    : t.reviewsExtra.metaNone}
  noindex={reviews.length === 0}
>
  <section class="max-w-2xl mx-auto px-6 pt-8 pb-16 md:pt-16">
    <div class="mb-8 rounded-2xl bg-gradient-to-br from-brand-900 via-brand-700 to-brand-600 p-6 text-center text-white shadow-lg shadow-brand-900/20 sm:p-8">
      <span class="inline-block rounded-full bg-white/15 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-100" set:html={t.reviewsPage.k6} />
      <h1 class="mt-3 text-3xl md:text-4xl font-serif font-semibold" set:html={t.reviewsPage.k1} />
      {reviews.length > 0 && (
        <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 text-brand-900 shadow-md"><span class="text-amber-500" aria-hidden="true">★</span><span class="font-semibold">{avg!.toFixed(1)}</span><span class="text-sm text-stone-600">{fmt(t.reviewsExtra.outOf, { count: reviews.length })}</span></p>
      )}
    </div>
    {reviews.length > 0 ? (
      <>
        <p class="text-stone-600 mb-8" set:html={t.reviewsPage.k2} />
        <div class="mb-10"><ReviewList reviews={reviews} tourNames={tourNames} /></div>
        <p class="text-stone-600 mb-6" set:html={t.reviewsPage.k3} />
      </>
    ) : (
      <>
        <p class="text-stone-600 mb-8" set:html={t.reviewsPage.k4} />
        <p class="text-stone-600 mb-10" set:html={t.reviewsPage.k5} />
      </>
    )}
    <div class="text-center">
      <Button href={GOOGLE_REVIEW_URL} target="_blank" rel="noopener noreferrer">
        {t.reviewsExtra.google}
      </Button>
    </div>

    <div class="mt-14 rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50 to-white p-6 text-center shadow-sm shadow-brand-900/5">
      <p class="text-stone-600 mb-4">{reviews.length > 0 ? t.reviewsExtra.how : t.reviewsExtra.howNone}</p>
      <div class="flex flex-col sm:flex-row sm:justify-center gap-3">
        <a href="/no-commission-pledge" class="inline-flex min-h-11 items-center justify-center rounded-full border border-brand-200 bg-white px-5 font-medium text-brand-800 hover:bg-brand-50 transition" set:html={t.reviewsPage.k7} />
        <a href="/about" class="inline-flex min-h-11 items-center justify-center rounded-full border border-brand-200 bg-white px-5 font-medium text-brand-800 hover:bg-brand-50 transition" set:html={t.reviewsPage.k8} />
        <a href="/tours" class="inline-flex min-h-11 items-center justify-center rounded-full bg-gradient-to-r from-brand-900 via-brand-700 to-brand-600 px-5 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:brightness-110" set:html={t.reviewsPage.k9} />
      </div>
    </div>
  </section>
</BaseLayout>
