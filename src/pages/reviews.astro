---
// Backlog 1.7. No AggregateRating schema — CLAUDE.md hard rule 2 (never
// publish fake/aggregate ratings) and this repo's own history (the "no
// fabricated ratings/reviews, ever" decision recorded in
// SESSION_HANDOFF.md). This page stays an honest empty state until real
// reviews exist on Google to actually link to or quote.
//
// noindex (and left out of the sitemap and llms.txt) until then: as a search
// entry point, "no reviews yet" doesn't help anyone deciding whether to book.
// Remove the noindex, the sitemap filter entry in astro.config.mjs, and
// re-add the llms.txt lines once real reviews are shown here.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Reviews — IWIS Global"
  description="We're a new operator and don't have reviews to show yet — here's where they'll go as real guests leave them."
  noindex
>
  <section class="max-w-2xl mx-auto px-6 py-16 text-center">
    <h1 class="text-3xl font-serif font-semibold mb-4">Reviews</h1>
    <p class="text-stone-600 mb-8">
      We're a newly-launched operator, so we don't have reviews to show here yet — and we're not going to make any
      up. As real guests leave reviews on Google, we'll link to them here.
    </p>
    <p class="text-stone-600 mb-10">
      Traveled with us already? We'd genuinely appreciate a review — it's one of the main ways new travelers decide
      whether to trust a small operator they haven't heard of before.
    </p>
    <Button href="https://share.google/LOqFXgGLF8KWXdMNn" target="_blank" rel="noopener noreferrer">
      Leave us a review on Google
    </Button>

    <div class="mt-14 border-t border-stone-200 pt-8">
      <p class="text-stone-600 mb-4">In the meantime, here's how we work:</p>
      <div class="flex flex-col sm:flex-row sm:justify-center gap-3">
        <a href="/no-commission-pledge" class="inline-flex min-h-11 items-center justify-center rounded-full border border-stone-300 bg-white px-5 font-medium text-brand-800 hover:border-brand-300 transition">No-commission pledge</a>
        <a href="/about" class="inline-flex min-h-11 items-center justify-center rounded-full border border-stone-300 bg-white px-5 font-medium text-brand-800 hover:border-brand-300 transition">About us</a>
        <a href="/tours" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-5 font-semibold text-white hover:bg-brand-800 transition">View tours</a>
      </div>
    </div>
  </section>
</BaseLayout>
