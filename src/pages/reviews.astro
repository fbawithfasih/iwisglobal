---
// Approved guest reviews (src/lib/reviews.ts), written through the private
// link in the "How was your tour?" email, so each comes from a real booking.
// No AggregateRating schema: CLAUDE.md hard rule 2, and Google doesn't show
// review stars for a business's reviews of itself anyway.
//
// noindex while there are no approved reviews: as a search entry point,
// "no reviews yet" doesn't help anyone deciding whether to book. (Left out
// of the sitemap either way, since it changes as reviews are approved.)
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ReviewList from '../components/ReviewList.astro';
import { resolveEnv } from '../lib/env';
import { listApprovedReviews, averageRating, GOOGLE_REVIEW_URL } from '../lib/reviews';
import { listTours } from '../lib/tours';

const db = resolveEnv(Astro.locals).DB;
const reviews = db ? await listApprovedReviews(db) : [];
const avg = averageRating(reviews);
const tourNames = new Map((db && reviews.length ? await listTours(db) : []).map((t) => [t.id, t.title]));
---

<BaseLayout floatingWhatsApp={false}
  title="Reviews — IWIS Global"
  description={reviews.length
    ? `Reviews from guests who booked a Taj Mahal or Agra tour with IWIS Global: ${avg!.toFixed(1)} out of 5 from ${reviews.length} review${reviews.length > 1 ? 's' : ''}.`
    : "We're a new operator and don't have reviews to show yet — here's where they'll go as real guests leave them."}
  noindex={reviews.length === 0}
>
  <section class="max-w-2xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-serif font-semibold mb-4 text-center">Reviews</h1>
    {reviews.length > 0 ? (
      <>
        <p class="text-stone-600 mb-8">
          <span class="text-amber-500" aria-hidden="true">★</span> {avg!.toFixed(1)} out of 5 from {reviews.length} review{reviews.length > 1 ? 's' : ''}.
          Every review here was written by a guest who booked and took the tour with us, through a private link we
          send after the trip. We publish every genuine review, good or bad.
        </p>
        <div class="mb-10"><ReviewList reviews={reviews} tourNames={tourNames} /></div>
        <p class="text-stone-600 mb-6">Traveled with us? You can also review us on Google.</p>
      </>
    ) : (
      <>
        <p class="text-stone-600 mb-8">
          We're a newly-launched operator, so we don't have reviews to show here yet — and we're not going to make any
          up. After each tour we ask our guests to rate it, and their reviews will appear here.
        </p>
        <p class="text-stone-600 mb-10">
          Traveled with us already? We'd genuinely appreciate a review — it's one of the main ways new travelers decide
          whether to trust a small operator they haven't heard of before.
        </p>
      </>
    )}
    <div class="text-center">
      <Button href={GOOGLE_REVIEW_URL} target="_blank" rel="noopener noreferrer">
        Leave us a review on Google
      </Button>
    </div>

    <div class="mt-14 border-t border-stone-200 pt-8 text-center">
      <p class="text-stone-600 mb-4">{reviews.length > 0 ? "Here's how we work:" : "In the meantime, here's how we work:"}</p>
      <div class="flex flex-col sm:flex-row sm:justify-center gap-3">
        <a href="/no-commission-pledge" class="inline-flex min-h-11 items-center justify-center rounded-full border border-stone-300 bg-white px-5 font-medium text-brand-800 hover:border-brand-300 transition">No-commission pledge</a>
        <a href="/about" class="inline-flex min-h-11 items-center justify-center rounded-full border border-stone-300 bg-white px-5 font-medium text-brand-800 hover:border-brand-300 transition">About us</a>
        <a href="/tours" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-5 font-semibold text-white hover:bg-brand-800 transition">View tours</a>
      </div>
    </div>
  </section>
</BaseLayout>
