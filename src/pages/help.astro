---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import { resolveEnv } from '../lib/env';
import { countBookings } from '../lib/db';
import { FOUNDING_GUEST_SLOT_CAP, FOUNDING_GUEST_DISCOUNT_RATE } from '../lib/catalog';
import { pageI18n, fmt } from '../i18n/dictionaries';

// Was prerender = true (static) — flipped to per-request now that
// BaseLayout's nav reflects live sign-in state via Astro.cookies, which
// only resolves per-request, not at build time.
export const prerender = false;

interface FaqItem {
  id: string;
  question: string;
  answer: string;
  // Phrases in the answer to show as links on the page (the FAQ schema
  // keeps the plain text).
  links?: { text: string; href: string }[];
}

interface FaqCategory {
  title: string;
  items: FaqItem[];
}

const { t } = pageI18n(Astro);
const h = t.help;

// The Founding Guest offer is mentioned only while spots remain.
const db = resolveEnv(Astro.locals).DB;
const foundingGuestOpen = db ? (await countBookings(db)) < FOUNDING_GUEST_SLOT_CAP : false;
const foundingGuestLine = foundingGuestOpen
  ? fmt(h.foundingLine, { cap: FOUNDING_GUEST_SLOT_CAP, percent: Math.round(FOUNDING_GUEST_DISCOUNT_RATE * 100) })
  : '';

// The FAQ lives in the dictionaries (src/i18n/*.ts) so every language has it.
const categories: FaqCategory[] = h.categories.map((cat) => ({
  title: cat.title,
  items: cat.items.map((item) => ({
    id: item.id,
    question: item.question,
    answer: item.answer.replace('{founding}', foundingGuestLine),
    links: item.links.length ? item.links : undefined,
  })),
}));

const allFaqs = categories.flatMap((c) => c.items);

const escapeHtml = (t: string) =>
  t.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;');
// Answer as HTML with its `links` phrases turned into links.
const answerHtml = (faq: FaqItem) =>
  (faq.links ?? []).reduce(
    (html, l) =>
      html.replace(escapeHtml(l.text), `<a href="${l.href}" class="text-brand-800 underline">${escapeHtml(l.text)}</a>`),
    escapeHtml(faq.answer)
  );
const searchText = (cat: string, faq: FaqItem) => `${cat} ${faq.question} ${faq.answer}`.toLowerCase();
const faqRows = categories.flatMap((c) => c.items.map((faq) => ({ faq, search: searchText(c.title, faq) })));

// Backlog 2.1 — built straight from the FAQ content above, so schema and
// the visible page can never drift out of sync.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---


<BaseLayout title={t.helpPage.k1} description={t.helpPage.k2}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <section class="max-w-4xl mx-auto px-6 py-12">
    <div class="rounded-2xl overflow-hidden bg-gradient-to-br from-brand-900 via-brand-700 to-brand-600 text-white p-8 shadow-lg shadow-brand-900/20 flex items-center justify-between gap-6 flex-wrap">
      <div>
        <p class="text-xl font-serif font-semibold mb-1">{h.heroTitle}</p>
        <p class="text-white/80 text-sm max-w-md">{h.heroBody}</p>
        <Button
          href={`https://wa.me/916399226633?text=${encodeURIComponent('Hi! I have a question about an existing booking. (ref: HELP-HERO)')}`}
          target="_blank"
          rel="noopener noreferrer"
          data-wa-ref="HELP-HERO"
          variant="ghost"
          class="mt-4"
        >
          {h.waUs}
        </Button>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" class="hidden sm:block h-20 w-20 text-white/25 shrink-0" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8M8 14h5m-9 6 2.5-2.5H18a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 .5 1.3" />
      </svg>
    </div>

    <span class="mt-12 inline-block rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-800">{h.badge}</span>
    <h1 class="text-3xl md:text-4xl font-serif font-semibold mt-3 mb-6">{h.h1}</h1>

    <div class="relative mb-10">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="absolute left-4 top-1/2 -translate-y-1/2 h-4 w-4 text-brand-500" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        id="faq-search"
        type="search"
        placeholder={h.searchPlaceholder}
        class="w-full rounded-full border border-brand-200 bg-white pl-11 pr-4 py-3 text-base shadow-sm shadow-brand-900/5 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-400"
      />
    </div>

    <!-- Category overview: tablets/desktop only. On phones it just repeated
         every question above the same questions below; search filters those. -->
    <div id="faq-grid" class="hidden sm:grid sm:grid-cols-2 md:grid-cols-3 gap-4 mb-16">
      {categories.map((cat) => (
        <div class="faq-category rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50/70 to-white p-5">
          <h2 class="mb-3 font-serif text-lg font-semibold text-brand-900">{cat.title}</h2>
          <ul class="space-y-2">
            {cat.items.map((item) => (
              <li data-search={searchText(cat.title, item)}>
                <a href={`#${item.id}`} class="faq-link text-sm text-stone-700 hover:text-brand-800 hover:underline">
                  {item.question}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p id="faq-no-results" class="hidden text-sm text-stone-500 -mt-12 mb-16">{h.noResults}</p>

    <!-- Phones get the same two buttons in the bottom bar instead. -->
    <div class="hidden sm:flex items-center gap-4 flex-wrap mb-16 rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50 to-white px-6 py-5 shadow-sm shadow-brand-900/5">
      <h2 class="text-xl font-serif font-semibold shrink-0">{h.stillNeed}</h2>
      <Button
        href={`https://wa.me/916399226633?text=${encodeURIComponent('Hi! I have a question. (ref: HELP-STILLNEEDHELP)')}`}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-ref="HELP-STILLNEEDHELP"
        variant="secondary"
      >
        {h.waUs}
      </Button>
      <Button href="mailto:info@iwisglobal.com" variant="secondary">
        {h.emailUs}
      </Button>
    </div>

    <div id="faq-list" class="space-y-3">
      {faqRows.map(({ faq, search }) => (
        <details id={faq.id} data-search={search} class="group rounded-2xl border border-brand-100 bg-white open:border-brand-300 open:bg-gradient-to-br open:from-brand-50/60 open:to-white open:shadow-sm open:shadow-brand-900/5 scroll-mt-24">
          <summary class="flex items-center justify-between gap-4 px-5 py-4 font-medium text-stone-900 cursor-pointer list-none group-open:text-brand-900">
            {faq.question}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5 shrink-0 text-brand-500 transition-transform group-open:rotate-180"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <p class="px-5 pb-5 text-stone-700 text-sm leading-relaxed" set:html={answerHtml(faq)} />
        </details>
      ))}
    </div>
  </section>

  <!-- Phones: WhatsApp moves into this bar so the floating button doesn't
       sit on the questions. Email rather than tours: this page's visitors
       have mostly booked already. -->
  <MobileActionBar waRef="HELPBAR-HELP" waMessage="Hi! I have a question.">
    <Fragment slot="info">
      <p class="text-[11px] font-medium uppercase tracking-wide text-stone-500">{h.barQuestion}</p>
      <p class="text-sm font-semibold leading-tight text-stone-900">{h.barAnswer}</p>
    </Fragment>
    <a slot="action" href="mailto:info@iwisglobal.com" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-5 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:bg-brand-800 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300">{h.emailUs}</a>
  </MobileActionBar>
</BaseLayout>

<script>
  // Category-grid links jump to and auto-expand the matching <details> below.
  document.querySelectorAll<HTMLAnchorElement>('.faq-link').forEach((link) => {
    link.addEventListener('click', () => {
      const target = document.querySelector(link.getAttribute('href') || '');
      if (target instanceof HTMLDetailsElement) target.open = true;
    });
  });

  // Live filter: hides non-matching links within each category, and hides a
  // category entirely if none of its links match.
  const search = document.getElementById('faq-search') as HTMLInputElement | null;
  const grid = document.getElementById('faq-grid');
  const list = document.getElementById('faq-list');
  const noResults = document.getElementById('faq-no-results');
  search?.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    let anyVisible = false;
    // The questions themselves (the only list phones see).
    list?.querySelectorAll<HTMLElement>('details').forEach((d) => {
      d.classList.toggle('hidden', !!q && !(d.dataset.search || '').includes(q));
    });
    grid?.querySelectorAll<HTMLElement>('.faq-category').forEach((cat) => {
      let categoryHasMatch = false;
      cat.querySelectorAll<HTMLElement>('li').forEach((li) => {
        // Match the answer and category too, not just the question wording
        // ("refund" should find the cancellation question).
        const matches = !q || (li.dataset.search || li.textContent || '').toLowerCase().includes(q);
        li.classList.toggle('hidden', !matches);
        if (matches) categoryHasMatch = true;
      });
      cat.classList.toggle('hidden', !categoryHasMatch);
      if (categoryHasMatch) anyVisible = true;
    });
    noResults?.classList.toggle('hidden', anyVisible);
  });
</script>
