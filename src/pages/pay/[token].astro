---
// A guest's private link to pay the balance of a tour booking (src/lib/balancePayment.ts).
// The token is the only way in, so the page is never indexed or cached. It shows
// the tour, the date and the amount; the amount comes from the stored link, and
// the order is opened server-side (/api/balance/order).
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveEnv } from '../../lib/env';
import { getBalanceLink, balanceOwed } from '../../lib/balancePayment';
import { getBookingById } from '../../lib/crm';
import { getTourById, localizeTour } from '../../lib/tours';
import { formatMoneyMinor, formatTravelDate } from '../../lib/format';
import { LOCALES, emailLocale, intlLocale, type Locale } from '../../lib/i18n';
import { fmt, getDictionary } from '../../i18n/dictionaries';

const env = resolveEnv(Astro.locals);
const db = env.DB;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const token = String(Astro.params.token ?? '');
const link = db ? await getBalanceLink(db, token) : null;
if (!db || !link || link.status === 'void') {
  return new Response('Not found', { status: 404, headers: { 'Cache-Control': 'no-store' } });
}
const booking = await getBookingById(db, link.booking_id);
if (!booking) return new Response('Not found', { status: 404, headers: { 'Cache-Control': 'no-store' } });
// ?lang= (the link carries it) wins, else the language the guest booked in.
const asked = Astro.url.searchParams.get('lang') ?? '';
const locale: Locale = LOCALES.some((l) => l.code === asked) ? (asked as Locale) : emailLocale(booking.locale);
const t = getDictionary(locale).balance;
const found = await getTourById(db, booking.tour_id);
const tour = found ? await localizeTour(db, found, locale) : null;

const paid = link.status === 'paid';
// The booking no longer owes what the link says (it was edited or settled another way).
const stale = !paid && (balanceOwed(booking) !== link.amount_minor || booking.currency !== link.currency || !['confirmed', 'completed'].includes(booking.status));
const amount = formatMoneyMinor(link.amount_minor, link.currency);
const firstName = booking.traveler_name.trim().split(/\s+/)[0] || getDictionary(locale).emails.there;
---
<BaseLayout title={t.metaTitle} description={t.metaDescription} noindex noTracking floatingWhatsApp={false}>
  <div class="mx-auto max-w-xl px-4 py-10 min-[300px]:px-5 md:py-14">
    <img src="/logo.png" alt="IWIS Global" width="64" height="64" class="h-14 w-auto" />
    <h1 class="mt-4 font-serif text-2xl font-semibold text-brand-900 md:text-3xl">{t.title}</h1>
    <p class="mt-1 text-stone-700">{fmt(t.hello, { name: firstName })}</p>

    <section class="mt-6 rounded-3xl border border-brand-100 bg-white p-5 shadow-sm shadow-brand-900/5">
      <h2 class="font-semibold text-stone-900 [overflow-wrap:anywhere]">{tour?.title ?? t.yourTour}</h2>
      <p class="mt-1 text-sm text-stone-700">{formatTravelDate(booking.travel_date, intlLocale(locale))} &middot; {fmt(booking.travelers === 1 ? t.travellerOne : t.travellerMany, { n: booking.travelers })}</p>
      <dl class="mt-4 space-y-1 text-sm">
        <div class="flex justify-between"><dt class="text-stone-600">{t.total}</dt><dd>{typeof booking.total_amount === 'number' ? formatMoneyMinor(booking.total_amount, booking.currency) : ''}</dd></div>
        <div class="flex justify-between"><dt class="text-stone-600">{t.paidSoFar}</dt><dd>{formatMoneyMinor(paid ? booking.amount_paid - link.amount_minor : booking.amount_paid, booking.currency)}</dd></div>
        <div class="flex justify-between border-t border-stone-100 pt-2 text-base font-semibold text-stone-900"><dt>{t.balance}</dt><dd>{amount}</dd></div>
      </dl>
    </section>

    {paid && (
      <div role="status" class="mt-6 rounded-3xl border border-emerald-200 bg-emerald-50 p-5 text-emerald-900">
        <p class="font-semibold">{t.paidTitle}</p>
        <p class="mt-1 text-sm">{t.paidBody}</p>
      </div>
    )}

    {stale && (
      <div role="status" class="mt-6 rounded-3xl border border-amber-200 bg-amber-50 p-5 text-amber-900">
        <p class="font-semibold">{t.staleTitle}</p>
        <p class="mt-1 text-sm">{t.staleBody}</p>
      </div>
    )}

    {!paid && !stale && (
      <div class="mt-6">
        <button id="pay-btn" type="button" data-token={token} class="min-h-12 w-full rounded-full bg-brand-700 px-6 py-3 font-semibold text-white hover:bg-brand-800 disabled:opacity-60">{fmt(t.pay, { amount })}</button>
        <p id="pay-msg" role="alert" class="mt-3 hidden rounded-xl bg-red-50 px-3 py-2 text-sm text-red-800"></p>
        <p class="mt-3 text-xs text-stone-600">{t.secureBefore}<a href="/cancellation-refund-policy" class="font-semibold text-brand-700 underline">{t.policyLink}</a>{t.secureAfter}</p>
      </div>
    )}

    <p class="mt-8 text-sm text-stone-600">{t.questions} <a href="mailto:info@iwisglobal.com" class="font-semibold text-brand-700 underline">info@iwisglobal.com</a>.</p>
  </div>

  <script define:vars={{ guestName: booking.traveler_name, email: booking.traveler_email, phone: booking.traveler_phone, title: tour?.title ?? t.yourTour, msg: { confirming: t.confirming, confirmFail: t.confirmFail, failed: t.failed, noStart: t.noStart, alreadyPaid: t.alreadyPaid, changed: t.changed } }}>
    const btn = document.getElementById('pay-btn');
    const msg = document.getElementById('pay-msg');
    const say = (text) => { if (!msg) return; msg.textContent = text; msg.classList.toggle('hidden', !text); };
    const loadScript = () => new Promise((resolve) => {
      if (window.Razorpay) return resolve(true);
      const s = document.createElement('script');
      s.src = 'https://checkout.razorpay.com/v1/checkout.js';
      s.onload = () => resolve(true);
      s.onerror = () => resolve(false);
      document.body.appendChild(s);
    });
    const post = (url, body) => fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });

    btn?.addEventListener('click', async () => {
      say('');
      btn.disabled = true;
      let confirming = false;
      try {
        if (!(await loadScript())) throw new Error('gateway');
        const res = await post('/api/balance/order', { token: btn.dataset.token });
        const order = await res.json().catch(() => ({}));
        if (!res.ok || !order.orderId || !order.publicKey) {
          if (res.status === 409) throw new Error(order.error === 'already_paid' ? msg.alreadyPaid : msg.changed);
          throw new Error('gateway');
        }
        const rzp = new window.Razorpay({
          key: order.publicKey,
          amount: order.amount,
          currency: order.currency,
          name: 'IWIS Global',
          description: title,
          order_id: order.orderId,
          image: 'https://www.iwisglobal.com/logo-globe.png',
          handler: async (r) => {
            confirming = true;
            say(msg.confirming);
            try {
              const v = await post('/api/balance/verify', { razorpay_order_id: r.razorpay_order_id, razorpay_payment_id: r.razorpay_payment_id, razorpay_signature: r.razorpay_signature });
              const done = await v.json().catch(() => ({}));
              if (!v.ok || !done.success) throw new Error('verify');
              window.location.reload();
            } catch {
              say(msg.confirmFail.replace('{id}', r.razorpay_payment_id));
            }
          },
          modal: { ondismiss: () => { if (!confirming) btn.disabled = false; } },
          prefill: { name: guestName, email, contact: String(phone || '').replace(/[\s().-]/g, '') },
          theme: { color: '#6d28d9' },
        });
        rzp.on('payment.failed', () => { say(msg.failed); btn.disabled = false; });
        rzp.open();
      } catch (err) {
        const m = err && err.message;
        say(!m || m === 'gateway' ? msg.noStart : m);
        btn.disabled = false;
      }
    });
  </script>
</BaseLayout>
