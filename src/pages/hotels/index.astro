---
// "Hotels in Agra" (src/lib/hotelSearchService.ts). Hidden from the public
// until the owner switches hotels on; a signed-in admin can preview it before then.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import HotelSearch from '../../components/HotelSearch';
import { resolveEnv } from '../../lib/env';
import { pageI18n } from '../../i18n/dictionaries';
import { resolveCurrency } from '../../lib/currency';
import { intlLocale } from '../../lib/i18n';
import { isAdminAuthenticated } from '../../lib/requireAdmin';
import { isHotelsEnabled } from '../../lib/hotelData';
import type { D1Like } from '../../lib/db';

const env = resolveEnv(Astro.locals);
const db = env.DB as D1Like | undefined;
const { locale, t: dict } = pageI18n(Astro);
const t = dict.hotelBooking;

const live = db ? (await isHotelsEnabled(db)) : false;
const admin = await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET);
if (!db || (!live && !admin)) {
  return new Response('Not found', { status: 404 });
}

const currency = resolveCurrency(Astro.url.searchParams, Astro.cookies.get('currency')?.value);
---
<BaseLayout title={t.meta.title} description={t.meta.description} noindex={!live} floatingWhatsApp={false}>
  <section class="mx-auto max-w-5xl px-4 py-10 min-[300px]:px-6 md:py-14">
    {!live && (
      <p class="mb-5 rounded-xl bg-amber-50 p-3 text-sm text-amber-900" role="status">{t.previewBanner}</p>
    )}
    <h1 class="font-serif text-3xl font-semibold text-brand-900 md:text-4xl">{t.heading}</h1>
    <p class="mt-3 max-w-3xl text-stone-700">{t.intro}</p>
    <div class="mt-8">
      <HotelSearch client:load t={t} currency={currency} intlLocale={intlLocale(locale)} locale={locale} />
    </div>
  </section>
</BaseLayout>
