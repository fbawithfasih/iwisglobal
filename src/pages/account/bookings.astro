---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveEnv } from '../../lib/env';
import { getSessionCustomerId } from '../../lib/requireCustomer';
import { getCustomerById, listCustomerBookings, type CustomerBookingRow } from '../../lib/customers';
import { getTourById, type ParsedTour } from '../../lib/tours';
import { chosenAddOnNames } from '../../lib/entryTickets';
import { canBeReviewed, ensureReviewToken, reviewedBookingIds, reviewUrl, SITE_URL } from '../../lib/reviews';
import { CURRENCY_SYMBOLS, type Currency } from '../../lib/currency';

const env = resolveEnv(Astro.locals);
const customerId = await getSessionCustomerId(Astro.cookies, env.CUSTOMER_SESSION_SECRET);
if (!customerId) {
  return Astro.redirect('/login?redirect=/account/bookings');
}

const db = env.DB;
const customer = db ? await getCustomerById(db, customerId) : null;
if (!customer) {
  return Astro.redirect('/login?redirect=/account/bookings');
}

const bookings = db ? await listCustomerBookings(db, customerId) : [];
// Set by /reset-password after a new password is saved.
const passwordChanged = Astro.url.searchParams.get('password') === 'changed';
const tours = new Map<string, ParsedTour | null>();
if (db) {
  const tourIds = [...new Set(bookings.map((b) => b.tour_id))];
  const found = await Promise.all(tourIds.map((id) => getTourById(db, id)));
  tourIds.forEach((id, i) => tours.set(id, found[i]));
}

// Today in India (tours run there), as YYYY-MM-DD for comparing travel dates.
const todayIst = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Kolkata' }).format(new Date());
// Upcoming soonest first; past most recent first.
// Cancelled bookings get their own section, whatever the date.
const cancelled = bookings.filter((b) => b.status === 'cancelled').sort((a, b) => b.travel_date.localeCompare(a.travel_date));
const active = bookings.filter((b) => b.status !== 'cancelled');
const upcoming = active
  .filter((b) => b.travel_date >= todayIst && b.status !== 'completed')
  .sort((a, b) => a.travel_date.localeCompare(b.travel_date));
const past = active
  .filter((b) => !upcoming.includes(b))
  .sort((a, b) => b.travel_date.localeCompare(a.travel_date));

const formatDate = (ymd: string) =>
  new Date(`${ymd}T00:00:00Z`).toLocaleDateString('en-GB', {
    weekday: 'short',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
// Amounts are stored in the smallest unit (paise/cents).
const formatMoney = (minor: number, currency: string) => {
  const symbol = CURRENCY_SYMBOLS[currency as Currency] ?? `${currency} `;
  return `${symbol}${(minor / 100).toLocaleString(currency === 'USD' ? 'en-US' : 'en-IN')}`;
};

type StatusStyle = { label: string; cls: string };
const STATUS: Record<string, StatusStyle> = {
  confirmed: { label: 'Confirmed', cls: 'bg-green-100 text-green-800' },
  completed: { label: 'Completed', cls: 'bg-stone-200 text-stone-700' },
  cancelled: { label: 'Cancelled', cls: 'bg-red-100 text-red-800' },
};
const statusOf = (status: string) =>
  STATUS[status] ?? { label: status.charAt(0).toUpperCase() + status.slice(1), cls: 'bg-stone-200 text-stone-700' };

const changeHref = (b: CustomerBookingRow) => {
  const message =
    'Hi! I would like to change or cancel my booking: ' +
    `${tours.get(b.tour_id)?.title ?? b.tour_id} on ${formatDate(b.travel_date)}. ` +
    `Booking ID: ${b.id} (ref: MYBOOKINGS)`;
  return 'https://wa.me/916399226633?text=' + encodeURIComponent(message);
};

// Past trips: a "Rate your tour" link to the booking's private review page.
// The guest is signed in and this is their own booking, so the link (the same
// one the after-tour email carries) can be made here on first view.
const reviewable = db ? bookings.filter((b) => canBeReviewed(b, todayIst)) : [];
const reviewed = db ? await reviewedBookingIds(db, reviewable.map((b) => b.id)) : new Set<string>();
const reviewLinks = new Map<string, string>();
if (db) {
  const tokens = await Promise.all(reviewable.map((b) => ensureReviewToken(db, b)));
  reviewable.forEach((b, i) => reviewLinks.set(b.id, reviewUrl(SITE_URL, tokens[i]).replace(SITE_URL, '')));
}

const withDetails = (list: CustomerBookingRow[]) =>
  list.map((b) => {
    const tour = tours.get(b.tour_id);
    return {
      b,
      title: tour?.title ?? b.tour_id,
      // The card opens the booking itself (what a guest here is after).
      href: b.payment_id ? `/booking/confirmation?payment_id=${encodeURIComponent(b.payment_id)}` : null,
      status: statusOf(b.status),
      addOns: tour ? chosenAddOnNames(tour, b.add_on_ids ?? '') : [],
      reviewHref: reviewLinks.get(b.id) ?? null,
      hasReview: reviewed.has(b.id),
    };
  });
const sections = [
  { title: 'Upcoming', items: withDetails(upcoming), canChange: true },
  { title: 'Past trips', items: withDetails(past), canChange: false },
  { title: 'Cancelled', items: withDetails(cancelled), canChange: false },
].filter((s) => s.items.length > 0);
---

<BaseLayout floatingWhatsApp={false} title="My Bookings — IWIS Global" noindex>
  <section class="max-w-3xl mx-auto px-6 pt-8 pb-28 md:pt-16 md:pb-16">
    <div class="flex items-center justify-between gap-4 mb-2">
      <h1 class="text-3xl font-serif font-semibold">My Bookings</h1>
      <form method="POST" action="/auth/logout">
        <button type="submit" class="inline-flex min-h-11 items-center rounded-full border border-stone-300 px-4 text-sm text-stone-600 hover:border-brand-300 hover:text-brand-800 transition cursor-pointer">Sign out</button>
      </form>
    </div>
    {passwordChanged && (
      <p role="status" class="mb-4 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-800">
        Your password has been changed.
      </p>
    )}
    <p class="text-stone-600 mb-8 break-words">Signed in as {customer.name} ({customer.email})</p>

    {bookings.length === 0 && (
      <div class="rounded-xl border border-stone-200 bg-white p-8 text-center">
        <p class="text-stone-600 mb-4">No bookings on this account yet. Bookings you make while signed in will show up here.</p>
        <a href="/tours" class="inline-flex min-h-11 items-center rounded-full bg-brand-800 hover:bg-brand-900 text-white px-5 text-sm font-medium transition">
          Browse tours
        </a>
      </div>
    )}

    {sections.map((section) => (
        <div class="mb-10">
          <h2 class="text-lg font-semibold mb-3">{section.title}</h2>
          <div class="space-y-3">
            {section.items.map(({ b, title, href, status, addOns, reviewHref, hasReview }) => (
                <div class="rounded-xl border border-stone-200 bg-white p-5">
                  <div class="flex items-start justify-between gap-3">
                    {href ? (
                      <a href={href} class="group min-w-0">
                        <span class="block font-semibold text-stone-900 group-hover:text-brand-800">{title}</span>
                        <span class="text-sm font-medium text-brand-800 group-hover:underline">View booking &rarr;</span>
                      </a>
                    ) : (
                      <p class="font-semibold">{title}</p>
                    )}
                    <span class={`shrink-0 text-xs font-medium px-2.5 py-0.5 rounded-full ${status.cls}`}>{status.label}</span>
                  </div>
                  <p class="text-sm text-stone-600 mt-1">
                    {formatDate(b.travel_date)} · {b.travelers} traveler{b.travelers > 1 ? 's' : ''}
                  </p>
                  {section.canChange && b.pickup_time && (
                    <p class="text-sm text-stone-800 mt-1"><span class="text-stone-500">Pickup:</span> <span class="font-semibold">{b.pickup_time}</span></p>
                  )}
                  {b.status !== 'cancelled' && addOns.length > 0 && (
                    <p class="text-sm text-stone-600 mt-1"><span class="text-stone-500">Add-ons:</span> {addOns.join(', ')}</p>
                  )}
                  {b.status === 'cancelled' ? (
                    <p class="text-sm text-stone-600 mt-2">
                      Any refund goes back to your original payment method —
                      <a href="/cancellation-refund-policy" class="text-brand-800 underline">refund policy</a>.
                    </p>
                  ) : (
                  <p class="text-sm mt-2">
                    <span class="font-semibold">{formatMoney(b.amount_paid, b.currency)}</span>
                    <span class="text-stone-500"> paid</span>
                    {b.payment_type === 'deposit' && (
                      <>
                        <span class="text-stone-500"> of {formatMoney(b.total_amount, b.currency)}</span>
                        <span class="text-amber-700"> · {formatMoney(b.total_amount - b.amount_paid, b.currency)} due on pickup</span>
                      </>
                    )}
                  </p>
                  )}
                  {b.status !== 'cancelled' && b.discount_label && b.discount_amount ? (
                    <p class="text-xs text-emerald-700 mt-0.5">{b.discount_label}: saved {formatMoney(b.discount_amount, b.currency)}</p>
                  ) : null}
                  <p class="text-xs text-stone-500 mt-1 break-all">
                    Booking ID: <span class="font-mono text-stone-700">{b.id}</span>
                  </p>
                  {reviewHref && (
                    <a href={reviewHref} class="mt-3 inline-flex min-h-11 items-center rounded-full bg-brand-700 px-4 text-sm font-semibold text-white hover:bg-brand-800 transition">
                      {hasReview ? 'Edit your review' : 'Rate your tour'}
                    </a>
                  )}
                  {section.canChange && b.status === 'confirmed' && (
                    <a
                      href={changeHref(b)}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-wa-ref="MYBOOKINGS"
                      class="mt-3 inline-flex min-h-11 items-center rounded-full border border-brand-200 bg-brand-50 px-4 text-sm font-medium text-brand-800 hover:border-brand-400 transition"
                    >
                      Change or cancel on WhatsApp
                    </a>
                  )}
                </div>
            ))}
          </div>
        </div>
    ))}
  </section>
</BaseLayout>
