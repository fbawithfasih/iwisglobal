---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveEnv } from '../../lib/env';
import { getSessionCustomerId } from '../../lib/requireCustomer';
import PhoneInput from '../../components/PhoneInput';
import { getCustomerById, listCustomerBookings, normalizeAccountPhone, updateCustomerPhone, type CustomerBookingRow } from '../../lib/customers';
import { getTourById, localizeTours, type ParsedTour } from '../../lib/tours';
import { pageI18n, fmt } from '../../i18n/dictionaries';
import { intlLocale } from '../../lib/i18n';
import { chosenAddOnNames } from '../../lib/entryTickets';
import { canBeReviewed, ensureReviewToken, reviewedBookingIds, reviewUrl, SITE_URL } from '../../lib/reviews';
import { CURRENCY_SYMBOLS, type Currency } from '../../lib/currency';
import { linkGuestBookings, createEmailVerificationLink } from '../../lib/emailVerification';
import { sendEmailVerificationEmail } from '../../lib/email';

const env = resolveEnv(Astro.locals);
const { locale, t } = pageI18n(Astro);
const a = t.account;
const customerId = await getSessionCustomerId(Astro.cookies, env.CUSTOMER_SESSION_SECRET);
// Keeps ?email=confirmed (from the confirmation link) through sign-in.
const signInRedirect = `/login?redirect=${encodeURIComponent(`/account/bookings${Astro.url.search}`)}`;
if (!customerId) {
  return Astro.redirect(signInRedirect);
}

const db = env.DB;
const customer = db ? await getCustomerById(db, customerId) : null;
if (!customer) {
  return Astro.redirect(signInRedirect);
}

// "Email me a confirmation link" for an unconfirmed email/password account.
let resent: 'sent' | 'limit' | null = null;
// Saving the phone number is a separate POST on the same page.
let phoneStatus: 'saved' | 'cleared' | 'invalid' | null = null;
const postForm = Astro.request.method === 'POST' && db ? await Astro.request.formData() : null;
if (postForm && postForm.get('_action') === 'phone') {
  const phone = normalizeAccountPhone(String(postForm.get('phone') ?? ''));
  if (phone === undefined) {
    phoneStatus = 'invalid';
  } else {
    await updateCustomerPhone(db!, customer.id, phone);
    customer.phone = phone;
    phoneStatus = phone ? 'saved' : 'cleared';
  }
} else if (postForm && !customer.email_verified_at) {
  const link = await createEmailVerificationLink(db, customer.id, Astro.url.origin);
  if (link) await sendEmailVerificationEmail(env, { to: customer.email, name: customer.name, link });
  resent = link ? 'sent' : 'limit';
}

// Bookings made without signing in join the account once its email is
// confirmed (src/lib/emailVerification.ts).
if (db) await linkGuestBookings(db, customer);
const emailUnconfirmed = !customer.email_verified_at;
const emailParam = Astro.url.searchParams.get('email');

const bookings = db ? await listCustomerBookings(db, customerId) : [];
// Set by /reset-password after a new password is saved.
const passwordChanged = Astro.url.searchParams.get('password') === 'changed';
// English tours are used for the message we send to the team; localized copies for what's shown.
const tours = new Map<string, ParsedTour | null>();
const toursShown = new Map<string, ParsedTour | null>();
if (db) {
  const tourIds = [...new Set(bookings.map((b) => b.tour_id))];
  const found = await Promise.all(tourIds.map((id) => getTourById(db, id)));
  const present = found.filter((x): x is ParsedTour => !!x);
  const localized = new Map((await localizeTours(db, present, locale)).map((x) => [x.id, x]));
  tourIds.forEach((id, i) => {
    tours.set(id, found[i]);
    toursShown.set(id, localized.get(id) ?? found[i]);
  });
}

// Today in India (tours run there), as YYYY-MM-DD for comparing travel dates.
const todayIst = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Kolkata' }).format(new Date());
// Upcoming soonest first; past most recent first.
// Cancelled bookings get their own section, whatever the date.
const cancelled = bookings.filter((b) => b.status === 'cancelled').sort((a, b) => b.travel_date.localeCompare(a.travel_date));
const active = bookings.filter((b) => b.status !== 'cancelled');
const upcoming = active
  .filter((b) => b.travel_date >= todayIst && b.status !== 'completed')
  .sort((a, b) => a.travel_date.localeCompare(b.travel_date));
const past = active
  .filter((b) => !upcoming.includes(b))
  .sort((a, b) => b.travel_date.localeCompare(a.travel_date));

const formatDate = (ymd: string, tag = 'en-GB') =>
  new Date(`${ymd}T00:00:00Z`).toLocaleDateString(tag, {
    weekday: 'short',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
// Amounts are stored in the smallest unit (paise/cents).
const formatMoney = (minor: number, currency: string) => {
  const symbol = CURRENCY_SYMBOLS[currency as Currency] ?? `${currency} `;
  return `${symbol}${(minor / 100).toLocaleString(currency === 'USD' ? 'en-US' : 'en-IN')}`;
};

type StatusStyle = { label: string; cls: string };
const STATUS: Record<string, StatusStyle> = {
  confirmed: { label: a.confirmed, cls: 'bg-green-100 text-green-800 ring-1 ring-green-200' },
  completed: { label: a.completed, cls: 'bg-stone-200 text-stone-700' },
  cancelled: { label: a.cancelled, cls: 'bg-red-100 text-red-800' },
};
const statusOf = (status: string) =>
  STATUS[status] ?? { label: status.charAt(0).toUpperCase() + status.slice(1), cls: 'bg-stone-200 text-stone-700' };

const changeHref = (b: CustomerBookingRow) => {
  const message =
    'Hi! I would like to change or cancel my booking: ' +
    `${tours.get(b.tour_id)?.title ?? b.tour_id} on ${formatDate(b.travel_date)}. ` +
    `Booking ID: ${b.id} (ref: MYBOOKINGS)`;
  return 'https://wa.me/916399226633?text=' + encodeURIComponent(message);
};

// Past trips: a "Rate your tour" link to the booking's private review page.
// The guest is signed in and this is their own booking, so the link (the same
// one the after-tour email carries) can be made here on first view.
const reviewable = db ? bookings.filter((b) => canBeReviewed(b, todayIst)) : [];
const reviewed = db ? await reviewedBookingIds(db, reviewable.map((b) => b.id)) : new Set<string>();
const reviewLinks = new Map<string, string>();
if (db) {
  const tokens = await Promise.all(reviewable.map((b) => ensureReviewToken(db, b)));
  reviewable.forEach((b, i) => reviewLinks.set(b.id, reviewUrl(SITE_URL, tokens[i]).replace(SITE_URL, '')));
}

const withDetails = (list: CustomerBookingRow[]) =>
  list.map((b) => {
    const tour = toursShown.get(b.tour_id);
    return {
      b,
      title: tour?.title ?? b.tour_id,
      // The card opens the booking itself (what a guest here is after).
      href: b.payment_id ? `/booking/confirmation?payment_id=${encodeURIComponent(b.payment_id)}` : null,
      status: statusOf(b.status),
      addOns: tour ? chosenAddOnNames(tour, b.add_on_ids ?? '') : [],
      reviewHref: reviewLinks.get(b.id) ?? null,
      hasReview: reviewed.has(b.id),
    };
  });
const sections = [
  { title: a.upcoming, items: withDetails(upcoming), canChange: true },
  { title: a.past, items: withDetails(past), canChange: false },
  { title: a.cancelled, items: withDetails(cancelled), canChange: false },
].filter((s) => s.items.length > 0);
---

<BaseLayout floatingWhatsApp={false} title={a.title} noindex>
  <section class="max-w-3xl mx-auto px-6 pt-8 pb-28 md:pt-16 md:pb-16">
    <div class="flex items-center justify-between gap-4 mb-4">
      <div>
        <span class="mb-2 inline-block rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-800">{t.auth.yourAccount}</span>
        <h1 class="text-3xl md:text-4xl font-serif font-semibold">{a.h1}</h1>
      </div>
      <form method="POST" action="/auth/logout">
        <button type="submit" class="inline-flex min-h-11 items-center rounded-full border border-stone-300 px-4 text-sm text-stone-600 hover:border-brand-300 hover:text-brand-800 transition cursor-pointer">{a.signOut}</button>
      </form>
    </div>
    {emailParam === 'confirmed' && !emailUnconfirmed && (
      <p role="status" class="mb-4 flex items-start gap-2 rounded-xl border border-green-200 bg-gradient-to-br from-green-50 to-white px-4 py-3 text-sm font-medium text-green-800 shadow-sm">
        <span aria-hidden="true" class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-green-600 text-xs text-white">&#10003;</span>
        <span>{fmt(a.emailConfirmed, { email: customer.email })}</span>
      </p>
    )}
    {emailParam === 'link-expired' && emailUnconfirmed && (
      <p role="alert" class="mb-4 flex items-start gap-2 rounded-xl border border-amber-200 bg-gradient-to-br from-amber-50 to-white px-4 py-3 text-sm text-amber-900 shadow-sm">
        <span aria-hidden="true" class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-amber-400 text-xs font-bold text-amber-950">!</span>
        <span>{a.linkExpired}</span>
      </p>
    )}
    {emailUnconfirmed && (
      <div class="mb-6 rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50 to-white p-4 shadow-sm shadow-brand-900/5 sm:p-5">
        <p class="text-sm text-stone-700">
          <span class="font-semibold text-stone-900">{a.confirmYour}</span>
          {a.weWillEmail.split('{email}')[0]}<span class="font-medium break-all">{customer.email}</span>{a.weWillEmail.split('{email}')[1]}
        </p>
        {resent === 'sent' && <p role="status" class="mt-2 text-sm font-medium text-green-800">{a.sent}</p>}
        {resent === 'limit' && <p role="alert" class="mt-2 text-sm text-amber-900">{a.limit}</p>}
        {resent !== 'sent' && (
          <form method="POST" class="mt-3">
            <button type="submit" class="inline-flex min-h-11 items-center rounded-full bg-gradient-to-r from-brand-900 via-brand-700 to-brand-600 px-5 text-sm font-semibold text-white shadow-md shadow-brand-900/20 transition hover:brightness-110 cursor-pointer">{a.emailMe}</button>
          </form>
        )}
      </div>
    )}
    {passwordChanged && (
      <p role="status" class="mb-4 flex items-start gap-2 rounded-xl border border-green-200 bg-gradient-to-br from-green-50 to-white px-4 py-3 text-sm font-medium text-green-800 shadow-sm">
        <span aria-hidden="true" class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-green-600 text-xs text-white">&#10003;</span>
        <span>{a.pwChanged}</span>
      </p>
    )}
    <p class="mb-6 flex items-center gap-3 rounded-2xl border border-brand-100 bg-white px-4 py-3 shadow-sm shadow-brand-900/5">
      <span aria-hidden="true" class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-brand-700 to-brand-500 text-base font-semibold text-white">{(customer.name.trim().charAt(0) || customer.email.charAt(0)).toUpperCase()}</span>
      <span class="min-w-0 text-sm text-stone-600"><span class="block font-semibold text-stone-900 break-words">{customer.name}</span><span class="block break-all">{customer.email}</span></span>
    </p>

    <form method="POST" class="mb-8 rounded-xl border border-brand-100 bg-brand-50/60 p-4">
      <input type="hidden" name="_action" value="phone" />
      <label for="accountPhone" class="block text-sm font-semibold text-stone-900 mb-1">{a.phone}</label>
      <p class="text-xs text-stone-500 mb-2">{a.phoneHelp}</p>
      <PhoneInput client:load id="accountPhone" name="phone" defaultValue={customer.phone ?? undefined} invalid={phoneStatus === 'invalid'} />
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <button type="submit" class="inline-flex min-h-11 items-center rounded-full bg-brand-700 px-5 text-sm font-semibold text-white hover:bg-brand-800 transition cursor-pointer">{a.savePhone}</button>
        {phoneStatus === 'saved' && <p role="status" class="text-sm font-medium text-green-800">{a.saved}</p>}
        {phoneStatus === 'cleared' && <p role="status" class="text-sm font-medium text-green-800">{a.removed}</p>}
        {phoneStatus === 'invalid' && <p role="alert" class="text-sm text-red-700">{a.invalid}</p>}
      </div>
    </form>

    {bookings.length === 0 && (
      <div class="rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50 to-white p-8 text-center shadow-sm shadow-brand-900/5">
        <p class="text-stone-600 mb-4">{a.none}</p>
        <a href="/tours" class="inline-flex min-h-11 items-center rounded-full bg-gradient-to-r from-brand-900 via-brand-700 to-brand-600 text-white shadow-md shadow-brand-900/20 transition hover:brightness-110 px-5 text-sm font-semibold">{a.browse}</a>
      </div>
    )}

    {sections.map((section) => (
        <div class="mb-10">
          <h2 class="mb-3 flex items-center gap-2 font-serif text-xl font-semibold">{section.title} <span class="rounded-full bg-brand-100 px-2.5 py-0.5 font-sans text-xs font-semibold text-brand-800">{section.items.length}</span></h2>
          <div class="space-y-3">
            {section.items.map(({ b, title, href, status, addOns, reviewHref, hasReview }) => (
                <div class="rounded-2xl border border-brand-100 bg-white p-5 shadow-sm shadow-brand-900/5 transition hover:shadow-md">
                  <div class="flex items-start justify-between gap-3">
                    {href ? (
                      <a href={href} class="group min-w-0">
                        <span class="block font-semibold text-stone-900 group-hover:text-brand-800">{title}</span>
                        <span class="text-sm font-medium text-brand-800 group-hover:underline">{a.viewBooking}</span>
                      </a>
                    ) : (
                      <p class="font-semibold">{title}</p>
                    )}
                    <span class={`shrink-0 text-xs font-medium px-2.5 py-0.5 rounded-full ${status.cls}`}>{status.label}</span>
                  </div>
                  <p class="text-sm text-stone-600 mt-1">
                    {formatDate(b.travel_date, intlLocale(locale))} · {fmt(b.travelers > 1 ? t.booking.manyTravelers : t.booking.oneTraveler, { n: b.travelers })}
                  </p>
                  {section.canChange && b.pickup_time && (
                    <p class="text-sm text-stone-800 mt-1"><span class="text-stone-500">{a.pickup}</span> <span class="font-semibold">{b.pickup_time}</span></p>
                  )}
                  {b.status !== 'cancelled' && addOns.length > 0 && (
                    <p class="text-sm text-stone-600 mt-1"><span class="text-stone-500">{a.addOns}</span> {addOns.join(', ')}</p>
                  )}
                  {b.status === 'cancelled' ? (
                    <p class="text-sm text-stone-600 mt-2" set:html={a.refundHtml} />
                  ) : (
                  <p class="text-sm mt-2">
                    <span class="font-semibold">{formatMoney(b.amount_paid, b.currency)}</span>
                    <span class="text-stone-500">{a.paid}</span>
                    {b.payment_type === 'deposit' && (
                      <>
                        <span class="text-stone-500">{fmt(a.ofTotal, { amount: formatMoney(b.total_amount, b.currency) })}</span>
                        <span class="ml-1 inline-block rounded-full bg-amber-300 px-2 py-0.5 text-xs font-semibold text-brand-950">{fmt(a.dueOnPickup, { amount: formatMoney(b.total_amount - b.amount_paid, b.currency) })}</span>
                      </>
                    )}
                  </p>
                  )}
                  {b.status !== 'cancelled' && b.discount_label && b.discount_amount ? (
                    <p class="text-xs text-emerald-700 mt-0.5">{fmt(a.savedAmount, { label: /^Founding Guest/i.test(b.discount_label) ? fmt(t.offers.founding, { percent: b.discount_label.match(/(\d+)%/)?.[1] ?? '' }) : b.discount_label, amount: formatMoney(b.discount_amount, b.currency) })}</p>
                  ) : null}
                  <p class="text-xs text-stone-500 mt-1 break-all">
                    {a.bookingId} <span class="font-mono text-stone-700">{b.id}</span>
                  </p>
                  {reviewHref && (
                    <a href={reviewHref} class="mt-3 inline-flex min-h-11 items-center rounded-full bg-gradient-to-r from-brand-900 via-brand-700 to-brand-600 text-white shadow-md shadow-brand-900/20 transition hover:brightness-110 px-4 text-sm font-semibold">
                      {hasReview ? a.editReview : a.rate}
                    </a>
                  )}
                  {section.canChange && b.status === 'confirmed' && (
                    <a
                      href={changeHref(b)}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-wa-ref="MYBOOKINGS"
                      class="mt-3 inline-flex min-h-11 items-center rounded-full border border-brand-200 bg-brand-50 px-4 text-sm font-medium text-brand-800 hover:border-brand-400 transition"
                    >
                      {a.change}
                    </a>
                  )}
                </div>
            ))}
          </div>
        </div>
    ))}
  </section>
</BaseLayout>
