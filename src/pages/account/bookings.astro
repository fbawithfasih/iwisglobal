---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveEnv } from '../../lib/env';
import { getSessionCustomerId } from '../../lib/requireCustomer';
import { getCustomerById, listCustomerBookings } from '../../lib/customers';
import { getTourById } from '../../lib/tours';

const env = resolveEnv(Astro.locals);
const customerId = await getSessionCustomerId(Astro.cookies, env.CUSTOMER_SESSION_SECRET);
if (!customerId) {
  return Astro.redirect('/login?redirect=/account/bookings');
}

const db = env.DB;
const customer = db ? await getCustomerById(db, customerId) : null;
if (!customer) {
  return Astro.redirect('/login?redirect=/account/bookings');
}

const bookings = db ? await listCustomerBookings(db, customerId) : [];
const tourTitles = new Map<string, string>();
if (db) {
  for (const b of bookings) {
    if (!tourTitles.has(b.tour_id)) {
      const tour = await getTourById(db, b.tour_id);
      tourTitles.set(b.tour_id, tour?.title ?? b.tour_id);
    }
  }
}

const statusClass = (status: string) =>
  status === 'confirmed' ? 'bg-blue-100 text-blue-800' : status === 'completed' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800';
---

<BaseLayout title="My Bookings — IWIS Global">
  <section class="max-w-3xl mx-auto px-6 py-16">
    <div class="flex items-center justify-between mb-2">
      <h1 class="text-3xl font-serif font-semibold">My Bookings</h1>
      <form method="POST" action="/auth/logout">
        <button type="submit" class="text-sm text-stone-500 hover:text-brand-800 transition cursor-pointer">Sign out</button>
      </form>
    </div>
    <p class="text-stone-600 mb-8">Signed in as {customer.name} ({customer.email})</p>

    {bookings.length === 0 ? (
      <div class="rounded-xl border border-stone-200 bg-white p-8 text-center">
        <p class="text-stone-600 mb-4">No bookings on this account yet. Bookings you make while signed in will show up here.</p>
        <a href="/tours" class="inline-block rounded-full bg-brand-800 hover:bg-brand-900 text-white px-5 py-2.5 text-sm font-medium transition">
          Browse tours
        </a>
      </div>
    ) : (
      <div class="space-y-3">
        {bookings.map((b) => (
          <div class="rounded-xl border border-stone-200 bg-white p-5 flex items-center justify-between gap-4 flex-wrap">
            <div>
              <p class="font-semibold">{tourTitles.get(b.tour_id)}</p>
              <p class="text-sm text-stone-500">
                {b.travel_date} · {b.travelers} traveler{b.travelers > 1 ? 's' : ''}
              </p>
            </div>
            <div class="text-right">
              <p class="font-semibold">
                {b.currency} {(b.amount_paid / 100).toLocaleString(b.currency === 'USD' ? 'en-US' : 'en-IN')}
              </p>
              <span class={`inline-block text-xs px-2 py-0.5 rounded-full ${statusClass(b.status)}`}>{b.status}</span>
            </div>
          </div>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
