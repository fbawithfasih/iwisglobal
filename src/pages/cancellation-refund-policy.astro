---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalNotice from '../components/LegalNotice.astro';
import { pageI18n } from '../i18n/dictionaries';

// Dynamic for the same reason as terms.astro: BaseLayout's nav/footer read
// per-request session and locale state. Policy terms confirmed by the owner
// on 25 September 2026 (required page for Razorpay card-network activation).
export const prerender = false;

const lastUpdated = '27 September 2026';
const { t } = pageI18n(Astro);
---


<BaseLayout
  title={t.cancelPage.k28}
  description={t.cancelPage.k29}
>
  <!-- Same [&_…] heading and list styling as /terms. -->
  <section class="max-w-2xl mx-auto px-6 py-12 md:py-16 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:border-l-4 [&_h2]:border-brand-500 [&_h2]:pl-3 [&_h2]:font-serif [&_h2]:text-xl [&_h2]:text-brand-900 [&_li]:marker:text-brand-500 [&_p]:leading-relaxed">
    <span class="inline-block rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-800" set:html={t.cancelPage.k24} />
    <h1 class="mt-3 text-3xl md:text-4xl font-serif font-semibold mb-2" set:html={t.cancelPage.k1} />
    <LegalNotice updated={lastUpdated} />

    <p class="mb-2 rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50 to-white p-5 text-stone-700 shadow-sm shadow-brand-900/5" set:html={t.cancelPage.k2} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.cancelPage.k3} />
    <div class="mb-3 overflow-x-auto rounded-2xl border border-brand-100 bg-white shadow-sm shadow-brand-900/5">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-brand-50 text-left text-brand-900">
            <th class="px-4 py-3 font-semibold" set:html={t.cancelPage.k4} />
            <th class="px-4 py-3 font-semibold" set:html={t.cancelPage.k5} />
          </tr>
        </thead>
        <tbody class="text-stone-700">
          <tr class="border-t border-brand-100">
            <td class="px-4 py-3" set:html={t.cancelPage.k6} />
            <td class="px-4 py-3" set:html={t.cancelPage.k7} />
          </tr>
          <tr class="border-t border-brand-100">
            <td class="px-4 py-3" set:html={t.cancelPage.k8} />
            <td class="px-4 py-3" set:html={t.cancelPage.k9} />
          </tr>
          <tr class="border-t border-brand-100">
            <td class="px-4 py-3" set:html={t.cancelPage.k10} />
            <td class="px-4 py-3" set:html={t.cancelPage.k11} />
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-stone-700 mb-6" set:html={t.cancelPage.k12} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.cancelPage.k13} />
    <p class="text-stone-700 mb-6">
      Email <a href="mailto:info@iwisglobal.com" class="text-brand-800 hover:underline" set:html={t.cancelPage.k25} /> or
      message us on
      <a href={`https://wa.me/916399226633?text=${encodeURIComponent("Hi! I'd like to cancel a booking. (ref: REFUND-POLICY)")}`} target="_blank" rel="noopener noreferrer" data-wa-ref="REFUND-POLICY" class="text-brand-800 hover:underline" set:html={t.cancelPage.k26} />
      with your name and the booking ID from your confirmation email (or the payment reference in
      <a href="/account/bookings" class="text-brand-800 hover:underline" set:html={t.cancelPage.k27} />).
    </p>

    <h2 class="text-lg font-semibold mb-2" set:html={t.cancelPage.k14} />
    <p class="text-stone-700 mb-6" set:html={t.cancelPage.k15} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.cancelPage.k16} />
    <p class="text-stone-700 mb-6" set:html={t.cancelPage.k17} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.cancelPage.k18} />
    <ul class="list-disc pl-5 text-stone-700 space-y-1 mb-6">
      <li set:html={t.cancelPage.k19} />
      <li set:html={t.cancelPage.k20} />
      <li set:html={t.cancelPage.k21} />
    </ul>

    <h2 class="text-lg font-semibold mb-2" set:html={t.cancelPage.k22} />
    <p class="rounded-2xl border border-brand-100 bg-brand-50/60 p-5 text-stone-700" set:html={t.cancelPage.k23} />
  </section>
</BaseLayout>
