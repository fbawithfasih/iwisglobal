---
import BaseLayout from '../layouts/BaseLayout.astro';

// Same reasoning as privacy.astro/terms.astro — dynamic because
// BaseLayout's nav/footer depend on live per-request session/locale state.
export const prerender = false;
---

<BaseLayout title="About IWIS Global" description="IWIS Global is a private Taj Mahal & Agra tour operator based in Agra, India — registered address, GST details, and how to reach us.">
  <section class="max-w-2xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-serif font-semibold mb-1">About IWIS Global</h1>
    <p class="text-stone-700 mt-6 mb-6">
      IWIS Global is a private Taj Mahal &amp; Agra tour operator based in Agra, India. We run private,
      guided same-day tours from Delhi to the Taj Mahal and Agra, by car or on the Gatimaan Express
      train — booked and paid for online, with transparent pricing and no hidden commissions. See our
      <a href="/no-commission-pledge" class="text-brand-800 hover:underline">No-Commission Pledge</a> for what
      that means in practice.
    </p>

    <h2 class="text-lg font-semibold mb-2">Registered address</h2>
    <p class="text-stone-700 mb-6">
      A-5, First Floor, ESSAR Mughal Residency, Jyoti Nagar, Shaheed Nagar,<br />
      Agra – 282001, Uttar Pradesh, India
    </p>

    <h2 class="text-lg font-semibold mb-2">GST registration</h2>
    <p class="text-stone-700 mb-2">
      IWIS Global is a partnership firm, registered for GST in Uttar Pradesh since 6 April 2021.
    </p>
    <p class="text-stone-700 mb-6">GSTIN: 09AAIFI6799J1ZH</p>

    <h2 class="text-lg font-semibold mb-3">Contact us</h2>
    <!-- Same cards as /contact: big tap targets instead of inline links. -->
    <!-- WhatsApp full width, then Call + Email side by side: three columns
         squeezed info@iwisglobal.com out of its card (sideways scroll on tablets). -->
    <div class="grid sm:grid-cols-2 gap-4 mb-10">
      <a href={`https://wa.me/916399226633?text=${encodeURIComponent('Hi! (ref: ABOUT)')}`} target="_blank" rel="noopener noreferrer" data-wa-ref="ABOUT" class="sm:col-span-2 block rounded-xl border border-brand-100 bg-brand-50/60 p-5 hover:border-brand-300 transition">
        <p class="text-xs font-medium uppercase tracking-wide text-stone-500">WhatsApp</p>
        <p class="text-lg font-semibold text-brand-800">Chat with us</p>
        <p class="text-sm text-stone-600 mt-1">We usually reply within 15 minutes</p>
      </a>
      <a href="tel:+916399226633" class="block rounded-xl border border-stone-200 bg-white p-5 hover:border-brand-300 transition">
        <p class="text-xs font-medium uppercase tracking-wide text-stone-500">Call</p>
        <p class="text-lg font-semibold text-brand-800">+91 6399226633</p>
        <p class="text-sm text-stone-600 mt-1">Tap to call</p>
      </a>
      <a href="mailto:info@iwisglobal.com" class="block rounded-xl border border-stone-200 bg-white p-5 hover:border-brand-300 transition">
        <p class="text-xs font-medium uppercase tracking-wide text-stone-500">Email</p>
        <p class="text-lg font-semibold text-brand-800">info@iwisglobal.com</p>
        <p class="text-sm text-stone-600 mt-1">Bookings, cancellations, and general questions</p>
      </a>
    </div>

    <div class="rounded-2xl bg-brand-50 border border-brand-100 p-6">
      <h2 class="text-lg font-semibold mb-1">Planning a Taj Mahal trip?</h2>
      <p class="text-stone-700 mb-4">
        See our private same-day tours from Delhi, or start with our
        <a href="/agra" class="text-brand-800 underline">guide to Agra</a> and
        <a href="/guides" class="text-brand-800 underline">travel guides</a>.
      </p>
      <a href="/tours" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-6 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:bg-brand-800 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300">
        View our tours
      </a>
    </div>
  </section>
</BaseLayout>
