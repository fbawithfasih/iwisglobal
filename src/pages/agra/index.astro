---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveEnv } from '../../lib/env';
import { pageI18n } from '../../i18n/dictionaries';
import { listTours, sharedTourFacts } from '../../lib/tours';
import { resolveCurrency, sortByFromPrice } from '../../lib/currency';
import { sortGuides } from '../../lib/guides';
import TourCard from '../../components/TourCard.astro';
import SharedTourFacts from '../../components/SharedTourFacts.astro';
import TajToday from '../../components/TajToday';
import AgraMap from '../../components/AgraMap';
import LightSlider from '../../components/LightSlider';
import FoundingGuestNote from '../../components/FoundingGuestNote.astro';
import MobileActionBar from '../../components/MobileActionBar.astro';

// Agra travel hub. Google crawled the old ~300-word card list and left it
// "Crawled - currently not indexed", so this page now carries real planning
// content. Every fact below comes from the attraction/guide markdown (already
// sourced to ASI) — ticket prices, hours, and Friday status are read from
// attraction frontmatter, never retyped here, so the table can't drift.

// Visit order for a typical trip: the Taj first, the Fort alongside it, the
// two left-bank sites (sunset view, "Baby Taj"), then the out-of-town day trip.
const ORDER = ['taj-mahal', 'agra-fort', 'mehtab-bagh', 'itimad-ud-daulah', 'fatehpur-sikri'];
const attractions = (await getCollection('attractions')).sort(
  (a, b) => ORDER.indexOf(a.slug) - ORDER.indexOf(b.slug)
);
const openOnFriday = attractions.filter((a) => !a.data.closedFriday);
// "A, B, and C" — reads correctly however many sites there are.
const openOnFridayNames = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' }).format(
  openOnFriday.map((a) => a.data.name)
);

const guides = sortGuides(await getCollection('guides'));

const env = resolveEnv(Astro.locals);
const { locale, t } = pageI18n(Astro);
const currency = resolveCurrency(Astro.url.searchParams, Astro.cookies.get('currency')?.value);
if (Astro.url.searchParams.get('currency')) {
  Astro.cookies.set('currency', currency, { path: '/', maxAge: 60 * 60 * 24 * 365 });
}
// Same cards and cheapest-first order as /tours and the homepage.
const tours = sortByFromPrice(env.DB ? await listTours(env.DB, { status: 'published' }) : [], currency);
// Listed once above the tour row; the cards then show only what differs.
const sharedFacts = sharedTourFacts(tours);

const faqs = [
  {
    q: 'What are the main things to do in Agra?',
    a: `Agra's main sites are the Taj Mahal, Agra Fort, Mehtab Bagh, Itimad-ud-Daulah's Tomb (the "Baby Taj"), and Fatehpur Sikri. The Taj Mahal, Agra Fort, and Fatehpur Sikri are all UNESCO World Heritage Sites.`,
  },
  {
    q: 'Is the Taj Mahal open on Fridays?',
    a: `No. The Taj Mahal is closed every Friday. ${openOnFridayNames} stay open on Fridays.`,
  },
  {
    q: 'Can you see the Taj Mahal and Agra Fort on the same day?',
    a: 'Yes. Agra Fort is a short drive from the Taj Mahal within Agra city, and most day-trip itineraries visit both.',
  },
  {
    q: 'How far is Fatehpur Sikri from Agra?',
    a: 'About 37 km, roughly 45 minutes to an hour by road. A proper visit takes 2.5 to 3.5 hours, so it fits a multi-day Agra trip better than a same-day trip from Delhi.',
  },
  {
    q: 'How far is Agra from Delhi?',
    a: 'Roughly 230 km via the Yamuna Expressway, which is why most international visitors see Agra as a same-day trip from Delhi.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Things to Do in Agra: Taj Mahal & Agra Fort"
  description="A visitor's guide to Agra: ticket prices, opening hours, and Friday closures for the Taj Mahal, Agra Fort, Mehtab Bagh, the Baby Taj, and Fatehpur Sikri."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <article class="max-w-3xl mx-auto px-6 py-16">
    <div class="mb-6 rounded-2xl bg-gradient-to-br from-brand-900 via-brand-700 to-brand-600 p-6 text-white shadow-lg shadow-brand-900/20 sm:p-8">
    <span class="inline-block rounded-full bg-white/15 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-100">Visitor's guide</span>
    <h1 class="mt-3 text-3xl md:text-4xl font-serif font-semibold mb-4">Things to do in Agra</h1>
    <p class="text-lg text-white/90">
      Agra is home to three UNESCO World Heritage Sites — the Taj Mahal, Agra Fort, and Fatehpur
      Sikri — plus Mehtab Bagh, the Mughal garden across the river with the classic view of the Taj,
      and Itimad-ud-Daulah's Tomb, the marble "Baby Taj" on the same side of the river as Mehtab Bagh.
    </p>
    </div>
    <p class="text-stone-600 mb-4">
      Below: what each site costs and when it's open, how to fit them into one or two days, and the
      rules worth knowing before you go.
    </p>
    <!-- The page runs to ~10 phone screens, so let readers jump straight to a section. -->
    <nav aria-label="On this page" class="mb-10 flex flex-wrap gap-2 text-sm">
      {[
        ['#at-a-glance', 'At a glance'],
        ['#the-sites', 'The sites'],
        ['#planning', 'Planning'],
        ['#before-you-go', 'Before you go'],
        ['#tours', 'Tours'],
        ['#faq', 'FAQ'],
      ].map(([href, label]) => (
        <a href={href} class="inline-flex min-h-11 items-center rounded-full border border-brand-200 bg-white px-4 font-semibold text-brand-800 shadow-sm shadow-brand-900/5 transition hover:border-brand-400 hover:bg-brand-50">{label}</a>
      ))}
    </nav>

    <div class="mb-8 grid gap-6 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:items-start">
      <TajToday client:visible t={t.tajToday} locale={locale} moonHref="/tours/taj-mahal-moonlight-night-viewing-tour" />
      <div>
        <h2 class="mb-3 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900">{t.agraMap.whereTitle}</h2>
        <AgraMap
          client:visible
          t={t.agraMap}
          details={attractions.map((a) => ({ slug: a.slug, name: a.data.name, hours: a.data.hours, ticketForeign: a.data.ticketPriceForeign, closedFriday: a.data.closedFriday }))}
        />
      </div>
    </div>

    <section class="mb-10" aria-labelledby="light-title">
      <h2 id="light-title" class="mb-3 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900">{t.light.title}</h2>
      <div class="max-w-2xl"><LightSlider client:visible t={t.light} sunriseHref="/tours/taj-mahal-sunrise-tour" moonlightHref="/tours/taj-mahal-moonlight-night-viewing-tour" /></div>
    </section>

    <h2 id="at-a-glance" class="mb-4 scroll-mt-20 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900">Agra's main sites at a glance</h2>
    <!-- Phones: one card per site. The 4-column table is wider than a phone
         and hid the Fridays column off-screen. -->
    <ul class="sm:hidden space-y-3 mb-3">
      {attractions.map((a) => (
        <li>
          <a href={`/agra/${a.slug}`} class="block rounded-2xl border border-brand-100 bg-white p-4 shadow-sm shadow-brand-900/5">
            <span class="flex items-center justify-between gap-3 mb-2">
              <span class="font-semibold text-brand-800">{a.data.name}</span>
              {a.data.closedFriday ? (
                <span class="shrink-0 rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-semibold text-red-800">Closed Fridays</span>
              ) : (
                <span class="shrink-0 rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">Open Fridays</span>
              )}
            </span>
            <dl class="text-sm text-stone-700 space-y-1">
              <div><dt class="inline font-medium text-stone-900">Ticket (foreign visitor): </dt><dd class="inline">{a.data.ticketPriceForeign}</dd></div>
              <div><dt class="inline font-medium text-stone-900">Hours: </dt><dd class="inline">{a.data.hours}</dd></div>
            </dl>
          </a>
        </li>
      ))}
    </ul>
    <div class="hidden sm:block overflow-x-auto mb-3 rounded-2xl border border-brand-100 bg-white shadow-sm shadow-brand-900/5">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-brand-50 text-left text-brand-900">
            <th class="px-4 py-3 font-semibold">Site</th>
            <th class="px-4 py-3 font-semibold">Foreign visitor ticket</th>
            <th class="px-4 py-3 font-semibold">Hours</th>
            <th class="px-4 py-3 font-semibold">Fridays</th>
          </tr>
        </thead>
        <tbody>
          {attractions.map((a) => (
            <tr class="border-t border-brand-100 align-top">
              <td class="px-4 py-3">
                <a href={`/agra/${a.slug}`} class="font-medium text-brand-800 hover:underline">{a.data.name}</a>
              </td>
              <td class="px-4 py-3">{a.data.ticketPriceForeign}</td>
              <td class="px-4 py-3">{a.data.hours}</td>
              <td class="px-4 py-3">{a.data.closedFriday ? <strong class="rounded-full bg-red-100 px-2 py-0.5 text-red-800">Closed</strong> : <span class="rounded-full bg-green-100 px-2 py-0.5 text-green-800">Open</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-xs text-stone-500 mb-12">
      Children under 15 enter free at every site listed here. Indian and SAARC/BIMSTEC prices are on each
      site's page. Prices change; confirm with ASI before a specific trip.
    </p>

    <h2 id="the-sites" class="mb-4 scroll-mt-20 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900">The sites</h2>
    <div class="space-y-4 mb-12">
      {attractions.map((a) => (
        <a href={`/agra/${a.slug}`} class="group block rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50/60 to-white p-6 shadow-sm shadow-brand-900/5 hover:border-brand-300 hover:shadow-md transition">
          <h3 class="mb-1 font-serif text-xl font-semibold text-brand-900 group-hover:underline">{a.data.name}</h3>
          <p class="text-sm text-stone-600 mb-2">{a.data.description}</p>
          {a.data.distanceFromTaj !== '—' && (
            <p class="text-xs text-stone-500">Location: {a.data.distanceFromTaj}</p>
          )}
        </a>
      ))}
    </div>

    <h2 id="planning" class="mb-4 scroll-mt-20 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900">Planning your visit</h2>
    <p class="text-stone-700 mb-4">
      Agra sits roughly 230 km from Delhi via the Yamuna Expressway, so most visitors come on a
      same-day trip; a second day lets you add Fatehpur Sikri without rushing.
    </p>
    <h3 class="mb-2 font-serif text-lg font-semibold text-brand-800">One day in Agra</h3>
    <p class="text-stone-700 mb-4">
      A single day covers the Taj Mahal and Agra Fort comfortably — the Fort is a short drive away
      within the city, and most same-day itineraries pair the two. If time allows at the end of the
      day, Mehtab Bagh sits directly across the Yamuna from the Taj and is known for its sunset view.
      <a href="/agra/itimad-ud-daulah" class="text-brand-800 underline">Itimad-ud-Daulah's Tomb</a>, the "Baby Taj",
      is on the same side of the river, so the two pair well.
      Whether one day is enough depends on what you want to see; our guide on
      <a href="/guides/is-one-day-enough-taj-mahal" class="text-brand-800 underline">whether one day is enough for the Taj Mahal</a>
      walks through it.
    </p>
    <h3 class="mb-2 font-serif text-lg font-semibold text-brand-800">Two days or more</h3>
    <p class="text-stone-700 mb-4">
      Fatehpur Sikri, Akbar's abandoned capital, is about 37 km from Agra and deserves 2.5 to 3.5
      hours on its own. That makes it a poor fit for a same-day trip from Delhi but a natural second
      day.
    </p>
    <h3 class="mb-2 font-serif text-lg font-semibold text-brand-800">Visiting on a Friday</h3>
    <p class="mb-12 rounded-2xl border border-amber-200 bg-gradient-to-br from-amber-50 to-white p-5 text-stone-700 shadow-sm">
      The Taj Mahal is <strong>closed every Friday</strong>. {openOnFridayNames}
      are all open, so a Friday in Agra still works — just plan the Taj for another day.
    </p>

    {guides.length > 0 && (
      <>
        <h2 id="before-you-go" class="mb-4 scroll-mt-20 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900">Before you go</h2>
        <ul class="space-y-2 mb-12">
          {guides.map((g) => (
            <li>
              <a href={`/guides/${g.slug}`} class="text-brand-800 hover:underline font-medium">{g.data.title}</a>
              <span class="text-stone-600 text-sm"> — {g.data.description}</span>
            </li>
          ))}
        </ul>
      </>
    )}

    {tours.length > 0 && (
      <>
        <h2 id="tours" class="mb-2 scroll-mt-20 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900">Private Agra tours</h2>
        <p class="text-stone-600 mb-3">
          IWIS Global runs private same-day tours from Delhi, with transport and a guide.
        </p>
        <SharedTourFacts facts={sharedFacts} class="mb-4" />
        <FoundingGuestNote class="mb-4" />
        <!-- Phones: a swipeable row (like the homepage) instead of four stacked cards. -->
        <div class="-mx-6 flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-px-6 px-6 pb-2 mb-12 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-6 sm:overflow-visible sm:px-0 sm:pb-0">
          {tours.map((tour) => <div class="w-64 shrink-0 snap-start sm:w-auto"><TourCard tour={tour} currency={currency} sharedFactsShown={sharedFacts.length > 0} headingLevel="h3" /></div>)}
        </div>
      </>
    )}

    <h2 id="faq" class="mb-4 scroll-mt-20 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900">Frequently asked questions</h2>
    <div class="space-y-3">
      {faqs.map((f) => (
        <div class="rounded-2xl border border-brand-100 bg-white p-5 shadow-sm shadow-brand-900/5">
          <h3 class="mb-1 font-semibold text-brand-900">{f.q}</h3>
          <p class="text-stone-700">{f.a}</p>
        </div>
      ))}
    </div>
  </article>

  <MobileActionBar waRef="ATTRBAR-AGRA" waMessage="Hi! I have a question about visiting Agra.">
    <Fragment slot="info">
      <p class="text-[11px] font-medium uppercase tracking-wide text-stone-500">Visiting Agra?</p>
      <p class="text-sm font-semibold leading-tight text-stone-900">Private Taj Mahal tours</p>
    </Fragment>
    <a slot="action" href="/tours" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-5 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:bg-brand-800 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300">
      View tours
    </a>
  </MobileActionBar>
</BaseLayout>
