---
// Backlog 2.7 — Agra attraction landing pages. Mirrors guides/[slug].astro's
// pattern (same content-collection approach, same reasons: dynamic route,
// prerender=false because BaseLayout needs per-request cookies).
export const prerender = false;

import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MobileActionBar from '../../components/MobileActionBar.astro';
import TourCard from '../../components/TourCard.astro';
import SharedTourFacts from '../../components/SharedTourFacts.astro';
import FoundingGuestNote from '../../components/FoundingGuestNote.astro';
import { resolveEnv } from '../../lib/env';
import { listTours, sharedTourFacts } from '../../lib/tours';
import { resolveCurrency, sortByFromPrice } from '../../lib/currency';
import { pageI18n } from '../../i18n/dictionaries';
import { fmt } from '../../i18n/fmt';
import { intlLocale } from '../../lib/i18n';
import { localizedEntry, overlayFields } from '../../lib/localizedContent';

const { slug } = Astro.params;
const entry: CollectionEntry<'attractions'> | undefined = (await getCollection('attractions')).find((e) => e.slug === slug);

if (!entry) {
  return Astro.redirect('/tours');
}

const { locale, t } = pageI18n(Astro);
const loc = await localizedEntry('attraction', locale, entry.slug);
const Content = loc ? null : (await entry.render()).Content;
const { name, description, ticketPriceForeign, ticketPriceIndian, ticketPriceSaarc, hours, closedFriday, dateModified, image: englishImage } = overlayFields(entry.data, loc);
const image = englishImage && { ...englishImage, alt: loc?.fields.imageAlt || englishImage.alt };

const currency = resolveCurrency(Astro.url.searchParams, Astro.cookies.get('currency')?.value);
if (Astro.url.searchParams.get('currency')) {
  Astro.cookies.set('currency', currency, { path: '/', maxAge: 60 * 60 * 24 * 365 });
}
// Tours with this site as an actual itinerary stop (not just a mention in
// the description, and not an optional add-on stop), cheapest first like /tours.
const env = resolveEnv(Astro.locals);
const siteName = entry.data.name.toLowerCase(); // matched against the English itinerary
const tours = sortByFromPrice(
  (env.DB ? await listTours(env.DB, { status: 'published' }) : []).filter((t) =>
    t.itinerary.some((step) => step.activity.toLowerCase().includes(siteName) && !/optional|add-on/i.test(step.time))
  ),
  currency
);
// Listed once above the tours; the cards then show only what differs.
const sharedFacts = sharedTourFacts(tours);

const attractionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name,
  description,
  url: `https://www.iwisglobal.com/agra/${entry.slug}`,
  ...(image && { image: `https://www.iwisglobal.com${image.src}` }),
  address: { '@type': 'PostalAddress', addressLocality: 'Agra', addressRegion: 'Uttar Pradesh', addressCountry: 'IN' },
};
---


<BaseLayout title={fmt(t.attractionExtra.title, { name })} description={description} breadcrumbs={[{ name: t.attractionExtra.breadcrumb, path: '/agra' }]}>
  <script type="application/ld+json" set:html={JSON.stringify(attractionJsonLd)} />

  <article class="max-w-3xl mx-auto px-6 py-16">
    <a href="/agra" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-800 hover:underline" set:html={t.attractionPage.k8} />
    <span class="mt-3 block w-fit rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-800" set:html={t.attractionPage.k9} />
    <h1 class="text-3xl md:text-4xl font-serif font-semibold mt-3 mb-6">{name}</h1>

    {image && (
      <img
        src={image.src}
        srcset={image.srcset}
        sizes="(min-width: 768px) 672px, calc(100vw - 48px)"
        alt={image.alt}
        width={image.width}
        height={image.height}
        fetchpriority="high"
        decoding="async"
        class="w-full h-auto rounded-2xl mb-6 bg-brand-50 shadow-lg shadow-brand-900/15"
      />
    )}

    <div class="grid sm:grid-cols-2 gap-3 mb-8 rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50/70 to-white p-4 text-sm shadow-sm shadow-brand-900/5">
      <div class="rounded-xl border border-brand-100 bg-white p-3">
        <p class="text-brand-600 uppercase text-xs font-semibold tracking-wide mb-1" set:html={t.attractionPage.k1} />
        <p class="font-semibold">{ticketPriceForeign}</p>
      </div>
      <div class="rounded-xl border border-brand-100 bg-white p-3">
        <p class="text-brand-600 uppercase text-xs font-semibold tracking-wide mb-1" set:html={t.attractionPage.k2} />
        <p class="font-semibold">{ticketPriceIndian}</p>
      </div>
      {ticketPriceSaarc && (
        <div class="rounded-xl border border-brand-100 bg-white p-3">
          <p class="text-brand-600 uppercase text-xs font-semibold tracking-wide mb-1" set:html={t.attractionPage.k3} />
          <p class="font-semibold">{ticketPriceSaarc}</p>
        </div>
      )}
      <div class="rounded-xl border border-brand-100 bg-white p-3">
        <p class="text-brand-600 uppercase text-xs font-semibold tracking-wide mb-1" set:html={t.attractionPage.k4} />
        <p class="font-semibold">{hours}</p>
      </div>
      <div class="rounded-xl border border-brand-100 bg-white p-3">
        <p class="text-brand-600 uppercase text-xs font-semibold tracking-wide mb-1" set:html={t.attractionPage.k5} />
        <p class="font-semibold"><span class={closedFriday ? 'rounded-full bg-red-100 px-2.5 py-0.5 text-red-800' : 'rounded-full bg-green-100 px-2.5 py-0.5 text-green-800'}>{closedFriday ? 'Closed' : 'Open'}</span></p>
      </div>
    </div>

    <div class="prose prose-stone max-w-none prose-headings:font-serif prose-headings:text-brand-900 prose-h2:border-l-4 prose-h2:border-brand-500 prose-h2:pl-3 prose-a:text-brand-700 prose-li:marker:text-brand-500">
      {Content ? <Content /> : <Fragment set:html={loc!.html} />}
    </div>

    {tours.length > 0 && (
      <section class="mt-12">
        <h2 class="mb-3 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900">{fmt(t.attractionExtra.toursThatVisit, { name })}</h2>
        <SharedTourFacts facts={sharedFacts} class="mb-4" />
        <FoundingGuestNote class="mb-4" />
        <!-- Phones: a swipeable row (like the homepage and /agra) instead of stacked cards. -->
        <div class="-mx-6 flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-px-6 px-6 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-6 sm:overflow-visible sm:px-0 sm:pb-0">
          {tours.map((tour) => <div class="w-64 shrink-0 snap-start sm:w-auto"><TourCard tour={tour} currency={currency} headingLevel="h3" sharedFactsShown={sharedFacts.length > 0} /></div>)}
        </div>
      </section>
    )}

    <p class="text-xs text-stone-400 mt-10">{fmt(t.attractionExtra.lastUpdated, { date: dateModified.toLocaleDateString(intlLocale(locale), { day: 'numeric', month: 'long', year: 'numeric' }) })}</p>
  </article>

  <!-- Phones: WhatsApp moves into this bar so the floating button doesn't
       sit on top of the article text; plus a way on to the tours. -->
  <MobileActionBar waRef={`ATTRBAR-AGRA-${entry.slug.toUpperCase()}`} waMessage={`Hi! I have a question about visiting ${name === 'Taj Mahal' ? 'the Taj Mahal' : name}.`}>
    <Fragment slot="info">
      <p class="text-[11px] font-medium uppercase tracking-wide text-stone-500" set:html={t.attractionPage.k6} />
      <p class="text-sm font-semibold leading-tight text-stone-900" set:html={t.attractionPage.k7} />
    </Fragment>
    <a slot="action" href="/tours" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-5 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:bg-brand-800 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300" set:html={t.attractionPage.k10} />
  </MobileActionBar>
</BaseLayout>
