---
// Backlog 2.7 — Agra attraction landing pages. Mirrors guides/[slug].astro's
// pattern (same content-collection approach, same reasons: dynamic route,
// prerender=false because BaseLayout needs per-request cookies).
export const prerender = false;

import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MobileActionBar from '../../components/MobileActionBar.astro';
import TourCard from '../../components/TourCard.astro';
import SharedTourFacts from '../../components/SharedTourFacts.astro';
import FoundingGuestNote from '../../components/FoundingGuestNote.astro';
import { resolveEnv } from '../../lib/env';
import { listTours, sharedTourFacts } from '../../lib/tours';
import { resolveCurrency, sortByFromPrice } from '../../lib/currency';

const { slug } = Astro.params;
const entry: CollectionEntry<'attractions'> | undefined = (await getCollection('attractions')).find((e) => e.slug === slug);

if (!entry) {
  return Astro.redirect('/tours');
}

const { Content } = await entry.render();
const { name, description, ticketPriceForeign, ticketPriceIndian, ticketPriceSaarc, hours, closedFriday, dateModified, image } = entry.data;

const currency = resolveCurrency(Astro.url.searchParams, Astro.cookies.get('currency')?.value);
if (Astro.url.searchParams.get('currency')) {
  Astro.cookies.set('currency', currency, { path: '/', maxAge: 60 * 60 * 24 * 365 });
}
// Tours with this site as an actual itinerary stop (not just a mention in
// the description), cheapest first like /tours.
const env = resolveEnv(Astro.locals);
const siteName = name.toLowerCase();
const tours = sortByFromPrice(
  (env.DB ? await listTours(env.DB, { status: 'published' }) : []).filter((t) =>
    t.itinerary.some((step) => step.activity.toLowerCase().includes(siteName))
  ),
  currency
);
// Listed once above the tours; the cards then show only what differs.
const sharedFacts = sharedTourFacts(tours);

const attractionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name,
  description,
  url: `https://www.iwisglobal.com/agra/${entry.slug}`,
  ...(image && { image: `https://www.iwisglobal.com${image.src}` }),
  address: { '@type': 'PostalAddress', addressLocality: 'Agra', addressRegion: 'Uttar Pradesh', addressCountry: 'IN' },
};
---

<BaseLayout title={`${name} — Agra Visitor Guide | IWIS Global`} description={description} breadcrumbs={[{ name: 'Agra Attractions', path: '/agra' }]}>
  <script type="application/ld+json" set:html={JSON.stringify(attractionJsonLd)} />

  <article class="max-w-3xl mx-auto px-6 py-16">
    <a href="/agra" class="inline-flex min-h-11 items-center text-sm text-stone-500 hover:underline">&larr; All Agra attractions</a>
    <h1 class="text-3xl md:text-4xl font-serif font-semibold mt-4 mb-6">{name}</h1>

    {image && (
      <img
        src={image.src}
        srcset={image.srcset}
        sizes="(min-width: 768px) 672px, calc(100vw - 48px)"
        alt={image.alt}
        width={image.width}
        height={image.height}
        fetchpriority="high"
        decoding="async"
        class="w-full h-auto rounded-xl mb-6 bg-brand-50"
      />
    )}

    <div class="grid sm:grid-cols-2 gap-4 mb-8 rounded-xl border border-stone-200 bg-white p-5 text-sm">
      <div>
        <p class="text-stone-500 uppercase text-xs tracking-wide mb-1">Ticket (foreign tourist)</p>
        <p class="font-semibold">{ticketPriceForeign}</p>
      </div>
      <div>
        <p class="text-stone-500 uppercase text-xs tracking-wide mb-1">Ticket (Indian national)</p>
        <p class="font-semibold">{ticketPriceIndian}</p>
      </div>
      {ticketPriceSaarc && (
        <div>
          <p class="text-stone-500 uppercase text-xs tracking-wide mb-1">Ticket (SAARC / BIMSTEC national)</p>
          <p class="font-semibold">{ticketPriceSaarc}</p>
        </div>
      )}
      <div>
        <p class="text-stone-500 uppercase text-xs tracking-wide mb-1">Hours</p>
        <p class="font-semibold">{hours}</p>
      </div>
      <div>
        <p class="text-stone-500 uppercase text-xs tracking-wide mb-1">Friday</p>
        <p class="font-semibold">{closedFriday ? 'Closed' : 'Open'}</p>
      </div>
    </div>

    <div class="prose prose-stone max-w-none prose-headings:font-serif prose-a:text-brand-700">
      <Content />
    </div>

    {tours.length > 0 && (
      <section class="mt-12">
        <h2 class="text-2xl font-serif font-semibold mb-3">Tours that visit {name === 'Taj Mahal' ? 'the Taj Mahal' : name}</h2>
        <SharedTourFacts facts={sharedFacts} class="mb-4" />
        <FoundingGuestNote class="mb-4" />
        <!-- Phones: a swipeable row (like the homepage and /agra) instead of stacked cards. -->
        <div class="-mx-6 flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-px-6 px-6 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-6 sm:overflow-visible sm:px-0 sm:pb-0">
          {tours.map((tour) => <div class="w-64 shrink-0 snap-start sm:w-auto"><TourCard tour={tour} currency={currency} headingLevel="h3" sharedFactsShown={sharedFacts.length > 0} /></div>)}
        </div>
      </section>
    )}

    <p class="text-xs text-stone-400 mt-10">Last updated {dateModified.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}.</p>
  </article>

  <!-- Phones: WhatsApp moves into this bar so the floating button doesn't
       sit on top of the article text; plus a way on to the tours. -->
  <MobileActionBar waRef={`ATTRBAR-AGRA-${entry.slug.toUpperCase()}`} waMessage={`Hi! I have a question about visiting ${name === 'Taj Mahal' ? 'the Taj Mahal' : name}.`}>
    <Fragment slot="info">
      <p class="text-[11px] font-medium uppercase tracking-wide text-stone-500">Visiting Agra?</p>
      <p class="text-sm font-semibold leading-tight text-stone-900">Private Taj Mahal tours</p>
    </Fragment>
    <a slot="action" href="/tours" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-5 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:bg-brand-800 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300">
      View tours
    </a>
  </MobileActionBar>
</BaseLayout>
