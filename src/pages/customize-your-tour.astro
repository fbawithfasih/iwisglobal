---
// "Customise your Agra tour" (src/lib/customTrip.ts). Guests build their own
// Agra trip and see a live estimate. Hidden from the public until the owner
// switches it on in /admin/custom-trips AND payment exists (PAYMENT_READY,
// turned on in milestone 3); a signed-in admin can preview it before then.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import TourCustomizer from '../components/TourCustomizer';
import { resolveEnv } from '../lib/env';
import { pageI18n } from '../i18n/dictionaries';
import { resolveCurrency } from '../lib/currency';
import { intlLocale } from '../lib/i18n';
import { isAdminAuthenticated } from '../lib/requireAdmin';
import { listTours } from '../lib/tours';
import { isCustomEnabled, loadRates } from '../lib/customTripData';
import { offeredTemplates } from '../lib/customTripTemplates';
import type { D1Like } from '../lib/db';

// Flipped to true when the payment step ships (milestone 3).
const PAYMENT_READY = false;

const env = resolveEnv(Astro.locals);
const db = env.DB as D1Like | undefined;
const { locale, t: dict } = pageI18n(Astro);
const t = dict.customTour;

const live = db ? (await isCustomEnabled(db)) && PAYMENT_READY : false;
const admin = await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET);
if (!db || (!live && !admin)) {
  return new Response('Not found', { status: 404 });
}

const currency = resolveCurrency(Astro.url.searchParams, Astro.cookies.get('currency')?.value);
const rates = await loadRates(db);
const tours = await listTours(db, { status: 'published' }, locale);
const templates = offeredTemplates(rates, new Map(tours.map((x) => [x.slug, x.title])));
---
<BaseLayout title={t.meta.title} description={t.meta.description} noindex={!live} floatingWhatsApp={false}>
  <section class="mx-auto max-w-5xl px-4 py-10 min-[300px]:px-6 md:py-14">
    {!live && (
      <p class="mb-5 rounded-xl bg-amber-50 p-3 text-sm text-amber-900" role="status">{t.previewBanner}</p>
    )}
    <h1 class="font-serif text-3xl font-semibold text-brand-900 md:text-4xl">{t.heading}</h1>
    <p class="mt-3 max-w-3xl text-stone-700">{t.intro}</p>
    <div class="mt-8">
      <TourCustomizer client:load rates={rates} templates={templates} currency={currency} intlLocale={intlLocale(locale)} t={t} />
      <noscript><p class="rounded-xl bg-stone-100 p-4 text-sm text-stone-700">{t.noJs} <a href="/contact" class="font-semibold text-brand-700 underline">{t.noJsLink}</a></p></noscript>
    </div>
  </section>
</BaseLayout>
