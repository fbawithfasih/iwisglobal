---
// Backlog 1.6. Real, confirmed differentiator (product-marketing-context.md
// §4: "No-commission pledge on craft/workshop stops... genuinely good") —
// not a claim invented for this page. The Same-Day tour's itinerary
// already lists its craft-gallery stop as optional (schema_tours.sql).
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import { pageI18n } from '../i18n/dictionaries';
const { t } = pageI18n(Astro);
---


<BaseLayout
  title={t.pledgePage.k17}
  description={t.pledgePage.k18}
>
  <!-- Same [&_…] heading styling as the policy pages. -->
  <section class="max-w-3xl mx-auto px-6 py-12 md:py-16 [&_h2]:border-l-4 [&_h2]:border-brand-500 [&_h2]:pl-3 [&_h2]:font-serif [&_h2]:text-brand-900 [&_p]:leading-relaxed">
    <div class="mb-10 rounded-2xl bg-gradient-to-br from-brand-900 via-brand-700 to-brand-600 p-6 text-white shadow-lg shadow-brand-900/20 sm:p-8">
    <span class="inline-block rounded-full bg-white/15 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-100" set:html={t.pledgePage.k15} />
    <h1 class="mt-3 text-3xl md:text-4xl font-serif font-semibold mb-4" set:html={t.pledgePage.k1} />

    <p class="text-lg text-white/90" set:html={t.pledgePage.k2} />
    </div>

    <h2 class="text-xl font-semibold mt-10 mb-3" set:html={t.pledgePage.k3} />
    <p class="text-stone-700 mb-4" set:html={t.pledgePage.k4} />
    <p class="text-stone-700 mb-4" set:html={t.pledgePage.k5} />

    <h2 class="text-xl font-semibold mt-10 mb-3" set:html={t.pledgePage.k6} />
    <ul class="mb-4 grid gap-3 sm:grid-cols-2">
      <li class="flex items-start gap-3 rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50/70 to-white p-4 text-stone-700 shadow-sm shadow-brand-900/5" set:html={t.pledgePage.k7} />
      <li class="flex items-start gap-3 rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50/70 to-white p-4 text-stone-700 shadow-sm shadow-brand-900/5" set:html={t.pledgePage.k8} />
      <li class="flex items-start gap-3 rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50/70 to-white p-4 text-stone-700 shadow-sm shadow-brand-900/5" set:html={t.pledgePage.k9} />
      <li class="flex items-start gap-3 rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50/70 to-white p-4 text-stone-700 shadow-sm shadow-brand-900/5" set:html={t.pledgePage.k10} />
    </ul>

    <p class="mt-10 rounded-2xl border border-brand-100 bg-brand-50/60 p-5 text-stone-700" set:html={t.pledgePage.k11} />

    <p class="text-stone-700 mt-4" set:html={t.pledgePage.k12} />
  </section>

  <!-- Phones: WhatsApp moves into this bar so the floating button doesn't
       sit on top of the text. -->
  <MobileActionBar waRef="PLEDGEBAR-NO-COMMISSION-PLEDGE" waMessage="Hi! I have a question about your tours.">
    <Fragment slot="info">
      <p class="text-[11px] font-medium uppercase tracking-wide text-stone-500" set:html={t.pledgePage.k13} />
      <p class="text-sm font-semibold leading-tight text-stone-900" set:html={t.pledgePage.k14} />
    </Fragment>
    <a slot="action" href="/tours" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-5 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:bg-brand-800 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300" set:html={t.pledgePage.k16} />
  </MobileActionBar>
</BaseLayout>
