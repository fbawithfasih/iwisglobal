---
// Where a guest lands after paying the deposit for a custom Agra tour. The
// trip id in the address is an unguessable random id; the page shows only the
// trip's status and totals, never contact details.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveEnv } from '../../lib/env';
import { pageI18n } from '../../i18n/dictionaries';
import { intlLocale } from '../../lib/i18n';
import { getCustomTrip, readStoredTrip } from '../../lib/customTripPayment';
import { formatMoneyMinor } from '../../lib/format';
import type { D1Like } from '../../lib/db';

const env = resolveEnv(Astro.locals);
const db = env.DB as D1Like | undefined;
const { locale, t: dict } = pageI18n(Astro);
const t = dict.customTour.thanks;

const id = Astro.url.searchParams.get('trip') ?? '';
const trip = db && /^ct_[0-9a-f-]{36}$/.test(id) ? await getCustomTrip(db, id) : null;
// A trip that was never paid is not shown.
const shown = trip && trip.status !== 'quoted' ? trip : null;
const stored = shown ? readStoredTrip(shown) : null;
const state = shown?.status === 'confirmed' ? t.confirmed : shown?.status === 'cancelled' ? t.cancelled : t.received;
const date = (d: string) => new Date(`${d}T00:00:00Z`).toLocaleDateString(intlLocale(locale), { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title={shown ? t.heading : t.notFound} noindex floatingWhatsApp={false}>
  <section class="mx-auto max-w-2xl px-4 py-12 min-[300px]:px-6 md:py-16">
    {shown && stored ? (
      <div>
        <h1 class="font-serif text-3xl font-semibold text-brand-900 md:text-4xl">{state.title}</h1>
        <p class="mt-3 text-stone-700">{state.body}</p>
        <div class="mt-6 rounded-2xl border border-brand-100 bg-white p-5 text-sm">
          <h2 class="font-serif text-lg font-semibold text-brand-900">{t.heading}</h2>
          <p class="mt-2 text-stone-700">
            {stored.quote.days.length === 1 ? date(stored.quote.startDate) : `${date(stored.quote.startDate)} – ${date(stored.quote.endDate)}`}
          </p>
          <dl class="mt-3 grid grid-cols-[1fr_auto] gap-x-4 gap-y-1">
            <dt class="text-stone-600">{t.ref}</dt><dd class="text-right font-mono text-xs">{shown.id}</dd>
            <dt class="text-stone-600">{t.total}</dt><dd class="text-right">{formatMoneyMinor(shown.total * 100, shown.currency)}</dd>
            <dt class="text-stone-600">{t.depositPaid}</dt><dd class="text-right">{formatMoneyMinor(shown.deposit * 100, shown.currency)}</dd>
            <dt class="text-stone-600">{t.balance}</dt><dd class="text-right">{formatMoneyMinor((shown.total - shown.deposit) * 100, shown.currency)}</dd>
          </dl>
        </div>
        {stored.input.hotel.mode !== 'own' && <p class="mt-4 text-sm text-stone-700">{t.hotel}</p>}
        <p class="mt-4 text-sm text-stone-700">{t.questions}</p>
      </div>
    ) : (
      <div>
        <h1 class="font-serif text-3xl font-semibold text-brand-900">{t.notFound}</h1>
        <p class="mt-3 text-stone-700">{t.questions}</p>
      </div>
    )}
  </section>
</BaseLayout>
