---
// Backlog 2.6's five Viator-FAQ counter-pages, plus the general-purpose
// route for any future guide added to the collection. Dynamic (not
// prerendered) for the same reason as every other page here — BaseLayout's
// nav/footer depend on Astro.cookies, which only resolves per-request.
export const prerender = false;

import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { slug } = Astro.params;
const entry: CollectionEntry<'guides'> | undefined = (await getCollection('guides')).find((e) => e.slug === slug);

if (!entry) {
  return Astro.redirect('/guides');
}

const { Content } = await entry.render();
const { title, description, authorName, datePublished, dateModified } = entry.data;

const dateFmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// Backlog 2.1's Article schema — the one item that was N/A when 2.1 shipped
// because no guide content existed yet.
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  author: { '@type': 'Organization', name: authorName },
  datePublished: datePublished.toISOString(),
  dateModified: dateModified.toISOString(),
  publisher: { '@type': 'Organization', name: 'IWIS Global', logo: { '@type': 'ImageObject', url: 'https://www.iwisglobal.com/logo.png' } },
};

// Marriott has zero FAQ content anywhere on activities.marriott.com — one
// of the biggest AEO gaps found there. Rather than hand-author a parallel
// FAQ list (which can drift from the guide's actual prose), pull genuine
// question-style ## headings straight out of the guide's own markdown body
// and pair each with the text that follows, up to the next heading. Guides
// with no "?" heading (e.g. the Viator/GetYourGuide comparison page) simply
// get no FAQPage schema — that's correct, not a gap, since they aren't
// FAQ-structured content.
function stripMarkdown(text: string): string {
  return text
    .replace(/<!--[\s\S]*?-->/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/\*([^*]+)\*/g, '$1')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/\s+/g, ' ')
    .trim();
}

function extractFaqFromMarkdown(body: string): { question: string; answer: string }[] {
  const faqs: { question: string; answer: string }[] = [];
  let current: { question: string; answerLines: string[] } | null = null;
  const flush = () => {
    if (current) {
      const answer = stripMarkdown(current.answerLines.join(' ').replace(/\s+/g, ' '));
      if (answer) faqs.push({ question: stripMarkdown(current.question), answer });
    }
    current = null;
  };
  for (const line of body.split('\n')) {
    const questionHeading = line.match(/^##\s+(.*\?)\s*$/);
    if (questionHeading) {
      flush();
      current = { question: questionHeading[1], answerLines: [] };
      continue;
    }
    // Every guide ends with a `---` rule before a "Last updated"/citation
    // footer (see e.g. taj-mahal-ticket-price-2026.md) — that footer isn't
    // part of the answer, so stop capture there too, same as a heading.
    if (/^#{1,6}\s/.test(line) || /^---\s*$/.test(line)) {
      flush();
      continue;
    }
    const trimmed = line.trim();
    if (current && trimmed && !trimmed.startsWith('|')) current.answerLines.push(trimmed);
  }
  flush();
  return faqs;
}

const faqs = extractFaqFromMarkdown(entry.body);
const faqJsonLd = faqs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }
  : null;
---

<BaseLayout title={`${title} — IWIS Global`} description={description} breadcrumbs={[{ name: 'Guides', path: '/guides' }]}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

  <article class="max-w-3xl mx-auto px-6 py-16">
    <a href="/guides" class="text-sm text-stone-500 hover:underline">&larr; All guides</a>
    <h1 class="text-3xl md:text-4xl font-serif font-semibold mt-4 mb-3">{title}</h1>
    <p class="text-sm text-stone-500 mb-10">
      By {authorName} · Published {dateFmt(datePublished)}
      {dateModified.getTime() !== datePublished.getTime() && <> · Updated {dateFmt(dateModified)}</>}
    </p>
    <div class="prose prose-stone max-w-none prose-headings:font-serif prose-a:text-brand-700">
      <Content />
    </div>

    <div class="mt-10 rounded-xl border border-brand-100 bg-brand-50/50 p-6 flex items-center justify-between gap-4 flex-wrap">
      <p class="text-sm text-stone-700">Ready to see it for yourself?</p>
      <a href="/tours" class="rounded-lg bg-brand-700 text-white px-5 py-2.5 text-sm font-semibold hover:bg-brand-800 transition">
        Browse Taj Mahal tours →
      </a>
    </div>
  </article>
</BaseLayout>
