---
// Backlog 2.6's five Viator-FAQ counter-pages, plus the general-purpose
// route for any future guide added to the collection. Dynamic (not
// prerendered) for the same reason as every other page here — BaseLayout's
// nav/footer depend on Astro.cookies, which only resolves per-request.
export const prerender = false;

import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MobileActionBar from '../../components/MobileActionBar.astro';
import { pageI18n } from '../../i18n/dictionaries';

const { slug } = Astro.params;
const entry: CollectionEntry<'guides'> | undefined = (await getCollection('guides')).find((e) => e.slug === slug);

if (!entry) {
  return Astro.redirect('/guides');
}

const { Content } = await entry.render();
const { title, description, authorName, datePublished, dateModified } = entry.data;

const dateFmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// Backlog 2.1's Article schema — the one item that was N/A when 2.1 shipped
// because no guide content existed yet.
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  author: { '@type': 'Organization', name: authorName },
  datePublished: datePublished.toISOString(),
  dateModified: dateModified.toISOString(),
  publisher: { '@type': 'Organization', name: 'IWIS Global', logo: { '@type': 'ImageObject', url: 'https://www.iwisglobal.com/logo.png' } },
};

// Marriott has zero FAQ content anywhere on activities.marriott.com — one
// of the biggest AEO gaps found there. Rather than hand-author a parallel
// FAQ list (which can drift from the guide's actual prose), pull genuine
// question-style ## headings straight out of the guide's own markdown body
// and pair each with the text that follows, up to the next heading. Guides
// with no "?" heading (e.g. the Viator/GetYourGuide comparison page) simply
// get no FAQPage schema — that's correct, not a gap, since they aren't
// FAQ-structured content.
function stripMarkdown(text: string): string {
  return text
    .replace(/<!--[\s\S]*?-->/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/\*([^*]+)\*/g, '$1')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/\s+/g, ' ')
    .trim();
}

function extractFaqFromMarkdown(body: string): { question: string; answer: string }[] {
  const faqs: { question: string; answer: string }[] = [];
  let current: { question: string; answerLines: string[] } | null = null;
  const flush = () => {
    if (current) {
      const answer = stripMarkdown(current.answerLines.join(' ').replace(/\s+/g, ' '));
      if (answer) faqs.push({ question: stripMarkdown(current.question), answer });
    }
    current = null;
  };
  for (const line of body.split('\n')) {
    const questionHeading = line.match(/^##\s+(.*\?)\s*$/);
    if (questionHeading) {
      flush();
      current = { question: questionHeading[1], answerLines: [] };
      continue;
    }
    // Every guide ends with a `---` rule before a "Last updated"/citation
    // footer (see e.g. taj-mahal-ticket-price-2026.md) — that footer isn't
    // part of the answer, so stop capture there too, same as a heading.
    if (/^#{1,6}\s/.test(line) || /^---\s*$/.test(line)) {
      flush();
      continue;
    }
    const trimmed = line.trim();
    if (current && trimmed && !trimmed.startsWith('|')) current.answerLines.push(trimmed);
  }
  flush();
  return faqs;
}

const faqs = extractFaqFromMarkdown(entry.body);
const faqJsonLd = faqs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }
  : null;
const { t } = pageI18n(Astro);
---


<BaseLayout title={`${title} — IWIS Global`} description={description} breadcrumbs={[{ name: 'Guides', path: '/guides' }]}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

  <article class="max-w-3xl mx-auto px-6 py-16">
    <a href="/guides" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-800 hover:underline" set:html={t.guidePage.k4} />
    <span class="mt-3 block w-fit rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-800" set:html={t.guidePage.k5} />
    <h1 class="text-3xl md:text-4xl font-serif font-semibold mt-3 mb-3">{title}</h1>
    <p class="mb-10 inline-block rounded-full border border-brand-100 bg-white px-3 py-1 text-sm text-stone-500">
      By {authorName} · Published {dateFmt(datePublished)}
      {dateModified.getTime() !== datePublished.getTime() && <> · Updated {dateFmt(dateModified)}</>}
    </p>
    <div class="prose prose-stone max-w-none prose-headings:font-serif prose-headings:text-brand-900 prose-h2:border-l-4 prose-h2:border-brand-500 prose-h2:pl-3 prose-a:text-brand-700 prose-li:marker:text-brand-500">
      <Content />
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 rounded-2xl bg-gradient-to-br from-brand-900 via-brand-700 to-brand-600 p-6 text-white shadow-lg shadow-brand-900/20">
      <p class="font-serif text-lg font-semibold" set:html={t.guidePage.k1} />
      <a href="/tours" class="inline-flex min-h-11 items-center rounded-full bg-white px-5 text-sm font-semibold text-brand-800 shadow-md shadow-brand-950/20 transition hover:bg-brand-50" set:html={t.guidePage.k6} />
    </div>
  </article>

  <!-- Phones: WhatsApp moves into this bar so the floating button doesn't
       sit on top of the article text; plus a way on to the tours. -->
  <MobileActionBar waRef={`GUIDEBAR-GUIDES-${entry.slug.toUpperCase()}`} waMessage="Hi! I have a question about visiting the Taj Mahal.">
    <Fragment slot="info">
      <p class="text-[11px] font-medium uppercase tracking-wide text-stone-500" set:html={t.guidePage.k2} />
      <p class="text-sm font-semibold leading-tight text-stone-900" set:html={t.guidePage.k3} />
    </Fragment>
    <a slot="action" href="/tours" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-5 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:bg-brand-800 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300" set:html={t.guidePage.k7} />
  </MobileActionBar>
</BaseLayout>
