---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MobileActionBar from '../../components/MobileActionBar.astro';
import { sortGuides } from '../../lib/guides';
import { pageI18n } from '../../i18n/dictionaries';
import { fmt } from '../../i18n/fmt';
import { intlLocale } from '../../lib/i18n';
import { localizedEntry, overlayFields } from '../../lib/localizedContent';

const { locale, t } = pageI18n(Astro);
const guides = await Promise.all(
  sortGuides(await getCollection('guides')).map(async (g) => ({ slug: g.slug, data: overlayFields(g.data, await localizedEntry('guide', locale, g.slug)) }))
);
---


<BaseLayout title={t.guidesIndex.k19} description={t.guidesIndex.k20}>
  <section class="max-w-3xl mx-auto px-6 py-16">
    <div class="mb-10 rounded-2xl bg-gradient-to-br from-brand-900 via-brand-700 to-brand-600 p-6 text-white shadow-lg shadow-brand-900/20 sm:p-8">
      <span class="inline-block rounded-full bg-white/15 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-100" set:html={t.guidesIndex.k17} />
      <h1 class="mt-3 text-3xl md:text-4xl font-serif font-semibold mb-2" set:html={t.guidesIndex.k1} />
      <p class="text-white/90" set:html={t.guidesIndex.k2} />
    </div>

    <div class="space-y-4">
      {guides.map((guide) => (
        <a href={`/guides/${guide.slug}`} class="group block rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50/60 to-white p-6 shadow-sm shadow-brand-900/5 hover:border-brand-300 hover:shadow-md transition">
          <h2 class="mb-1 font-serif text-xl font-semibold text-brand-900 group-hover:underline">{guide.data.title}</h2>
          <p class="text-sm text-stone-600">{guide.data.description}</p>
          {/* Guides carry prices and rules, so show how recent each one is. */}
          <p class="mt-3 inline-block rounded-full border border-brand-100 bg-white px-2.5 py-0.5 text-xs text-stone-500">
            {fmt(t.guideExtra.updated, { date: guide.data.dateModified.toLocaleDateString(intlLocale(locale), { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) })}
          </p>
        </a>
      ))}
    </div>

    <h2 class="mt-14 mb-3 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900" set:html={t.guidesIndex.k3} />
    <p class="text-stone-700 mb-4" set:html={t.guidesIndex.k4} />
    <ul class="list-disc pl-5 text-stone-700 space-y-2 mb-8 marker:text-brand-500">
      <li set:html={t.guidesIndex.k5} />
      <li set:html={t.guidesIndex.k6} />
      <li set:html={t.guidesIndex.k7} />
      <li set:html={t.guidesIndex.k8} />
    </ul>
    <p class="text-stone-700 mb-8" set:html={t.guidesIndex.k9} />
    <h2 class="mb-3 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900" set:html={t.guidesIndex.k10} />
    <p class="text-stone-700 mb-8" set:html={t.guidesIndex.k11} />
    <h2 class="mb-3 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900" set:html={t.guidesIndex.k12} />
    <p class="text-stone-700 mb-4" set:html={t.guidesIndex.k13} />
    <p class="rounded-2xl border border-brand-100 bg-brand-50/60 p-5 text-stone-700" set:html={t.guidesIndex.k14} />
  </section>

  <!-- Phones: WhatsApp moves into this bar so the floating button doesn't
       sit on top of the guide cards; plus a way on to the tours. -->
  <MobileActionBar waRef="GUIDEBAR-GUIDES" waMessage="Hi! I have a question about visiting the Taj Mahal.">
    <Fragment slot="info">
      <p class="text-[11px] font-medium uppercase tracking-wide text-stone-500" set:html={t.guidesIndex.k15} />
      <p class="text-sm font-semibold leading-tight text-stone-900" set:html={t.guidesIndex.k16} />
    </Fragment>
    <a slot="action" href="/tours" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-5 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:bg-brand-800 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300" set:html={t.guidesIndex.k18} />
  </MobileActionBar>
</BaseLayout>
