---
import BaseLayout from '../layouts/BaseLayout.astro';
import TourCard from '../components/TourCard.astro';
import TajToday from '../components/TajToday';
import TourFinder from '../components/TourFinder';
import { toFinderTours } from '../lib/tourFinderData';
import WeatherCard from '../components/WeatherCard';
import AiGuideBox from '../components/AiGuideBox';
import { listTours, sharedTourFacts } from '../lib/tours';
import FoundingGuestNote from '../components/FoundingGuestNote.astro';
import { listAgraHighlights } from '../lib/agraHighlights';
import HotelsCarousel from '../components/HotelsCarousel.astro';
import { resizedSrcset, uploadedImageSize } from '../lib/resizedImages';
import { liveAutomaticOffersForRequest } from '../lib/offers';
import { hasApprovedReviewsForRequest } from '../lib/reviews';
import { countBookingsForRequest } from '../lib/db';
import { todayIst } from '../lib/availability';
import { resolveEnv } from '../lib/env';
import { resolveCurrency, sortByFromPrice } from '../lib/currency';
import { pageI18n } from '../i18n/dictionaries';

export const prerender = false;

const env = resolveEnv(Astro.locals);
const { locale, t } = pageI18n(Astro);
// Every D1 query this page needs, started together: one after another they
// cost ~2 s before the first byte (each is a round trip to the database in
// North America). The layout, tour cards and Founding Guest note read the
// per-request results of the last three instead of querying again.
const [allTours, highlights] = env.DB
  ? await Promise.all([
      listTours(env.DB, { status: 'published' }, locale),
      listAgraHighlights(env.DB, locale),
      liveAutomaticOffersForRequest(env.DB, Astro.request, todayIst()),
      hasApprovedReviewsForRequest(env.DB, Astro.request),
      countBookingsForRequest(env.DB, Astro.request).catch(() => 0),
    ])
  : [[], []];
const featuredTours = allTours.filter((t) => t.featured);

const currency = resolveCurrency(Astro.url.searchParams, Astro.cookies.get('currency')?.value);
if (Astro.url.searchParams.get('currency')) {
  Astro.cookies.set('currency', currency, { path: '/', maxAge: 60 * 60 * 24 * 365 });
}

// Cheapest first, same as /tours (see sortByFromPrice).
const tours = sortByFromPrice(featuredTours, currency);
const finderTours = toFinderTours(allTours, currency);
// The hero already promises the facts every tour shares (guide, private
// car, pickup, free cancellation), so the cards show only what differs.
const sharedFactsShown = sharedTourFacts(tours).length > 0;

// "The Taj Mahal, curated just for you." -> a small lead-in and the main line
// (every language writes it as "<lead>, <rest>"). Desktop reads it as one line.
const heroParts = t.hero.title.split(/,\s+/);
const heroLead = heroParts.length > 1 ? heroParts[0] : null;
const heroRest = heroParts.length > 1 ? heroParts.slice(1).join(', ') : t.hero.title;

// A tiny traveller sits on (or stands on, or sleeps on) the letters of the main
// headline line (public/hero-minis, cut from one Higgsfield sheet; all share one
// scale, so `h` is the sprite's pixel height). The 14 letters carrying one are
// spread evenly over the line, in any language. `sink` lowers a sprite that
// dangles its legs, so its seat, not its feet, rests on the letter.
const MINI_SPRITES: Record<number, { w: number; h: number; sink?: number }> = {
  1: { w: 178, h: 230 }, 2: { w: 137, h: 241 }, 3: { w: 213, h: 285, sink: 0.36 }, 4: { w: 285, h: 133 },
  5: { w: 257, h: 209 }, 6: { w: 145, h: 332 }, 7: { w: 145, h: 357 }, 8: { w: 141, h: 347 },
  9: { w: 164, h: 337 }, 10: { w: 174, h: 360 }, 11: { w: 174, h: 230 }, 12: { w: 195, h: 264 },
};
// Sitting, standing and sleeping ones alternate so wide sprites sit between narrow ones.
const MINI_ORDER = [1, 6, 3, 7, 2, 12, 4, 8, 11, 9, 5, 10];
const MAX_MINIS = 14;
// Where a letter's top sits below its line box, in em: lower-case letters, then
// "t", then tall letters (ascenders, capitals, i and j dots).
const letterTop = (ch: string) => (/[bdfhklij]|\p{Lu}|\d/u.test(ch) ? 0.17 : ch === 't' ? 0.28 : 0.4);
function headlineWords(text: string) {
  const total = [...text].filter((c) => /\p{L}/u.test(c)).length;
  let seen = 0;
  let placed = 0;
  return text.split(' ').map((word) =>
    [...word].map((ch) => {
      if (!/\p{L}/u.test(ch)) return { ch };
      const i = seen++;
      const hasMini = Math.floor(((i + 1) * MAX_MINIS) / total) !== Math.floor((i * MAX_MINIS) / total);
      if (!hasMini) return { ch };
      const n = MINI_ORDER[placed++ % MINI_ORDER.length];
      return { ch, mini: { n, ...MINI_SPRITES[n], top: letterTop(ch), alt: placed % 2 === 0 } };
    })
  );
}

// Informational "things to do" content, not separate bookable products.
// Managed from /admin/agra-highlights (src/lib/agraHighlights.ts); a card
// without an uploaded image falls back to the same "No image yet"
// placeholder TourCard.astro uses for tours without a photo.
const AGRA_HIGHLIGHTS = highlights;

// Backlog 2.7 — link each card to its own attraction landing page (real,
// sourced ticket-price/hours content) instead of a generic /tours page.
// Falls back to /tours for any highlight without a dedicated page yet.
const ATTRACTION_SLUGS: Record<string, string> = {
  TAJ_MAHAL: 'taj-mahal',
  AGRA_FORT: 'agra-fort',
  FATEHPUR_SIKRI: 'fatehpur-sikri',
  MEHTAB_BAGH: 'mehtab-bagh',
  ITMAD_UD_DAULAH: 'itimad-ud-daulah',
};
function highlightHref(id: string): string {
  const slug = ATTRACTION_SLUGS[id];
  return slug ? `/agra/${slug}` : '/tours';
}
---
<BaseLayout title="Private Delhi to Agra Taj Mahal Tour | IWIS Global">
  <section class="relative isolate flex min-h-[82svh] flex-col justify-end md:min-h-[min(88svh,820px)]">
    <div class="absolute inset-0 -z-10 overflow-hidden" id="hero-frame">
      <!-- The still behind the video (instead of a poster="" attribute, which
           can't be responsive): phones load a 79 KB 720×720 copy rather than
           the 577 KB 1920×1920 one. The video covers it once it plays; with
           reduced motion or Save-Data it stays as the hero image. -->
      <picture>
        <source srcset="/hero-taj-mahal-720.jpg" media="(max-width: 767px)" />
        <img
          src="/hero-taj-mahal.jpg"
          width="1920"
          height="1920"
          alt=""
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover object-[center_28%]"
        />
      </picture>
      <video
        id="hero-video"
        class="relative w-full h-full object-cover object-[center_28%]"
        autoplay
        muted
        loop
        playsinline
        preload="none"
      >
        <!-- Phones get a 720×720 centre crop (1.2 MB, what a portrait hero
             actually shows) instead of the 19.3 MB 1080p original. Sources use
             data-src: the script below only attaches them (and plays) when
             neither reduced motion nor Data Saver is on, so those visitors
             never download the video at all. -->
        <source data-src="/hero-mobile.mp4" type="video/mp4" media="(max-width: 767px)" />
        <source data-src="https://d2ol7oe51mr4n9.cloudfront.net/user_3DcNrqF8RYl6IEcXyvyHIz0mgUZ/77342590-7bb6-4f5c-a0dc-8c192a2db2bd.mp4" type="video/mp4" />
      </video>
      <!-- The text sits in the lower part of the frame on every screen size, so
           only that part is darkened and the monument above it stays bright. -->
      <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(46,16,101,0.94)_0%,rgba(46,16,101,0.82)_30%,rgba(46,16,101,0.35)_50%,rgba(46,16,101,0)_66%)]"></div>
    </div>
    <div class="mx-auto w-full max-w-3xl px-5 pb-8 pt-56 text-center md:px-6 md:pb-14 md:pt-80">
      <h1 class="mb-3 font-serif font-semibold text-white [text-shadow:0_2px_14px_rgba(30,10,60,0.45)] md:mb-4">
        {heroLead && (
          <span class="mb-11 block font-sans text-xs font-semibold uppercase tracking-[0.24em] text-amber-200 md:mb-14 md:text-sm">{heroLead}</span>
        )}
        <span class="block text-[2rem] leading-[1.1] md:text-6xl" aria-label={heroRest}>
          <span aria-hidden="true">
            {headlineWords(heroRest).map((word, wi) => (
              <>
                {wi > 0 && ' '}
                <span class="inline-block whitespace-nowrap">
                  {word.map((l) => (
                    <span class="hero-letter">
                      {l.ch}
                      {'mini' in l && l.mini && (
                        <img
                          src={`/hero-minis/mini-${l.mini.n}.webp`}
                          alt=""
                          width={l.mini.w}
                          height={l.mini.h}
                          loading="eager"
                          decoding="async"
                          class:list={['hero-mini', l.mini.alt && 'max-md:hidden']}
                          style={`--h:${l.mini.h};--top:${l.mini.top}em;--sink:${l.mini.sink ?? 0};--d:${(l.mini.n % 5) * 0.4}s`}
                        />
                      )}
                    </span>
                  ))}
                </span>
              </>
            ))}
          </span>
        </span>
      </h1>
      <p class="mx-auto mb-5 max-w-sm text-[15px] leading-6 text-white/85 [text-shadow:0_1px_10px_rgba(30,10,60,0.45)] md:mb-8 md:max-w-xl md:text-lg md:leading-7 md:text-white/90">
        {t.hero.subtitle}
      </p>
      <AiGuideBox client:load t={t.aiGuide} />
    </div>
  </section>

  <!-- Everything below the hero scales together on ultrawide screens (the
       hero is full-bleed and sized to the viewport, so it stays out of it), and
       on smart TVs via the shared tv-scale rule. -->
  <div class="tv-scale min-[2200px]:[zoom:1.25] min-[3000px]:[zoom:1.5]">
  <section class="max-w-3xl mx-auto px-6 pt-12 md:pt-16">
    <TourFinder client:visible tours={finderTours} t={t.finder} />
  </section>

  <section class="max-w-5xl mx-auto px-6 py-12 md:py-16">
    <div data-carousel>
      <div class="flex items-center justify-between mb-4">
        <h2 class="border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900">{t.recommendations.title}</h2>
        <div class="hidden md:flex items-center gap-2">
          <button type="button" data-carousel-prev aria-label={t.common.previous} class="h-9 w-9 rounded-full border border-brand-200 text-brand-700 bg-white flex items-center justify-center hover:bg-brand-50 transition disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button type="button" data-carousel-next aria-label={t.common.next} class="h-9 w-9 rounded-full border border-brand-200 text-brand-700 bg-white flex items-center justify-center hover:bg-brand-50 transition disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
      <FoundingGuestNote class="mb-6" />
      <div data-carousel-row class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-px-6 scroll-smooth pb-2 -mx-6 px-6 carousel-row">
        {tours.map((tour) => (
          <div class="w-64 sm:w-72 shrink-0 snap-start">
            <TourCard tour={tour} currency={currency} sharedFactsShown={sharedFactsShown} headingLevel="h3" />
          </div>
        ))}
      </div>
      <div class="mt-4 flex justify-center gap-3 md:hidden">
        <button type="button" data-carousel-prev aria-label={t.common.previous} class="h-11 w-11 rounded-full border border-brand-200 text-brand-700 bg-white flex items-center justify-center hover:bg-brand-50 transition disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-white">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" data-carousel-next aria-label={t.common.next} class="h-11 w-11 rounded-full border border-brand-200 text-brand-700 bg-white flex items-center justify-center hover:bg-brand-50 transition disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-white">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </section>

  <section class="bg-gradient-to-b from-brand-50 via-brand-50 to-white py-10 md:py-14 2xl:py-20 [@media(max-height:500px)]:py-6">
    <div class="max-w-5xl 2xl:max-w-6xl mx-auto px-6 grid gap-5 md:gap-8 2xl:gap-10 [@media(max-height:500px)]:gap-4">
      <!-- The two live cards side by side, the four promises in a row below. -->
      <div class="grid items-stretch gap-4 md:grid-cols-2 md:gap-6 2xl:gap-8 [@media(max-height:500px)]:gap-3">
        <TajToday client:visible t={t.tajToday} locale={locale} moonHref="/tours/taj-mahal-moonlight-night-viewing-tour" />
        <WeatherCard client:visible t={t.weather} locale={locale} />
      </div>
      <!-- Phones: swipe through the promises instead of four tall stacked cards. -->
      <ul class="-mx-6 flex snap-x snap-mandatory gap-3 overflow-x-auto px-6 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-4 sm:auto-rows-fr sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-4 [@media(max-height:500px)]:gap-3 [@media(max-height:500px)]:[&_li]:p-3 [@media(max-height:500px)]:[&_li>span]:h-9 [@media(max-height:500px)]:[&_li>span]:w-9 [@media(max-height:500px)]:[&_li_p:first-child]:text-sm [@media(max-height:500px)]:[&_li_p+p]:text-xs [@media(max-height:500px)]:[&_li_p+p]:leading-snug [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        <li class="flex w-[78%] shrink-0 snap-start gap-3.5 rounded-2xl border border-brand-100 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md sm:w-auto sm:shrink">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-brand-700 to-brand-500 text-white shadow-md shadow-brand-900/20">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v3m0 12v3m9-9h-3M6 12H3m14.4-6.4-2.1 2.1M8.7 15.3l-2.1 2.1m0-10.8 2.1 2.1m8.7 8.7 2.1 2.1" />
          </svg>
          </span>
          <div>
            <p class="font-serif text-base font-semibold leading-snug text-brand-900">{t.trust.curatedTitle}</p>
            <p class="mt-1 text-sm leading-relaxed text-stone-600">{t.trust.curatedDesc}</p>
          </div>
        </li>
        <li class="flex w-[78%] shrink-0 snap-start gap-3.5 rounded-2xl border border-brand-100 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md sm:w-auto sm:shrink">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-brand-700 to-brand-500 text-white shadow-md shadow-brand-900/20">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke-linecap="round" stroke-linejoin="round" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 3" />
          </svg>
          </span>
          <div>
            <p class="font-serif text-base font-semibold leading-snug text-brand-900">{t.trust.bookTitle}</p>
            <p class="mt-1 text-sm leading-relaxed text-stone-600">{t.trust.bookDesc}</p>
          </div>
        </li>
        <li class="flex w-[78%] shrink-0 snap-start gap-3.5 rounded-2xl border border-brand-100 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md sm:w-auto sm:shrink">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-brand-700 to-brand-500 text-white shadow-md shadow-brand-900/20">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.6 12.6 12.9 20.3a1.5 1.5 0 0 1-2.1 0l-7.1-7.1a1.5 1.5 0 0 1 0-2.1L11.4 3.4a1.5 1.5 0 0 1 1.05-.44H19a1.5 1.5 0 0 1 1.5 1.5v6.55a1.5 1.5 0 0 1-.44 1.05Z" />
            <circle cx="16" cy="8" r="1" fill="currentColor" stroke="none" />
          </svg>
          </span>
          <div>
            <p class="font-serif text-base font-semibold leading-snug text-brand-900">{t.trust.pricingTitle}</p>
            <p class="mt-1 text-sm leading-relaxed text-stone-600">{t.trust.pricingDesc}</p>
          </div>
        </li>
        <li class="flex w-[78%] shrink-0 snap-start gap-3.5 rounded-2xl border border-brand-100 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md sm:w-auto sm:shrink">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-brand-700 to-brand-500 text-white shadow-md shadow-brand-900/20">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3.5 5 6v6c0 4.2 2.9 7.3 7 8.5 4.1-1.2 7-4.3 7-8.5V6l-7-2.5Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="m9.5 12 1.8 1.8L14.5 10" />
          </svg>
          </span>
          <div>
            <p class="font-serif text-base font-semibold leading-snug text-brand-900">{t.trust.promiseTitle}</p>
            <p class="mt-1 text-sm leading-relaxed text-stone-600">{t.trust.promiseDesc}</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-12 md:py-16">
    <div data-carousel>
      <div class="flex items-center justify-between mb-6">
        <h2 class="border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900">{t.thingsToDo.title}</h2>
        <div class="hidden md:flex items-center gap-2">
          <button type="button" data-carousel-prev aria-label={t.common.previous} class="h-9 w-9 rounded-full border border-brand-200 text-brand-700 bg-white flex items-center justify-center hover:bg-brand-50 transition disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button type="button" data-carousel-next aria-label={t.common.next} class="h-9 w-9 rounded-full border border-brand-200 text-brand-700 bg-white flex items-center justify-center hover:bg-brand-50 transition disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
      <div data-carousel-row class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-px-6 scroll-smooth pb-2 -mx-6 px-6 carousel-row">
        {AGRA_HIGHLIGHTS.map((item) => (
          <a href={highlightHref(item.id)} class="group w-64 sm:w-72 shrink-0 snap-start block">
            <div class="aspect-[4/3] bg-brand-50 rounded-2xl overflow-hidden shadow-md shadow-brand-900/10">
              {item.image ? (
                <img src={item.image} srcset={resizedSrcset(item.image)} sizes="(min-width: 640px) 288px, 256px" {...uploadedImageSize(item.image)} alt={item.name} loading="lazy" decoding="async" class="w-full h-full object-cover transition group-hover:opacity-90" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-brand-300 text-sm">No image yet</div>
              )}
            </div>
            <div class="pt-3">
              <p class="mb-1 font-serif text-lg font-semibold text-brand-900 group-hover:underline">{item.name}</p>
              <p class="text-sm text-stone-600">{item.description}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-4 flex justify-center gap-3 md:hidden">
        <button type="button" data-carousel-prev aria-label={t.common.previous} class="h-11 w-11 rounded-full border border-brand-200 text-brand-700 bg-white flex items-center justify-center hover:bg-brand-50 transition disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-white">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" data-carousel-next aria-label={t.common.next} class="h-11 w-11 rounded-full border border-brand-200 text-brand-700 bg-white flex items-center justify-center hover:bg-brand-50 transition disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-white">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </section>

  <HotelsCarousel currency={currency} />

  <section class="max-w-3xl mx-auto px-6 pb-16 [&_p]:leading-relaxed">
    <h2 class="mb-4 border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900">{t.home.howTitle}</h2>
    <p class="text-stone-700 mb-4">{t.home.howIntro}</p>
    <ol class="mb-6 space-y-3 text-stone-700 [counter-reset:step]">
      {t.home.steps.map((step) => (
        <li class="relative rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50/60 to-white p-4 pl-14 shadow-sm shadow-brand-900/5 [counter-increment:step] before:absolute before:left-4 before:top-4 before:flex before:h-7 before:w-7 before:items-center before:justify-center before:rounded-full before:bg-gradient-to-br before:from-brand-700 before:to-brand-500 before:text-sm before:font-semibold before:text-white before:content-[counter(step)]"><strong>{step.title}</strong> {step.body}</li>
      ))}
    </ol>
    <p class="text-stone-700 mb-4" set:html={t.home.firmHtml} />
    <p class="text-stone-700" set:html={t.home.guidesHtml} />
    <p class="rounded-2xl border border-brand-100 bg-brand-50/60 p-5 text-stone-700" set:html={t.home.ctaHtml} />
  </section>
  </div>
</BaseLayout>

<style>
  /* One letter of the headline, with its tiny traveller (if any) perched on top. */
  .hero-letter {
    position: relative;
    display: inline-block;
  }
  .hero-mini {
    position: absolute;
    left: 50%;
    height: calc(var(--h) * 0.0031em);
    width: auto;
    max-width: none;
    /* Feet (or seat) on the letter's top edge; --sink lowers dangling legs. */
    bottom: calc(100% - var(--top) - var(--sink) * var(--h) * 0.0031em);
    transform: translateX(-50%);
    pointer-events: none;
    filter: drop-shadow(0 3px 3px rgba(30, 10, 60, 0.4));
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-mini {
      animation: hero-mini-bob 3.2s ease-in-out var(--d) infinite;
    }
  }
  @keyframes hero-mini-bob {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-0.06em); }
  }
  .carousel-row {
    scrollbar-width: none;
  }
  .carousel-row::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Delegated on `document` (always exists at script-execution time) rather
  // than bound directly to each prev/next button — this bundle's <script>
  // tag ends up in <head>, ahead of the carousel markup in body, and the
  // per-element listeners this used to attach directly were silently never
  // firing (confirmed: a freshly-attached listener on the same button fires
  // immediately; the original per-element one never did). Delegation
  // resolves the clicked element and its row fresh at click time, so it
  // can't be affected by that class of attach-before-DOM-exists timing bug.
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element)?.closest?.<HTMLButtonElement>('[data-carousel-prev], [data-carousel-next]');
    if (!btn) return;
    const row = btn.closest('[data-carousel]')?.querySelector<HTMLElement>('[data-carousel-row]');
    if (!row) return;
    const direction = btn.matches('[data-carousel-prev]') ? -1 : 1;
    const card = row.firstElementChild as HTMLElement | null;
    const amount = (card?.offsetWidth ?? 320) + 24; // card width + gap-6
    row.scrollBy({ left: direction * amount, behavior: 'smooth' });
  });

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const row = carousel.querySelector<HTMLElement>('[data-carousel-row]');
    // Two arrow pairs per carousel: heading row (md+) and below the cards (phones).
    const prevBtns = carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-prev]');
    const nextBtns = carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-next]');
    if (!row || !prevBtns.length || !nextBtns.length) return;

    const updateButtons = () => {
      const atStart = row.scrollLeft <= 4;
      const atEnd = row.scrollLeft >= row.scrollWidth - row.clientWidth - 4;
      prevBtns.forEach((b) => (b.disabled = atStart));
      nextBtns.forEach((b) => (b.disabled = atEnd));
    };
    row.addEventListener('scroll', updateButtons, { passive: true });
    updateButtons();
  });
</script>

<script>
  // The video itself provides motion now, so no CSS zoom/parallax/fake-cloud
  // effects are needed (those existed specifically to animate a static
  // image). Respect prefers-reduced-motion the same way the old effects
  // did: don't autoplay (the still photo behind the video shows instead).
  const heroVideo = document.getElementById('hero-video') as HTMLVideoElement | null;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Data-saver mode (Chrome/Android "Lite"/Save-Data): stop the download and
  // keep the still photo, same as reduced motion but also dropping sources.
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  // Wait for the page to finish loading first: the video (1.2 MB on phones)
  // otherwise competes for bandwidth with the stylesheet, font and hero
  // still, delaying the first paint. The still shows until the video plays.
  const attachVideo = () => {
    if (!heroVideo) return;
    heroVideo.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => {
      s.src = s.dataset.src!;
    });
    heroVideo.preload = 'auto';
    heroVideo.load();
    // Start once it can play, and again whenever the page comes back into
    // view (a background tab doesn't start media). If autoplay is blocked
    // (e.g. Low Power Mode) the still photo simply stays.
    const start = () => {
      if (heroVideo.paused) heroVideo.play().catch(() => {});
    };
    heroVideo.addEventListener('canplay', start);
    document.addEventListener('visibilitychange', start);
    start();
  };
  if (heroVideo && !reduceMotion && !saveData) {
    // The still (already loading, responsive) doubles as the video's poster,
    // so the hero counts as painted when the photo shows, not seconds later
    // when the video's first frame does.
    const still = document.querySelector<HTMLImageElement>('#hero-frame picture img');
    if (still?.currentSrc) heroVideo.poster = still.currentSrc;
    if (document.readyState === 'complete') attachVideo();
    else window.addEventListener('load', attachVideo, { once: true });
  }
</script>
