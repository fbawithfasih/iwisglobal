---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const tours = (await getCollection('tours')).filter((t) => t.data.featured);
---
<BaseLayout title="IWIS Global — Private Taj Mahal & Agra Tours, Booked Online">
  <section class="max-w-3xl mx-auto px-6 py-20 text-center">
    <h1 class="text-4xl md:text-5xl font-serif font-semibold mb-4">See the Taj Mahal, without the chaos.</h1>
    <p class="text-lg text-stone-600 mb-8">
      IWIS Global runs professional, private Agra tours for international travelers — same-day trips from
      Delhi, multi-day itineraries, and curated stops at local art galleries. Book online, pay securely,
      arrive prepared.
    </p>
    <a href="/tours" class="inline-block rounded bg-amber-800 text-white px-6 py-3 font-medium">
      Browse tours
    </a>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-20">
    <h2 class="text-2xl font-serif font-semibold mb-6">Featured tours</h2>
    <div class="grid md:grid-cols-2 gap-6">
      {tours.map((tour) => (
        <a href={`/tours/${tour.slug}`} class="block rounded-xl border border-stone-200 p-6 hover:shadow-md transition">
          <h3 class="text-xl font-semibold mb-2">{tour.data.title}</h3>
          <p class="text-stone-600 text-sm mb-3">{tour.data.summary}</p>
          <span class="text-sm text-amber-800 font-medium">{tour.data.durationLabel}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
