---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalNotice from '../components/LegalNotice.astro';
import { pageI18n } from '../i18n/dictionaries';

// Required page for Razorpay card-network activation. IWIS Global sells tour
// services, not goods, so "shipping" here means how the booking and the tour
// are delivered, and "exchange" means changing the tour date.
export const prerender = false;

const lastUpdated = '27 September 2026';
const { t } = pageI18n(Astro);
---


<BaseLayout
  title={t.shippingPage.k19}
  description={t.shippingPage.k20}
>
  <!-- Same [&_…] heading and list styling as /terms. -->
  <section class="max-w-2xl mx-auto px-6 py-12 md:py-16 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:border-l-4 [&_h2]:border-brand-500 [&_h2]:pl-3 [&_h2]:font-serif [&_h2]:text-xl [&_h2]:text-brand-900 [&_li]:marker:text-brand-500 [&_p]:leading-relaxed">
    <span class="inline-block rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-800" set:html={t.shippingPage.k18} />
    <h1 class="mt-3 text-3xl md:text-4xl font-serif font-semibold mb-2" set:html={t.shippingPage.k1} />
    <LegalNotice updated={lastUpdated} />

    <h2 class="text-lg font-semibold mb-2 !mt-6" set:html={t.shippingPage.k2} />
    <p class="text-stone-700 mb-6" set:html={t.shippingPage.k3} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.shippingPage.k4} />
    <ul class="list-disc pl-5 text-stone-700 space-y-1 mb-6">
      <li set:html={t.shippingPage.k5} />
      <li set:html={t.shippingPage.k6} />
      <li set:html={t.shippingPage.k7} />
      <li set:html={t.shippingPage.k8} />
    </ul>

    <h2 class="text-lg font-semibold mb-2" set:html={t.shippingPage.k9} />
    <ul class="list-disc pl-5 text-stone-700 space-y-1 mb-6">
      <li set:html={t.shippingPage.k10} />
      <li set:html={t.shippingPage.k11} />
      <li set:html={t.shippingPage.k12} />
      <li set:html={t.shippingPage.k13} />
    </ul>

    <h2 class="text-lg font-semibold mb-2" set:html={t.shippingPage.k14} />
    <p class="text-stone-700 mb-6" set:html={t.shippingPage.k15} />

    <h2 class="text-lg font-semibold mb-2" set:html={t.shippingPage.k16} />
    <p class="rounded-2xl border border-brand-100 bg-brand-50/60 p-5 text-stone-700" set:html={t.shippingPage.k17} />
  </section>
</BaseLayout>
