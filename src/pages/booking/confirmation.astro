---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveEnv } from '../../lib/env';
import { getBookingByPaymentId } from '../../lib/crm';
import { getTourById, localizeTours } from '../../lib/tours';
import { pageI18n, fmt } from '../../i18n/dictionaries';
import { intlLocale } from '../../lib/i18n';
import { getSessionCustomerId } from '../../lib/requireCustomer';
import { CURRENCY_SYMBOLS, type Currency } from '../../lib/currency';
import { chosenAddOnNames, computeTicketsToBuy } from '../../lib/entryTickets';
import { canOfferSignup } from '../../lib/marketing';

export const prerender = false;

// Where the booking widget lands after a verified payment
// (?payment_id=pay_…, kept in a cookie — see below). Shows the trip and amounts only — no name, phone or
// full email — since anyone holding the link can open it.
const env = resolveEnv(Astro.locals);
const { locale, t } = pageI18n(Astro);
const c = t.confirmation;

// Every way in (the booking form after paying, the email, My Bookings, the
// calendar file) links here with ?payment_id=. It moves straight into a
// cookie and the address loses it, so analytics and the Meta Pixel (both
// record page addresses) never get a key to this booking.
const BOOKING_COOKIE = 'booking_ref';
const fromLink = Astro.url.searchParams.get('payment_id');
if (fromLink) {
  Astro.cookies.set(BOOKING_COOKIE, fromLink, { httpOnly: true, secure: true, sameSite: 'lax', path: '/booking', maxAge: 60 * 60 * 24 * 30 });
  return Astro.redirect('/booking/confirmation', 303);
}
const paymentId = Astro.cookies.get(BOOKING_COOKIE)?.value ?? null;
const db = env.DB;
const booking = paymentId && db ? await getBookingByPaymentId(db, paymentId) : null;
// English copy for logic and the messages we send to the team; localized copy for display.
const tour = booking && db ? await getTourById(db, booking.tour_id) : null;
const tourLoc = tour && db ? (await localizeTours(db, [tour], locale))[0] : tour;
const signedIn = !!(await getSessionCustomerId(Astro.cookies, env.CUSTOMER_SESSION_SECRET));

const formatDate = (ymd: string, tag = 'en-GB') =>
  new Date(`${ymd}T00:00:00Z`).toLocaleDateString(tag, {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
// Amounts are stored in the smallest unit (paise/cents).
const money = (minor: number, currency: string) =>
  `${CURRENCY_SYMBOLS[currency as Currency] ?? `${currency} `}${(minor / 100).toLocaleString(currency === 'USD' ? 'en-US' : 'en-IN')}`;
// "a•••@gmail.com": enough to recognise, not enough to read out.
const maskEmail = (email: string) => {
  const [user, domain] = email.split('@');
  return domain ? `${user.charAt(0)}•••@${domain}` : '';
};

const tourTitle = tour?.title ?? booking?.tour_id ?? '';
const tourTitleShown = tourLoc?.title ?? tourTitle;
const showDate = (ymd: string) => formatDate(ymd, intlLocale(locale));
const balance = booking ? booking.total_amount - booking.amount_paid : 0;
const isDeposit = booking?.payment_type === 'deposit';
const discount = booking?.discount_label && booking.discount_amount ? { label: booking.discount_label, amount: booking.discount_amount } : null;
// The stored label is English ("Founding Guest Offer (15% off)"); show the founding offer in the visitor's language.
const discountText = discount && /^Founding Guest/i.test(discount.label) ? fmt(t.offers.founding, { percent: discount.label.match(/(\d+)%/)?.[1] ?? '' }) : discount?.label;
// Reached right after paying and, later, from the email's "View your
// booking" button — so say what the booking's status is now.
// Meta Pixel Purchase: only on the visit right after paying (the booking is
// under 30 minutes old), not when the guest reopens this page from the email.
const freshPurchase =
  booking && booking.status !== 'cancelled' && Date.now() - new Date(booking.created_at).getTime() < 30 * 60 * 1000
    ? { eventID: booking.payment_id, tourId: booking.tour_id, value: booking.amount_paid / 100, currency: booking.currency }
    : null;
const status = booking?.status === 'cancelled' ? 'cancelled' : booking?.status === 'completed' ? 'completed' : 'confirmed';
const bookingSummary = booking ? `${tourTitle} on ${formatDate(booking.travel_date)}, booking ID ${booking.id}` : '';
const waLink = (text: string) => 'https://wa.me/916399226633?text=' + encodeURIComponent(text);
const waHref = booking
  ? waLink(`Hi! I have a question about my booking: ${bookingSummary}. (ref: CONFIRMATION)`)
  : waLink(`Hi! I just paid for a tour but can't see my booking. Payment reference: ${paymentId ?? 'unknown'} (ref: CONFIRMATION)`);
const changeHref = booking ? waLink(`Hi! I'd like to change or cancel my booking: ${bookingSummary}. (ref: CONFIRMATION-CHANGE)`) : '';
const addOnNames = booking && tourLoc ? chosenAddOnNames(tourLoc, booking.add_on_ids) : [];
// Entry tickets are bought on ASI's site, which needs each traveler's name and
// nationality (see /privacy), so ask for them when the booking includes any.
const needsTicketDetails = !!(booking && tour && computeTicketsToBuy(tour, booking).length > 0);
const nextStepsHref = booking
  ? waLink(
      [
        `Hi! Details for my booking: ${bookingSummary}.`,
        'Pickup address: ',
        ...(needsTicketDetails ? ['Travelers (full name, nationality): '] : []),
        '(ref: CONFIRMATION-PICKUP)',
      ].join('\n')
    )
  : '';
const depositNote = booking && isDeposit && balance > 0 ? fmt(c.depositNote, { balance: money(balance, booking.currency) }) : '';
// Add to calendar: an all-day event on the travel date. The Google link
// carries only the tour and date (the booking id opens this page, so it
// stays out of URLs sent elsewhere); the .ics file downloads to the device.
const ymd = booking?.travel_date.replace(/-/g, '') ?? '';
const nextDay = booking
  ? new Date(new Date(`${booking.travel_date}T00:00:00Z`).getTime() + 86_400_000).toISOString().slice(0, 10).replace(/-/g, '')
  : '';
const googleCalendarHref = booking
  ? 'https://calendar.google.com/calendar/render?' +
    new URLSearchParams({
      action: 'TEMPLATE',
      text: `${tourTitleShown} (IWIS Global)`,
      dates: `${ymd}/${nextDay}`,
      details: c.calDetails,
      location: 'Agra, India',
    }).toString()
  : '';
const icsHref = booking ? `/booking/calendar.ics?payment_id=${encodeURIComponent(booking.payment_id)}` : '';
// Optional email-ideas box: only for a confirmed booking whose address we hold no marketing choice for yet.
const offerSignup = !!(booking && status === 'confirmed' && booking.traveler_email && db && (await canOfferSignup(db, booking.traveler_email).catch(() => false)));
const heading = { confirmed: c.headConfirmed, completed: c.headCompleted, cancelled: c.headCancelled }[status];
---
<BaseLayout floatingWhatsApp={false} title={booking ? `${heading}${c.titleSuffix}` : c.notFoundTitle} noindex>
  <section class="max-w-xl mx-auto px-6 pt-8 pb-16 md:pt-16">
    {booking ? (
      <>
        <div class="text-center mb-8">
          <div class:list={['mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full', status === 'cancelled' ? 'bg-stone-200 text-stone-600' : 'bg-gradient-to-br from-brand-700 to-brand-500 text-white shadow-lg shadow-brand-900/25 ring-8 ring-brand-100']} aria-hidden="true">
            {status === 'cancelled' ? (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7"><path d="M18 6 6 18M6 6l12 12" /></svg>
            ) : (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7"><path d="M20 6 9 17l-5-5" /></svg>
            )}
          </div>
          <h1 class="text-3xl md:text-4xl font-serif font-semibold mb-3">{heading}</h1>
          {status === 'cancelled' && (
            <p class="text-stone-600" set:html={c.cancelledHtml} />
          )}
          {status === 'confirmed' && booking.traveler_email && (
            <p class="text-stone-600">
              {c.emailed.split('{email}')[0]}<span class="font-medium text-brand-900">{maskEmail(booking.traveler_email)}</span>{c.emailed.split('{email}')[1]}
            </p>
          )}
        </div>

        <div class="mb-6 overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-sm shadow-brand-900/5">
          <div class="bg-gradient-to-r from-brand-900 via-brand-700 to-brand-600 px-5 py-4 text-white">
          {tour?.slug ? (
            <a href={`/tours/${tour.slug}`} class="group block py-1">
              <span class="block font-semibold">{tourTitleShown}</span>
              <span class="mt-1 inline-flex min-h-6 items-center text-sm font-medium text-brand-100 group-hover:underline">{c.viewTour}</span>
            </a>
          ) : (
            <p class="font-semibold">{tourTitleShown}</p>
          )}
          </div>
          <dl class="space-y-2 p-5 text-sm">
            <div class="flex justify-between gap-4"><dt class="text-stone-500">{c.date}</dt><dd class="text-right">{showDate(booking.travel_date)}</dd></div>
            {booking.pickup_time && status === 'confirmed' && (
              <div class="flex justify-between gap-4"><dt class="text-stone-500">{c.pickup}</dt><dd class="text-right font-semibold">{booking.pickup_time}</dd></div>
            )}
            <div class="flex justify-between gap-4"><dt class="text-stone-500">{c.travelers}</dt><dd>{booking.travelers}</dd></div>
            {addOnNames.length > 0 && (
              <div class="flex justify-between gap-4"><dt class="shrink-0 whitespace-nowrap text-stone-500">{c.addOns}</dt><dd class="text-right">{addOnNames.join(', ')}</dd></div>
            )}
            {discount && (
              <>
                <div class="flex justify-between gap-4"><dt class="text-stone-500">{c.tourPrice}</dt><dd>{money(booking.total_amount + discount.amount, booking.currency)}</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-stone-500">{discountText}</dt><dd class="text-green-700 whitespace-nowrap">−{money(discount.amount, booking.currency)}</dd></div>
              </>
            )}
            {isDeposit ? (
              <>
                <div class="flex justify-between gap-4"><dt class="text-stone-500">{c.tourTotal}</dt><dd>{money(booking.total_amount, booking.currency)}</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-stone-500">{c.depositPaid}</dt><dd class="font-semibold">{money(booking.amount_paid, booking.currency)}</dd></div>
                {balance > 0 && status !== 'cancelled' && (
                  <div class="flex justify-between gap-4"><dt class="text-stone-500">{c.dueOnPickup}</dt><dd class="rounded-full bg-amber-300 px-2.5 py-0.5 font-semibold text-brand-950">{money(balance, booking.currency)}</dd></div>
                )}
              </>
            ) : (
              <div class="flex justify-between gap-4"><dt class="text-stone-500">{c.amountPaid}</dt><dd class="font-semibold">{money(booking.amount_paid, booking.currency)}</dd></div>
            )}
            <div class="flex justify-between gap-4 border-t border-brand-100 pt-2">
              <dt class="text-stone-500">{c.bookingId}</dt>
              <dd class="font-mono text-xs text-stone-700 break-all text-right">{booking.id}</dd>
            </div>
          </dl>
        </div>

        {depositNote && status === 'confirmed' && (
          <p class="mb-6 rounded-xl border border-brand-100 bg-brand-50/60 px-4 py-3 text-sm text-stone-700">{depositNote}</p>
        )}

        {status === 'confirmed' && (
          <div class="mb-6 rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50 to-white p-5 shadow-sm shadow-brand-900/5">
            <span class="mb-2 inline-block rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-800">{c.nextStep}</span>
            <h2 class="font-serif text-xl font-semibold text-stone-900 mb-2">{c.whatNext}</h2>
            <p class="text-sm text-stone-700 mb-4">
              {needsTicketDetails ? c.nextBodyTickets : c.nextBody}
            </p>
            <a href={nextStepsHref} target="_blank" rel="noopener noreferrer" data-wa-ref="CONFIRMATION-PICKUP" class="inline-flex min-h-11 items-center justify-center rounded-full bg-green-700 px-5 font-semibold text-white hover:bg-green-800 transition">
              {needsTicketDetails ? c.sendBoth : c.sendPickup}
            </a>
          </div>
        )}

        {status === 'confirmed' && (
          <div class="mb-6">
            <p class="text-sm font-semibold text-brand-900 mb-2">{c.calendar}</p>
            <div class="grid grid-cols-2 gap-3">
              <a href={googleCalendarHref} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center justify-center rounded-full border border-brand-200 bg-white px-4 text-sm font-semibold text-brand-900 hover:bg-brand-50 transition">{c.googleCal}</a>
              <a href={icsHref} class="inline-flex min-h-11 items-center justify-center rounded-full border border-brand-200 bg-white px-4 text-sm font-semibold text-brand-900 hover:bg-brand-50 transition">{c.appleCal}</a>
            </div>
          </div>
        )}

        {offerSignup && (
          <form id="booking-signup" class="mb-6 rounded-2xl border border-brand-100 bg-white p-5 shadow-sm shadow-brand-900/5" novalidate>
            <h2 class="font-serif text-lg font-semibold text-stone-900 mb-1">{t.bookingSignup.title}</h2>
            <p class="text-sm text-stone-700 mb-3">{t.bookingSignup.body.replace('{email}', maskEmail(booking.traveler_email))}</p>
            <label class="flex items-start gap-2 text-sm text-stone-700">
              <input type="checkbox" name="consent" required class="mt-0.5 h-5 w-5 shrink-0 rounded border-stone-400" />
              <span>{t.bookingSignup.consent}</span>
            </label>
            <button type="submit" class="mt-3 inline-flex min-h-11 items-center justify-center rounded-full border border-brand-200 bg-white px-5 text-sm font-semibold text-brand-900 hover:bg-brand-50 transition">{t.bookingSignup.button}</button>
            <p id="booking-signup-thanks" class="mt-2 hidden text-sm text-emerald-700" role="status">{t.bookingSignup.thanks}</p>
            <p id="booking-signup-error" class="mt-2 hidden text-sm text-red-700" role="alert">{t.bookingSignup.error}</p>
          </form>
        )}

        <div class="flex flex-col gap-3">
          <a href={waHref} target="_blank" rel="noopener noreferrer" data-wa-ref="CONFIRMATION" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-green-700 px-6 font-semibold text-white hover:bg-green-800 transition">
            {c.waAbout}
          </a>
          {status === 'confirmed' && (
            <>
              <a href={changeHref} target="_blank" rel="noopener noreferrer" data-wa-ref="CONFIRMATION-CHANGE" class="inline-flex min-h-12 items-center justify-center rounded-full border border-brand-200 bg-white px-6 font-semibold text-brand-900 hover:bg-brand-50 transition">
                {c.change}
              </a>
              <p class="text-center text-xs text-stone-500" set:html={c.freeCancelHtml} />
            </>
          )}
          {signedIn && (
            <a href="/account/bookings" class="inline-flex min-h-12 items-center justify-center rounded-full bg-gradient-to-r from-brand-900 via-brand-700 to-brand-600 px-6 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:brightness-110">
              {c.viewBookings}
            </a>
          )}
          <a href="/tours" class="inline-flex min-h-11 items-center justify-center text-sm text-stone-500 hover:text-brand-800 hover:underline">{c.browse}</a>
        </div>
      </>
    ) : (
      <div class="text-center">
        <h1 class="text-3xl font-serif font-semibold mb-3">{c.notFoundH}</h1>
        <p class="text-stone-600 mb-6">
          {c.notFoundBody.split('{ref}')[0]}{paymentId ? <> (<span class="font-mono break-all">{paymentId}</span>)</> : null}{c.notFoundBody.split('{ref}')[1]}
        </p>
        <a href={waHref} target="_blank" rel="noopener noreferrer" data-wa-ref="CONFIRMATION" class="inline-flex min-h-12 items-center justify-center rounded-full bg-green-700 px-6 font-semibold text-white hover:bg-green-800 transition">
          {c.waUs}
        </a>
      </div>
    )}
  </section>
</BaseLayout>

{offerSignup && (
  <script is:inline define:vars={{ locale }}>
    (function () {
      var form = document.getElementById('booking-signup');
      if (!form) return;
      var show = function (id, on) { document.getElementById(id).classList.toggle('hidden', !on); };
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        show('booking-signup-error', false);
        if (!form.elements.consent.checked) { show('booking-signup-error', true); return; }
        fetch('/booking/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ consent: true, locale: locale })
        }).then(function (r) {
          if (!r.ok) throw new Error('failed');
          form.querySelectorAll('input, button').forEach(function (el) { el.disabled = true; });
          show('booking-signup-thanks', true);
        }).catch(function () { show('booking-signup-error', true); });
      });
    })();
  </script>
)}

{freshPurchase && (
  <script is:inline define:vars={{ purchase: freshPurchase }}>
    // Sent only if the visitor accepts cookies (CookieConsent.astro).
    (window.iwisPixelQueue = window.iwisPixelQueue || []).push([
      'Purchase',
      { content_ids: [purchase.tourId], content_type: 'product', value: purchase.value, currency: purchase.currency },
      { eventID: purchase.eventID },
    ]);
  </script>
)}
