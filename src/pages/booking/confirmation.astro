---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveEnv } from '../../lib/env';
import { getBookingByPaymentId } from '../../lib/crm';
import { getTourById } from '../../lib/tours';
import { getSessionCustomerId } from '../../lib/requireCustomer';
import { CURRENCY_SYMBOLS, type Currency } from '../../lib/currency';
import { chosenAddOnNames, computeTicketsToBuy } from '../../lib/entryTickets';
import { depositTermsNote } from '../../lib/email';

export const prerender = false;

// Where the booking widget lands after a verified payment
// (?payment_id=pay_…). Shows the trip and amounts only — no name, phone or
// full email — since anyone holding the link can open it.
const env = resolveEnv(Astro.locals);
const paymentId = Astro.url.searchParams.get('payment_id');
const db = env.DB;
const booking = paymentId && db ? await getBookingByPaymentId(db, paymentId) : null;
const tour = booking && db ? await getTourById(db, booking.tour_id) : null;
const signedIn = !!(await getSessionCustomerId(Astro.cookies, env.CUSTOMER_SESSION_SECRET));

const formatDate = (ymd: string) =>
  new Date(`${ymd}T00:00:00Z`).toLocaleDateString('en-GB', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
// Amounts are stored in the smallest unit (paise/cents).
const money = (minor: number, currency: string) =>
  `${CURRENCY_SYMBOLS[currency as Currency] ?? `${currency} `}${(minor / 100).toLocaleString(currency === 'USD' ? 'en-US' : 'en-IN')}`;
// "a•••@gmail.com": enough to recognise, not enough to read out.
const maskEmail = (email: string) => {
  const [user, domain] = email.split('@');
  return domain ? `${user.charAt(0)}•••@${domain}` : '';
};

const tourTitle = tour?.title ?? booking?.tour_id ?? '';
const balance = booking ? booking.total_amount - booking.amount_paid : 0;
const isDeposit = booking?.payment_type === 'deposit';
const discount = booking?.discount_label && booking.discount_amount ? { label: booking.discount_label, amount: booking.discount_amount } : null;
// Reached right after paying and, later, from the email's "View your
// booking" button — so say what the booking's status is now.
// Meta Pixel Purchase: only on the visit right after paying (the booking is
// under 30 minutes old), not when the guest reopens this page from the email.
const freshPurchase =
  booking && booking.status !== 'cancelled' && Date.now() - new Date(booking.created_at).getTime() < 30 * 60 * 1000
    ? { eventID: booking.payment_id, tourId: booking.tour_id, value: booking.amount_paid / 100, currency: booking.currency }
    : null;
const status = booking?.status === 'cancelled' ? 'cancelled' : booking?.status === 'completed' ? 'completed' : 'confirmed';
const bookingSummary = booking ? `${tourTitle} on ${formatDate(booking.travel_date)}, booking ID ${booking.id}` : '';
const waLink = (text: string) => 'https://wa.me/916399226633?text=' + encodeURIComponent(text);
const waHref = booking
  ? waLink(`Hi! I have a question about my booking: ${bookingSummary}. (ref: CONFIRMATION)`)
  : waLink(`Hi! I just paid for a tour but can't see my booking. Payment reference: ${paymentId ?? 'unknown'} (ref: CONFIRMATION)`);
const changeHref = booking ? waLink(`Hi! I'd like to change or cancel my booking: ${bookingSummary}. (ref: CONFIRMATION-CHANGE)`) : '';
const addOnNames = booking && tour ? chosenAddOnNames(tour, booking.add_on_ids) : [];
// Entry tickets are bought on ASI's site, which needs each traveler's name and
// nationality (see /privacy), so ask for them when the booking includes any.
const needsTicketDetails = !!(booking && tour && computeTicketsToBuy(tour, booking).length > 0);
const nextStepsHref = booking
  ? waLink(
      [
        `Hi! Details for my booking: ${bookingSummary}.`,
        'Pickup address: ',
        ...(needsTicketDetails ? ['Travelers (full name, nationality): '] : []),
        '(ref: CONFIRMATION-PICKUP)',
      ].join('\n')
    )
  : '';
const depositNote = booking && isDeposit && balance > 0 ? depositTermsNote(money(balance, booking.currency)) : '';
// Add to calendar: an all-day event on the travel date. The Google link
// carries only the tour and date (the booking id opens this page, so it
// stays out of URLs sent elsewhere); the .ics file downloads to the device.
const ymd = booking?.travel_date.replace(/-/g, '') ?? '';
const nextDay = booking
  ? new Date(new Date(`${booking.travel_date}T00:00:00Z`).getTime() + 86_400_000).toISOString().slice(0, 10).replace(/-/g, '')
  : '';
const googleCalendarHref = booking
  ? 'https://calendar.google.com/calendar/render?' +
    new URLSearchParams({
      action: 'TEMPLATE',
      text: `${tourTitle} (IWIS Global)`,
      dates: `${ymd}/${nextDay}`,
      details: 'Private tour with IWIS Global. Questions: WhatsApp +91 6399226633',
      location: 'Agra, India',
    }).toString()
  : '';
const icsHref = booking ? `/booking/calendar.ics?payment_id=${encodeURIComponent(booking.payment_id)}` : '';
const heading = { confirmed: 'Your booking is confirmed', completed: 'Thanks for touring with us', cancelled: 'This booking was cancelled' }[status];
---
<BaseLayout floatingWhatsApp={false} title={booking ? `${heading} — IWIS Global` : "Booking not found — IWIS Global"} noindex>
  <section class="max-w-xl mx-auto px-6 pt-8 pb-16 md:pt-16">
    {booking ? (
      <>
        <div class="text-center mb-8">
          <div class:list={['mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full', status === 'cancelled' ? 'bg-stone-200 text-stone-600' : 'bg-green-100 text-green-700']} aria-hidden="true">
            {status === 'cancelled' ? (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7"><path d="M18 6 6 18M6 6l12 12" /></svg>
            ) : (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7"><path d="M20 6 9 17l-5-5" /></svg>
            )}
          </div>
          <h1 class="text-3xl font-serif font-semibold mb-3">{heading}</h1>
          {status === 'cancelled' && (
            <p class="text-stone-600">
              Any refund goes back to your original payment method — see our
              <a href="/cancellation-refund-policy" class="text-brand-800 underline">Cancellation &amp; Refund Policy</a>. Questions? WhatsApp us below.
            </p>
          )}
          {status === 'confirmed' && booking.traveler_email && (
            <p class="text-stone-600">
              We've emailed your confirmation to <span class="font-medium text-stone-800">{maskEmail(booking.traveler_email)}</span>.
              If it isn't there in a few minutes, check your spam folder.
            </p>
          )}
        </div>

        <div class="rounded-xl border border-stone-200 bg-white p-5 mb-6">
          {tour?.slug ? (
            <a href={`/tours/${tour.slug}`} class="group block py-1">
              <span class="block font-semibold text-stone-900 group-hover:text-brand-800">{tourTitle}</span>
              <span class="mt-1 inline-flex min-h-6 items-center text-sm font-medium text-brand-800 group-hover:underline">View tour &rarr;</span>
            </a>
          ) : (
            <p class="font-semibold">{tourTitle}</p>
          )}
          <dl class="mt-3 space-y-2 text-sm">
            <div class="flex justify-between gap-4"><dt class="text-stone-500">Date</dt><dd class="text-right">{formatDate(booking.travel_date)}</dd></div>
            {booking.pickup_time && status === 'confirmed' && (
              <div class="flex justify-between gap-4"><dt class="text-stone-500">Pickup</dt><dd class="text-right font-semibold">{booking.pickup_time}</dd></div>
            )}
            <div class="flex justify-between gap-4"><dt class="text-stone-500">Travelers</dt><dd>{booking.travelers}</dd></div>
            {addOnNames.length > 0 && (
              <div class="flex justify-between gap-4"><dt class="shrink-0 whitespace-nowrap text-stone-500">Add-ons</dt><dd class="text-right">{addOnNames.join(', ')}</dd></div>
            )}
            {discount && (
              <>
                <div class="flex justify-between gap-4"><dt class="text-stone-500">Tour price</dt><dd>{money(booking.total_amount + discount.amount, booking.currency)}</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-stone-500">{discount.label}</dt><dd class="text-green-700 whitespace-nowrap">−{money(discount.amount, booking.currency)}</dd></div>
              </>
            )}
            {isDeposit ? (
              <>
                <div class="flex justify-between gap-4"><dt class="text-stone-500">Tour total</dt><dd>{money(booking.total_amount, booking.currency)}</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-stone-500">Deposit paid</dt><dd class="font-semibold">{money(booking.amount_paid, booking.currency)}</dd></div>
                {balance > 0 && status !== 'cancelled' && (
                  <div class="flex justify-between gap-4"><dt class="text-stone-500">Due on pickup</dt><dd class="font-semibold text-amber-700">{money(balance, booking.currency)}</dd></div>
                )}
              </>
            ) : (
              <div class="flex justify-between gap-4"><dt class="text-stone-500">Amount paid</dt><dd class="font-semibold">{money(booking.amount_paid, booking.currency)}</dd></div>
            )}
            <div class="flex justify-between gap-4 border-t border-stone-100 pt-2">
              <dt class="text-stone-500">Booking ID</dt>
              <dd class="font-mono text-xs text-stone-700 break-all text-right">{booking.id}</dd>
            </div>
          </dl>
        </div>

        {depositNote && status === 'confirmed' && (
          <p class="-mt-2 mb-6 text-sm text-stone-600">{depositNote}</p>
        )}

        {status === 'confirmed' && (
          <div class="mb-6 rounded-xl border border-brand-100 bg-brand-50/60 p-5">
            <h2 class="font-semibold text-stone-900 mb-2">What happens next</h2>
            <p class="text-sm text-stone-700 mb-4">
              Send us your hotel or pickup address on WhatsApp{needsTicketDetails && <>, and each traveler's full name and nationality (the Archaeological Survey of India needs them for your entry tickets)</>}.
            </p>
            <a href={nextStepsHref} target="_blank" rel="noopener noreferrer" data-wa-ref="CONFIRMATION-PICKUP" class="inline-flex min-h-11 items-center justify-center rounded-full bg-green-700 px-5 font-semibold text-white hover:bg-green-800 transition">
              {needsTicketDetails ? 'Send pickup and traveler details' : 'Send pickup address'}
            </a>
          </div>
        )}

        {status === 'confirmed' && (
          <div class="mb-6">
            <p class="text-sm font-medium text-stone-700 mb-2">Add to your calendar</p>
            <div class="grid grid-cols-2 gap-3">
              <a href={googleCalendarHref} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center justify-center rounded-full border border-stone-300 bg-white px-4 text-sm font-semibold text-stone-800 hover:border-brand-300 transition">Google Calendar</a>
              <a href={icsHref} class="inline-flex min-h-11 items-center justify-center rounded-full border border-stone-300 bg-white px-4 text-sm font-semibold text-stone-800 hover:border-brand-300 transition">Apple / Outlook</a>
            </div>
          </div>
        )}

        <div class="flex flex-col gap-3">
          <a href={waHref} target="_blank" rel="noopener noreferrer" data-wa-ref="CONFIRMATION" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-green-700 px-6 font-semibold text-white hover:bg-green-800 transition">
            WhatsApp us about this booking
          </a>
          {status === 'confirmed' && (
            <>
              <a href={changeHref} target="_blank" rel="noopener noreferrer" data-wa-ref="CONFIRMATION-CHANGE" class="inline-flex min-h-12 items-center justify-center rounded-full border border-stone-300 bg-white px-6 font-semibold text-stone-800 hover:border-brand-300 transition">
                Change or cancel
              </a>
              <p class="text-center text-xs text-stone-500">
                Free cancellation up to 24 hours before your tour —
                <a href="/cancellation-refund-policy" class="text-brand-800 underline">Cancellation &amp; Refund Policy</a>
              </p>
            </>
          )}
          {signedIn && (
            <a href="/account/bookings" class="inline-flex min-h-12 items-center justify-center rounded-full bg-brand-800 px-6 font-semibold text-white hover:bg-brand-900 transition">
              View my bookings
            </a>
          )}
          <a href="/tours" class="inline-flex min-h-11 items-center justify-center text-sm text-stone-500 hover:text-brand-800 hover:underline">Browse more tours</a>
        </div>
      </>
    ) : (
      <div class="text-center">
        <h1 class="text-3xl font-serif font-semibold mb-3">We couldn't find this booking</h1>
        <p class="text-stone-600 mb-6">
          If you've just paid, check your email for the confirmation, or message us on WhatsApp with your payment
          reference{paymentId ? <> (<span class="font-mono break-all">{paymentId}</span>)</> : null} and we'll look it up.
        </p>
        <a href={waHref} target="_blank" rel="noopener noreferrer" data-wa-ref="CONFIRMATION" class="inline-flex min-h-12 items-center justify-center rounded-full bg-green-700 px-6 font-semibold text-white hover:bg-green-800 transition">
          WhatsApp us
        </a>
      </div>
    )}
  </section>
</BaseLayout>

{freshPurchase && (
  <script is:inline define:vars={{ purchase: freshPurchase }}>
    // Sent only if the visitor accepts cookies (CookieConsent.astro).
    (window.iwisPixelQueue = window.iwisPixelQueue || []).push([
      'Purchase',
      { content_ids: [purchase.tourId], content_type: 'product', value: purchase.value, currency: purchase.currency },
      { eventID: purchase.eventID },
    ]);
  </script>
)}
