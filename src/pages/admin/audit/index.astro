---
// Read-only view of the admin audit log (src/lib/audit.ts). Newest first, 100 per page, filter by action.
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { auditActions, listAudit, type AuditRow } from '../../../lib/audit';
import { formatDateTimeIst } from '../../../lib/format';
import type { D1Like } from '../../../lib/db';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}
const db: D1Like | undefined = env.DB;
if (!db) return new Response('No database', { status: 503 });

const PAGE = 100;
const action = Astro.url.searchParams.get('action') ?? '';
const before = Number(Astro.url.searchParams.get('before')) || undefined;

let rows: AuditRow[] = [];
let actions: string[] = [];
let missing = false;
try {
  [rows, actions] = await Promise.all([listAudit(db, { action: action || undefined, beforeId: before, limit: PAGE + 1 }), auditActions(db)]);
} catch {
  missing = true;
}
const more = rows.length > PAGE;
if (more) rows = rows.slice(0, PAGE);
const older = more ? `/admin/audit?${new URLSearchParams({ ...(action ? { action } : {}), before: String(rows[rows.length - 1].id) })}` : '';

const meta = (r: AuditRow) => {
  if (!r.meta_json) return '';
  try {
    return Object.entries(JSON.parse(r.meta_json) as Record<string, unknown>).map(([k, v]) => `${k}: ${v}`).join(', ');
  } catch {
    return '';
  }
};
---
<AdminLayout title="Audit log">
  <h1 class="mb-1 text-2xl font-semibold">Audit log</h1>
  <p class="mb-4 text-sm text-stone-600">Who did what in the admin. Entries cannot be edited or deleted. Customer contact details and message text are never stored here.</p>

  {missing ? (
    <div class="rounded-xl border bg-white p-4 text-sm">
      <p class="font-semibold">The audit log is not set up yet.</p>
      <p class="mt-1 text-stone-700">Its database table has not been created. Nothing is lost: actions work as normal and are simply not recorded until it is.</p>
    </div>
  ) : (
    <>
      <form method="GET" class="mb-4 flex flex-wrap items-end gap-2 text-sm">
        <label class="grid gap-1 font-medium">Action
          <select name="action" class="min-h-11 rounded border border-violet-200 px-3 font-normal">
            <option value="">All actions</option>
            {actions.map((a) => <option value={a} selected={a === action}>{a}</option>)}
          </select>
        </label>
        <button class="btn-primary min-h-11 px-4 text-white">Filter</button>
      </form>

      {rows.length === 0 ? (
        <p class="rounded-xl border bg-white p-4 text-sm text-stone-700">Nothing recorded yet.</p>
      ) : (
        <div class="overflow-x-auto rounded-xl border bg-white" tabindex="0" role="region" aria-label="Audit log entries, scrolls sideways">
          <table class="w-full text-left text-sm">
            <thead><tr class="border-b border-violet-100"><th class="px-3 py-2">When (IST)</th><th class="px-3 py-2">Who</th><th class="px-3 py-2">Action</th><th class="px-3 py-2">What</th><th class="px-3 py-2">From</th></tr></thead>
            <tbody>
              {rows.map((r) => (
                <tr class="border-b border-violet-100 align-top last:border-0">
                  <td class="whitespace-nowrap px-3 py-2">{formatDateTimeIst(r.at)}</td>
                  <td class="px-3 py-2">{r.actor}</td>
                  <td class="px-3 py-2"><span class="badge badge-neutral">{r.action}</span></td>
                  <td class="px-3 py-2">
                    {r.summary}
                    {r.resource_id && <span class="block text-xs text-stone-500">{r.resource} {r.resource_id}</span>}
                    {meta(r) && <span class="block text-xs text-stone-500">{meta(r)}</span>}
                  </td>
                  <td class="whitespace-nowrap px-3 py-2 text-stone-500">{r.ip ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      {older && <p class="mt-3"><a href={older} class="btn-secondary inline-block px-4 py-2 text-sm">Older entries</a></p>}
    </>
  )}
</AdminLayout>
