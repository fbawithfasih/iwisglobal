---
export const prerender = false;

import EmptyState from '../../../components/EmptyState.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { createCampaign, type CampaignRow } from '../../../lib/campaigns';
import { formatDateTimeIst } from '../../../lib/format';
import type { D1Like } from '../../../lib/db';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}
const db: D1Like | undefined = env.DB;

if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  if (String(form.get('_action') ?? '') === 'create') {
    const id = await createCampaign(db, String(form.get('name') ?? '').trim(), 'admin');
    return Astro.redirect(`/admin/campaigns/${id}`);
  }
  return Astro.redirect('/admin/campaigns');
}

let campaigns: (CampaignRow & { sent: number; total: number })[] = [];
let failed = false;
if (db) {
  try {
    campaigns = (
      await db
        .prepare(
          `SELECT c.*, (SELECT COUNT(*) FROM campaign_sends s WHERE s.campaign_id = c.id AND s.status = 'sent') AS sent,
                  (SELECT COUNT(*) FROM campaign_sends s WHERE s.campaign_id = c.id) AS total
             FROM campaigns c ORDER BY c.created_at DESC LIMIT 100`
        )
        .bind()
        .all<(typeof campaigns)[number]>()
    ).results;
  } catch {
    failed = true;
  }
}
const badge: Record<string, string> = { draft: 'bg-stone-100 text-stone-700', scheduled: 'bg-blue-100 text-blue-800', sending: 'bg-brand-100 text-brand-700', sent: 'bg-green-100 text-green-800', cancelled: 'bg-red-100 text-red-800' };
---
<AdminLayout title="Campaigns">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold">Email campaigns</h1>
    <a href="/admin/leads/subscribers" class="rounded border border-violet-200 bg-white px-3 py-2 text-sm">Email subscribers</a>
  </div>
  {failed && <p class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-800">The campaign tables are not in the database yet (schema_campaigns.sql).</p>}
  <form method="POST" class="mb-6 flex flex-wrap gap-2 rounded-xl border border-violet-100 bg-white p-4 text-sm">
    <input type="hidden" name="_action" value="create" />
    <input name="name" required placeholder="Campaign name (only you see this)" class="min-w-60 flex-1 rounded border border-violet-200 px-3 py-2" />
    <button class="min-h-11 rounded btn-primary px-4 text-white">New campaign</button>
  </form>
  {campaigns.length === 0 ? <EmptyState message="No campaigns yet" hint="Name a campaign above to start one. Nothing is sent until you approve it." /> : (
    <ul class="space-y-3">
      {campaigns.map((c) => (
        <li class="rounded-xl border border-violet-100 bg-white p-4 text-sm">
          <div class="flex items-start justify-between gap-3">
            <a href={`/admin/campaigns/${c.id}`} class="text-base font-semibold text-amber-900 hover:underline">{c.name}</a>
            <span class={`rounded px-2 py-0.5 text-xs ${badge[c.status] ?? ''}`}>{c.status}</span>
          </div>
          <p class="mt-1 text-xs text-stone-500">Created {formatDateTimeIst(c.created_at)}{c.scheduled_at && c.status === 'scheduled' ? ` · scheduled ${formatDateTimeIst(c.scheduled_at)}` : ''}{c.total > 0 ? ` · ${c.sent} of ${c.total} sent` : ''}</p>
        </li>
      ))}
    </ul>
  )}
</AdminLayout>
