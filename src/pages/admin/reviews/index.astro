---
// Backlog 1.2 — WhatsApp review request within 24h of drop-off, with a
// direct GBP review link. No WhatsApp Business API here (see
// schema_review_requests.sql) — this surfaces who's due and gives the
// admin a one-click wa.me link with the request pre-filled; "Mark as sent"
// just records that the click happened.
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { listReviewCandidates, markReviewRequested, type BookingRow } from '../../../lib/crm';
import { listTours } from '../../../lib/tours';
import { formatTravelDate } from '../../../lib/format';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET))) {
  return Astro.redirect('/admin/login');
}

const db = env.DB;

if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  const bookingId = String(form.get('bookingId') ?? '');
  if (bookingId) await markReviewRequested(db, bookingId);
  return Astro.redirect('/admin/reviews');
}

const candidates = db ? await listReviewCandidates(db) : [];
const tourNames = new Map((db ? await listTours(db) : []).map((t) => [t.id, t.title]));

// TODO(fasih): this is the Google Business Profile share link you gave —
// if GBP's "Get more reviews" feature has generated a dedicated
// write-a-review short link, swap it in here; it's a more direct path to
// the review form than the general profile link.
const GBP_REVIEW_LINK = 'https://share.google/LOqFXgGLF8KWXdMNn';

function reviewMessage(name: string): string {
  const firstName = name.trim().split(/\s+/)[0] || 'there';
  return `Hi ${firstName}! This is IWIS Global — thank you again for traveling with us. If you had a good experience, would you mind leaving us a quick review? It really helps: ${GBP_REVIEW_LINK}`;
}

const waHref = (b: BookingRow) =>
  b.traveler_phone
    ? `https://wa.me/${b.traveler_phone.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(reviewMessage(b.traveler_name))}`
    : null;
---
<AdminLayout title="Reviews">
  <h1 class="text-2xl font-semibold mb-2">Review requests</h1>
  <p class="text-stone-500 text-sm mb-6">
    Completed trips that haven't had a review request sent yet, oldest first. Click "WhatsApp" to open the message
    pre-filled, send it, then come back and click "Mark as sent."
  </p>

  {candidates.length === 0 ? (
    <p class="text-stone-500">Nobody's due for a review request right now.</p>
  ) : (
    <>
    <!-- Phones: one card per trip with full-size WhatsApp / Mark as sent. -->
    <ul class="md:hidden space-y-3">
      {candidates.map((b) => (
        <li class="rounded-xl border border-stone-200 bg-white p-4 text-sm">
          <p class="font-semibold text-base">{b.traveler_name}</p>
          <p class="text-stone-700">{tourNames.get(b.tour_id) ?? b.tour_id}</p>
          <p class="text-stone-500">Traveled {formatTravelDate(b.travel_date)}{b.traveler_phone ? ` · ${b.traveler_phone}` : ''}</p>
          <div class="flex gap-2 mt-3">
            {waHref(b) ? (
              <a href={waHref(b)} target="_blank" rel="noopener noreferrer" class="flex-1 inline-flex min-h-11 items-center justify-center rounded bg-emerald-600 font-medium text-white">WhatsApp</a>
            ) : (
              <span class="flex-1 inline-flex min-h-11 items-center justify-center rounded border border-dashed border-stone-300 text-stone-400">No phone on file</span>
            )}
            <form method="POST" class="flex-1">
              <input type="hidden" name="bookingId" value={b.id} />
              <button type="submit" class="w-full min-h-11 rounded border border-stone-300 bg-white text-stone-700">Mark as sent</button>
            </form>
          </div>
        </li>
      ))}
    </ul>
    <div class="hidden md:block bg-white rounded-xl border border-stone-200 overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-stone-50 text-left">
          <tr>
            <th class="px-4 py-2">Travel date</th>
            <th class="px-4 py-2">Tour</th>
            <th class="px-4 py-2">Traveler</th>
            <th class="px-4 py-2">Phone</th>
            <th class="px-4 py-2"></th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody>
          {candidates.map((b) => (
            <tr class="border-t border-stone-100">
              <td class="px-4 py-2 whitespace-nowrap">{formatTravelDate(b.travel_date)}</td>
              <td class="px-4 py-2">{tourNames.get(b.tour_id) ?? b.tour_id}</td>
              <td class="px-4 py-2">{b.traveler_name}</td>
              <td class="px-4 py-2">{b.traveler_phone}</td>
              <td class="px-4 py-2">
                {waHref(b) ? (
                  <a
                    href={waHref(b)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-emerald-700 hover:underline font-medium"
                  >
                    WhatsApp
                  </a>
                ) : (
                  <span class="text-stone-400">No phone on file</span>
                )}
              </td>
              <td class="px-4 py-2">
                <form method="POST">
                  <input type="hidden" name="bookingId" value={b.id} />
                  <button type="submit" class="text-stone-500 hover:text-stone-800 hover:underline">Mark as sent</button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    </>
  )}
</AdminLayout>
