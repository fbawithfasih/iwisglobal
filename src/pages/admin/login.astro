---
export const prerender = false;

import { verifyPassword, createSessionToken } from '../../lib/adminAuth';
import { resolveEnv } from '../../lib/env';
import { ADMIN_COOKIE } from '../../lib/requireAdmin';
import { checkLoginLock, recordFailedLogin, clearLoginAttempts } from '../../lib/loginAttempts';

let error: string | null = null;
const env = resolveEnv(Astro.locals);
const db = env.DB;
// Cloudflare sets this on every request; falls back to a shared bucket in
// local dev where it's absent, which is fine since dev has no real attacker.
const ip = Astro.request.headers.get('cf-connecting-ip') ?? 'unknown';

if (Astro.request.method === 'POST') {
  const lockedForMs = db ? await checkLoginLock(db, ip) : null;
  if (lockedForMs) {
    error = `Too many failed attempts. Try again in ${Math.ceil(lockedForMs / 60000)} minute(s).`;
  } else if (!env.ADMIN_PASSWORD_SALT || !env.ADMIN_PASSWORD_HASH || !env.ADMIN_SESSION_SECRET) {
    error = 'Admin login is not configured yet.';
  } else {
    const form = await Astro.request.formData();
    const password = String(form.get('password') ?? '');
    const valid = await verifyPassword(password, env.ADMIN_PASSWORD_SALT, env.ADMIN_PASSWORD_HASH);
    if (valid) {
      if (db) await clearLoginAttempts(db, ip);
      const token = await createSessionToken(env.ADMIN_SESSION_SECRET);
      Astro.cookies.set(ADMIN_COOKIE, token, {
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        path: '/admin',
        maxAge: 60 * 60 * 12,
      });
      return Astro.redirect('/admin');
    }
    if (db) await recordFailedLogin(db, ip);
    error = 'Incorrect password.';
  }
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin Login — IWIS Global</title>
    <style is:global>
      @tailwind base;
      @tailwind components;
      @tailwind utilities;
    </style>
  </head>
  <body class="min-h-screen bg-gradient-to-br from-brand-950 via-brand-800 to-brand-600 flex items-center justify-center px-6 py-10">
    <form method="POST" class="w-full max-w-sm space-y-4 rounded-2xl bg-white p-7 shadow-2xl shadow-brand-950/30 sm:p-8">
      <div class="text-center">
        <span class="inline-block rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-800">Admin</span>
        <h1 class="mt-3 text-2xl font-semibold text-stone-900">IWIS Admin Login</h1>
      </div>
      {error && <p role="alert" class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{error}</p>}
      <div>
        <label for="password" class="block text-sm font-medium text-stone-700 mb-1">Password</label>
        <input
          id="password"
          type="password"
          name="password"
          required
          autocomplete="current-password"
          class="w-full rounded-lg border border-stone-300 px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-brand-400"
        />
      </div>
      <button type="submit" class="w-full min-h-12 rounded-full bg-gradient-to-r from-brand-900 via-brand-700 to-brand-600 px-4 py-3 font-semibold text-white shadow-md shadow-brand-900/20 transition hover:brightness-110 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300 cursor-pointer">
        Log in
      </button>
    </form>
  </body>
</html>
