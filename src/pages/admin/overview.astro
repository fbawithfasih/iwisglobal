---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { resolveEnv } from '../../lib/env';
import { isAdminAuthenticated } from '../../lib/requireAdmin';
import { listStaff } from '../../lib/staff';
import { ownerLabel } from '../../lib/leadsAdmin';
import { todayIst } from '../../lib/availability';
import { loadOwnerOverview } from '../../lib/ownerOverview';
import { formatMoneyMinor, formatTravelDate } from '../../lib/format';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}
const db = env.DB;
const today = todayIst();

let o = null;
let loadError = false;
if (db) {
  try {
    o = await loadOwnerOverview(db, { today });
  } catch (err) {
    console.error('owner overview failed', err instanceof Error ? err.message : 'error');
    loadError = true;
  }
}
const staffNames: Record<string, string> = db ? Object.fromEntries((await listStaff(db).catch(() => [])).map((s) => [s.email, s.name || s.email])) : {};
const shown = (part: 'bookings' | 'leads' | 'chats' | 'reviews', n: number) => (o?.failed.includes(part) ? '–' : n);
const card = 'rounded-xl border border-violet-100 bg-white p-4';
const tinted = (tone: 'info' | 'success' | 'warn' | 'danger') => `rounded-xl border p-4 tint-${tone}`;
const big = 'block text-3xl font-semibold text-stone-900';
---
<AdminLayout title="Owner overview">
  <h1 class="text-2xl font-semibold">Owner overview</h1>
  <p class="mb-6 text-sm text-stone-600">Only you can see this page. Counts and money from your own records, as of {formatTravelDate(today)} (India time). Nothing here is a forecast.</p>

  {!db && <p class="notice notice-danger my-3" role="alert">Database not available.</p>}
  {loadError && <p class="notice notice-danger my-3" role="alert">Could not load the overview. The other pages still work; try again in a moment.</p>}

  {o && o.failed.length > 0 && (
    <p class="notice notice-warn my-3" role="alert">
      Could not load {o.failed.map((f) => ({ bookings: 'bookings and money', leads: 'leads', chats: 'WhatsApp chats', reviews: 'reviews' })[f]).join(', ')}. Those numbers show a dash, not zero.
    </p>
  )}

  {o && (
    <>
      <section aria-labelledby="money" class="mb-8">
        <h2 id="money" class="mb-1 text-lg font-semibold">Bookings and money, this month</h2>
        <p class="mb-3 text-xs text-stone-500">Since {formatTravelDate(o.monthFrom)}. Money is what guests have paid so far on confirmed or completed bookings made this month; cancelled bookings and custom trips still waiting for you are not counted.</p>
        <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
          <a href="/admin?view=confirmed" class={tinted('success')}><span class={big}>{shown('bookings', o.bookingsThisMonth.confirmed)}</span><span class="block text-sm text-stone-700">Confirmed</span></a>
          <a href="/admin?view=completed" class={card}><span class={big}>{shown('bookings', o.bookingsThisMonth.completed)}</span><span class="block text-sm text-stone-700">Completed</span></a>
          <a href="/admin?view=cancelled" class={tinted('danger')}><span class={big}>{shown('bookings', o.bookingsThisMonth.cancelled)}</span><span class="block text-sm text-stone-700">Cancelled</span></a>
          <a href="/admin?view=upcoming" class={tinted('info')}><span class={big}>{shown('bookings', o.tripsNext30Days)}</span><span class="block text-sm text-stone-700">Trips in the next 30 days</span></a>
        </div>
        <div class="mt-3 grid gap-3 md:grid-cols-2">
          <div class={tinted('success')}>
            <h3 class="mb-1 text-sm font-semibold text-stone-700">Paid so far this month</h3>
            {o.failed.includes('bookings') ? <p class="text-stone-500">–</p> : o.paidThisMonth.length === 0 ? <p class="text-stone-500">Nothing paid yet this month.</p> : (
              <ul>{o.paidThisMonth.map((m) => <li class="text-2xl font-semibold text-stone-900">{formatMoneyMinor(m.minor, m.currency)}</li>)}</ul>
            )}
          </div>
          <div class={tinted('warn')}>
            <h3 class="mb-1 text-sm font-semibold text-stone-700">Still to collect on confirmed bookings</h3>
            {o.failed.includes('bookings') ? <p class="text-stone-500">–</p> : o.balanceOutstanding.length === 0 ? <p class="text-stone-500">No balances outstanding.</p> : (
              <ul>{o.balanceOutstanding.map((m) => <li class="text-2xl font-semibold text-stone-900">{formatMoneyMinor(m.minor, m.currency)}</li>)}</ul>
            )}
            <p class="mt-1 text-xs text-stone-500">Deposits whose balance has not been paid. All dates, not only this month.</p>
          </div>
        </div>
      </section>

      <section aria-labelledby="leads" class="mb-8">
        <h2 id="leads" class="mb-1 text-lg font-semibold">Leads and chats, last 30 days</h2>
        <p class="mb-3 text-xs text-stone-500">Leads created in the last 30 days and where they stand today. Detail by source and cost is in the <a href="/admin/leads/report" class="underline">Lead report</a>.</p>
        <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
          <a href="/admin/leads?view=all" class={card}><span class={big}>{shown('leads', o.leads30.created)}</span><span class="block text-sm text-stone-700">New leads</span></a>
          <a href="/admin/leads?view=open" class={tinted('warn')}><span class={big}>{shown('leads', o.leads30.stillOpen)}</span><span class="block text-sm text-stone-700">Of those, still open</span></a>
          <a href="/admin/leads?view=closed" class={tinted('success')}><span class={big}>{shown('leads', o.leads30.booked)}</span><span class="block text-sm text-stone-700">Of those, booked</span></a>
          <a href="/admin/whatsapp?tab=all" class={tinted('info')}><span class={big}>{shown('chats', o.chats30)}</span><span class="block text-sm text-stone-700">WhatsApp chats started</span></a>
        </div>
        <p class="mt-2 text-sm text-stone-600">{shown('leads', o.leads30.lost)} lost in that group. {shown('leads', o.leadsUnassigned)} open leads have nobody on them (<a href="/admin/leads?view=unassigned" class="underline">see them</a>). {shown('reviews', o.reviewsToCheck)} guest reviews are waiting for you to check (<a href="/admin/reviews" class="underline">Reviews</a>).</p>
      </section>

      <section aria-labelledby="load" class="mb-8">
        <h2 id="load" class="mb-1 text-lg font-semibold">Who is holding what</h2>
        <p class="mb-3 text-xs text-stone-500">Open leads and live WhatsApp chats each person has taken, today. Not a score: a quiet person may simply have little assigned.</p>
        {o.workload.length === 0 ? (
          <EmptyState message="Nobody has taken a lead or a chat yet" hint="People take work from the Leads and WhatsApp pages." />
        ) : (
          <div class="overflow-x-auto rounded-xl border border-violet-100 bg-white">
            <table class="w-full text-sm">
              <caption class="sr-only">Open leads and chats by person</caption>
              <thead class="bg-stone-50 text-left"><tr><th scope="col" class="px-4 py-2">Person</th><th scope="col" class="px-4 py-2">Open leads</th><th scope="col" class="px-4 py-2">Chats</th></tr></thead>
              <tbody>
                {o.workload.map((w) => (
                  <tr class="border-t border-stone-100">
                    <td class="px-4 py-2">{ownerLabel(w.holder, staffNames)}</td>
                    <td class="px-4 py-2">{w.leads}</td>
                    <td class="px-4 py-2">{w.chats}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </>
  )}
</AdminLayout>
