---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { auditContext, recordAudit } from '../../../../lib/audit';
import OfferForm from '../../../../components/OfferForm.astro';
import { resolveEnv } from '../../../../lib/env';
import { isAdminAuthenticated } from '../../../../lib/requireAdmin';
import { getOffer, updateOffer, deleteOffer, parseOfferForm, type OfferInput } from '../../../../lib/offers';
import { listTours } from '../../../../lib/tours';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}

const db = env.DB;
const { id } = Astro.params;
if (!db || !id) return Astro.redirect('/admin/offers');

let error: string | null = null;
let typed: OfferInput | null = null; // shown again if the save fails
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('_action') === 'delete') {
    // Bookings keep their own copy of the offer name and amount saved.
    await deleteOffer(db, id);
    await recordAudit(db, auditContext(Astro.request, Astro.locals), { action: 'offer.delete', resource: 'offer', resourceId: id, summary: 'Deleted an offer or coupon' });
    return Astro.redirect('/admin/offers');
  }
  const parsed = parseOfferForm(form);
  typed = parsed.input;
  if (parsed.error) {
    error = parsed.error;
  } else {
    try {
      await updateOffer(db, id, parsed.input);
      await recordAudit(db, auditContext(Astro.request, Astro.locals), { action: 'offer.update', resource: 'offer', resourceId: id, summary: 'Changed an offer or coupon' });
      return Astro.redirect('/admin/offers');
    } catch (err: any) {
      error = err?.message || 'Could not save the offer.';
    }
  }
}

const offer = await getOffer(db, id);
if (!offer) return Astro.redirect('/admin/offers');
const tours = await listTours(db);
---
<AdminLayout title={`Edit ${offer.name}`}>
  <a href="/admin/offers" class="text-sm text-stone-500 hover:underline">&larr; Back to offers</a>
  <h1 class="text-2xl font-semibold mt-2 mb-6">Edit "{offer.name}"</h1>
  {error && <p role="alert" class="text-red-600 text-sm mb-4">{error}</p>}
  <OfferForm offer={typed ?? offer} tours={tours} submitLabel="Save changes" />

  <form method="POST" class="mt-4 max-w-2xl">
    <input type="hidden" name="_action" value="delete" />
    <button type="submit" class="min-h-11 text-sm text-red-600 hover:underline" data-confirm="delete">Delete this offer</button>
  </form>
</AdminLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-confirm="delete"]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      if (!confirm('Delete this offer? Past bookings keep their discount record. To stop it for now, untick "On" instead.')) e.preventDefault();
    });
  });
</script>
