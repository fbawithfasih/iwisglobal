---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { listOffers, offerStatus, offerValueLabel, offerConditions } from '../../../lib/offers';
import { listTours } from '../../../lib/tours';
import { todayIst } from '../../../lib/availability';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET))) {
  return Astro.redirect('/admin/login');
}

const db = env.DB;
const offers = db ? await listOffers(db) : [];
const tours = db ? await listTours(db) : [];
const today = todayIst();
const tourNames = (ids: string[]) =>
  ids.length === 0 ? 'All tours' : ids.map((id) => tours.find((t) => t.id === id)?.title ?? 'Deleted tour').join(', ');
const pill: Record<string, string> = {
  Running: 'bg-emerald-100 text-emerald-800',
  Scheduled: 'bg-sky-100 text-sky-800',
  Ended: 'bg-stone-200 text-stone-600',
  Off: 'bg-stone-200 text-stone-600',
};
const rows = offers.map((o) => ({
  o,
  status: offerStatus(o, today),
  value: offerValueLabel(o, 'INR') + (o.kind === 'fixed' && o.amountUsd ? ` / ${offerValueLabel(o, 'USD')}` : ''),
  conditions: offerConditions(o),
  tours: tourNames(o.tourIds),
}));
---
<AdminLayout title="Offers & coupons">
  <div class="flex items-center justify-between gap-3 mb-2">
    <h1 class="text-2xl font-semibold">Offers &amp; coupons</h1>
    <a href="/admin/offers/new" class="inline-flex min-h-11 items-center rounded bg-amber-800 text-white px-4 text-sm">+ New offer</a>
  </div>
  <p class="text-sm text-stone-500 mb-6">
    Automatic offers show on tour pages and apply without a code; coupons need the customer to enter the code. One discount per
    booking — the biggest wins, including the Founding Guest Offer.
  </p>

  {rows.length === 0 ? (
    <p class="text-stone-500">No offers yet.</p>
  ) : (
    <ul class="space-y-3">
      {rows.map(({ o, status, value, conditions, tours }) => (
        <li class="rounded-xl border border-stone-200 bg-white p-4 text-sm">
          <div class="flex flex-wrap items-start justify-between gap-2">
            <div class="min-w-0">
              <p class="font-semibold text-base">{o.name} <span class="font-normal text-stone-600">· {value}</span></p>
              <p class="text-stone-600 mt-0.5">
                {o.code ? <>Code <span class="font-mono font-semibold text-stone-900">{o.code}</span></> : 'Automatic (no code)'} · {tours}
              </p>
              {conditions && <p class="text-stone-500 mt-0.5">{conditions}</p>}
              <p class="text-stone-500 mt-0.5">Used on {o.uses} {o.uses === 1 ? 'booking' : 'bookings'}</p>
            </div>
            <span class={`shrink-0 rounded-full px-2.5 py-0.5 text-xs font-semibold ${pill[status]}`}>{status}</span>
          </div>
          <a href={`/admin/offers/${o.id}/edit`} class="mt-3 inline-flex min-h-11 items-center rounded border border-stone-300 bg-white px-4 text-stone-800">Edit</a>
        </li>
      ))}
    </ul>
  )}
</AdminLayout>
