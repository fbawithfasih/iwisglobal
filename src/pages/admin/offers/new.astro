---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { auditContext, recordAudit } from '../../../lib/audit';
import OfferForm from '../../../components/OfferForm.astro';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { createOffer, parseOfferForm, type OfferInput } from '../../../lib/offers';
import { listTours } from '../../../lib/tours';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}

const db = env.DB;
if (!db) return Astro.redirect('/admin/offers');

let error: string | null = null;
let typed: OfferInput | null = null; // shown again if the save fails
if (Astro.request.method === 'POST') {
  const parsed = parseOfferForm(await Astro.request.formData());
  typed = parsed.input;
  if (parsed.error) {
    error = parsed.error;
  } else {
    try {
      await createOffer(db, parsed.input);
      await recordAudit(db, auditContext(Astro.request, Astro.locals), { action: 'offer.create', resource: 'offer', summary: 'Created an offer or coupon' });
      return Astro.redirect('/admin/offers');
    } catch (err: any) {
      error = err?.message || 'Could not save the offer.';
    }
  }
}

const tours = await listTours(db);
---
<AdminLayout title="New offer">
  <a href="/admin/offers" class="text-sm text-stone-500 hover:underline">&larr; Back to offers</a>
  <h1 class="text-2xl font-semibold mt-2 mb-6">New offer or coupon</h1>
  {error && <p role="alert" class="text-red-600 text-sm mb-4">{error}</p>}
  <OfferForm offer={typed} tours={tours} submitLabel="Create offer" />
</AdminLayout>
