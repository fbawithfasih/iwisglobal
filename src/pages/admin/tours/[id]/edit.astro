---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../../lib/env';
import { isAdminAuthenticated } from '../../../../lib/requireAdmin';
import { getTourById, updateTour, replaceAddOns, replacePricingTiers } from '../../../../lib/tours';
import {
  parseLines,
  parseItinerary,
  parseAddOns,
  parsePricingTiers,
  formatLines,
  formatItinerary,
  formatAddOns,
  formatPricingTiers,
} from '../../../../lib/tourForm';
import { uploadTourImage } from '../../../../lib/images';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET))) {
  return Astro.redirect('/admin/login');
}

const db = env.DB;
const { id } = Astro.params;
if (!db || !id) return Astro.redirect('/admin/tours');

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const title = String(form.get('title') ?? '').trim();
  const amount = Number(form.get('amount') ?? 0);
  const usdAmountRaw = String(form.get('usdAmount') ?? '').trim();
  const usdAmount = usdAmountRaw !== '' ? Number(usdAmountRaw) : null;

  if (!title || !amount || amount <= 0) {
    error = 'Title and a valid price are required.';
  } else {
    try {
      const imageFile = form.get('imageFile');
      const existing = await getTourById(db, id);
      let image = String(form.get('image') ?? '').trim() || existing?.image || '';
      if (imageFile instanceof File && imageFile.size > 0) {
        if (!env.IMAGES) throw new Error('Image storage is not configured yet.');
        const uploaded = await uploadTourImage(env.IMAGES, imageFile);
        image = uploaded.url;
      }

      await updateTour(db, id, {
        title,
        summary: String(form.get('summary') ?? ''),
        description: String(form.get('description') ?? ''),
        durationLabel: String(form.get('durationLabel') ?? ''),
        startPoint: String(form.get('startPoint') ?? ''),
        amount,
        usdAmount: usdAmount != null && Number.isFinite(usdAmount) ? usdAmount : null,
        currency: String(form.get('currency') ?? 'INR'),
        highlights: parseLines(String(form.get('highlights') ?? '')),
        itinerary: parseItinerary(String(form.get('itinerary') ?? '')),
        includes: parseLines(String(form.get('includes') ?? '')),
        excludes: parseLines(String(form.get('excludes') ?? '')),
        image,
        featured: form.get('featured') === 'on',
        guideLanguage: String(form.get('guideLanguage') ?? 'English').trim() || 'English',
        pickupIncluded: form.get('pickupIncluded') === 'on',
        privateTour: form.get('privateTour') === 'on',
      });
      await replaceAddOns(db, id, parseAddOns(String(form.get('addOns') ?? '')));
      await replacePricingTiers(db, id, parsePricingTiers(String(form.get('pricingTiers') ?? '')));
      return Astro.redirect(`/admin/tours/${id}/edit?saved=1`);
    } catch (err: any) {
      error = err?.message || 'Failed to save tour.';
    }
  }
}

const tour = await getTourById(db, id);
if (!tour) return Astro.redirect('/admin/tours');
const saved = Astro.url.searchParams.get('saved') === '1';
---
<AdminLayout title={`Edit ${tour.title}`}>
  <a href="/admin/tours" class="text-sm text-stone-500 hover:underline">&larr; Back to tours</a>
  <div class="flex items-center justify-between mt-2 mb-6">
    <h1 class="text-2xl font-semibold">Edit tour</h1>
    <span class={`px-2 py-0.5 rounded text-xs ${tour.status === 'published' ? 'bg-green-100 text-green-800' : 'bg-stone-200 text-stone-700'}`}>
      {tour.status}
    </span>
  </div>

  {saved && <p class="text-green-700 text-sm mb-4">Saved.</p>}
  {error && <p class="text-red-600 text-sm mb-4">{error}</p>}

  <p class="text-stone-500 text-sm mb-4">
    Tour ID: <span class="font-mono">{tour.id}</span> · Slug: <span class="font-mono">{tour.slug}</span> ·
    Live at <a href={`/tours/${tour.slug}`} class="text-amber-800 hover:underline" target="_blank">/tours/{tour.slug}</a>
  </p>

  <form method="POST" enctype="multipart/form-data" class="bg-white rounded-xl border border-stone-200 p-6 space-y-4 max-w-2xl text-sm">
    <div>
      <label class="block text-stone-500 mb-1">Title *</label>
      <input name="title" required value={tour.title} class="w-full rounded border border-stone-300 px-3 py-2" />
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Summary</label>
      <textarea name="summary" rows="2" class="w-full rounded border border-stone-300 px-3 py-2">{tour.summary}</textarea>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-stone-500 mb-1">Price per traveler (INR) *</label>
        <input type="number" name="amount" min="1" required value={tour.amount} class="w-full rounded border border-stone-300 px-3 py-2" />
      </div>
      <div>
        <label class="block text-stone-500 mb-1">Price per traveler (USD, optional)</label>
        <input type="number" name="usdAmount" min="1" value={tour.usdAmount ?? ''} class="w-full rounded border border-stone-300 px-3 py-2" placeholder="Leave blank to hide USD for this tour" />
      </div>
    </div>
    <input type="hidden" name="currency" value={tour.currency} />
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-stone-500 mb-1">Duration label</label>
        <input name="durationLabel" value={tour.durationLabel} class="w-full rounded border border-stone-300 px-3 py-2" />
      </div>
      <div>
        <label class="block text-stone-500 mb-1">Start point</label>
        <input name="startPoint" value={tour.startPoint} class="w-full rounded border border-stone-300 px-3 py-2" />
      </div>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Current image</label>
      {tour.image ? (
        <img src={tour.image} alt="" class="w-40 h-28 object-cover rounded border border-stone-200 mb-2" />
      ) : (
        <p class="text-stone-500 text-xs mb-2">No image set.</p>
      )}
      <label class="block text-stone-500 mb-1">Upload new image (replaces current)</label>
      <input id="imageFile" type="file" name="imageFile" accept="image/jpeg,image/png,image/webp,image/gif" class="w-full text-sm" />
      <p class="text-xs text-stone-500 mt-1">JPEG/PNG/WebP/GIF, up to 5MB. Leave blank to keep the current image.</p>
      <p id="imageOptimizeStatus" class="text-xs text-emerald-700 mt-1"></p>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Image URL (only used if no new file is uploaded above)</label>
      <input name="image" value={tour.image} class="w-full rounded border border-stone-300 px-3 py-2" />
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Highlights (one per line)</label>
      <textarea name="highlights" rows="4" class="w-full rounded border border-stone-300 px-3 py-2">{formatLines(tour.highlights)}</textarea>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Itinerary (one step per line: "Time | Activity | Details (optional, shown when the stop is tapped)")</label>
      <textarea name="itinerary" rows="5" class="w-full rounded border border-stone-300 px-3 py-2">{formatItinerary(tour.itinerary)}</textarea>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Includes (one per line)</label>
      <textarea name="includes" rows="3" class="w-full rounded border border-stone-300 px-3 py-2">{formatLines(tour.includes)}</textarea>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Excludes (one per line)</label>
      <textarea name="excludes" rows="3" class="w-full rounded border border-stone-300 px-3 py-2">{formatLines(tour.excludes)}</textarea>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">
        Group-size pricing tiers (one per line: "Travelers | INR price per traveler | USD price (optional)")
      </label>
      <textarea name="pricingTiers" rows="4" class="w-full rounded border border-stone-300 px-3 py-2" placeholder={'1 | 11999\n2 | 6499\n3 | 5499\n4 | 4499'}>{formatPricingTiers(tour.pricingTiers)}</textarea>
      <p class="text-xs text-stone-500 mt-1">
        Optional. Leave blank to keep the flat "Price per traveler" above for every group size. A group larger than
        the biggest tier here still prices at that tier's rate.
      </p>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">
        Add-ons (one per line: "Name | INR price | USD price (optional) | yes-if-included-by-default | each-if-per-traveler")
      </label>
      <textarea name="addOns" rows="3" class="w-full rounded border border-stone-300 px-3 py-2">{formatAddOns(tour.addOns)}</textarea>
      <p class="text-xs text-stone-500 mt-1">
        Add "| yes" as a 4th segment to bundle it into the price by default (backlog 0.3) — the booking widget
        pre-checks it and the customer unchecks to remove it, rather than checking to add it. Example:
        "Monument entry (Taj Mahal + Agra Fort) | 1300 | | yes"
      </p>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Guide language</label>
      <input name="guideLanguage" value={tour.guideLanguage} class="w-full rounded border border-stone-300 px-3 py-2" />
    </div>
    <label class="flex items-center gap-2">
      <input type="checkbox" name="pickupIncluded" checked={tour.pickupIncluded} />
      Hotel pickup included
    </label>
    <label class="flex items-center gap-2">
      <input type="checkbox" name="privateTour" checked={tour.privateTour} />
      Private tour (not a shared/group tour)
    </label>
    <label class="flex items-center gap-2">
      <input type="checkbox" name="featured" checked={tour.featured} />
      Featured on homepage
    </label>
    <button type="submit" class="rounded bg-amber-800 text-white px-4 py-2">Save changes</button>
  </form>
</AdminLayout>

<script>
  import { attachImageOptimizer } from '../../../../lib/imageOptimizeClient';
  const input = document.getElementById('imageFile') as HTMLInputElement | null;
  const status = document.getElementById('imageOptimizeStatus');
  if (input) attachImageOptimizer(input, status);
</script>
