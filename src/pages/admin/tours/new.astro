---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { createTour, replaceAddOns, replacePricingTiers } from '../../../lib/tours';
import { parseLines, parseItinerary, parseAddOns, parsePricingTiers } from '../../../lib/tourForm';
import { uploadTourImage } from '../../../lib/images';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET))) {
  return Astro.redirect('/admin/login');
}

const db = env.DB;
let error: string | null = null;

if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  const title = String(form.get('title') ?? '').trim();
  const amount = Number(form.get('amount') ?? 0);
  const usdAmountRaw = String(form.get('usdAmount') ?? '').trim();
  const usdAmount = usdAmountRaw !== '' ? Number(usdAmountRaw) : null;

  if (!title || !amount || amount <= 0) {
    error = 'Title and a valid price are required.';
  } else {
    try {
      const imageFile = form.get('imageFile');
      let image = String(form.get('image') ?? '').trim();
      if (imageFile instanceof File && imageFile.size > 0) {
        if (!env.IMAGES) throw new Error('Image storage is not configured yet.');
        const uploaded = await uploadTourImage(env.IMAGES, imageFile);
        image = uploaded.url;
      }

      const id = await createTour(db, {
        title,
        summary: String(form.get('summary') ?? ''),
        description: String(form.get('description') ?? ''),
        durationLabel: String(form.get('durationLabel') ?? ''),
        startPoint: String(form.get('startPoint') ?? ''),
        amount,
        usdAmount: usdAmount != null && Number.isFinite(usdAmount) ? usdAmount : null,
        currency: String(form.get('currency') ?? 'INR'),
        highlights: parseLines(String(form.get('highlights') ?? '')),
        itinerary: parseItinerary(String(form.get('itinerary') ?? '')),
        includes: parseLines(String(form.get('includes') ?? '')),
        excludes: parseLines(String(form.get('excludes') ?? '')),
        image,
        featured: form.get('featured') === 'on',
        guideLanguage: String(form.get('guideLanguage') ?? 'English').trim() || 'English',
        pickupIncluded: form.get('pickupIncluded') === 'on',
        privateTour: form.get('privateTour') === 'on',
        entryTicketsInPrice: parseLines(String(form.get('entryTicketsInPrice') ?? '')),
      });
      const addOns = parseAddOns(String(form.get('addOns') ?? ''));
      if (addOns.length > 0) await replaceAddOns(db, id, addOns);
      const pricingTiers = parsePricingTiers(String(form.get('pricingTiers') ?? ''));
      if (pricingTiers.length > 0) await replacePricingTiers(db, id, pricingTiers);
      return Astro.redirect(`/admin/tours/${id}/edit`);
    } catch (err: any) {
      error = err?.message || 'Failed to create tour.';
    }
  }
}
---
<AdminLayout title="New Tour">
  <a href="/admin/tours" class="text-sm text-stone-500 hover:underline">&larr; Back to tours</a>
  <h1 class="text-2xl font-semibold mt-2 mb-6">New tour</h1>

  {error && <p class="text-red-600 text-sm mb-4">{error}</p>}

  <form method="POST" enctype="multipart/form-data" class="bg-white rounded-xl border border-stone-200 p-6 space-y-4 max-w-2xl text-sm">
    <div>
      <label class="block text-stone-500 mb-1">Title *</label>
      <input name="title" required class="w-full rounded border border-stone-300 px-3 py-2" placeholder="e.g. Sunset Agra Fort & Taj Mahal Tour" />
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Summary (shown on cards/meta description)</label>
      <textarea name="summary" rows="2" class="w-full rounded border border-stone-300 px-3 py-2"></textarea>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Description ("About this tour" — blank line between paragraphs; "## Heading" for a bullet heading; "Know before you go: …", "What to bring: …", "Not allowed: …" paragraphs go to "Good to know"; [text](/link) for links)</label>
      <textarea name="description" rows="14" class="w-full rounded border border-stone-300 px-3 py-2 font-mono text-xs leading-relaxed"></textarea>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-stone-500 mb-1">Price per traveler (INR) *</label>
        <input type="number" name="amount" min="1" required class="w-full rounded border border-stone-300 px-3 py-2" />
      </div>
      <div>
        <label class="block text-stone-500 mb-1">Price per traveler (USD, optional)</label>
        <input type="number" name="usdAmount" min="1" class="w-full rounded border border-stone-300 px-3 py-2" placeholder="Leave blank to hide USD for this tour" />
      </div>
    </div>
    <input type="hidden" name="currency" value="INR" />
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-stone-500 mb-1">Duration label</label>
        <input name="durationLabel" placeholder="e.g. Same-day (12–14 hrs)" class="w-full rounded border border-stone-300 px-3 py-2" />
      </div>
      <div>
        <label class="block text-stone-500 mb-1">Start point</label>
        <input name="startPoint" placeholder="e.g. Delhi Airport" class="w-full rounded border border-stone-300 px-3 py-2" />
      </div>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Upload image</label>
      <input id="imageFile" type="file" name="imageFile" accept="image/jpeg,image/png,image/webp,image/gif" class="w-full text-sm" />
      <p class="text-xs text-stone-500 mt-1">JPEG/PNG/WebP/GIF, up to 5MB. Or paste a URL below instead.</p>
      <p id="imageOptimizeStatus" class="text-xs text-emerald-700 mt-1"></p>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Image URL (used only if no file is uploaded above)</label>
      <input name="image" placeholder="https://…" class="w-full rounded border border-stone-300 px-3 py-2" />
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Highlights (one per line)</label>
      <textarea name="highlights" rows="4" class="w-full rounded border border-stone-300 px-3 py-2"></textarea>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Entry tickets included in the price (one per line — only tickets NOT sold as an add-on below; staff buy these on ASI's site for every booking)</label>
      <textarea name="entryTicketsInPrice" rows="2" class="w-full rounded border border-stone-300 px-3 py-2" placeholder="Agra Fort entry ticket"></textarea>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Itinerary (one step per line: "Time | Activity | Details (optional, shown when the stop is tapped)")</label>
      <textarea name="itinerary" rows="5" class="w-full rounded border border-stone-300 px-3 py-2" placeholder="5:30 AM | Pickup from hotel"></textarea>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Includes (one per line)</label>
      <textarea name="includes" rows="3" class="w-full rounded border border-stone-300 px-3 py-2"></textarea>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Excludes (one per line)</label>
      <textarea name="excludes" rows="3" class="w-full rounded border border-stone-300 px-3 py-2"></textarea>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">
        Group-size pricing tiers (one per line: "Travelers | INR price per traveler | USD price (optional)")
      </label>
      <textarea name="pricingTiers" rows="4" class="w-full rounded border border-stone-300 px-3 py-2" placeholder={'1 | 11999\n2 | 6499\n3 | 5499\n4 | 4499'}></textarea>
      <p class="text-xs text-stone-500 mt-1">
        Optional. Leave blank to keep the flat "Price per traveler" above for every group size.
      </p>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">
        Add-ons (one per line: "Name | INR price | USD price (optional) | yes-if-included-by-default | each-if-per-traveler")
      </label>
      <textarea name="addOns" rows="3" class="w-full rounded border border-stone-300 px-3 py-2" placeholder="Taj Mahal entry ticket (foreign visitor) | 1300 | 16 | yes | each"></textarea>
      <p class="text-xs text-stone-500 mt-1">Add "| yes" as a 4th segment to bundle it into the price by default (backlog 0.3).</p>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Guide language</label>
      <input name="guideLanguage" value="English" class="w-full rounded border border-stone-300 px-3 py-2" />
    </div>
    <label class="flex items-center gap-2">
      <input type="checkbox" name="pickupIncluded" />
      Hotel pickup included
    </label>
    <label class="flex items-center gap-2">
      <input type="checkbox" name="privateTour" />
      Private tour (not a shared/group tour)
    </label>
    <label class="flex items-center gap-2">
      <input type="checkbox" name="featured" />
      Featured on homepage
    </label>
    <button type="submit" class="rounded bg-amber-800 text-white px-4 py-2">Create tour</button>
  </form>
</AdminLayout>

<script>
  import { attachImageOptimizer } from '../../../lib/imageOptimizeClient';
  const input = document.getElementById('imageFile') as HTMLInputElement | null;
  const status = document.getElementById('imageOptimizeStatus');
  if (input) attachImageOptimizer(input, status);
</script>
