---
export const prerender = false;

import EmptyState from '../../../components/EmptyState.astro';
import PageHeader from '../../../components/PageHeader.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { listTours, setTourStatus } from '../../../lib/tours';
import { resolveFromPrice } from '../../../lib/currency';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}

const db = env.DB;

if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  const id = String(form.get('tourId') ?? '');
  const status = String(form.get('status') ?? '') as 'published' | 'draft';
  if (id && (status === 'published' || status === 'draft')) {
    await setTourStatus(db, id, status);
  }
  return Astro.redirect('/admin/tours');
}

const tours = db ? await listTours(db) : [];

// The same "From" price the tour cards show customers (lowest group-size
// rate when the tour has tiers), plus USD when the tour has a USD price.
const fromPrice = (t: (typeof tours)[number]) => {
  const inr = resolveFromPrice(t, 'INR');
  const usd = t.usdAmount != null ? resolveFromPrice(t, 'USD') : null;
  return `₹${inr.amount.toLocaleString('en-IN')}` + (usd ? ` · $${usd.amount.toLocaleString('en-US')}` : '');
};
const statusTone = (status: string) => (status === 'published' ? 'ok' : 'muted');
const cardBtn = 'inline-flex min-h-11 items-center justify-center rounded border border-violet-200 bg-white px-3 text-sm text-stone-800';
---
<AdminLayout title="Tours">
  <PageHeader title="Tours" count={tours.length} href="/admin/tours/new" action="+ New Tour" />

  {tours.length === 0 ? (
    <EmptyState message="No tours yet" hint="A tour appears on the site once it is published." href="/admin/tours/new" action="+ New Tour" />
  ) : (
    <>
    <!-- Phones: one card per tour with full-size actions. -->
    <ul class="md:hidden space-y-3">
      {tours.map((t) => (
        <li class="rounded-xl border border-violet-100 bg-white p-4 text-sm">
          <div class="flex items-start justify-between gap-3">
            <a href={`/admin/tours/${t.id}/edit`} class="font-semibold text-base text-stone-900">{t.title}</a>
            <StatusBadge tone={statusTone(t.status)}>{t.status}</StatusBadge>
          </div>
          <p class="mt-1 text-stone-700">
            From {fromPrice(t)} /person
            {t.featured && <span class="ml-1 px-1.5 py-0.5 rounded text-[11px] bg-brand-100 text-brand-700">Featured</span>}
          </p>
          <div class="flex flex-wrap gap-2 mt-3">
            <a href={`/admin/tours/${t.id}/edit`} class={cardBtn}>Edit</a>
            {t.status === 'published' && (
              <a href={`/tours/${t.slug}`} target="_blank" rel="noopener" class={cardBtn}>View on site ↗</a>
            )}
            <form method="POST">
              <input type="hidden" name="tourId" value={t.id} />
              <input type="hidden" name="status" value={t.status === 'published' ? 'draft' : 'published'} />
              <button type="submit" class={cardBtn} data-confirm={t.status === 'published' ? `Unpublish "${t.title}"? It will disappear from the website and can't be booked.` : undefined} data-confirm-label="Unpublish">
                {t.status === 'published' ? 'Unpublish' : 'Publish'}
              </button>
            </form>
          </div>
        </li>
      ))}
    </ul>
    <div class="hidden md:block bg-white rounded-xl border border-violet-100 overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-stone-50 text-left">
          <tr>
            <th class="px-4 py-2">Title</th>
            <th class="px-4 py-2">Price</th>
            <th class="px-4 py-2">Featured</th>
            <th class="px-4 py-2">Status</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody>
          {tours.map((t) => (
            <tr class="border-t border-stone-100">
              <td class="px-4 py-2">
                <a href={`/admin/tours/${t.id}/edit`} class="text-brand-700 hover:underline">{t.title}</a>
              </td>
              <td class="px-4 py-2 whitespace-nowrap">From {fromPrice(t)}</td>
              <td class="px-4 py-2">{t.featured ? 'Yes' : '—'}</td>
              <td class="px-4 py-2">
                <StatusBadge tone={statusTone(t.status)}>{t.status}</StatusBadge>
              </td>
              <td class="px-4 py-2 flex items-center gap-3">
                <a href={`/admin/tours/${t.id}/edit`} class="text-stone-500 hover:underline">Edit</a>
                <form method="POST">
                  <input type="hidden" name="tourId" value={t.id} />
                  <input type="hidden" name="status" value={t.status === 'published' ? 'draft' : 'published'} />
                  <button type="submit" class="text-stone-500 hover:underline" data-confirm={t.status === 'published' ? `Unpublish "${t.title}"? It will disappear from the website and can't be booked.` : undefined} data-confirm-label="Unpublish">
                    {t.status === 'published' ? 'Unpublish' : 'Publish'}
                  </button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    </>
  )}
</AdminLayout>
