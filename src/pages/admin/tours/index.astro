---
export const prerender = false;

import EmptyState from '../../../components/EmptyState.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { setFlash } from '../../../lib/flash';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { listTours, setTourStatus } from '../../../lib/tours';
import { loadTourStats, listingHealth, ratingLabel, SALES_DAYS, type TourStats } from '../../../lib/toursAdmin';
import { resolveFromPrice } from '../../../lib/currency';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}

const db = env.DB;

if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  const id = String(form.get('tourId') ?? '');
  const status = String(form.get('status') ?? '') as 'published' | 'draft';
  if (id && (status === 'published' || status === 'draft')) {
    await setTourStatus(db, id, status);
    setFlash(Astro.cookies, status === 'published' ? 'published' : 'unpublished');
  }
  return Astro.redirect('/admin/tours');
}

const [tours, stats] = db
  ? await Promise.all([listTours(db), loadTourStats(db).catch((err) => { console.error('admin tours: stats failed', err instanceof Error ? err.message : 'error'); return null as Map<string, TourStats> | null; })])
  : [[], null as Map<string, TourStats> | null];

// The same "From" price the tour cards show customers (lowest group-size
// rate when the tour has tiers), plus USD when the tour has a USD price.
const fromPrice = (t: (typeof tours)[number]) => {
  const inr = resolveFromPrice(t, 'INR');
  const usd = t.usdAmount != null ? resolveFromPrice(t, 'USD') : null;
  return `₹${inr.amount.toLocaleString('en-IN')}` + (usd ? ` · $${usd.amount.toLocaleString('en-US')}` : '');
};
const statusTone = (status: string) => (status === 'published' ? 'ok' : 'muted');
const cardBtn = 'inline-flex min-h-11 items-center justify-center rounded border border-violet-200 bg-white px-3 text-sm text-stone-800';
const none: TourStats = { bookings: 0, guests: 0, reviews: 0, rating: null };
const statOf = (id: string) => stats?.get(id) ?? none;
const published = tours.filter((t) => t.status === 'published');
const drafts = tours.length - published.length;
const featured = tours.filter((t) => t.featured).length;
const health = new Map(tours.map((t) => [t.id, listingHealth(t)]));
const incomplete = published.filter((t) => (health.get(t.id)?.missing.length ?? 0) > 0);
const ranked = [...tours].sort((a, b) => statOf(b.id).bookings - statOf(a.id).bookings || a.title.localeCompare(b.title));
const bookingsMax = Math.max(1, ...tours.map((t) => statOf(t.id).bookings));
const soldTotal = tours.reduce((t, x) => t + statOf(x.id).bookings, 0);
const tiles = [
  { label: 'Published', n: published.length, hint: 'Live on the website and bookable.', tone: 'success' },
  { label: 'Drafts', n: drafts, hint: 'Hidden until you publish them.', tone: drafts ? 'info' : 'brand' },
  { label: 'Featured', n: featured, hint: 'Shown first on the tour pages.', tone: 'brand' },
  { label: 'Listings to finish', n: incomplete.length, hint: incomplete.length ? 'Published tours missing a photo, text or price.' : '✓ Every published tour is complete.', tone: incomplete.length ? 'danger' : 'success' },
] as const;
---
<AdminLayout title="Tours">
  <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-semibold">Tours</h1>
      <p class="text-sm text-stone-600">{tours.length} {tours.length === 1 ? 'tour' : 'tours'} · {published.length} live{soldTotal ? ` · ${soldTotal} ${soldTotal === 1 ? 'booking' : 'bookings'} in the last ${SALES_DAYS} days` : ''}</p>
    </div>
    <a href="/admin/tours/new" class="btn-primary inline-flex min-h-11 items-center rounded px-4 text-sm text-white">+ New Tour</a>
  </div>

  {tours.length === 0 ? (
    <EmptyState message="No tours yet" hint="A tour appears on the site once it is published." href="/admin/tours/new" action="+ New Tour" />
  ) : (
    <>
    <section aria-label="Overview" class="mb-6">
      <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
        {tiles.map((t) => (
          <div class={`rounded-xl border p-4 tint-${t.tone}`}>
            <span class="block text-4xl font-semibold leading-none text-stone-900">{t.n}</span>
            <span class="mt-2 block font-medium text-stone-800">{t.label}</span>
            <span class="block text-xs text-stone-600">{t.hint}</span>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="selling" class="mb-6 rounded-xl border border-violet-100 bg-white p-4">
      <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="selling" class="text-lg font-semibold">How each tour is selling</h2>
        <p class="text-sm text-stone-600">Bookings in the last {SALES_DAYS} days. Pick a tour to see them.</p>
      </div>
      {!stats ? (
        <p class="notice notice-warn" role="alert">Could not load the booking counts. Try again in a moment.</p>
      ) : (
        <ul class="space-y-2.5">
          {ranked.map((t) => {
            const st = statOf(t.id);
            return (
              <li>
                <a href={`/admin?view=all&q=${encodeURIComponent(t.title)}`} data-tip={`${t.title}: ${st.bookings} ${st.bookings === 1 ? 'booking' : 'bookings'}, ${st.guests} ${st.guests === 1 ? 'guest' : 'guests'}${st.rating !== null ? `, rated ${ratingLabel(st.rating)} from ${st.reviews} ${st.reviews === 1 ? 'review' : 'reviews'}` : ''}`} class="block rounded-md px-1 py-0.5 hover:bg-violet-50">
                  <span class="flex items-center justify-between gap-3 text-sm">
                    <span class={`truncate ${t.status === 'published' ? 'text-stone-900' : 'text-stone-600'}`}>{t.title}{t.status !== 'published' && <span class="badge-neutral ml-2 rounded-full px-2 py-0.5 text-[11px] font-medium">Draft</span>}</span>
                    <span class="shrink-0 text-stone-700">
                      {st.rating !== null && <span class="mr-3"><span aria-hidden="true" class="text-amber-500">★</span> <span class="font-semibold text-stone-900">{ratingLabel(st.rating)}</span> <span class="text-xs">({st.reviews})</span></span>}
                      <span class="font-semibold text-stone-900">{st.bookings}</span> <span class="text-xs">{st.bookings === 1 ? 'booking' : 'bookings'} · {st.guests} {st.guests === 1 ? 'guest' : 'guests'}</span>
                    </span>
                  </span>
                  <span class="mt-1 block h-2.5 rounded-full bg-stone-100" aria-hidden="true"><span class="block h-full rounded-full bg-violet-500" style={`width:${st.bookings === 0 ? 0 : Math.max(4, Math.round((st.bookings / bookingsMax) * 100))}%`}></span></span>
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </section>

    <h2 class="mb-3 text-lg font-semibold">All tours</h2>
    <ul class="grid gap-3 lg:grid-cols-2">
      {tours.map((t) => {
        const h = health.get(t.id)!;
        const st = statOf(t.id);
        return (
          <li class={`rounded-xl border border-l-4 border-violet-100 bg-white p-4 text-sm transition hover:shadow-md ${t.status === 'published' ? 'border-l-emerald-500' : 'border-l-stone-300'}`}>
            <div class="flex gap-3">
              {t.image ? <img src={t.image} alt="" loading="lazy" width="72" height="72" class="h-[72px] w-[72px] shrink-0 rounded-lg object-cover" /> : <span class="flex h-[72px] w-[72px] shrink-0 items-center justify-center rounded-lg badge-neutral text-xs" aria-hidden="true">No photo</span>}
              <div class="min-w-0 flex-1">
                <div class="flex items-start justify-between gap-3">
                  <a href={`/admin/tours/${t.id}/edit`} class="text-base font-semibold text-stone-900 hover:underline">{t.title}</a>
                  <StatusBadge tone={statusTone(t.status)}>{t.status}</StatusBadge>
                </div>
                <p class="mt-0.5 text-stone-700">
                  From {fromPrice(t)} /person
                  {t.featured && <span class="badge-brand ml-1 rounded-full px-2 py-0.5 text-[11px] font-medium">Featured</span>}
                </p>
                <p class="mt-0.5 text-xs text-stone-600">
                  {st.bookings} {st.bookings === 1 ? 'booking' : 'bookings'} in {SALES_DAYS} days{st.rating !== null && <> · <span aria-hidden="true" class="text-amber-500">★</span> {ratingLabel(st.rating)} ({st.reviews})</>}
                </p>
              </div>
            </div>
            <div class="mt-3 flex items-center gap-2">
              <span class="flex flex-1 gap-1" role="img" aria-label={`Listing ${h.done} of ${h.total} complete`}>
                {Array.from({ length: h.total }, (_, k) => <span class={`h-1.5 flex-1 rounded-full ${k < h.done ? (h.missing.length ? 'bg-orange-400' : 'bg-emerald-500') : 'bg-stone-200'}`}></span>)}
              </span>
              <span class={`text-xs font-medium ${h.missing.length ? 'text-orange-800' : 'text-emerald-800'}`}>{h.missing.length ? `${h.done} of ${h.total} complete` : '✓ Listing complete'}</span>
            </div>
            {h.missing.length > 0 && <p class="mt-1.5">{h.missing.map((m) => <span class="badge-warn mr-1 rounded px-1.5 py-0.5 text-[11px]">Add: {m.toLowerCase()}</span>)}</p>}
            <div class="mt-3 flex flex-wrap gap-2">
              <a href={`/admin/tours/${t.id}/edit`} class={cardBtn} aria-label={`Edit ${t.title}`}>Edit</a>
              {t.status === 'published' && (
                <a href={`/tours/${t.slug}`} target="_blank" rel="noopener" class={cardBtn} aria-label={`View ${t.title} on the site (opens in a new tab)`}>View on site ↗</a>
              )}
              <form method="POST">
                <input type="hidden" name="tourId" value={t.id} />
                <input type="hidden" name="status" value={t.status === 'published' ? 'draft' : 'published'} />
                <button type="submit" class={cardBtn} aria-label={`${t.status === 'published' ? 'Unpublish' : 'Publish'} ${t.title}`} data-confirm={t.status === 'published' ? `Unpublish "${t.title}"? It will disappear from the website and can't be booked.` : undefined} data-confirm-label="Unpublish">
                  {t.status === 'published' ? 'Unpublish' : 'Publish'}
                </button>
              </form>
            </div>
          </li>
        );
      })}
    </ul>
    </>
  )}

  <div id="viz-tip" role="tooltip" hidden class="pointer-events-none fixed z-50 max-w-xs rounded-lg border border-violet-200 bg-white px-3 py-2 text-xs text-stone-800 shadow-lg"></div>
</AdminLayout>

<script is:inline>
  (function () {
    // One tooltip for the selling bars. The text is set with textContent, never as HTML.
    var tip = document.getElementById('viz-tip');
    if (!tip) return;
    document.querySelectorAll('[data-tip]').forEach(function (el) {
      var show = function (x, y) {
        tip.textContent = el.getAttribute('data-tip');
        tip.hidden = false;
        var w = tip.offsetWidth, h = tip.offsetHeight;
        tip.style.left = Math.max(8, Math.min(window.innerWidth - w - 8, x + 12)) + 'px';
        tip.style.top = Math.max(8, Math.min(window.innerHeight - h - 8, y - h - 12)) + 'px';
      };
      el.addEventListener('pointermove', function (e) { show(e.clientX, e.clientY); });
      el.addEventListener('focus', function () { var b = el.getBoundingClientRect(); show(b.left + b.width / 2, b.top); });
      el.addEventListener('pointerleave', function () { tip.hidden = true; });
      el.addEventListener('blur', function () { tip.hidden = true; });
    });
  })();
</script>
