---
export const prerender = false;

import EmptyState from '../../../components/EmptyState.astro';
import PageHeader from '../../../components/PageHeader.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { setFlash } from '../../../lib/flash';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { listBlogPosts, updateBlogPost, getBlogPostById, deleteBlogPost } from '../../../lib/blog';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}

const db = env.DB;

if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  const id = String(form.get('postId') ?? '');
  const action = String(form.get('_action') ?? '');

  if (id && action === 'delete') {
    await deleteBlogPost(db, id);
    setFlash(Astro.cookies, 'deleted');
  } else if (id) {
    const status = String(form.get('status') ?? '') as 'published' | 'draft';
    const existing = await getBlogPostById(db, id);
    if (existing && (status === 'published' || status === 'draft')) {
      await updateBlogPost(db, id, {
        title: existing.title,
        description: existing.description,
        body: existing.body,
        category: existing.category,
        authorName: existing.authorName,
        image: existing.image ?? '',
        imageThumb: existing.imageThumb ?? '',
        imageIsIllustration: existing.imageIsIllustration,
        status,
      });
      setFlash(Astro.cookies, status === 'published' ? 'published' : 'unpublished');
    }
  }
  return Astro.redirect('/admin/blog');
}

const posts = db ? await listBlogPosts(db) : [];
---
<AdminLayout title="Blog">
  <PageHeader title="Blog" count={posts.length} href="/admin/blog/new" action="+ New post" />

  {posts.length === 0 ? (
    <EmptyState message="No blog posts yet" hint="Posts you publish show on the blog and in search." href="/admin/blog/new" action="+ New post" />
  ) : (
    <div class="bg-white rounded-xl border border-violet-100 overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-stone-50 text-left">
          <tr>
            <th class="px-4 py-2">Title</th>
            <th class="px-4 py-2">Category</th>
            <th class="px-4 py-2">Status</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody>
          {posts.map((p) => (
            <tr class="border-t border-stone-100">
              <td class="px-4 py-2">
                <a href={`/admin/blog/${p.id}/edit`} class="text-brand-700 hover:underline">{p.title}</a>
              </td>
              <td class="px-4 py-2 text-stone-600">{p.category}</td>
              <td class="px-4 py-2">
                <StatusBadge tone={p.status === 'published' ? 'ok' : 'muted'}>{p.status}</StatusBadge>
              </td>
              <td class="px-4 py-2 flex items-center gap-3">
                <a href={`/admin/blog/${p.id}/edit`} class="text-stone-500 hover:underline" aria-label={`Edit ${p.title}`}>Edit</a>
                <form method="POST">
                  <input type="hidden" name="postId" value={p.id} />
                  <input type="hidden" name="status" value={p.status === 'published' ? 'draft' : 'published'} />
                  <button type="submit" class="text-stone-500 hover:underline" aria-label={`${p.status === 'published' ? 'Unpublish' : 'Publish'} ${p.title}`} data-confirm={p.status === 'published' ? `Unpublish "${p.title}"? It will disappear from the blog and can't be found in search.` : undefined} data-confirm-label="Unpublish">
                    {p.status === 'published' ? 'Unpublish' : 'Publish'}
                  </button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</AdminLayout>
