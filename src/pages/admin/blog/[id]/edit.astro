---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../../lib/env';
import { isAdminAuthenticated } from '../../../../lib/requireAdmin';
import { getBlogPostById, updateBlogPost, deleteBlogPost, type BlogCategory, type BlogStatus } from '../../../../lib/blog';
import { uploadBlogImage } from '../../../../lib/images';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}

const db = env.DB;
const { id } = Astro.params;
if (!db || !id) return Astro.redirect('/admin/blog');

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  if (form.get('_action') === 'delete') {
    await deleteBlogPost(db, id);
    return Astro.redirect('/admin/blog');
  }

  const title = String(form.get('title') ?? '').trim();
  const description = String(form.get('description') ?? '').trim();
  const body = String(form.get('body') ?? '');
  const category = String(form.get('category') ?? 'news') as BlogCategory;
  const authorName = String(form.get('authorName') ?? 'IWIS Global').trim() || 'IWIS Global';
  const status = String(form.get('status') ?? 'draft') as BlogStatus;

  if (!title || !description) {
    error = 'Title and description are required.';
  } else {
    try {
      const imageFile = form.get('imageFile');
      const existing = await getBlogPostById(db, id);
      let image = String(form.get('image') ?? '').trim() || existing?.image || '';
      // The small list copy only matches the cover it was made from.
      let imageThumb = image === existing?.image ? existing?.imageThumb ?? '' : '';
      if (imageFile instanceof File && imageFile.size > 0) {
        if (!env.IMAGES) throw new Error('Image storage is not configured yet.');
        const thumbFile = form.get('imageThumb');
        const uploaded = await uploadBlogImage(env.IMAGES, imageFile, thumbFile instanceof File ? thumbFile : null);
        image = uploaded.url;
        imageThumb = uploaded.thumbUrl;
      }

      const imageIsIllustration = form.get('imageIsIllustration') === 'on';
      await updateBlogPost(db, id, { title, description, body, category, authorName, image, imageThumb, imageIsIllustration, status });
      return Astro.redirect('/admin/blog');
    } catch (err: any) {
      error = err?.message || 'Failed to update post.';
    }
  }
}

const post = await getBlogPostById(db, id);
if (!post) return Astro.redirect('/admin/blog');
---
<AdminLayout title={`Edit ${post.title}`}>
  <a href="/admin/blog" class="text-sm text-stone-500 hover:underline">&larr; Back to blog</a>
  <div class="flex items-center justify-between gap-4 mt-2 mb-6">
    <h1 class="text-2xl font-semibold">Edit post</h1>
    {post.status === 'published' && (
      <a href={`/blog/${post.slug}`} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center rounded border border-violet-200 bg-white px-4 text-sm text-brand-700 hover:underline">View post ↗</a>
    )}
  </div>

  {error && <p class="text-red-600 text-sm mb-4">{error}</p>}

  <form method="POST" enctype="multipart/form-data" class="bg-white rounded-xl border border-violet-100 p-6 space-y-4 max-w-2xl text-sm">
    <div>
      <label class="block text-stone-500 mb-1">Title *</label>
      <input name="title" required value={post.title} class="w-full rounded border border-violet-200 px-3 py-2" />
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Description</label>
      <textarea name="description" required rows="2" class="w-full rounded border border-violet-200 px-3 py-2">{post.description}</textarea>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-stone-500 mb-1">Category</label>
        <select name="category" class="w-full rounded border border-violet-200 px-3 py-2">
          <option value="news" selected={post.category === 'news'}>News</option>
          <option value="travel-tips" selected={post.category === 'travel-tips'}>Travel Tips</option>
          <option value="seasonal" selected={post.category === 'seasonal'}>Seasonal</option>
        </select>
      </div>
      <div>
        <label class="block text-stone-500 mb-1">Status</label>
        <select name="status" class="w-full rounded border border-violet-200 px-3 py-2">
          <option value="draft" selected={post.status === 'draft'}>Draft (not visible on the site)</option>
          <option value="published" selected={post.status === 'published'}>Published (live immediately)</option>
        </select>
      </div>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Author name</label>
      <input name="authorName" value={post.authorName} class="w-full rounded border border-violet-200 px-3 py-2" />
    </div>
    {post.image && (
      <div>
        <label class="block text-stone-500 mb-1">Current image</label>
        <img src={post.image} alt={post.title} class="w-48 aspect-[4/3] object-cover rounded border border-violet-100" />
      </div>
    )}
    <div>
      <label class="block text-stone-500 mb-1">Upload new image (replaces current)</label>
      <input id="imageFile" type="file" name="imageFile" accept="image/jpeg,image/png,image/webp,image/gif" class="w-full text-sm" />
      <p class="text-xs text-stone-500 mt-1">JPEG/PNG/WebP/GIF, up to 5MB. Leave blank to keep the current image.</p>
      <p id="imageOptimizeStatus" class="text-xs text-emerald-700 mt-1"></p>
      <input id="imageThumb" type="file" name="imageThumb" hidden />
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Image URL (only used if no new file is uploaded above)</label>
      <input name="image" value={post.image ?? ''} class="w-full rounded border border-violet-200 px-3 py-2" />
      <label class="flex items-start gap-2 min-h-11 py-2">
        <input type="checkbox" name="imageIsIllustration" checked={post.imageIsIllustration} class="mt-1" />
        <span>Cover is an illustration (AI-generated or artwork), not a real photo — the site labels it "Illustration".</span>
      </label>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Body (Markdown)</label>
      <textarea name="body" rows="14" class="w-full rounded border border-violet-200 px-3 py-2 md:font-mono md:text-xs">{post.body}</textarea>
    </div>
    <!-- Phones: pinned to the bottom of the screen while scrolling the form. -->
    <div class="sticky bottom-0 -mx-6 -mb-6 px-6 py-3 bg-white/95 border-t border-violet-100 md:static md:m-0 md:p-0 md:bg-transparent md:border-0">
      <button type="submit" class="w-full md:w-auto min-h-11 rounded btn-primary text-white px-4 py-2">Save changes</button>
    </div>
  </form>

  <form method="POST" class="mt-4 max-w-2xl">
    <input type="hidden" name="_action" value="delete" />
    <button type="submit" class="text-sm text-red-600 hover:underline" data-confirm="delete">Delete this post</button>
  </form>
</AdminLayout>

<script>
  import { attachImageOptimizer } from '../../../../lib/imageOptimizeClient';

  document.querySelectorAll<HTMLButtonElement>('[data-confirm="delete"]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      if (!confirm('Delete this post? This cannot be undone.')) e.preventDefault();
    });
  });

  const input = document.getElementById('imageFile') as HTMLInputElement | null;
  const status = document.getElementById('imageOptimizeStatus');
  if (input) attachImageOptimizer(input, status, document.getElementById('imageThumb') as HTMLInputElement | null);
</script>
