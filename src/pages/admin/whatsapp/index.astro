---
// WhatsApp: the chats the webhook has stored (src/pages/api/webhooks/whatsapp.ts)
// and, under each guest message, the drafted reply (src/lib/waDraft.ts). Staff
// read the draft, edit it, and press Send, or discard it. Nothing is ever sent
// without that press, and the auto-reply switch is Off.
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { formatDateTimeIst } from '../../../lib/format';
import type { D1Like } from '../../../lib/db';
import { sendDraft, discardDraft, type DraftRow } from '../../../lib/waDraft';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET))) {
  return Astro.redirect('/admin/login');
}

interface Conversation { id: string; profile_name: string | null; state: string; last_message_at: string }
interface Message { wa_message_id: string; direction: string; kind: string; body: string; status: string; sent_at: string }

const db = env.DB as D1Like | undefined;

if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  const conversation = String(form.get('c') ?? '');
  const draftId = Number(form.get('draftId'));
  let error = '';
  if (form.get('_action') === 'send') {
    const result = await sendDraft(env, db, draftId, String(form.get('text') ?? ''));
    if (!result.ok) error = result.error ?? 'Could not send.';
  } else if (form.get('_action') === 'discard') {
    await discardDraft(db, draftId);
  }
  const query = new URLSearchParams({ c: conversation });
  if (error) query.set('err', error);
  return Astro.redirect(`/admin/whatsapp?${query}`);
}

const conversations = db
  ? (await db.prepare(`SELECT id, profile_name, state, last_message_at FROM wa_conversations ORDER BY last_message_at DESC LIMIT 100`).bind().all<Conversation>()).results
  : [];
const selectedId = Astro.url.searchParams.get('c') ?? conversations[0]?.id ?? '';
const messages = db && selectedId
  ? (await db.prepare(`SELECT wa_message_id, direction, kind, body, status, sent_at FROM wa_messages WHERE conversation_id = ? ORDER BY sent_at ASC LIMIT 200`).bind(selectedId).all<Message>()).results
  : [];
const drafts = new Map<string, DraftRow>(
  db && selectedId
    ? (await db.prepare(`SELECT * FROM wa_drafts WHERE conversation_id = ? ORDER BY id ASC`).bind(selectedId).all<DraftRow>()).results.map((d) => [d.message_id, d])
    : []
);
const autoReply = db
  ? (await db.prepare(`SELECT value FROM wa_settings WHERE key = 'auto_reply'`).bind().first<{ value: string }>())?.value ?? 'off'
  : 'off';
const error = Astro.url.searchParams.get('err');
const selected = conversations.find((c) => c.id === selectedId);
const who = (c: Conversation) => c.profile_name || `+${c.id}`;
const directionLabel: Record<string, string> = { in: 'Guest', out: 'Sent from the site', echo: 'Staff (app)' };
const reasonLabel: Record<string, string> = {
  handoff: 'Needs a person: money, complaint, booking change or similar',
  no_knowledge: 'Needs a person: no approved answer for this',
  price_mismatch: 'Needs a person: the draft quotes a price that is not in the catalogue',
  unsupported: 'Needs a person: not a text message',
  format: 'Needs a person: the draft was not in the expected format, check it carefully',
  no_booking: 'Needs a person: no booking found under this WhatsApp number',
  cap: 'No draft: daily limit reached',
  no_api_key: 'No draft: the AI key is not set',
  error: 'No draft: something went wrong',
};
// The lookups a draft relied on (src/lib/waTools.ts), shown so staff can see them.
const toolLog = (d: DraftRow): { name: string; result: string }[] => {
  try {
    const parsed = JSON.parse(d.tools);
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
};
// A staff reply (from the app or the site) after this guest message makes the draft stale.
const repliedAfter = (m: Message) => messages.some((x) => x.direction !== 'in' && x.sent_at > m.sent_at);
---
<AdminLayout title="WhatsApp">
  <h1 class="text-2xl font-semibold mb-2">WhatsApp</h1>
  <p class="text-stone-500 text-sm mb-1">
    Every message on the business number, with a drafted reply under each guest message. Nothing is sent until you press Send.
  </p>
  <p class="text-sm mb-6">
    Automatic replies:
    <span class={`ml-1 rounded px-2 py-0.5 text-xs font-medium ${autoReply === 'on' ? 'bg-green-100 text-green-800' : 'bg-stone-200 text-stone-700'}`}>{autoReply === 'on' ? 'On' : 'Off'}</span>
    <a href="/admin/whatsapp/knowledge" class="ml-4 text-brand-800 hover:underline">Knowledge base</a>
  </p>
  {error && <p class="mb-4 rounded-xl bg-red-50 p-3 text-sm text-red-700" role="alert">{error}</p>}

  {conversations.length === 0 ? (
    <p class="text-stone-500">No messages yet. Once the webhook is connected in Meta, chats appear here.</p>
  ) : (
    <div class="grid gap-6 md:grid-cols-[18rem_1fr]">
      <ul class="space-y-2" aria-label="Conversations">
        {conversations.map((c) => (
          <li>
            <a
              href={`/admin/whatsapp?c=${c.id}`}
              aria-current={c.id === selectedId ? 'page' : undefined}
              class={`block rounded-xl border p-3 text-sm ${c.id === selectedId ? 'border-brand-700 bg-violet-50' : 'border-stone-200 bg-white hover:bg-stone-50'}`}
            >
              <span class="block font-semibold">{who(c)}</span>
              <span class="block text-stone-500">+{c.id}</span>
              <span class="block text-xs text-stone-400">{formatDateTimeIst(c.last_message_at)}</span>
            </a>
          </li>
        ))}
      </ul>

      <section aria-label="Messages">
        {selected && <h2 class="text-lg font-semibold mb-3">{who(selected)} <span class="text-sm font-normal text-stone-500">· {selected.state}</span></h2>}
        <ul class="space-y-3">
          {messages.map((m) => {
            const draft = drafts.get(m.wa_message_id);
            const open = draft && draft.status === 'draft' && !repliedAfter(m);
            return (
              <li>
                <div class={`max-w-xl rounded-xl p-3 text-sm ${m.direction === 'in' ? 'bg-white border border-stone-200' : 'ml-auto bg-violet-100'}`}>
                  <p class="text-xs text-stone-500 mb-1">{directionLabel[m.direction] ?? m.direction} · {formatDateTimeIst(m.sent_at)}{m.direction !== 'in' && ` · ${m.status}`}</p>
                  <p class="whitespace-pre-line break-words">{m.body || `[${m.kind}]`}</p>
                </div>
                {open && (
                  <form method="POST" class="mt-2 max-w-xl rounded-xl border border-violet-200 bg-violet-50 p-3 text-sm">
                    <input type="hidden" name="c" value={selectedId} />
                    <input type="hidden" name="draftId" value={draft.id} />
                    <p class="mb-2 text-xs text-stone-600">
                      Draft · {draft.intent || 'unlabelled'}{draft.language && ` · ${draft.language}`}{draft.body && ` · confidence ${Math.round(draft.confidence * 100)}%`}
                    </p>
                    {draft.reason && <p class="mb-2 rounded bg-amber-100 px-2 py-1 text-xs text-amber-900">{reasonLabel[draft.reason] ?? 'Needs a person'}</p>}
                    {toolLog(draft).map((t) => (
                      <p class="mb-1 text-xs text-stone-600"><span class="font-medium">Checked {t.name.replace('_', ' ')}:</span> {t.result.split('\n')[0]}</p>
                    ))}
                    <label class="sr-only" for={`draft-${draft.id}`}>Reply to send</label>
                    <textarea id={`draft-${draft.id}`} name="text" rows="4" class="w-full rounded-lg border border-stone-300 bg-white p-2" placeholder="Write a reply">{draft.body}</textarea>
                    <div class="mt-2 flex flex-wrap gap-2">
                      <button type="submit" name="_action" value="send" class="min-h-11 rounded bg-emerald-600 px-4 text-sm font-medium text-white">Send</button>
                      <button type="submit" name="_action" value="discard" formnovalidate class="min-h-11 rounded border border-stone-300 bg-white px-4 text-sm font-medium text-stone-700">Discard</button>
                    </div>
                  </form>
                )}
                {draft && !open && (
                  <p class="mt-1 max-w-xl text-xs text-stone-400">
                    {draft.status === 'sent' ? 'Draft sent.' : draft.status === 'discarded' ? 'Draft discarded.' : draft.status === 'sending' ? 'Sending…' : 'Draft not shown: someone already replied.'}
                  </p>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    </div>
  )}
</AdminLayout>
