                      </p>
                    )}
                    {toolLog(draft).map((t) => (
                      <p class="mb-1 text-xs text-stone-600"><span class="font-medium">Checked {t.name.replace('_', ' ')}:</span> {t.result.split('\n')[0]}</p>
                    ))}
                    <label class="sr-only" for={`draft-${draft.id}`}>Reply to send</label>
                    <textarea id={`draft-${draft.id}`} name="text" rows="4" class="w-full rounded-lg border border-violet-200 bg-white p-2" placeholder="Write a reply">{draft.body}</textarea>
                    <p class="mt-1 flex flex-wrap items-center gap-1 text-xs text-stone-500">Add email signup link:{SIGNUP_LANGS.map((l) => <button type="button" data-signup-for={`draft-${draft.id}`} data-signup-text={signupMessage(l)} class="min-h-8 rounded border border-violet-200 bg-white px-2 uppercase text-stone-700">{l}</button>)}</p>
                    <div class="mt-2 flex flex-wrap gap-2">
                      <button type="submit" name="_action" value="send" class="min-h-11 rounded bg-emerald-700 px-4 text-sm font-medium text-white">Send</button>
                      <button type="submit" name="_action" value="discard" formnovalidate class="min-h-11 rounded border border-violet-200 bg-white px-4 text-sm font-medium text-stone-700">Discard</button>
                    </div>
                  </form>
                )}
                {draft && !open && (
                  <p class="mt-1 max-w-xl text-xs text-stone-600">
                    {draft.status === 'sent' ? (draft.sent_by === 'auto' ? 'Sent automatically.' : 'Draft sent.') : draft.status === 'discarded' ? 'Draft discarded.' : draft.status === 'sending' ? 'Sending…' : 'Draft not shown: someone already replied.'}
                  </p>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    </div>
  )}
</AdminLayout>

{flow && <script type="application/json" id="flow-data" set:html={JSON.stringify(flow)} />}
<div id="viz-tip" role="tooltip" hidden class="pointer-events-none fixed z-50 max-w-xs rounded-lg border border-violet-200 bg-white px-3 py-2 text-xs text-stone-800 shadow-lg"></div>
<style is:global>
  .viz { --s1: #6250d6; --s2: #eb6834; }
  #flow-chart svg { display: block; width: 100%; height: auto; }
  #flow-chart .hit { fill: transparent; cursor: pointer; }
  #flow-chart .hit:hover { fill: #6250d6; fill-opacity: 0.07; }
  @media (prefers-reduced-motion: no-preference) {
    #flow-chart .col { transform-origin: bottom; transform-box: fill-box; animation: wa-grow 0.45s ease-out both; }
    @keyframes wa-grow { from { transform: scaleY(0.1); opacity: 0.4; } to { transform: scaleY(1); opacity: 1; } }
  }
</style>
<script is:inline>
  (function () {
    // Messages per day: grouped columns (guests violet, us orange) from the 14 days in the page, with a hover readout.
    var holder = document.getElementById('flow-chart');
    var dataEl = document.getElementById('flow-data');
    var tip = document.getElementById('viz-tip');
    if (!holder || !dataEl || !tip) return;
    var days = JSON.parse(dataEl.textContent);
    var NS = 'http://www.w3.org/2000/svg', C1 = '#6250d6', C2 = '#eb6834';
    var el = function (name, attrs, parent) { var n = document.createElementNS(NS, name); for (var k in attrs) n.setAttribute(k, attrs[k]); if (parent) parent.appendChild(n); return n; };
    var fmt = function (ymd) { return new Date(ymd + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }); };
    var longFmt = function (ymd) { return new Date(ymd + 'T00:00:00Z').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }); };
    var bar = function (x, y, w, h) { var r = Math.min(4, w / 2, h); return 'M' + x + ',' + (y + h) + 'V' + (y + r) + 'Q' + x + ',' + y + ' ' + (x + r) + ',' + y + 'H' + (x + w - r) + 'Q' + (x + w) + ',' + y + ' ' + (x + w) + ',' + (y + r) + 'V' + (y + h) + 'Z'; };
    var W = 640, H = 220, L = 30, R = 6, T = 10, B = 26;
    var max = Math.max(3, Math.max.apply(null, days.map(function (r) { return Math.max(r.guest, r.ours); })));
    var top = max <= 4 ? max : Math.ceil(max / 2) * 2;
    var y = function (v) { return T + (H - T - B) * (1 - v / top); };
    var gw = (W - L - R) / days.length, bw = Math.min(16, gw * 0.34);
    var svg = el('svg', { viewBox: '0 0 ' + W + ' ' + H, role: 'img', 'aria-label': 'Messages per day over the last ' + days.length + ' days, from guests and from us. The same numbers are in the table below.' }, holder);
    [0, top / 2, top].forEach(function (v) {
      el('line', { x1: L, x2: W - R, y1: y(v), y2: y(v), stroke: v === 0 ? '#a8a29e' : '#e7e5e4', 'stroke-width': 1 }, svg);
      var t = el('text', { x: L - 6, y: y(v) + 4, 'text-anchor': 'end', 'font-size': 11, fill: '#57534e' }, svg); t.textContent = Math.round(v);
    });
    days.forEach(function (r, i) {
      var gx = L + gw * i, cx = gx + gw / 2, g = el('g', {}, svg);
      var hit = el('rect', { class: 'hit', x: gx, y: T, width: gw, height: H - T - B }, g);
      [[r.guest, C1, cx - bw - 1], [r.ours, C2, cx + 1]].forEach(function (s) { if (s[0] > 0) el('path', { class: 'col', d: bar(s[2], y(s[0]), bw, y(0) - y(s[0])), fill: s[1], 'pointer-events': 'none' }, g); });
      if ((days.length - 1 - i) % 2 === 0) { var lab = el('text', { x: cx, y: H - 8, 'text-anchor': 'middle', 'font-size': 11, fill: '#57534e' }, svg); lab.textContent = i === days.length - 1 ? 'Today' : fmt(r.day); }
      hit.addEventListener('pointermove', function (e) {
        tip.textContent = '';
        [{ v: longFmt(r.day) }, { k: C1, v: r.guest, l: r.guest === 1 ? 'message from guests' : 'messages from guests' }, { k: C2, v: r.ours, l: r.ours === 1 ? 'message from us' : 'messages from us' }].forEach(function (l) {
          var p = document.createElement('p');
          if (l.k) { var k = document.createElement('span'); k.style.cssText = 'display:inline-block;width:12px;height:3px;border-radius:2px;margin-right:6px;vertical-align:middle;background:' + l.k; p.appendChild(k); }
          var v = document.createElement('span'); v.textContent = l.v; v.style.fontWeight = '600'; p.appendChild(v);
          if (l.l) { var t = document.createElement('span'); t.textContent = ' ' + l.l; t.style.color = '#57534e'; p.appendChild(t); }
          tip.appendChild(p);
        });
        tip.hidden = false;
        var w = tip.offsetWidth, h = tip.offsetHeight;
        tip.style.left = Math.max(8, Math.min(window.innerWidth - w - 8, e.clientX + 12)) + 'px';
        tip.style.top = Math.max(8, Math.min(window.innerHeight - h - 8, e.clientY - h - 12)) + 'px';
      });
      hit.addEventListener('pointerleave', function () { tip.hidden = true; });
    });
  })();
</script>
<script>
  // Phone alerts: register the service worker, ask permission, save this device's subscription.
  const box = document.getElementById('push-box');
  if (box) {
    const status = document.getElementById('push-status')!;
    const on = document.getElementById('push-on')!;
    const test = document.getElementById('push-test')!;
    const off = document.getElementById('push-off')!;
    const key = box.dataset.key || '';
    const toBytes = (b64: string) => {
      const bin = atob((b64 + '='.repeat((4 - (b64.length % 4)) % 4)).replace(/-/g, '+').replace(/_/g, '/'));
      return Uint8Array.from(bin, (c) => c.charCodeAt(0));
    };
    const post = (url: string, method: string, body?: unknown) =>
      fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined });
    const show = (text: string, buttons: HTMLElement[]) => {
      status.textContent = text;
      [on, test, off].forEach((b) => b.classList.toggle('hidden', !buttons.includes(b)));
    };
    const standalone = (navigator as any).standalone === true || matchMedia('(display-mode: standalone)').matches;
    const isIos = /iphone|ipad/i.test(navigator.userAgent);

    (async () => {
      if (!key) return show('Not set up yet: the push keys are missing in Cloudflare.', []);
      if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
        return show(isIos && !standalone ? 'On iPhone, first add this page to your Home Screen (Share, then Add to Home Screen) and open it from there.' : 'This browser cannot receive alerts.', []);
      }
      const reg = await navigator.serviceWorker.register('/admin/sw.js', { scope: '/admin/' });
      const existing = await reg.pushManager.getSubscription();
      const refresh = (sub: PushSubscription | null) =>
        sub ? show('Alerts are on for this device. You get one when a guest needs a person.', [test, off]) : show('Alerts are off on this device.', [on]);
      refresh(existing);

      on.onclick = async () => {
        try {
          if ((await Notification.requestPermission()) !== 'granted') return show('Permission was not given. Allow notifications for this app in your phone settings, then try again.', [on]);
          const sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: toBytes(key) });
          const res = await post('/admin/api/push/subscribe', 'POST', sub.toJSON());
          if (!res.ok) throw new Error('save failed');
          refresh(sub);
        } catch {
          show('Could not turn alerts on. Try again.', [on]);
        }
      };
      test.onclick = async () => {
        test.setAttribute('disabled', '');
        const res = await post('/admin/api/push/test', 'POST');
        const data = await res.json().catch(() => ({}));
        test.removeAttribute('disabled');
        status.textContent = res.ok ? (data.sent > 0 ? 'Test alert sent. It should appear on your phone in a few seconds.' : 'The server could not deliver it. Turn alerts off and on again.') : data.error || 'Could not send the test.';
      };
      off.onclick = async () => {
        const sub = await reg.pushManager.getSubscription();
        if (sub) {
          await post('/admin/api/push/subscribe', 'DELETE', { endpoint: sub.endpoint });
          await sub.unsubscribe();
        }
        refresh(null);
      };
    })().catch(() => show('Alerts are not available here.', []));
  }
</script>

<script>
  // Live updates: check every few seconds whether anything changed and reload when it did.
  // A reply being typed is never thrown away: then a banner offers the refresh instead.
  // "Add email signup link": appends the ready-made line (in the chosen language) to the reply being written.
  // Nothing is sent until a person presses Send.
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-signup-for]');
    if (!btn) return;
    const box = document.getElementById(btn.dataset.signupFor ?? '') as HTMLTextAreaElement | null;
    if (!box) return;
    const line = btn.dataset.signupText ?? '';
    if (!box.value.includes(line)) box.value = box.value.trim() ? `${box.value.trimEnd()}\n\n${line}` : line;
    box.focus();
  });

  const live = document.getElementById('live');
  if (live) {
    let known = live.dataset.sig || '';
    const typing = () => Array.from(document.querySelectorAll('main textarea')).some((t) => (t as HTMLTextAreaElement).value.trim() !== '');
    const check = async () => {
      if (document.hidden || !known) return;
      try {
        const res = await fetch('/admin/api/whatsapp/poll', { cache: 'no-store' });
        if (!res.ok) return;
        const { sig } = await res.json();
        if (!sig || sig === known) return;
        if (typing()) {
          live.classList.remove('hidden');
        } else {
          known = sig;
          // Keep the reader's place: stay put if they scrolled down into older messages, follow the
          // chat if they were reading the newest ones at the top.
          const chat = document.getElementById('chat');
          const atNewest = !chat || chat.getBoundingClientRect().top >= -80;
          try { sessionStorage.setItem('waScroll', JSON.stringify({ y: window.scrollY, atNewest })); } catch {}
          location.reload();
        }
      } catch {}
    };
    setInterval(check, 5000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) check(); });
  }
</script>

<script>
  // Open a chat at its newest message (shown first, with the reply box above it):
  // after Send, after switching chats, and after a live refresh while reading the newest messages.
  // A live refresh while the reader was further down in older messages restores that position instead.
  const chat = document.getElementById('chat');
  if (chat && new URLSearchParams(location.search).has('c')) {
    let saved: { y: number; atNewest: boolean } | null = null;
    try {
      saved = JSON.parse(sessionStorage.getItem('waScroll') || 'null');
      sessionStorage.removeItem('waScroll');
    } catch {}
    if (saved && !saved.atNewest) window.scrollTo(0, saved.y);
    else chat.scrollIntoView({ block: 'start' });
  }
</script>
