---
// WhatsApp: the chats the webhook has stored (src/pages/api/webhooks/whatsapp.ts)
// and, under each guest message, the drafted reply (src/lib/waDraft.ts). Staff
// read the draft, edit it, and press Send, or discard it. Nothing is ever sent
// without that press, and the auto-reply switch is Off. The tabs and the Take over /
// Give back buttons come from src/lib/waInbox.ts.
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { formatDateTimeIst } from '../../../lib/format';
import type { D1Like } from '../../../lib/db';
import { sendDraft, sendStaffMessage, sendStaffTemplate, discardDraft, draftWaitingMessage, type DraftRow } from '../../../lib/waDraft';
import { listInbox, inboxCounts, inboxSignature, takeOver, giveBack, formatDuration, WINDOW_MS, type InboxFilter } from '../../../lib/waInbox';
import { auditOverdue } from '../../../lib/waLaunch';
import { WA_TEMPLATES } from '../../../lib/waTemplates';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET))) {
  return Astro.redirect('/admin/login');
}

interface Chat { id: string; profile_name: string | null; state: string; handoff_reason: string }
interface Message { wa_message_id: string; direction: string; kind: string; body: string; status: string; sent_at: string }

const db = env.DB as D1Like | undefined;

if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  const conversation = String(form.get('c') ?? '');
  const draftId = Number(form.get('draftId'));
  let error = '';
  if (form.get('_action') === 'send') {
    const result = await sendDraft(env, db, draftId, String(form.get('text') ?? ''));
    if (!result.ok) error = result.error ?? 'Could not send.';
  } else if (form.get('_action') === 'reply') {
    const result = await sendStaffMessage(env, db, conversation, String(form.get('text') ?? ''));
    if (!result.ok) error = result.error ?? 'Could not send.';
  } else if (form.get('_action') === 'template') {
    const result = await sendStaffTemplate(env, db, conversation, String(form.get('template') ?? ''), String(form.get('guestName') ?? ''));
    if (!result.ok) error = result.error ?? 'Could not send.';
  } else if (form.get('_action') === 'discard') {
    await discardDraft(db, draftId);
  } else if (form.get('_action') === 'takeover') {
    await takeOver(db, conversation);
  } else if (form.get('_action') === 'giveback') {
    await giveBack(db, conversation);
    // Answer what the guest wrote while staff had the chat. Giving back must not fail on this.
    try {
      await draftWaitingMessage(env, db, conversation);
    } catch {
      error = 'Given back, but the waiting message could not be drafted.';
    }
  }
  const query = new URLSearchParams({ c: conversation });
  const postedTab = String(form.get('tab') ?? '');
  if (postedTab) query.set('tab', postedTab);
  if (error) query.set('err', error);
  return Astro.redirect(`/admin/whatsapp?${query}`);
}

const signature = db ? await inboxSignature(db) : '';
const counts = db ? await inboxCounts(db) : {};
const overdue = db ? await auditOverdue(db) : 0;
const waitingForPerson = counts.handed_off ?? 0;
const tabParam = Astro.url.searchParams.get('tab');
const tab: InboxFilter = tabParam === 'attention' || tabParam === 'staff' || tabParam === 'all' ? tabParam : waitingForPerson > 0 ? 'attention' : 'all';
const conversations = db ? await listInbox(db, tab) : [];
// On a phone the list and the open chat are separate screens; ?c= opens the chat.
const chatOpen = Astro.url.searchParams.has('c');
const selectedId = Astro.url.searchParams.get('c') ?? conversations[0]?.id ?? '';
const selected = db && selectedId
  ? await db.prepare(`SELECT id, profile_name, state, handoff_reason FROM wa_conversations WHERE id = ?`).bind(selectedId).first<Chat>()
  : null;
const messages = db && selectedId
  ? (await db.prepare(`SELECT wa_message_id, direction, kind, body, status, sent_at FROM wa_messages WHERE conversation_id = ? ORDER BY sent_at ASC LIMIT 200`).bind(selectedId).all<Message>()).results
  : [];
const drafts = new Map<string, DraftRow>(
  db && selectedId
    ? (await db.prepare(`SELECT * FROM wa_drafts WHERE conversation_id = ? ORDER BY id ASC`).bind(selectedId).all<DraftRow>()).results.map((d) => [d.message_id, d])
    : []
);
const lastGuestAt = messages.filter((m) => m.direction === 'in').map((m) => m.sent_at).sort().pop();
const selectedWindowLeft = lastGuestAt ? WINDOW_MS - (Date.now() - Date.parse(lastGuestAt)) : 0;
const autoReply = db
  ? (await db.prepare(`SELECT value FROM wa_settings WHERE key = 'auto_reply'`).bind().first<{ value: string }>())?.value ?? 'off'
  : 'off';
const error = Astro.url.searchParams.get('err');
const who = (c: { id: string; profile_name: string | null }) => c.profile_name || `+${c.id}`;
const stateLabel: Record<string, { text: string; style: string }> = {
  agent: { text: 'Agent drafting', style: 'bg-stone-200 text-stone-700' },
  handed_off: { text: 'Needs a person', style: 'bg-amber-100 text-amber-900' },
  staff: { text: 'Staff handling', style: 'bg-violet-100 text-violet-800' },
  opted_out: { text: 'Opted out', style: 'bg-red-100 text-red-800' },
};
const tabs: { id: InboxFilter; label: string; count?: number }[] = [
  { id: 'attention', label: 'Needs a person', count: waitingForPerson },
  { id: 'staff', label: 'Staff handling', count: counts.staff ?? 0 },
  { id: 'all', label: 'All' },
];
const toneStyle = { red: 'text-red-700', amber: 'text-amber-700', none: 'text-stone-400' } as const;
const directionLabel: Record<string, string> = { in: 'Guest', out: 'Sent from the site', echo: 'Staff (app)' };
const reasonLabel: Record<string, string> = {
  handoff: 'Needs a person: money, complaint, booking change or similar',
  no_knowledge: 'Needs a person: no approved answer for this',
  price_mismatch: 'Needs a person: the draft quotes a price that is not in the catalogue',
  unsupported: 'Needs a person: not a text message',
  format: 'Needs a person: the draft was not in the expected format, check it carefully',
  no_booking: 'Needs a person: no booking found under this WhatsApp number',
  cap: 'No draft: daily limit reached',
  no_api_key: 'No draft: the AI key is not set',
  error: 'No draft: something went wrong',
};
// The lookups a draft relied on (src/lib/waTools.ts), shown so staff can see them.
const toolLog = (d: DraftRow): { name: string; result: string }[] => {
  try {
    const parsed = JSON.parse(d.tools);
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
};
// A staff reply (from the app or the site) after this guest message makes the draft stale.
const repliedAfter = (m: Message) => messages.some((x) => x.direction !== 'in' && x.sent_at > m.sent_at);
---
<AdminLayout title="WhatsApp">
  <h1 class="text-2xl font-semibold mb-2">WhatsApp</h1>
  <p class="text-stone-500 text-sm mb-1">
    Every message on the business number, with a drafted reply under each guest message. Nothing is sent until you press Send.
  </p>
  <p class="text-sm mb-6">
    Automatic replies:
    <span class={`ml-1 rounded px-2 py-0.5 text-xs font-medium ${autoReply === 'on' ? 'bg-green-100 text-green-800' : 'bg-stone-200 text-stone-700'}`}>{autoReply === 'on' ? 'On' : 'Off'}</span>
    <a href="/admin/whatsapp/auto" class="ml-2 text-brand-800 hover:underline">Settings</a>
    <a href="/admin/whatsapp/launch" class="ml-2 text-brand-800 hover:underline">Launch readiness</a>
    <a href="/admin/whatsapp/knowledge" class="ml-4 text-brand-800 hover:underline">Knowledge base</a>
  </p>
  <div id="push-box" class="mb-6 max-w-xl rounded-xl border border-stone-200 bg-white p-3 text-sm" data-key={env.VAPID_PUBLIC_KEY ?? ''}>
    <p class="font-medium text-stone-800">Phone alerts</p>
    <p id="push-status" class="mt-1 text-stone-600">Checking…</p>
    <div class="mt-2 flex flex-wrap gap-2">
      <button type="button" id="push-on" class="hidden min-h-11 rounded bg-brand-800 px-4 text-sm font-medium text-white">Turn on alerts</button>
      <button type="button" id="push-test" class="hidden min-h-11 rounded border border-stone-300 bg-white px-4 text-sm font-medium text-stone-700">Send test alert</button>
      <button type="button" id="push-off" class="hidden min-h-11 rounded border border-stone-300 bg-white px-4 text-sm font-medium text-stone-700">Turn off</button>
    </div>
  </div>
  {overdue > 0 && (
    <p class="mb-4 rounded-xl bg-amber-50 p-3 text-sm text-amber-900" role="status">
      {overdue} automatic message{overdue === 1 ? ' is' : 's are'} more than a week old and not yet audited.
      <a href="/admin/whatsapp/auto#audit" class="ml-1 font-medium underline">Audit them now</a>
    </p>
  )}
  {error && <p class="mb-4 rounded-xl bg-red-50 p-3 text-sm text-red-700" role="alert">{error}</p>}

  <div id="live" data-sig={signature} class="hidden mb-4 rounded-xl bg-violet-50 p-3 text-sm text-violet-900" role="status">
    New messages arrived. <a href="" class="font-semibold underline">Show them</a>
  </div>
  <nav class="mb-4 flex flex-wrap gap-2" aria-label="Chat filters">
    {tabs.map((t) => (
      <a
        href={`/admin/whatsapp?tab=${t.id}`}
        aria-current={t.id === tab ? 'page' : undefined}
        class={`min-h-11 inline-flex items-center rounded-full px-4 text-sm font-medium ${t.id === tab ? 'bg-brand-800 text-white' : 'border border-stone-300 bg-white text-stone-700 hover:bg-stone-50'}`}
      >
        {t.label}{t.count ? ` (${t.count})` : ''}
      </a>
    ))}
  </nav>

  {conversations.length === 0 && !selected ? (
    <p class="text-stone-500">{tab === 'all' ? 'No messages yet. Once the webhook is connected in Meta, chats appear here.' : 'Nothing here right now.'}</p>
  ) : (
    <div class="grid gap-6 md:grid-cols-[18rem_1fr]">
      <ul class={`space-y-2 ${chatOpen ? 'max-md:hidden' : ''}`} aria-label="Conversations">
        {conversations.map((c) => (
          <li>
            <a
              href={`/admin/whatsapp?tab=${tab}&c=${c.id}`}
              aria-current={c.id === selectedId ? 'page' : undefined}
              class={`block rounded-xl border p-3 text-sm ${c.id === selectedId ? 'border-brand-700 bg-violet-50' : 'border-stone-200 bg-white hover:bg-stone-50'}`}
            >
              <span class="flex items-center justify-between gap-2">
                <span class="font-semibold">{who(c)}</span>
                <span class={`rounded px-2 py-0.5 text-xs ${stateLabel[c.state]?.style ?? ''}`}>{stateLabel[c.state]?.text ?? c.state}</span>
              </span>
              {who(c) !== `+${c.id}` && <span class="block text-stone-500">+{c.id}</span>}
              {c.waiting && <span class={`block text-xs font-medium ${toneStyle[c.tone]}`}>Waiting {formatDuration(c.waitingMs)}</span>}
              {c.windowLeftMs !== null && (
                <span class={`block text-xs ${c.waiting && c.windowLeftMs < 2 * 3600000 ? 'text-red-700' : 'text-stone-400'}`}>
                  {c.windowLeftMs > 0 ? `Reply window: ${formatDuration(c.windowLeftMs)} left` : 'Reply window closed'}
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>

      <section aria-label="Messages" class={chatOpen ? '' : 'max-md:hidden'}>
        <a href={`/admin/whatsapp?tab=${tab}`} class="mb-3 inline-flex min-h-11 items-center text-sm font-medium text-brand-800 md:hidden">← All chats</a>
        {selected && (
          <div class="mb-3 flex flex-wrap items-center gap-3">
            <h2 class="text-lg font-semibold">{who(selected)}</h2>
            <span class={`rounded px-2 py-0.5 text-xs ${stateLabel[selected.state]?.style ?? ''}`}>{stateLabel[selected.state]?.text ?? selected.state}</span>
            {selected.state !== 'opted_out' && (
              <form method="POST" class="flex gap-2">
                <input type="hidden" name="c" value={selectedId} />
                <input type="hidden" name="tab" value={tab} />
                {selected.state !== 'staff' && <button type="submit" name="_action" value="takeover" class="min-h-11 rounded border border-stone-300 bg-white px-4 text-sm font-medium text-stone-700">Take over</button>}
                {selected.state !== 'agent' && <button type="submit" name="_action" value="giveback" class="min-h-11 rounded bg-brand-800 px-4 text-sm font-medium text-white">Give back to agent</button>}
              </form>
            )}
            {selected.state === 'opted_out' && <span class="text-xs text-stone-500">The guest asked us to stop. They can write START to resume.</span>}
          </div>
        )}
        <ul class="space-y-3">
          {messages.map((m) => {
            const draft = drafts.get(m.wa_message_id);
            const open = draft && draft.status === 'draft' && !repliedAfter(m);
            return (
              <li>
                <div class={`max-w-xl rounded-xl p-3 text-sm ${m.direction === 'in' ? 'bg-white border border-stone-200' : 'ml-auto bg-violet-100'}`}>
                  <p class="text-xs text-stone-500 mb-1">{directionLabel[m.direction] ?? m.direction}{m.kind === 'template' && ' (template)'} · {formatDateTimeIst(m.sent_at)}{m.direction !== 'in' && ` · ${m.status}`}</p>
                  <p class="whitespace-pre-line break-words">{m.body || `[${m.kind}]`}</p>
                </div>
                {open && (
                  <form method="POST" class="mt-2 max-w-xl rounded-xl border border-violet-200 bg-violet-50 p-3 text-sm">
                    <input type="hidden" name="c" value={selectedId} />
                    <input type="hidden" name="tab" value={tab} />
                    <input type="hidden" name="draftId" value={draft.id} />
                    <p class="mb-2 text-xs text-stone-600">
                      Draft · {draft.intent || 'unlabelled'}{draft.language && ` · ${draft.language}`}{draft.body && ` · confidence ${Math.round(draft.confidence * 100)}%`}
                    </p>
                    {draft.reason && <p class="mb-2 rounded bg-amber-100 px-2 py-1 text-xs text-amber-900">{reasonLabel[draft.reason] ?? 'Needs a person'}</p>}
                    {draft.auto_decision && (
                      <p class="mb-1 text-xs text-stone-500">
                        {draft.auto_decision === 'eligible' ? 'Good enough to send without a person (if its kind is enabled).' : `Would not be sent automatically: ${draft.auto_decision.replace('blocked:', '').replaceAll('_', ' ')}.`}
                      </p>
                    )}
                    {toolLog(draft).map((t) => (
                      <p class="mb-1 text-xs text-stone-600"><span class="font-medium">Checked {t.name.replace('_', ' ')}:</span> {t.result.split('\n')[0]}</p>
                    ))}
                    <label class="sr-only" for={`draft-${draft.id}`}>Reply to send</label>
                    <textarea id={`draft-${draft.id}`} name="text" rows="4" class="w-full rounded-lg border border-stone-300 bg-white p-2" placeholder="Write a reply">{draft.body}</textarea>
                    <div class="mt-2 flex flex-wrap gap-2">
                      <button type="submit" name="_action" value="send" class="min-h-11 rounded bg-emerald-600 px-4 text-sm font-medium text-white">Send</button>
                      <button type="submit" name="_action" value="discard" formnovalidate class="min-h-11 rounded border border-stone-300 bg-white px-4 text-sm font-medium text-stone-700">Discard</button>
                    </div>
                  </form>
                )}
                {draft && !open && (
                  <p class="mt-1 max-w-xl text-xs text-stone-400">
                    {draft.status === 'sent' ? (draft.sent_by === 'auto' ? 'Sent automatically.' : 'Draft sent.') : draft.status === 'discarded' ? 'Draft discarded.' : draft.status === 'sending' ? 'Sending…' : 'Draft not shown: someone already replied.'}
                  </p>
                )}
              </li>
            );
          })}
        </ul>
        {selected && selected.state !== 'opted_out' && (
          <form method="POST" class="mt-4 max-w-xl rounded-xl border border-stone-200 bg-white p-3 text-sm">
            <input type="hidden" name="c" value={selectedId} />
            <input type="hidden" name="tab" value={tab} />
            <label class="mb-1 block text-xs font-medium text-stone-600" for="staff-reply">{selectedWindowLeft <= 0 ? 'Message the guest' : 'Write your own reply'}</label>
            {selectedWindowLeft <= 0 ? (
              <div>
                <p class="rounded bg-amber-50 p-2 text-xs text-amber-900">
                  The guest last wrote more than 24 hours ago, so WhatsApp only allows an approved template message now. They can then reply and the chat reopens.
                </p>
                <fieldset class="mt-3 grid gap-2">
                  <legend class="mb-1 text-xs font-medium text-stone-600">Template to send</legend>
                  {WA_TEMPLATES.map((t, i) => (
                    <label class="flex cursor-pointer gap-2 rounded-lg border border-stone-200 p-2">
                      <input type="radio" name="template" value={t.id} required checked={i === 0} class="mt-1" />
                      <span><span class="block font-medium text-stone-800">{t.label}</span><span class="block text-xs text-stone-600">{t.body}</span></span>
                    </label>
                  ))}
                </fieldset>
                <label class="mt-3 block text-xs font-medium text-stone-600" for="guest-name">Guest's first name (fills {'{{1}}'})</label>
                <input id="guest-name" name="guestName" type="text" required maxlength="60" value={(selected.profile_name ?? '').split(' ')[0]} class="w-full rounded-lg border border-stone-300 bg-white p-2" />
                <p class="mt-1 text-xs text-stone-500">One template per guest per 24 hours. Templates are billed by WhatsApp per message, and each must be approved in Meta first.</p>
                <button type="submit" name="_action" value="template" class="mt-2 min-h-11 rounded bg-emerald-600 px-4 text-sm font-medium text-white">Send template</button>
              </div>
            ) : (
              <>
                <textarea id="staff-reply" name="text" rows="3" maxlength="4096" required class="w-full rounded-lg border border-stone-300 bg-white p-2" placeholder="Type a message to send on WhatsApp"></textarea>
                <p class="mt-1 text-xs text-stone-500">Reply window: {formatDuration(selectedWindowLeft)} left. Sending marks this chat as staff handling, so the agent stops drafting until you give it back.</p>
                <button type="submit" name="_action" value="reply" class="mt-2 min-h-11 rounded bg-emerald-600 px-4 text-sm font-medium text-white">Send reply</button>
              </>
            )}
          </form>
        )}
        <div id="chat-end" aria-hidden="true"></div>
      </section>
    </div>
  )}
</AdminLayout>

<script>
  // Phone alerts: register the service worker, ask permission, save this device's subscription.
  const box = document.getElementById('push-box');
  if (box) {
    const status = document.getElementById('push-status')!;
    const on = document.getElementById('push-on')!;
    const test = document.getElementById('push-test')!;
    const off = document.getElementById('push-off')!;
    const key = box.dataset.key || '';
    const toBytes = (b64: string) => {
      const bin = atob((b64 + '='.repeat((4 - (b64.length % 4)) % 4)).replace(/-/g, '+').replace(/_/g, '/'));
      return Uint8Array.from(bin, (c) => c.charCodeAt(0));
    };
    const post = (url: string, method: string, body?: unknown) =>
      fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined });
    const show = (text: string, buttons: HTMLElement[]) => {
      status.textContent = text;
      [on, test, off].forEach((b) => b.classList.toggle('hidden', !buttons.includes(b)));
    };
    const standalone = (navigator as any).standalone === true || matchMedia('(display-mode: standalone)').matches;
    const isIos = /iphone|ipad/i.test(navigator.userAgent);

    (async () => {
      if (!key) return show('Not set up yet: the push keys are missing in Cloudflare.', []);
      if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
        return show(isIos && !standalone ? 'On iPhone, first add this page to your Home Screen (Share, then Add to Home Screen) and open it from there.' : 'This browser cannot receive alerts.', []);
      }
      const reg = await navigator.serviceWorker.register('/admin/sw.js', { scope: '/admin/' });
      const existing = await reg.pushManager.getSubscription();
      const refresh = (sub: PushSubscription | null) =>
        sub ? show('Alerts are on for this device. You get one when a guest needs a person.', [test, off]) : show('Alerts are off on this device.', [on]);
      refresh(existing);

      on.onclick = async () => {
        try {
          if ((await Notification.requestPermission()) !== 'granted') return show('Permission was not given. Allow notifications for this app in your phone settings, then try again.', [on]);
          const sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: toBytes(key) });
          const res = await post('/admin/api/push/subscribe', 'POST', sub.toJSON());
          if (!res.ok) throw new Error('save failed');
          refresh(sub);
        } catch {
          show('Could not turn alerts on. Try again.', [on]);
        }
      };
      test.onclick = async () => {
        test.setAttribute('disabled', '');
        const res = await post('/admin/api/push/test', 'POST');
        const data = await res.json().catch(() => ({}));
        test.removeAttribute('disabled');
        status.textContent = res.ok ? (data.sent > 0 ? 'Test alert sent. It should appear on your phone in a few seconds.' : 'The server could not deliver it. Turn alerts off and on again.') : data.error || 'Could not send the test.';
      };
      off.onclick = async () => {
        const sub = await reg.pushManager.getSubscription();
        if (sub) {
          await post('/admin/api/push/subscribe', 'DELETE', { endpoint: sub.endpoint });
          await sub.unsubscribe();
        }
        refresh(null);
      };
    })().catch(() => show('Alerts are not available here.', []));
  }
</script>

<script>
  // Live updates: check every few seconds whether anything changed and reload when it did.
  // A reply being typed is never thrown away: then a banner offers the refresh instead.
  const live = document.getElementById('live');
  if (live) {
    let known = live.dataset.sig || '';
    const typing = () => Array.from(document.querySelectorAll('main textarea')).some((t) => (t as HTMLTextAreaElement).value.trim() !== '');
    const check = async () => {
      if (document.hidden || !known) return;
      try {
        const res = await fetch('/admin/api/whatsapp/poll', { cache: 'no-store' });
        if (!res.ok) return;
        const { sig } = await res.json();
        if (!sig || sig === known) return;
        if (typing()) {
          live.classList.remove('hidden');
        } else {
          known = sig;
          // Keep the reader's place: stay put if they scrolled up, follow the chat if they were at the bottom.
          const atBottom = window.innerHeight + window.scrollY >= document.body.scrollHeight - 80;
          try { sessionStorage.setItem('waScroll', JSON.stringify({ y: window.scrollY, atBottom })); } catch {}
          location.reload();
        }
      } catch {}
    };
    setInterval(check, 5000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) check(); });
  }
</script>

<script>
  // Open a chat at its newest message (and the reply box), like a chat app, instead of at the top:
  // after Send, after switching chats, and after a live refresh while reading the bottom.
  // A live refresh while the reader was higher up restores that position instead.
  const end = document.getElementById('chat-end');
  if (end && new URLSearchParams(location.search).has('c')) {
    let saved: { y: number; atBottom: boolean } | null = null;
    try {
      saved = JSON.parse(sessionStorage.getItem('waScroll') || 'null');
      sessionStorage.removeItem('waScroll');
    } catch {}
    if (saved && !saved.atBottom) window.scrollTo(0, saved.y);
    else end.scrollIntoView({ block: 'end' });
  }
</script>
