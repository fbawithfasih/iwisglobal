---
// WhatsApp: the chats the webhook has stored (src/pages/api/webhooks/whatsapp.ts)
// and, under each guest message, the drafted reply (src/lib/waDraft.ts). Staff
// read the draft, edit it, and press Send, or discard it. Nothing is ever sent
// without that press, and the auto-reply switch is Off. The tabs and the Take over /
// Give back buttons come from src/lib/waInbox.ts.
export const prerender = false;

import EmptyState from '../../../components/EmptyState.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { auditContext, recordAudit } from '../../../lib/audit';
import { resolveEnv } from '../../../lib/env';
import { setFlash, type FlashKey } from '../../../lib/flash';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { formatDateTimeIst } from '../../../lib/format';
import type { D1Like } from '../../../lib/db';
import { sendDraft, sendStaffMessage, sendStaffTemplate, discardDraft, draftWaitingMessage, type DraftRow } from '../../../lib/waDraft';
import { listInbox, inboxCounts, inboxSignature, takeChat, handOverChat, giveBack, formatDuration, WINDOW_MS, type InboxFilter } from '../../../lib/waInbox';
import { messageFlow, waitBuckets, windowBuckets, FLOW_DAYS, type MessageDay } from '../../../lib/waInsights';
import { todayIst } from '../../../lib/availability';
import { actorLabel } from '../../../lib/authz';
import { listStaff } from '../../../lib/staff';
import { ownerLabel } from '../../../lib/leadsAdmin';
import { auditOverdue } from '../../../lib/waLaunch';
import { WA_TEMPLATES } from '../../../lib/waTemplates';
import { SIGNUP_LANGS, signupMessage } from '../../../lib/waSignup';
import { unsupportedLabel, type WaMessageMeta } from '../../../lib/whatsapp';
import { isInlineMime } from '../../../lib/waMedia';
import { deleteWaMessage, deleteWaChat } from '../../../lib/waDelete';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}

interface Chat { id: string; profile_name: string | null; state: string; handoff_reason: string; handled_by: string }
interface Message { id: number; wa_message_id: string; direction: string; kind: string; body: string; status: string; sent_at: string; media_id: string | null; media_mime: string | null; meta_json: string | null; sent_by: string }

const db = env.DB as D1Like | undefined;
const me = actorLabel(Astro.locals.admin);
// The newest messages of a chat (older ones stay in the WhatsApp Business app).
const MESSAGE_LIMIT = 200;

// Active team members by email, for names on chats and for the hand-over list.
const staffList = db ? (await listStaff(db).catch(() => [])).filter((s) => s.status === 'active') : [];
const staffNames: Record<string, string> = Object.fromEntries(staffList.map((s) => [s.email, s.name || s.email]));

if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  const conversation = String(form.get('c') ?? '');
  const draftId = Number(form.get('draftId'));
  let error = '';
  if (form.get('_action') === 'send') {
    const result = await sendDraft(env, db, draftId, String(form.get('text') ?? ''), 'staff', me);
    if (!result.ok) error = result.error ?? 'Could not send.';
  } else if (form.get('_action') === 'reply') {
    const result = await sendStaffMessage(env, db, conversation, String(form.get('text') ?? ''), me);
    if (!result.ok) error = result.error ?? 'Could not send.';
  } else if (form.get('_action') === 'template') {
    const result = await sendStaffTemplate(env, db, conversation, String(form.get('template') ?? ''), String(form.get('guestName') ?? ''), me);
    if (!result.ok) error = result.error ?? 'Could not send.';
  } else if (form.get('_action') === 'discard') {
    await discardDraft(db, draftId);
  } else if (form.get('_action') === 'takeover') {
    const r = await takeChat(db, conversation, me);
    if (!r.ok && 'heldBy' in r) error = `${ownerLabel(r.heldBy, staffNames)} is already handling this chat. Use Hand over to pass it to someone.`;
    else if (!r.ok) error = 'This chat cannot be taken (the guest asked us to stop, or it no longer exists).';
  } else if (form.get('_action') === 'handover') {
    if (!(await handOverChat(db, conversation, String(form.get('to') ?? '')))) error = 'Could not hand the chat over.';
  } else if (form.get('_action') === 'giveback') {
    await giveBack(db, conversation);
    // Answer what the guest wrote while staff had the chat. Giving back must not fail on this.
    try {
      await draftWaitingMessage(env, db, conversation);
    } catch {
      error = 'Given back, but the waiting message could not be drafted.';
    }
  } else if (form.get('_action') === 'delete_message') {
    if (!(await deleteWaMessage(db, env.IMAGES, Number(form.get('messageId'))))) error = 'That message was already deleted.';
    else await recordAudit(db, auditContext(Astro.request, Astro.locals), { action: 'whatsapp.delete_message', resource: 'wa_message', resourceId: String(form.get('messageId') ?? ''), summary: 'Deleted one WhatsApp message' });
  } else if (form.get('_action') === 'delete_chat') {
    if (String(form.get('confirm') ?? '').trim().toUpperCase() !== 'DELETE') {
      error = 'To delete this chat, type DELETE in the box.';
    } else {
      await deleteWaChat(db, env.IMAGES, conversation);
      await recordAudit(db, auditContext(Astro.request, Astro.locals), { action: 'whatsapp.delete_chat', resource: 'wa_conversation', resourceId: conversation, summary: 'Deleted a whole WhatsApp chat' });
      const back = new URLSearchParams();
      const postedTab = String(form.get('tab') ?? '');
      if (postedTab) back.set('tab', postedTab);
      return Astro.redirect(`/admin/whatsapp?${back}`);
    }
  }
  const query = new URLSearchParams({ c: conversation });
  const postedTab = String(form.get('tab') ?? '');
  if (postedTab) query.set('tab', postedTab);
  if (error) query.set('err', error);
  else {
    const flashKey: Partial<Record<string, FlashKey>> = { send: 'sent', reply: 'sent', template: 'template', discard: 'discarded', takeover: 'chat_taken', handover: 'handed_over', giveback: 'given_back' };
    const confirmation = flashKey[String(form.get('_action') ?? '')];
    if (confirmation) setFlash(Astro.cookies, confirmation);
  }
  return Astro.redirect(`/admin/whatsapp?${query}`);
}

const signature = db ? await inboxSignature(db) : '';
const counts = db ? await inboxCounts(db, me) : {};
const overdue = db ? await auditOverdue(db) : 0;
const waitingForPerson = counts.handed_off ?? 0;
const tabParam = Astro.url.searchParams.get('tab');
const tab: InboxFilter = tabParam === 'attention' || tabParam === 'staff' || tabParam === 'mine' || tabParam === 'all' ? tabParam : waitingForPerson > 0 ? 'attention' : 'all';
// The list for the open tab, every chat (for the pictures) and the messages per day load together, one round trip.
const now = new Date();
const [conversations, allChats, flow] = db
  ? await Promise.all([
      listInbox(db, tab, now, me),
      tab === 'all' ? Promise.resolve(null) : listInbox(db, 'all', now, me),
      messageFlow(db, todayIst()).catch((err) => { console.error('whatsapp: message flow failed', err instanceof Error ? err.message : 'error'); return null as MessageDay[] | null; }),
    ])
  : [[], null, null as MessageDay[] | null];
const everyChat = allChats ?? conversations;
const waits = waitBuckets(everyChat);
const windows = windowBuckets(everyChat);
const waitingNow = waits.calm + waits.soon + waits.late;
const waitMax = Math.max(1, waits.calm, waits.soon, waits.late);
const flowTotals = flow ? { guest: flow.reduce((t, d) => t + d.guest, 0), ours: flow.reduce((t, d) => t + d.ours, 0) } : null;
// On a phone the list and the open chat are separate screens; ?c= opens the chat.
const chatOpen = Astro.url.searchParams.has('c');
const selectedId = Astro.url.searchParams.get('c') ?? conversations[0]?.id ?? '';
const selected = db && selectedId
  ? await db.prepare(`SELECT id, profile_name, state, handoff_reason, handled_by FROM wa_conversations WHERE id = ?`).bind(selectedId).first<Chat>()
  : null;
const messages = db && selectedId
  ? (await db.prepare(`SELECT id, wa_message_id, direction, kind, body, status, sent_at, media_id, media_mime, meta_json, sent_by FROM wa_messages WHERE conversation_id = ? ORDER BY sent_at DESC LIMIT ${MESSAGE_LIMIT}`).bind(selectedId).all<Message>()).results.reverse()
  : [];
// Shown newest first, so the latest message and its draft are at the top of a long chat.
const newestFirst = [...messages].reverse();
const drafts = new Map<string, DraftRow>(
  db && selectedId
    ? (await db.prepare(`SELECT * FROM wa_drafts WHERE conversation_id = ? ORDER BY id ASC`).bind(selectedId).all<DraftRow>()).results.map((d) => [d.message_id, d])
    : []
);
// Extras for photos, voice notes, locations and unsupported messages (schema_whatsapp_media.sql).
const metaOf = (m: Message): WaMessageMeta => {
  try {
    return m.meta_json ? JSON.parse(m.meta_json) : {};
  } catch {
    return {};
  }
};
const mediaUrl = (m: Message, download = false) => `/admin/api/whatsapp/media/${m.id}${download ? '?download=1' : ''}`;
const inlineMime = (m: Message) => !!m.media_mime && isInlineMime(m.media_mime);
const lastGuestAt = messages.filter((m) => m.direction === 'in').map((m) => m.sent_at).sort().pop();
const selectedWindowLeft = lastGuestAt ? WINDOW_MS - (Date.now() - Date.parse(lastGuestAt)) : 0;
const autoReply = db
  ? (await db.prepare(`SELECT value FROM wa_settings WHERE key = 'auto_reply'`).bind().first<{ value: string }>())?.value ?? 'off'
  : 'off';
const error = Astro.url.searchParams.get('err');
const who = (c: { id: string; profile_name: string | null }) => c.profile_name || `+${c.id}`;
const stateLabel: Record<string, { text: string; style: string }> = {
  agent: { text: 'Agent drafting', style: 'badge-neutral' },
  handed_off: { text: 'Needs a person', style: 'badge-warn' },
  staff: { text: 'Staff handling', style: 'badge-brand' },
  opted_out: { text: 'Opted out', style: 'badge-danger' },
};
const totalChats = Object.entries(counts).filter(([k]) => k !== 'mine').reduce((t, [, n]) => t + n, 0);
const tabs: { id: InboxFilter; label: string; count: number; tone: 'warn' | 'brand' | 'info' | 'success'; hint: string }[] = [
  { id: 'attention', label: 'Needs a person', count: waitingForPerson, tone: 'warn', hint: 'The agent handed these over.' },
  { id: 'mine', label: 'Mine', count: counts.mine ?? 0, tone: 'brand', hint: 'Chats you are handling.' },
  { id: 'staff', label: 'Staff handling', count: counts.staff ?? 0, tone: 'info', hint: 'A person has taken these over.' },
  { id: 'all', label: 'All chats', count: totalChats, tone: 'success', hint: 'Every conversation.' },
];
const edge: Record<string, string> = { agent: 'border-l-stone-300', handed_off: 'border-l-amber-400', staff: 'border-l-violet-500', opted_out: 'border-l-rose-400' };
const initial = (name: string | null) => ((name ?? '').trim()[0] ?? '#').toUpperCase();
const waitBars = [
  { key: 'late', label: 'Over 4 h', n: waits.late, bar: 'bg-rose-500', cls: 'badge-danger' },
  { key: 'soon', label: '1 to 4 h', n: waits.soon, bar: 'bg-orange-400', cls: 'badge-warn' },
  { key: 'calm', label: 'Under 1 h', n: waits.calm, bar: 'bg-emerald-500', cls: 'badge-success' },
] as const;
const windowBars = [
  { label: 'Open, over 2 h left', n: windows.plenty, bar: 'bg-emerald-500' },
  { label: 'Closing, under 2 h left', n: windows.closing, bar: 'bg-orange-400' },
  { label: 'Closed (templates only)', n: windows.closed, bar: 'bg-stone-400' },
] as const;
const windowMax = Math.max(1, windows.plenty, windows.closing, windows.closed);
const dayShort = (ymd: string) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(new Date(`${ymd}T00:00:00Z`));
const toneStyle = { red: 'text-red-700', amber: 'text-amber-700', none: 'text-stone-600' } as const;
const directionLabel: Record<string, string> = { in: 'Guest', out: 'Sent from the site', echo: 'Staff (app)' };
const reasonLabel: Record<string, string> = {
  handoff: 'Needs a person: money, complaint, booking change or similar',
  no_knowledge: 'Needs a person: no approved answer for this',
  price_mismatch: 'Needs a person: the draft quotes a price that is not in the catalogue',
  unsupported: 'Needs a person: a photo, voice note or other message the agent cannot read',
  format: 'Needs a person: the draft was not in the expected format, check it carefully',
  no_booking: 'Needs a person: no booking found under this WhatsApp number',
  cap: 'No draft: daily limit reached',
  no_api_key: 'No draft: the AI key is not set',
  error: 'No draft: something went wrong',
};
// The lookups a draft relied on (src/lib/waTools.ts), shown so staff can see them.
const toolLog = (d: DraftRow): { name: string; result: string }[] => {
  try {
    const parsed = JSON.parse(d.tools);
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
};
// A staff reply (from the app or the site) after this guest message makes the draft stale.
const repliedAfter = (m: Message) => messages.some((x) => x.direction !== 'in' && x.sent_at > m.sent_at);
---
<AdminLayout title="WhatsApp">
  <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-semibold">WhatsApp</h1>
      <p class="text-sm text-stone-600">{totalChats} {totalChats === 1 ? 'chat' : 'chats'} · {waitingNow > 0 ? `${waitingNow} waiting for a reply` : 'nobody waiting for a reply'}. Every message on the business number, with a drafted reply under each guest message. Nothing is sent until you press Send.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2 text-sm">
      <span class={`rounded-full px-3 py-1 text-xs font-medium ${autoReply === 'on' ? 'badge-success' : 'badge-neutral'}`}>Automatic replies: {autoReply === 'on' ? 'On' : 'Off'}</span>
      <a href="/admin/whatsapp/auto" class="rounded border border-violet-200 bg-white px-3 py-2">Settings</a>
      <a href="/admin/whatsapp/launch" class="rounded border border-violet-200 bg-white px-3 py-2">Launch readiness</a>
      <a href="/admin/whatsapp/knowledge" class="rounded border border-violet-200 bg-white px-3 py-2">Knowledge base</a>
    </div>
  </div>
  <div id="push-box" class="mb-6 max-w-xl rounded-xl border border-violet-100 bg-white p-3 text-sm" data-key={env.VAPID_PUBLIC_KEY ?? ''}>
    <p class="font-medium text-stone-800">Phone alerts</p>
    <p id="push-status" class="mt-1 text-stone-600">Checking…</p>
    <div class="mt-2 flex flex-wrap gap-2">
      <button type="button" id="push-on" class="hidden min-h-11 rounded bg-brand-800 px-4 text-sm font-medium text-white">Turn on alerts</button>
      <button type="button" id="push-test" class="hidden min-h-11 rounded border border-violet-200 bg-white px-4 text-sm font-medium text-stone-700">Send test alert</button>
      <button type="button" id="push-off" class="hidden min-h-11 rounded border border-violet-200 bg-white px-4 text-sm font-medium text-stone-700">Turn off</button>
    </div>
  </div>
  {overdue > 0 && (
    <p class="notice notice-warn mb-4" role="status">
      {overdue} automatic message{overdue === 1 ? ' is' : 's are'} more than a week old and not yet audited.
      <a href="/admin/whatsapp/auto#audit" class="ml-1 font-medium underline">Audit them now</a>
    </p>
  )}
  {error && <p class="notice notice-danger mb-4" role="alert">{error}</p>}

  <div id="live" data-sig={signature} class="hidden mb-4 rounded-xl bg-violet-50 p-3 text-sm text-violet-900" role="status">
    New messages arrived. <a href="" class="font-semibold underline">Show them</a>
  </div>
  <section aria-label="Chat filters" class="mb-6">
    <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
      {tabs.map((t) => {
        const clear = t.count === 0 && t.id === 'attention';
        return (
          <a href={`/admin/whatsapp?tab=${t.id}`} aria-current={t.id === tab ? 'page' : undefined} class={`block rounded-xl border p-4 transition hover:-translate-y-0.5 hover:shadow-md ${clear ? 'tint-success' : `tint-${t.tone}`} ${t.id === tab ? 'ring-2 ring-violet-500 ring-offset-2' : ''}`}>
            <span class="block text-4xl font-semibold leading-none text-stone-900">{t.count}</span>
            <span class="mt-2 block font-medium text-stone-800">{t.label}</span>
            <span class="block text-xs text-stone-600">{clear ? '✓ All clear.' : t.hint}</span>
          </a>
        );
      })}
    </div>
  </section>

  {db && (
    <details open={!chatOpen} class="mb-6">
      <summary class="mb-3 cursor-pointer text-lg font-semibold">Overview <span class="text-sm font-normal text-stone-600">messages per day, who is waiting, reply windows</span></summary>
    <div class="grid items-start gap-4 lg:grid-cols-5">
      <section aria-labelledby="flow" class="viz rounded-xl border border-violet-100 bg-white p-4 lg:col-span-3">
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="flow" class="text-lg font-semibold">Messages per day</h2>
          {flowTotals && <p class="text-sm text-stone-600">Last {FLOW_DAYS} days: <span class="font-semibold text-stone-900">{flowTotals.guest}</span> from guests, <span class="font-semibold text-stone-900">{flowTotals.ours}</span> from us</p>}
        </div>
        {!flow ? (
          <p class="notice notice-warn" role="alert">Could not load the message counts. Try again in a moment.</p>
        ) : (
          <>
            <div id="flow-chart"></div>
            <p class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-stone-700">
              <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm" style="background:var(--s1)"></span>From guests</span>
              <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm" style="background:var(--s2)"></span>From us (this site and the phone app)</span>
            </p>
            <details class="mt-2 text-sm">
              <summary class="cursor-pointer text-stone-700">Show as a table</summary>
              <div class="mt-2 max-h-56 overflow-auto">
                <table class="w-full text-left text-xs">
                  <caption class="sr-only">Messages per day, last {FLOW_DAYS} days</caption>
                  <thead class="text-stone-600"><tr><th scope="col" class="py-1 pr-3">Day</th><th scope="col" class="py-1 pr-3">From guests</th><th scope="col" class="py-1">From us</th></tr></thead>
                  <tbody>{[...flow].reverse().map((d) => <tr class="border-t border-violet-50"><th scope="row" class="py-1 pr-3 font-normal">{dayShort(d.day)}</th><td class="py-1 pr-3">{d.guest}</td><td class="py-1">{d.ours}</td></tr>)}</tbody>
                </table>
              </div>
            </details>
            <p class="mt-2 text-xs text-stone-600">Counted by India day. Reactions, edits and deletions are not counted.</p>
          </>
        )}
      </section>

      <section aria-labelledby="waiting" class="rounded-xl border border-violet-100 bg-white p-4 lg:col-span-2">
        <h2 id="waiting" class="mb-1 text-lg font-semibold">Waiting for a reply</h2>
        <p class="mb-3 text-xs text-stone-600">Guests who wrote last, by how long they have waited.</p>
        {waitingNow === 0 ? (
          <p class="rounded-lg tint-success border px-3 py-2 text-sm text-stone-800">✓ Nobody is waiting for a reply.</p>
        ) : (
          <ul class="space-y-2">
            {waitBars.map((w) => (
              <li>
                <span class="flex items-center justify-between text-sm"><span class="inline-flex items-center gap-2"><span class={`${w.cls} rounded-full px-2 py-0.5 text-[11px] font-medium`}>{w.label}</span></span><span class="font-semibold text-stone-900">{w.n}</span></span>
                <span class="mt-1 block h-2.5 rounded-full bg-stone-100" aria-hidden="true"><span class={`block h-full rounded-full ${w.bar}`} style={`width:${w.n === 0 ? 0 : Math.max(6, Math.round((w.n / waitMax) * 100))}%`}></span></span>
              </li>
            ))}
          </ul>
        )}
        <h3 class="mb-1 mt-5 text-sm font-semibold text-stone-800">Reply windows</h3>
        <p class="mb-2 text-xs text-stone-600">WhatsApp lets us write freely for 24 hours after a guest's last message.</p>
        <ul class="space-y-2">
          {windowBars.map((w) => (
            <li>
              <span class="flex items-center justify-between text-sm"><span class="text-stone-800">{w.label}</span><span class="font-semibold text-stone-900">{w.n}</span></span>
              <span class="mt-1 block h-2 rounded-full bg-stone-100" aria-hidden="true"><span class={`block h-full rounded-full ${w.bar}`} style={`width:${w.n === 0 ? 0 : Math.max(6, Math.round((w.n / windowMax) * 100))}%`}></span></span>
            </li>
          ))}
        </ul>
      </section>
    </div>
    </details>
  )}

  {conversations.length === 0 && !selected ? (
    <EmptyState message={tab === 'all' ? 'No messages yet' : 'Nothing here right now'} hint={tab === 'all' ? 'Once the webhook is connected in Meta, chats appear here.' : undefined} />
  ) : (
    <div class="grid gap-6 md:grid-cols-[18rem_1fr]">
      <ul class={`space-y-2 ${chatOpen ? 'max-md:hidden' : ''}`} aria-label="Conversations">
        {conversations.map((c) => (
          <li>
            <a
              href={`/admin/whatsapp?tab=${tab}&c=${c.id}`}
              aria-current={c.id === selectedId ? 'page' : undefined}
              class={`block rounded-xl border border-l-4 p-3 text-sm transition hover:shadow-md ${edge[c.state] ?? 'border-l-stone-300'} ${c.id === selectedId ? 'border-brand-700 bg-violet-50' : 'border-violet-100 bg-white'}`}
            >
              <span class="flex items-center justify-between gap-2">
                <span class="flex min-w-0 items-center gap-2"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full badge-brand text-xs font-semibold" aria-hidden="true">{initial(c.profile_name)}</span><span class="truncate font-semibold">{who(c)}</span></span>
                <span class={`shrink-0 rounded-full px-2 py-0.5 text-[11px] font-medium ${stateLabel[c.state]?.style ?? ''}`}>{stateLabel[c.state]?.text ?? c.state}</span>
              </span>
              {who(c) !== `+${c.id}` && <span class="block text-stone-500">+{c.id}</span>}
              {c.handled_by && <span class="block text-xs text-stone-600">Handled by <span class="font-semibold">{ownerLabel(c.handled_by, staffNames)}</span></span>}
              {c.waiting && <span class={`block text-xs font-medium ${toneStyle[c.tone]}`}>Waiting {formatDuration(c.waitingMs)}</span>}
              {c.windowLeftMs !== null && (
                <span class={`block text-xs ${c.waiting && c.windowLeftMs < 2 * 3600000 ? 'text-red-700' : 'text-stone-600'}`}>
                  {c.windowLeftMs > 0 ? `Reply window: ${formatDuration(c.windowLeftMs)} left` : 'Reply window closed'}
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>

      <section id="chat" aria-label="Messages" class={chatOpen ? '' : 'max-md:hidden'}>
        <a href={`/admin/whatsapp?tab=${tab}`} class="mb-3 inline-flex min-h-11 items-center text-sm font-medium text-brand-800 md:hidden">← All chats</a>
        {selected && (
          <div class="mb-3 flex flex-wrap items-center gap-3">
            <h2 class="text-lg font-semibold">{who(selected)}</h2>
            <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${stateLabel[selected.state]?.style ?? ''}`}>{stateLabel[selected.state]?.text ?? selected.state}</span>
            {selected.state !== 'opted_out' && (
              <form method="POST" class="flex gap-2">
