---
// Read-only list of private offers (schema_private_offers.sql) and their
// payments. Offers are created with scripts/offer-seed.mjs and never edited.
// Not the coupon admin (/admin/offers).
export const prerender = false;

import EmptyState from '../../../components/EmptyState.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import type { D1Like } from '../../../lib/db';
import { readOffer, listPaid } from '../../../lib/offerData';
import { offerState } from '../../../lib/offerPricing';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}

const db = env.DB as D1Like | undefined;

interface PaymentView {
  kind: string;
  amount: string;
  status: string;
  payer: string;
  paidAt: string;
  emails: string;
  paymentId: string;
}
interface OfferView {
  id: string;
  ok: boolean;
  created?: string;
  customer?: string;
  statusLabel?: string;
  chosen?: string;
  paid?: string;
  balance?: string;
  paidCount: number;
  payments: PaymentView[];
}

const STATUS_LABEL: Record<string, string> = { unpaid: 'Unpaid', deposit_paid: 'Booking amount paid', paid_in_full: 'Paid in full' };
const when = (iso: unknown) => {
  const t = typeof iso === 'string' ? Date.parse(iso) : NaN;
  return Number.isNaN(t) ? '' : new Date(t).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
};
const text = (v: unknown) => (typeof v === 'string' ? v : '');

const offers: OfferView[] = [];
let loadError = false;
if (db) {
  try {
    const { results } = await db.prepare(`SELECT id FROM private_offers ORDER BY created_at DESC, id`).bind().all<{ id: unknown }>();
    for (const r of results ?? []) {
      const id = text(r.id);
      try {
        const offer = await readOffer(db, id);
        if (!offer) throw new Error('unreadable');
        const money = new Intl.NumberFormat('en-IE', { style: 'currency', currency: offer.currency });
        const fmt = (minor: number) => money.format(minor / 100);
        const state = offerState(offer.terms, await listPaid(db, id));
        const { results: pays } = await db
          .prepare(`SELECT kind, amount_minor, status, payment_id, payer_name, payer_email, receipt_sent_at, updated_at, created_at FROM offer_payments WHERE offer_id = ? ORDER BY created_at, id`)
          .bind(id)
          .all<Record<string, unknown>>();
        const payments = (pays ?? []).map((p): PaymentView => {
          const sent = text(p.receipt_sent_at);
          const status = text(p.status);
          return {
            kind: text(p.kind),
            amount: typeof p.amount_minor === 'number' ? fmt(p.amount_minor) : '?',
            status,
            payer: [text(p.payer_name), text(p.payer_email)].filter(Boolean).join(' / '),
            paidAt: status === 'paid' ? when(p.updated_at) : '',
            paymentId: text(p.payment_id),
            emails: status !== 'paid' ? '' : sent === '' ? 'not sent yet' : sent.startsWith('pending:') ? 'sending / interrupted' : `sent ${when(sent) || sent}`,
          };
        });
        const opt = offer.terms.options.find((o) => o.id === state.optionId);
        offers.push({
          id,
          ok: true,
          created: when(offer.createdAt),
          customer: offer.customerName,
          statusLabel: (STATUS_LABEL[state.status] ?? state.status) + (offer.status === 'open' ? '' : ' (closed)'),
          chosen: opt ? `${opt.label}, ${state.guideLanguage === 'de' ? 'German' : 'English'} guide` : '',
          paid: state.status === 'unpaid' ? '' : fmt(state.paidMinor),
          balance: state.status === 'unpaid' ? '' : fmt(state.balanceMinor),
          paidCount: payments.filter((p) => p.status === 'paid').length,
          payments,
        });
      } catch {
        offers.push({ id, ok: false, paidCount: 0, payments: [] });
      }
    }
  } catch {
    loadError = true;
  }
}
const th = 'px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-stone-500';
const td = 'px-3 py-2 align-top text-sm';
---
<AdminLayout title="Private offers">
  <h1 class="text-2xl font-semibold mb-2">Private offers</h1>
  <p class="text-stone-500 text-sm mb-1">
    Offers cannot be edited once created; to change terms, create a new offer.
  </p>
  <p class="text-stone-500 text-sm mb-4">Created with <code>scripts/offer-seed.mjs</code>. Each guest has their own secret link.</p>
  {!db && <p class="my-3 rounded-xl bg-red-50 p-3 text-sm text-red-700" role="alert">Database not available.</p>}
  {loadError && <p class="my-3 rounded-xl bg-red-50 p-3 text-sm text-red-700" role="alert">Could not load private offers. Has schema_private_offers.sql been applied?</p>}
  {db && !loadError && offers.length === 0 && <EmptyState message="No private offers yet" hint="A private offer is a price made for one guest, sent as a private link." />}

  {offers.map((o) => (
    <section class="mb-5 rounded-xl border border-violet-100 bg-white p-4">
      {!o.ok ? (
        <p class="text-sm text-red-700">unreadable offer {o.id}</p>
      ) : (
        <>
          <div class="overflow-x-auto">
            <table class="min-w-full">
              <thead>
                <tr>
                  <th class={th}>Created</th><th class={th}>Customer</th><th class={th}>Status</th>
                  <th class={th}>Option</th><th class={th}>Paid</th><th class={th}>Balance</th><th class={th}>Payments received</th><th class={th}></th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class={td}>{o.created}</td>
                  <td class={`${td} font-medium`}>{o.customer}</td>
                  <td class={td}>{o.statusLabel}</td>
                  <td class={td}>{o.chosen || '-'}</td>
                  <td class={td}>{o.paid || '-'}</td>
                  <td class={td}>{o.balance || '-'}</td>
                  <td class={td}>{o.paidCount}</td>
                  <td class={td}>
                    <button type="button" data-copy-link={`https://www.iwisglobal.com/offer/${o.id}`} class="min-h-11 rounded border border-violet-200 bg-white px-3 text-sm">Copy link</button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          {o.payments.length > 0 && (
            <div class="mt-3 overflow-x-auto">
              <table class="min-w-full border-t border-violet-100">
                <thead>
                  <tr><th class={th}>Kind</th><th class={th}>Amount</th><th class={th}>Status</th><th class={th}>Payer</th><th class={th}>Paid at</th><th class={th}>Razorpay payment id</th><th class={th}>Emails</th></tr>
                </thead>
                <tbody>
                  {o.payments.map((p) => (
                    <tr class="border-t border-stone-100">
                      <td class={td}>{p.kind}</td><td class={td}>{p.amount}</td><td class={td}>{p.status}</td>
                      <td class={td}>{p.payer || '-'}</td><td class={td}>{p.paidAt || '-'}</td><td class={td}>{p.paymentId || '-'}</td><td class={td}>{p.emails || '-'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </>
      )}
    </section>
  ))}

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const link = btn.dataset.copyLink ?? '';
        let ok = false;
        try {
          await navigator.clipboard.writeText(link);
          ok = true;
        } catch {
          const ta = document.createElement('textarea');
          ta.value = link;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { ok = document.execCommand('copy'); } catch { ok = false; }
          ta.remove();
        }
        const old = btn.textContent;
        btn.textContent = ok ? 'Copied' : 'Copy failed';
        setTimeout(() => { btn.textContent = old; }, 1800);
      });
    });
  </script>
</AdminLayout>
