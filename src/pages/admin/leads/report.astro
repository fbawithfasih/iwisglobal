---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { formatMoneyMinor } from '../../../lib/format';
import { addSpend, deleteSpend, loadReport, summarise, unitCost, type ReportLine, type SpendRow } from '../../../lib/leadReport';
import { clickStats, deliveryStats, unsubscribedSince } from '../../../lib/resendEvents';
import { sendCounts } from '../../../lib/campaigns';
import type { D1Like } from '../../../lib/db';
import { reportTotals, funnel, topLine, withoutSpend, minutesLabel, percent, barWidth } from '../../../lib/leadReportView';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}
const db: D1Like | undefined = env.DB;

const day = (d: Date) => d.toISOString().slice(0, 10);
const isDay = (v: string | null): v is string => !!v && /^\d{4}-\d{2}-\d{2}$/.test(v);
const q = Astro.url.searchParams;
const to = isDay(q.get('to')) ? (q.get('to') as string) : day(new Date());
const from = isDay(q.get('from')) ? (q.get('from') as string) : day(new Date(Date.now() - 90 * 86400000));

let notice = '';
if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');
  try {
    if (action === 'add_spend') {
      notice =
        (await addSpend(db, {
          date: String(form.get('date') ?? ''),
          channel: String(form.get('channel') ?? ''),
          campaign: String(form.get('campaign') ?? ''),
          amountMajor: Number(form.get('amount')),
          currency: String(form.get('currency') ?? ''),
          note: String(form.get('note') ?? ''),
        })) ?? 'Spend saved.';
    } else if (action === 'delete_spend') {
      await deleteSpend(db, Number(form.get('id')));
      notice = 'Spend entry removed.';
    }
  } catch {
    notice = 'That could not be saved.';
  }
}

let byChannel: ReportLine[] = [];
let byCampaign: ReportLine[] = [];
let spend: SpendRow[] = [];
let campaigns: { id: string; name: string; sent: number; delivered: number; bounced: number; complained: number; unsubscribed: number; clicks: number }[] = [];
let failed = false;
if (db) {
  try {
    const data = await loadReport(db, from, to);
    spend = data.spend;
    byChannel = summarise(data.leads, data.spend, 'channel');
    byCampaign = summarise(data.leads, data.spend, 'campaign');
  } catch {
    failed = true;
  }
  try {
    const list = (await db.prepare(`SELECT id, name FROM campaigns WHERE status IN ('sending','sent') ORDER BY created_at DESC LIMIT 20`).bind().all<{ id: string; name: string }>()).results;
    for (const c of list) {
      const d = await deliveryStats(db, c.id);
      campaigns.push({
        id: c.id,
        name: c.name,
        sent: (await sendCounts(db, c.id)).sent,
        delivered: d.delivered,
        bounced: d.bounced,
        complained: d.complained,
        unsubscribed: await unsubscribedSince(db, c.id),
        clicks: (await clickStats(db, c.id)).reduce((n, x) => n + x.clicks, 0),
      });
    }
  } catch {
    // email tables not created yet: the section below simply stays empty
  }
}

const money = (m: Record<string, number>) => Object.entries(m).map(([cur, minor]) => formatMoneyMinor(minor, cur)).join(' + ') || '-';
const unit = (spendBy: Record<string, number>, n: number) => {
  const u = unitCost(spendBy, n);
  return u ? money(u) : '-';
};
const minutes = minutesLabel;
const card = 'rounded-xl border border-violet-100 bg-white text-sm';
const field = 'rounded border border-violet-200 px-3 py-2';
const totals = reportTotals(byChannel);
const steps = funnel(totals);
const top = topLine(byChannel);
const noSpend = withoutSpend(byChannel);
const channelMax = Math.max(1, ...byChannel.map((l) => l.leads));
const noticeOk = /^Spend (saved|entry removed)/.test(notice);
const tiles = [
  { label: 'Leads', n: totals.leads, hint: `From ${byChannel.filter((l) => l.leads > 0).length} ${byChannel.filter((l) => l.leads > 0).length === 1 ? 'channel' : 'channels'} in this period.`, tone: 'info' },
  { label: 'Bookings', n: totals.bookings, hint: totals.leads ? `${percent(totals.bookings, totals.leads)}% of leads booked.` : 'No leads in this period.', tone: totals.bookings ? 'success' : 'brand' },
  { label: 'Top channel', n: top ? top.key : '–', hint: top ? `${top.leads} ${top.leads === 1 ? 'lead' : 'leads'}, ${top.bookings} booked.` : 'Nothing to rank yet.', tone: 'brand', text: true },
  { label: 'No spend entered', n: noSpend.length, hint: noSpend.length ? `Cost per lead is blank for ${noSpend.slice(0, 3).join(', ')}${noSpend.length > 3 ? ` and ${noSpend.length - 3} more` : ''}.` : '✓ Every channel with leads has spend entered.', tone: noSpend.length ? 'warn' : 'success' },
] as const;
---
<AdminLayout title="Lead report">
  <p class="mb-2 text-sm"><a href="/admin/leads" class="text-brand-700 hover:underline">&larr; All leads</a></p>
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-semibold">Where leads come from</h1>
      <p class="text-sm text-stone-600">{from} to {to}</p>
    </div>
    <form method="GET" class="flex flex-wrap items-end gap-2 text-sm">
      <label>From <input type="date" name="from" value={from} class={field} /></label>
      <label>To <input type="date" name="to" value={to} class={field} /></label>
      <button class="min-h-11 rounded btn-primary px-4 text-white">Show</button>
    </form>
  </div>
  {notice && <p class={`notice mb-4 ${noticeOk ? 'notice-success' : 'notice-danger'}`} role={noticeOk ? 'status' : 'alert'}>{notice}</p>}
  {failed && <p class="notice notice-danger mb-4" role="alert">The report could not be read.</p>}
  <p class="mb-4 max-w-3xl text-xs text-stone-600">A lead counts at every stage it reached. Revenue is what was paid on the linked booking. Cost figures use the spend you enter below, so they are only as complete as that.</p>

  <section aria-label="Overview" class="mb-6">
    <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
      {tiles.map((t) => (
        <div class={`rounded-xl border p-4 tint-${t.tone}`}>
          <span class={`block font-semibold leading-none text-stone-900 ${'text' in t && t.text ? 'break-words text-2xl' : 'text-4xl'}`}>{t.n}</span>
          <span class="mt-2 block font-medium text-stone-800">{t.label}</span>
          <span class="block text-xs text-stone-600">{t.hint}</span>
        </div>
      ))}
    </div>
  </section>

  {totals.leads > 0 && (
    <div class="mb-6 grid items-start gap-4 lg:grid-cols-2">
      <section aria-labelledby="funnel" class="rounded-xl border border-violet-100 bg-white p-4">
        <h2 id="funnel" class="mb-1 text-lg font-semibold">From lead to booking</h2>
        <p class="mb-3 text-xs text-stone-600">Every lead in the period, and how far each got.</p>
        <ul class="space-y-3">
          {steps.map((st) => (
            <li data-tip={`${st.label}: ${st.n} (${st.ofLeads}% of leads${st.fromPrevious !== null ? `, ${st.fromPrevious}% of the step before` : ''})`} tabindex="0">
              <span class="flex items-baseline justify-between gap-3 text-sm">
                <span class="text-stone-800">{st.label}</span>
                <span class="text-stone-700"><span class="font-semibold text-stone-900">{st.n}</span> <span class="text-xs">{st.ofLeads}% of leads{st.fromPrevious !== null ? ` · ${st.fromPrevious}% of the step before` : ''}</span></span>
              </span>
              <span class="mt-1 block h-3 rounded-full bg-stone-100" aria-hidden="true"><span class={`block h-full rounded-full ${st.label === 'Booked' ? 'bg-emerald-500' : 'bg-violet-500'}`} style={`width:${barWidth(st.n, totals.leads)}%`}></span></span>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="chan" class="rounded-xl border border-violet-100 bg-white p-4">
        <h2 id="chan" class="mb-1 text-lg font-semibold">Leads by channel</h2>
        <p class="mb-3 text-xs text-stone-600">How many came from each, and how many of those booked.</p>
        <ul class="space-y-3">
          {byChannel.filter((l) => l.leads > 0).map((l) => (
            <li data-tip={`${l.key}: ${l.leads} leads, ${l.bookings} booked (${percent(l.bookings, l.leads)}%), first reply ${minutesLabel(l.medianResponseMinutes)}`} tabindex="0">
              <span class="flex items-baseline justify-between gap-3 text-sm">
                <span class="truncate text-stone-800">{l.key}</span>
                <span class="shrink-0 text-stone-700"><span class="font-semibold text-stone-900">{l.leads}</span> <span class="text-xs">leads · {l.bookings} booked · reply {minutesLabel(l.medianResponseMinutes)}</span></span>
              </span>
              <span class="mt-1 block h-3 rounded-full bg-stone-100" aria-hidden="true"><span class="relative block h-full overflow-hidden rounded-full bg-violet-500" style={`width:${barWidth(l.leads, channelMax)}%`}><span class="absolute inset-y-0 left-0 bg-emerald-500" style={`width:${percent(l.bookings, l.leads)}%`}></span></span></span>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs text-stone-600"><span class="inline-block h-2.5 w-2.5 rounded-full bg-violet-500 align-middle" aria-hidden="true"></span> leads · <span class="inline-block h-2.5 w-2.5 rounded-full bg-emerald-500 align-middle" aria-hidden="true"></span> the part that booked</p>
      </section>
    </div>
  )}
  {[['By channel', byChannel], ['By campaign', byCampaign]].map(([title, lines]) => (
    <section class="mb-6">
      <h2 class="mb-2 text-lg font-semibold">{title as string} <span class="text-sm font-normal text-stone-600">(full table)</span></h2>
      <div class={`${card} overflow-x-auto`} tabindex="0" role="region" aria-label="Report table, scrolls sideways">
        <table class="w-full text-left">
          <thead class="bg-stone-50"><tr>
            <th class="px-3 py-2">{title === 'By channel' ? 'Channel' : 'Campaign'}</th><th class="px-3 py-2">Leads</th><th class="px-3 py-2">Quotes</th><th class="px-3 py-2">Deposits</th><th class="px-3 py-2">Bookings</th><th class="px-3 py-2">Revenue</th><th class="px-3 py-2">Spend</th><th class="px-3 py-2">Per lead</th><th class="px-3 py-2">Per booking</th><th class="px-3 py-2">First reply</th>
          </tr></thead>
          <tbody>
            {(lines as ReportLine[]).length === 0 && <tr><td class="px-3 py-3 text-stone-500" colspan="10">No leads in this period.</td></tr>}
            {(lines as ReportLine[]).map((l) => (
              <tr class="border-t border-stone-100">
                <td class="px-3 py-2">{l.key}</td><td class="px-3 py-2">{l.leads}</td><td class="px-3 py-2">{l.quotes}</td><td class="px-3 py-2">{l.deposits}</td><td class="px-3 py-2">{l.bookings}</td>
                <td class="px-3 py-2 whitespace-nowrap">{money(l.revenue)}</td><td class="px-3 py-2 whitespace-nowrap">{money(l.spend)}</td>
                <td class="px-3 py-2 whitespace-nowrap">{unit(l.spend, l.leads)}</td><td class="px-3 py-2 whitespace-nowrap">{unit(l.spend, l.bookings)}</td>
                <td class="px-3 py-2 whitespace-nowrap">{minutes(l.medianResponseMinutes)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <section class="mb-6">
    <h2 class="mb-2 text-lg font-semibold">Email campaigns</h2>
    <div class={`${card} overflow-x-auto`} tabindex="0" role="region" aria-label="Report table, scrolls sideways">
      <table class="w-full text-left">
        <thead class="bg-stone-50"><tr><th class="px-3 py-2">Campaign</th><th class="px-3 py-2">Sent</th><th class="px-3 py-2">Delivered</th><th class="px-3 py-2">Bounced</th><th class="px-3 py-2">Spam</th><th class="px-3 py-2">Unsubscribed</th><th class="px-3 py-2">Link clicks</th></tr></thead>
        <tbody>
          {campaigns.length === 0 && <tr><td class="px-3 py-3 text-stone-500" colspan="7">No campaign has been sent yet.</td></tr>}
          {campaigns.map((c) => (
            <tr class="border-t border-stone-100">
              <td class="px-3 py-2"><a href={`/admin/campaigns/${c.id}`} class="text-brand-700 hover:underline">{c.name}</a></td>
              <td class="px-3 py-2">{c.sent}</td><td class="px-3 py-2">{c.delivered}</td><td class="px-3 py-2">{c.bounced}</td><td class="px-3 py-2">{c.complained}</td><td class="px-3 py-2">{c.unsubscribed}</td><td class="px-3 py-2">{c.clicks}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mb-6">
    <h2 class="mb-2 text-lg font-semibold">Marketing spend</h2>
    <form method="POST" class={`${card} mb-3 grid gap-2 p-4 sm:grid-cols-6`}>
      <input type="hidden" name="_action" value="add_spend" />
      <input type="date" name="date" aria-label="Date" value={day(new Date())} required class={field} />
      <input name="channel" list="spend-channels" placeholder="Channel (facebook_ads)" required class={field} />
      <datalist id="spend-channels">{byChannel.map((l) => <option value={l.key} />)}</datalist>
      <input name="campaign" placeholder="Campaign (optional)" class={field} />
      <input name="amount" type="number" step="0.01" min="0" placeholder="Amount" required class={field} />
      <select name="currency" aria-label="Currency" class={field}><option>INR</option><option>USD</option><option>EUR</option><option>GBP</option></select>
      <button class="min-h-11 rounded btn-primary text-white">Add spend</button>
      <input name="note" placeholder="Note (optional)" class={`${field} sm:col-span-6`} />
    </form>
    <div class={`${card} overflow-x-auto`} tabindex="0" role="region" aria-label="Report table, scrolls sideways">
      <table class="w-full text-left">
        <tbody>
          {spend.length === 0 && <tr><td class="px-3 py-3 text-stone-500">No spend entered for this period.</td></tr>}
          {spend.map((s) => (
            <tr class="border-t border-stone-100 first:border-0">
              <td class="px-3 py-2 whitespace-nowrap">{s.spend_date}</td><td class="px-3 py-2">{s.channel}</td><td class="px-3 py-2">{s.campaign}</td>
              <td class="px-3 py-2 whitespace-nowrap">{formatMoneyMinor(s.amount_minor, s.currency)}</td><td class="px-3 py-2">{s.note}</td>
              <td class="px-3 py-2"><form method="POST"><input type="hidden" name="_action" value="delete_spend" /><input type="hidden" name="id" value={s.id} /><button class="text-red-700 hover:underline" aria-label="Remove this spend entry" data-confirm="Remove this spend entry? Cost per lead and per booking will change." data-confirm-label="Remove">Remove</button></form></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <div id="viz-tip" role="tooltip" hidden class="pointer-events-none fixed z-50 max-w-xs rounded-lg border border-violet-200 bg-white px-3 py-2 text-xs text-stone-800 shadow-lg"></div>
</AdminLayout>

<script is:inline>
  (function () {
    // One tooltip for the bars. The text is set with textContent, never as HTML.
    var tip = document.getElementById('viz-tip');
    if (!tip) return;
    document.querySelectorAll('[data-tip]').forEach(function (el) {
      var show = function (x, y) {
        tip.textContent = el.getAttribute('data-tip');
        tip.hidden = false;
        var w = tip.offsetWidth, h = tip.offsetHeight;
        tip.style.left = Math.max(8, Math.min(window.innerWidth - w - 8, x + 12)) + 'px';
        tip.style.top = Math.max(8, Math.min(window.innerHeight - h - 8, y - h - 12)) + 'px';
      };
      el.addEventListener('pointermove', function (e) { show(e.clientX, e.clientY); });
      el.addEventListener('focus', function () { var b = el.getBoundingClientRect(); show(b.left + b.width / 2, b.top); });
      el.addEventListener('pointerleave', function () { tip.hidden = true; });
      el.addEventListener('blur', function () { tip.hidden = true; });
    });
  })();
</script>
