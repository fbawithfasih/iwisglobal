---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { recordLead, scoreBucket, CHANNELS, CHANNEL_LABELS, LEAD_STAGES, type Channel } from '../../../lib/contacts';
import { VIEWS, STAGE_LABELS, listLeadsView, ownerLabel, takeLead, viewCounts, waitingLabel, waitingTooLong, type ViewKey } from '../../../lib/leadsAdmin';
import { actorLabel } from '../../../lib/authz';
import { listStaff } from '../../../lib/staff';
import { formatDateTimeIst } from '../../../lib/format';
import { telHref, waHref } from '../../../lib/contact';
import PhoneInput from '../../../components/PhoneInput';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}
const db = env.DB;
const me = actorLabel(Astro.locals.admin);

// Where to go back to after a button on the list: only a leads page on this site.
const safeBack = (v: unknown) => (typeof v === 'string' && /^\/admin\/leads(\?[^\s\\]*)?$/.test(v) ? v : '/admin/leads');

if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  if (String(form.get('_action') ?? '') === 'take') {
    await takeLead(db, String(form.get('id') ?? ''), me).catch(() => null);
    return Astro.redirect(safeBack(form.get('back')));
  }
  if (String(form.get('_action') ?? '') === 'add') {
    const name = String(form.get('name') ?? '').trim();
    const email = String(form.get('email') ?? '').trim();
    const phone = String(form.get('phone') ?? '').trim();
    const picked = String(form.get('channel') ?? 'manual');
    const channel = ((CHANNELS as readonly string[]).includes(picked) ? picked : 'manual') as Channel;
    if (name && (email || phone)) {
      const res = await recordLead(db, {
        channel,
        identifiers: [
          ...(email ? [{ type: 'email' as const, value: email, source: 'admin' }] : []),
          ...(phone ? [{ type: 'phone' as const, value: phone, source: 'admin' }] : []),
        ],
        name,
        message: String(form.get('message') ?? ''),
        tourInterest: String(form.get('tourInterest') ?? ''),
        type: 'manual',
        externalRef: `manual:${crypto.randomUUID()}`,
        createdBy: me,
      });
      // Someone who adds a lead from a call or a visit is the one handling it.
      await takeLead(db, res.leadId, me).catch(() => null);
      return Astro.redirect(`/admin/leads/${res.leadId}`);
    }
  }
  return Astro.redirect('/admin/leads');
}

const q = Astro.url.searchParams;
const view = (VIEWS.find((v) => v.key === q.get('view'))?.key ?? 'attention') as ViewKey;
const channel = q.get('channel') ?? '';
const stage = q.get('stage') ?? '';
const search = q.get('q') ?? '';
const cursor = q.get('cursor') ?? '';

let failed = false;
let rows: Awaited<ReturnType<typeof listLeadsView>>['rows'] = [];
let next: string | null = null;
let counts: Record<string, number> = {};
let waiting = 0;
let staffNames: Record<string, string> = {};
if (db) {
  try {
    staffNames = Object.fromEntries((await listStaff(db).catch(() => [])).map((s) => [s.email, s.name || s.email]));
    const page = await listLeadsView(db, { view, channel, stage, q: search, cursor, me });
    rows = page.rows;
    next = page.next;
    counts = await viewCounts(db, new Date().toISOString(), me);
    waiting = await waitingTooLong(db);
  } catch (err) {
    failed = true;
    console.error('admin leads: list failed', err instanceof Error ? err.message : 'error');
  }
}

const base = (extra: Record<string, string>) => {
  const p = new URLSearchParams();
  const all = { view, channel, stage, q: search, ...extra };
  for (const [k, v] of Object.entries(all)) if (v) p.set(k, v);
  return `/admin/leads?${p.toString()}`;
};
const stageClass = (s: string) =>
  s === 'booked' || s === 'converted' ? 'bg-green-100 text-green-800' :
  s === 'lost' || s === 'spam' ? 'bg-red-100 text-red-800' :
  s === 'deposit_paid' || s === 'quote_sent' ? 'bg-brand-100 text-brand-700' :
  s === 'contacted' || s === 'qualified' ? 'bg-blue-100 text-blue-800' :
  'bg-stone-100 text-stone-700';
const bucketClass = { hot: 'bg-red-100 text-red-800', warm: 'bg-brand-100 text-brand-700', cold: 'bg-stone-100 text-stone-600' } as const;
const contactBtn = 'inline-flex min-h-11 items-center rounded border border-violet-200 bg-white px-3 text-sm text-stone-800';
const field = 'rounded border border-violet-200 px-3 py-2';
const back = Astro.url.pathname + Astro.url.search;
---
<AdminLayout title="Leads">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold">Leads</h1>
    <div class="flex flex-wrap gap-2 text-sm">
      <a href="/admin/leads/import" class="rounded border border-violet-200 bg-white px-3 py-2">Import CSV</a>
      <a href="/admin/leads/export" class="rounded border border-violet-200 bg-white px-3 py-2">Export CSV</a>
      <a href="/admin/leads/meta" class="rounded border border-violet-200 bg-white px-3 py-2">Facebook / Instagram</a>
      <a href="/admin/leads/subscribers" class="rounded border border-violet-200 bg-white px-3 py-2">Email subscribers</a>
      <a href="/admin/leads/report" class="rounded border border-violet-200 bg-white px-3 py-2">Report</a>
      <a href="/admin/leads/backfill" class="rounded border border-violet-200 bg-white px-3 py-2">Carry over existing</a>
    </div>
  </div>

  {failed && (
    <p class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-800">The leads could not be read. If the lead tables have not been added to the database yet, they need to be applied first.</p>
  )}
  {waiting > 0 && (
    <p class="mb-4 rounded-lg bg-amber-50 p-3 text-sm text-amber-900">{waiting} new {waiting === 1 ? 'lead has' : 'leads have'} waited more than an hour for a first reply.</p>
  )}

  <nav class="mb-4 flex flex-wrap gap-2 text-sm" aria-label="Saved views">
    {VIEWS.map((v) => (
      <a href={`/admin/leads?view=${v.key}`} class={`rounded-full border px-3 py-1.5 ${v.key === view ? 'border-amber-800 btn-primary text-white' : 'border-violet-200 bg-white text-stone-700'}`}>
        {v.label}{counts[v.key] ? ` (${counts[v.key]})` : ''}
      </a>
    ))}
  </nav>

  <form method="GET" class="mb-4 grid gap-2 text-sm sm:grid-cols-5">
    <input type="hidden" name="view" value={view} />
    <input name="q" value={search} placeholder="Search name, email, phone, tour" class={`${field} sm:col-span-2`} />
    <select name="stage" class={field} aria-label="Stage">
      <option value="">Any stage</option>
      {LEAD_STAGES.map((s) => <option value={s} selected={stage === s}>{STAGE_LABELS[s]}</option>)}
    </select>
    <select name="channel" class={field} aria-label="Channel">
      <option value="">Any channel</option>
      {CHANNELS.map((c) => <option value={c} selected={channel === c}>{CHANNEL_LABELS[c]}</option>)}
    </select>
    <button type="submit" class="rounded btn-primary px-4 py-2 text-white">Filter</button>
  </form>

  <details class="mb-6 rounded-xl border border-violet-100 bg-white p-6 text-sm">
    <summary class="cursor-pointer font-semibold">+ Add a lead (call, walk-in, email, anything else)</summary>
    <form method="POST" class="mt-4 grid gap-3 md:grid-cols-2">
      <input type="hidden" name="_action" value="add" />
      <input name="name" placeholder="Name" required class={field} />
      <select name="channel" class={field} aria-label="Where did it come from?">
        {(['manual', 'phone', 'email', 'whatsapp', 'instagram_dm', 'facebook_dm', 'marketplace'] as const).map((c) => <option value={c}>{CHANNEL_LABELS[c]}</option>)}
      </select>
      <input name="email" type="email" placeholder="Email" class={field} />
      <PhoneInput client:load id="leadPhone" name="phone" />
      <input name="tourInterest" placeholder="Tour interest" class={field} />
      <textarea name="message" placeholder="Message / notes" class={`${field} md:col-span-2`}></textarea>
      <p class="text-xs text-stone-500 md:col-span-2">Add an email or a phone number. Hand-added people are not marked as agreeing to marketing email.</p>
      <button type="submit" class="rounded btn-primary px-4 py-2 text-white md:col-span-2">Add lead</button>
    </form>
  </details>

  {rows.length === 0 ? (
    <p class="rounded-xl border border-violet-100 bg-white p-4 text-sm text-stone-700">{failed ? '' : view === 'attention' ? 'Nothing needs attention right now. New enquiries and follow-ups that have come due appear here.' : view === 'mine' ? 'No open leads are assigned to you. Use "Take it" on a lead to start handling it.' : 'No leads here.'}</p>
  ) : (
    <ul class="space-y-3">
      {rows.map((l) => {
        const bucket = scoreBucket(l.score ?? 0);
        const wa = l.phone ? waHref(l.phone) : null;
        const wait = waitingLabel(l);
        const closed = l.status === 'booked' || l.status === 'converted' || l.status === 'lost' || l.status === 'spam';
        return (
          <li class="rounded-xl border border-violet-100 bg-white p-4 text-sm">
            <div class="flex items-start justify-between gap-3">
              <a href={`/admin/leads/${l.id}`} class="text-base font-semibold text-amber-900 hover:underline">{l.name}</a>
              <div class="flex shrink-0 flex-wrap justify-end gap-1">
                <span class={`rounded px-2 py-0.5 text-xs ${stageClass(l.status)}`}>{STAGE_LABELS[l.status] ?? l.status}</span>
                {l.status !== 'booked' && l.status !== 'lost' && l.status !== 'spam' && <span class={`rounded px-2 py-0.5 text-xs ${bucketClass[bucket]}`}>{bucket}</span>}
              </div>
            </div>
            <p class="mt-0.5 text-xs text-stone-500">
              {CHANNEL_LABELS[l.channel] ?? l.channel} · {formatDateTimeIst(l.last_activity_at ?? l.created_at)}
              {l.next_action_at && <span class="text-brand-700"> · follow up {formatDateTimeIst(l.next_action_at)}</span>}
              {wait && <span class="font-semibold text-amber-800"> · {wait}</span>}
            </p>
            {!closed && <p class="mt-0.5 text-xs text-stone-600">Handled by: <span class={l.owner === '' ? 'font-semibold text-amber-800' : 'font-semibold'}>{ownerLabel(l.owner, staffNames)}</span></p>}
            {l.tour_interest && <p class="mt-2"><span class="text-stone-500">Interested in:</span> {l.tour_interest}</p>}
            {l.message && <p class="mt-1 line-clamp-2 whitespace-pre-line text-stone-700">{l.message}</p>}
            <div class="mt-3 flex flex-wrap gap-2">
              {l.phone && <a href={telHref(l.phone)} class={contactBtn}>Call</a>}
              {wa && <a href={wa} target="_blank" rel="noopener noreferrer" class={contactBtn}>WhatsApp</a>}
              {l.email && <a href={`mailto:${l.email}`} class={contactBtn}>Email</a>}
              <a href={`/admin/leads/${l.id}`} class={contactBtn}>Open</a>
              {l.owner === '' && !closed && (
                <form method="POST"><input type="hidden" name="_action" value="take" /><input type="hidden" name="id" value={l.id} /><input type="hidden" name="back" value={back} /><button class="inline-flex min-h-11 items-center rounded btn-primary px-3 text-sm text-white">Take it</button></form>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  )}

  {next && (
    <p class="mt-6"><a href={base({ cursor: next })} class="rounded border border-violet-200 bg-white px-4 py-2 text-sm">Older leads</a></p>
  )}
</AdminLayout>
