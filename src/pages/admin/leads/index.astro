---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { setFlash } from '../../../lib/flash';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { recordLead, scoreBucket, CHANNELS, CHANNEL_LABELS, LEAD_STAGES, type Channel } from '../../../lib/contacts';
import { VIEWS, STAGE_LABELS, PIPELINE_STAGES, INSIGHT_DAYS, listLeadsView, loadLeadInsights, minutesLabel, ownerLabel, takeLead, viewCounts, waitingLabel, waitingTooLong, type LeadInsights, type ViewKey } from '../../../lib/leadsAdmin';
import { actorLabel } from '../../../lib/authz';
import { listStaff } from '../../../lib/staff';
import { formatDateTimeIst } from '../../../lib/format';
import { telHref, waHref } from '../../../lib/contact';
import { chatLinks } from '../../../lib/waDirect';
import { normalisePhone } from '../../../lib/whatsapp';
import PhoneInput from '../../../components/PhoneInput';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}
const db = env.DB;
const me = actorLabel(Astro.locals.admin);

// Where to go back to after a button on the list: only a leads page on this site.
const safeBack = (v: unknown) => (typeof v === 'string' && /^\/admin\/leads(\?[^\s\\]*)?$/.test(v) ? v : '/admin/leads');

if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  if (String(form.get('_action') ?? '') === 'take') {
    await takeLead(db, String(form.get('id') ?? ''), me).catch(() => null);
    setFlash(Astro.cookies, 'taken');
    return Astro.redirect(safeBack(form.get('back')));
  }
  if (String(form.get('_action') ?? '') === 'add') {
    const name = String(form.get('name') ?? '').trim();
    const email = String(form.get('email') ?? '').trim();
    const phone = String(form.get('phone') ?? '').trim();
    const picked = String(form.get('channel') ?? 'manual');
    const channel = ((CHANNELS as readonly string[]).includes(picked) ? picked : 'manual') as Channel;
    if (name && (email || phone)) {
      const res = await recordLead(db, {
        channel,
        identifiers: [
          ...(email ? [{ type: 'email' as const, value: email, source: 'admin' }] : []),
          ...(phone ? [{ type: 'phone' as const, value: phone, source: 'admin' }] : []),
        ],
        name,
        message: String(form.get('message') ?? ''),
        tourInterest: String(form.get('tourInterest') ?? ''),
        type: 'manual',
        externalRef: `manual:${crypto.randomUUID()}`,
        createdBy: me,
      });
      // Someone who adds a lead from a call or a visit is the one handling it.
      await takeLead(db, res.leadId, me).catch(() => null);
      setFlash(Astro.cookies, 'lead_added');
      return Astro.redirect(`/admin/leads/${res.leadId}`);
    }
  }
  return Astro.redirect('/admin/leads');
}

const q = Astro.url.searchParams;
const view = (VIEWS.find((v) => v.key === q.get('view'))?.key ?? 'attention') as ViewKey;
const channel = q.get('channel') ?? '';
const stage = q.get('stage') ?? '';
const search = q.get('q') ?? '';
const cursor = q.get('cursor') ?? '';

let failed = false;
let rows: Awaited<ReturnType<typeof listLeadsView>>['rows'] = [];
let next: string | null = null;
let counts: Record<string, number> = {};
let waiting = 0;
let staffNames: Record<string, string> = {};
let insights: LeadInsights | null = null;
let inboxLinks = new Map<string, string>(); // phone -> the guest's chat in the WhatsApp inbox, for those who have one
if (db) {
  try {
    // All four are independent, so they go to the database together (one round trip, not four in a row).
    const nowIso = new Date().toISOString();
    const [staff, page, viewTotals, tooLong, ins] = await Promise.all([
      listStaff(db).catch(() => []),
      listLeadsView(db, { view, channel, stage, q: search, cursor, me }),
      viewCounts(db, nowIso, me),
      waitingTooLong(db),
      loadLeadInsights(db).catch((err) => { console.error('admin leads: insights failed', err instanceof Error ? err.message : 'error'); return null; }),
    ]);
    insights = ins;
    staffNames = Object.fromEntries(staff.map((s) => [s.email, s.name || s.email]));
    rows = page.rows;
    next = page.next;
    counts = viewTotals;
    waiting = tooLong;
    inboxLinks = await chatLinks(db, rows.map((r) => r.phone)).catch(() => inboxLinks);
  } catch (err) {
    failed = true;
    console.error('admin leads: list failed', err instanceof Error ? err.message : 'error');
  }
}

const base = (extra: Record<string, string>) => {
  const p = new URLSearchParams();
  const all = { view, channel, stage, q: search, ...extra };
  for (const [k, v] of Object.entries(all)) if (v) p.set(k, v);
  return `/admin/leads?${p.toString()}`;
};
const stageClass = (s: string) =>
  s === 'booked' || s === 'converted' ? 'badge-success' :
  s === 'lost' || s === 'spam' ? 'badge-danger' :
  s === 'deposit_paid' || s === 'quote_sent' ? 'badge-brand' :
  s === 'contacted' || s === 'qualified' ? 'badge-info' :
  'badge-neutral';
const bucketClass = { hot: 'badge-danger', warm: 'badge-warn', cold: 'badge-neutral' } as const;
// The coloured edge of a lead card follows its stage, the same colours as the pills.
const edge = (s: string) =>
  s === 'booked' || s === 'converted' ? 'border-l-emerald-500' :
  s === 'lost' || s === 'spam' ? 'border-l-rose-400' :
  s === 'deposit_paid' || s === 'quote_sent' ? 'border-l-violet-500' :
  s === 'contacted' || s === 'qualified' ? 'border-l-sky-500' :
  'border-l-amber-400';
const initial = (name: string) => (name.trim()[0] ?? '?').toUpperCase();
const tiles = [
  { key: 'attention', label: 'Needs attention', hint: 'New enquiries and follow-ups that have come due.', tone: 'warn' },
  { key: 'unanswered', label: 'New and unanswered', hint: 'Nobody has replied yet.', tone: 'danger' },
  { key: 'followups', label: 'Follow-ups due', hint: 'Open leads whose follow-up date has come.', tone: 'info' },
  { key: 'mine', label: 'Mine', hint: 'Open leads you are handling.', tone: 'brand' },
] as const;
const tileKeys = new Set<string>(tiles.map((t) => t.key));
const open = counts.open ?? 0;
// The pipeline: open leads per stage. The funnel bars share one violet ramp, darker the closer to booking.
const pipe = insights?.pipeline;
const pipeMax = Math.max(1, ...PIPELINE_STAGES.map((k) => pipe?.[k] ?? 0));
const pipeShade = ['bg-violet-200', 'bg-violet-300', 'bg-violet-400', 'bg-violet-500', 'bg-violet-700'];
const channelsTop = (insights?.channels ?? []).slice(0, 6);
const channelRest = (insights?.channels ?? []).slice(6).reduce((t, c) => t + c.count, 0);
const channelMax = Math.max(1, ...channelsTop.map((c) => c.count));
const speed = insights?.speed;
// The verdict counts the enquiries nobody has answered too, so a good median among a few replies cannot look like good service.
const coverage = speed && speed.total ? speed.answered / speed.total : 1;
const unanswered = speed ? speed.total - speed.answered : 0;
const speedTone = !speed || speed.answered === 0 ? 'info' : coverage < 0.5 ? 'danger' : coverage < 0.8 ? 'warn' : (speed.medianMinutes ?? 0) <= 60 ? 'success' : (speed.medianMinutes ?? 0) <= 240 ? 'warn' : 'danger';
const speedPct = speed && speed.total ? Math.round((speed.withinHour / speed.total) * 100) : 0;
const contactBtn = 'inline-flex min-h-11 items-center rounded border border-violet-200 bg-white px-3 text-sm text-stone-800';
const field = 'rounded border border-violet-200 px-3 py-2';
const back = Astro.url.pathname + Astro.url.search;
---
<AdminLayout title="Leads">
  <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-semibold">Leads</h1>
      <p class="text-sm text-stone-600">{open} open · {counts.attention ?? 0 ? `${counts.attention} need attention` : 'nothing needs attention'}</p>
    </div>
    <div class="flex flex-wrap gap-2 text-sm">
      <a href="/admin/leads/import" class="rounded border border-violet-200 bg-white px-3 py-2">Import CSV</a>
      <a href="/admin/leads/export" class="rounded border border-violet-200 bg-white px-3 py-2">Export CSV</a>
      <a href="/admin/leads/meta" class="rounded border border-violet-200 bg-white px-3 py-2">Facebook / Instagram</a>
      <a href="/admin/leads/subscribers" class="rounded border border-violet-200 bg-white px-3 py-2">Email subscribers</a>
      <a href="/admin/leads/report" class="rounded border border-violet-200 bg-white px-3 py-2">Report</a>
      <a href="/admin/leads/backfill" class="rounded border border-violet-200 bg-white px-3 py-2">Carry over existing</a>
    </div>
  </div>

  {failed && (
    <p class="notice notice-danger mb-4">The leads could not be read. If the lead tables have not been added to the database yet, they need to be applied first.</p>
  )}
  {waiting > 0 && (
    <p class="notice notice-warn mb-4">{waiting} new {waiting === 1 ? 'lead has' : 'leads have'} waited more than an hour for a first reply.</p>
  )}

  <section aria-label="Views" class="mb-6">
    <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
      {tiles.map((t) => {
        const n = counts[t.key] ?? 0;
        const active = view === t.key;
        const clear = n === 0 && t.key !== 'mine';
        return (
          <a href={`/admin/leads?view=${t.key}`} aria-current={active ? 'page' : undefined} class={`block rounded-xl border p-4 transition hover:-translate-y-0.5 hover:shadow-md ${clear ? 'tint-success' : `tint-${t.tone}`} ${active ? 'ring-2 ring-violet-500 ring-offset-2' : ''}`}>
            <span class="block text-4xl font-semibold leading-none text-stone-900">{n}</span>
            <span class="mt-2 block font-medium text-stone-800">{t.label}</span>
            <span class="block text-xs text-stone-600">{clear ? '✓ All clear.' : t.hint}</span>
          </a>
        );
      })}
    </div>
    <nav class="mt-3 flex flex-wrap gap-2 text-sm" aria-label="More views">
      {VIEWS.filter((v) => !tileKeys.has(v.key)).map((v) => (
        <a href={`/admin/leads?view=${v.key}`} aria-current={v.key === view ? 'page' : undefined} class={`rounded-full border px-3 py-1.5 ${v.key === view ? 'border-brand-700 btn-primary text-white' : 'border-violet-200 bg-white text-stone-700'}`}>
          {v.label}{counts[v.key] ? ` (${counts[v.key]})` : ''}
        </a>
      ))}
    </nav>
  </section>

  {insights && (
    <div class="mb-6 grid items-start gap-4 lg:grid-cols-3">
      <section aria-labelledby="pipeline" class="rounded-xl border border-violet-100 bg-white p-4">
        <h2 id="pipeline" class="mb-1 text-lg font-semibold">Pipeline</h2>
        <p class="mb-3 text-xs text-stone-600">Open leads by stage. Pick a stage to list them.</p>
        <ul class="space-y-2">
          {PIPELINE_STAGES.map((k, i) => {
            const n = pipe?.[k] ?? 0;
            return (
              <li>
                <a href={base({ view: 'open', stage: k, channel: '', cursor: '' })} data-tip={`${STAGE_LABELS[k]}: ${n} open ${n === 1 ? 'lead' : 'leads'}`} aria-current={stage === k ? 'true' : undefined} class={`vz block rounded-md px-1 py-0.5 hover:bg-violet-50 ${stage === k ? 'bg-violet-50' : ''}`}>
                  <span class="flex items-center justify-between text-sm"><span class="text-stone-800">{STAGE_LABELS[k]}</span><span class="font-semibold text-stone-900">{n}</span></span>
                  <span class="mt-1 block h-2.5 rounded-full bg-stone-100" aria-hidden="true"><span class={`block h-full rounded-full ${pipeShade[i]}`} style={`width:${n === 0 ? 0 : Math.max(6, Math.round((n / pipeMax) * 100))}%`}></span></span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>

      <section aria-labelledby="sources" class="rounded-xl border border-violet-100 bg-white p-4">
        <h2 id="sources" class="mb-1 text-lg font-semibold">Where enquiries come from</h2>
        <p class="mb-3 text-xs text-stone-600">Last {INSIGHT_DAYS} days, spam left out. Pick a channel to list its leads.</p>
        {channelsTop.length === 0 ? (
          <p class="text-sm text-stone-600">No enquiries in the last {INSIGHT_DAYS} days.</p>
        ) : (
          <ul class="space-y-2">
            {channelsTop.map((c) => (
              <li>
                <a href={base({ view: 'all', channel: c.channel, stage: '', cursor: '' })} data-tip={`${CHANNEL_LABELS[c.channel] ?? c.channel}: ${c.count} ${c.count === 1 ? 'enquiry' : 'enquiries'}`} class={`vz block rounded-md px-1 py-0.5 hover:bg-violet-50 ${channel === c.channel ? 'bg-violet-50' : ''}`}>
                  <span class="flex items-center justify-between text-sm"><span class="truncate text-stone-800">{CHANNEL_LABELS[c.channel] ?? c.channel}</span><span class="font-semibold text-stone-900">{c.count}</span></span>
                  <span class="mt-1 block h-2.5 rounded-full bg-stone-100" aria-hidden="true"><span class="block h-full rounded-full bg-violet-500" style={`width:${Math.max(6, Math.round((c.count / channelMax) * 100))}%`}></span></span>
                </a>
              </li>
            ))}
            {channelRest > 0 && <li class="px-1 text-sm text-stone-600">Other channels: {channelRest}</li>}
          </ul>
        )}
      </section>

      <section aria-labelledby="speed" class={`rounded-xl border p-4 tint-${speedTone}`}>
        <h2 id="speed" class="mb-1 text-lg font-semibold">How fast we reply</h2>
        <p class="mb-3 text-xs text-stone-700">First reply to enquiries from the last {INSIGHT_DAYS} days.</p>
        {!speed || speed.total === 0 ? (
          <p class="text-sm text-stone-700">No enquiries in the last {INSIGHT_DAYS} days.</p>
        ) : speed.answered === 0 ? (
          <p class="text-sm text-stone-800">None of the {speed.total} enquiries has had a reply recorded yet.</p>
        ) : (
          <>
            <p class="text-4xl font-semibold leading-none text-stone-900">{minutesLabel(speed.medianMinutes ?? 0)}</p>
            <p class="mt-1 text-sm text-stone-800">typical wait among the {speed.answered} replied</p>
            <div class="mt-4">
              <div class="flex items-baseline justify-between text-sm"><span class="text-stone-800">Replied within an hour</span><span class="font-semibold text-stone-900">{speed.withinHour} of {speed.total} ({speedPct}%)</span></div>
              <div class="mt-1 h-2.5 rounded-full bg-white/70" role="img" aria-label={`${speedPct} percent replied within an hour`}><div class="h-full rounded-full bg-violet-600" style={`width:${speedPct}%`}></div></div>
              <p class="mt-3 text-xs text-stone-700">
                {unanswered > 0 ? `⚠ ${unanswered} of ${speed.total} ${unanswered === 1 ? 'enquiry has' : 'enquiries have'} no reply recorded. ` : '✓ Every enquiry has a reply. '}
                {speedTone === 'success' ? 'A typical reply comes within the hour.' : (speed.medianMinutes ?? 0) > 240 ? 'A typical reply takes over four hours.' : (speed.medianMinutes ?? 0) > 60 ? 'A typical reply takes over an hour.' : ''}
              </p>
            </div>
          </>
        )}
      </section>
    </div>
  )}

  <form method="GET" class="mb-4 grid gap-2 text-sm sm:grid-cols-5">
    <input type="hidden" name="view" value={view} />
    <input name="q" value={search} placeholder="Search name, email, phone, tour" class={`${field} sm:col-span-2`} />
    <select name="stage" class={field} aria-label="Stage">
      <option value="">Any stage</option>
      {LEAD_STAGES.map((s) => <option value={s} selected={stage === s}>{STAGE_LABELS[s]}</option>)}
    </select>
    <select name="channel" class={field} aria-label="Channel">
      <option value="">Any channel</option>
      {CHANNELS.map((c) => <option value={c} selected={channel === c}>{CHANNEL_LABELS[c]}</option>)}
    </select>
    <button type="submit" class="rounded btn-primary px-4 py-2 text-white">Filter</button>
  </form>

  <details class="mb-6 rounded-xl border border-violet-100 bg-white p-6 text-sm">
    <summary class="cursor-pointer font-semibold">+ Add a lead (call, walk-in, email, anything else)</summary>
    <form method="POST" class="mt-4 grid gap-3 md:grid-cols-2">
      <input type="hidden" name="_action" value="add" />
      <input name="name" placeholder="Name" required class={field} />
      <select name="channel" class={field} aria-label="Where did it come from?">
        {(['manual', 'phone', 'email', 'whatsapp', 'instagram_dm', 'facebook_dm', 'marketplace'] as const).map((c) => <option value={c}>{CHANNEL_LABELS[c]}</option>)}
      </select>
      <input name="email" type="email" placeholder="Email" class={field} />
      <PhoneInput client:load tone="admin" id="leadPhone" name="phone" />
      <input name="tourInterest" placeholder="Tour interest" class={field} />
      <textarea name="message" placeholder="Message / notes" class={`${field} md:col-span-2`}></textarea>
      <p class="text-xs text-stone-500 md:col-span-2">Add an email or a phone number. Hand-added people are not marked as agreeing to marketing email.</p>
      <button type="submit" class="rounded btn-primary px-4 py-2 text-white md:col-span-2">Add lead</button>
    </form>
  </details>

  {rows.length === 0 ? (
    <p class="rounded-xl border border-violet-100 bg-white p-4 text-sm text-stone-700">{failed ? '' : view === 'attention' ? 'Nothing needs attention right now. New enquiries and follow-ups that have come due appear here.' : view === 'mine' ? 'No open leads are assigned to you. Use "Take it" on a lead to start handling it.' : 'No leads here.'}</p>
  ) : (
    <ul class="space-y-3">
      {rows.map((l) => {
        const bucket = scoreBucket(l.score ?? 0);
        const inboxChat = l.phone ? inboxLinks.get(normalisePhone(l.phone)) : undefined;
        const wa = inboxChat ?? (l.phone ? waHref(l.phone) : null);
        const wait = waitingLabel(l);
        const closed = l.status === 'booked' || l.status === 'converted' || l.status === 'lost' || l.status === 'spam';
        return (
          <li class={`rounded-xl border border-l-4 border-violet-100 bg-white p-4 text-sm transition hover:shadow-md ${edge(l.status)}`}>
            <div class="flex items-start justify-between gap-3">
              <span class="flex min-w-0 items-center gap-2.5">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full badge-brand text-sm font-semibold" aria-hidden="true">{initial(l.name)}</span>
                <a href={`/admin/leads/${l.id}`} class="truncate text-base font-semibold text-brand-700 hover:underline">{l.name}</a>
              </span>
              <div class="flex shrink-0 flex-wrap justify-end gap-1">
                <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${stageClass(l.status)}`}>{STAGE_LABELS[l.status] ?? l.status}</span>
                {l.status !== 'booked' && l.status !== 'lost' && l.status !== 'spam' && <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${bucketClass[bucket]}`}>{bucket}</span>}
              </div>
            </div>
            <p class="mt-0.5 text-xs text-stone-500">
              {CHANNEL_LABELS[l.channel] ?? l.channel} · {formatDateTimeIst(l.last_activity_at ?? l.created_at)}
              {l.next_action_at && <span class="text-brand-700"> · follow up {formatDateTimeIst(l.next_action_at)}</span>}
              {wait && <span class="font-semibold text-brand-700"> · {wait}</span>}
            </p>
            {!closed && <p class="mt-0.5 text-xs text-stone-600">Handled by: <span class={l.owner === '' ? 'font-semibold text-brand-700' : 'font-semibold'}>{ownerLabel(l.owner, staffNames)}</span></p>}
            {l.tour_interest && <p class="mt-2"><span class="text-stone-500">Interested in:</span> {l.tour_interest}</p>}
            {l.message && <p class="mt-1 line-clamp-2 whitespace-pre-line text-stone-700">{l.message}</p>}
            <div class="mt-3 flex flex-wrap gap-2">
              {l.phone && <a href={telHref(l.phone)} class={contactBtn}>Call</a>}
              {wa && <a href={wa} {...(inboxChat ? {} : { target: '_blank', rel: 'noopener noreferrer' })} class={contactBtn}>WhatsApp</a>}
              {l.email && <a href={`mailto:${l.email}`} class={contactBtn}>Email</a>}
              <a href={`/admin/leads/${l.id}`} class={contactBtn}>Open</a>
              {l.owner === '' && !closed && (
                <form method="POST"><input type="hidden" name="_action" value="take" /><input type="hidden" name="id" value={l.id} /><input type="hidden" name="back" value={back} /><button class="inline-flex min-h-11 items-center rounded btn-primary px-3 text-sm text-white">Take it</button></form>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  )}

  {next && (
    <p class="mt-6"><a href={base({ cursor: next })} class="rounded border border-violet-200 bg-white px-4 py-2 text-sm">Older leads</a></p>
  )}
  <div id="viz-tip" role="tooltip" hidden class="pointer-events-none fixed z-50 max-w-xs rounded-lg border border-violet-200 bg-white px-3 py-2 text-xs text-stone-800 shadow-lg"></div>
</AdminLayout>

<script is:inline>
  (function () {
    // One tooltip for the pipeline and the channel bars. The text is set with textContent, never as HTML.
    var tip = document.getElementById('viz-tip');
    if (!tip) return;
    document.querySelectorAll('[data-tip]').forEach(function (el) {
      var show = function (x, y) {
        tip.textContent = el.getAttribute('data-tip');
        tip.hidden = false;
        var w = tip.offsetWidth, h = tip.offsetHeight;
        tip.style.left = Math.max(8, Math.min(window.innerWidth - w - 8, x + 12)) + 'px';
        tip.style.top = Math.max(8, Math.min(window.innerHeight - h - 8, y - h - 12)) + 'px';
      };
      el.addEventListener('pointermove', function (e) { show(e.clientX, e.clientY); });
      el.addEventListener('focus', function () { var b = el.getBoundingClientRect(); show(b.left + b.width / 2, b.top); });
      el.addEventListener('pointerleave', function () { tip.hidden = true; });
      el.addEventListener('blur', function () { tip.hidden = true; });
    });
  })();
</script>
