---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { listLeads, insertLead, updateLeadStatus } from '../../../lib/crm';
import { formatDateTimeIst } from '../../../lib/format';
import { telHref, waHref } from '../../../lib/contact';
import PhoneInput from '../../../components/PhoneInput';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET))) {
  return Astro.redirect('/admin/login');
}

const db = env.DB;

if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');

  if (action === 'add') {
    const name = String(form.get('name') ?? '').trim();
    if (name) {
      await insertLead(db, {
        name,
        email: String(form.get('email') ?? ''),
        phone: String(form.get('phone') ?? ''),
        message: String(form.get('message') ?? ''),
        tourInterest: String(form.get('tourInterest') ?? ''),
      });
    }
  } else if (action === 'status') {
    const id = String(form.get('leadId') ?? '');
    const status = String(form.get('status') ?? '');
    if (id && status) await updateLeadStatus(db, id, status);
  }
  return Astro.redirect('/admin/leads');
}

const leads = db ? await listLeads(db) : []; // newest first

const STATUSES = [
  { value: 'new', label: 'New' },
  { value: 'contacted', label: 'Contacted' },
  { value: 'converted', label: 'Converted' },
  { value: 'lost', label: 'Lost' },
];
const statusClass = (status: string) =>
  status === 'converted' ? 'bg-green-100 text-green-800' :
  status === 'lost' ? 'bg-red-100 text-red-800' :
  status === 'contacted' ? 'bg-blue-100 text-blue-800' :
  'bg-stone-100 text-stone-700';
const contactBtn = 'inline-flex min-h-11 items-center rounded border border-stone-300 bg-white px-3 text-sm text-stone-800';
---
<AdminLayout title="Leads">
  <h1 class="text-2xl font-semibold mb-6">Leads</h1>

  <details class="bg-white rounded-xl border border-stone-200 p-6 mb-6 text-sm">
    <summary class="font-semibold cursor-pointer">+ Add a lead</summary>
    <form method="POST" class="grid md:grid-cols-2 gap-3 mt-4">
      <input type="hidden" name="_action" value="add" />
      <input name="name" placeholder="Name" required class="rounded border border-stone-300 px-3 py-2" />
      <input name="email" type="email" placeholder="Email" class="rounded border border-stone-300 px-3 py-2" />
      <PhoneInput client:load id="leadPhone" name="phone" />
      <input name="tourInterest" placeholder="Tour interest" class="rounded border border-stone-300 px-3 py-2" />
      <textarea name="message" placeholder="Message / notes" class="rounded border border-stone-300 px-3 py-2 md:col-span-2"></textarea>
      <button type="submit" class="rounded bg-amber-800 text-white px-4 py-2 md:col-span-2">Add lead</button>
    </form>
  </details>

  {leads.length === 0 ? (
    <p class="text-stone-500">No leads yet.</p>
  ) : (
    <>
    <!-- Phones: one card per lead, with tap-to-contact and status. -->
    <ul class="md:hidden space-y-3">
      {leads.map((l) => (
        <li class="rounded-xl border border-stone-200 bg-white p-4 text-sm">
          <div class="flex items-start justify-between gap-3">
            <p class="font-semibold text-base">{l.name}</p>
            <span class={`shrink-0 px-2 py-0.5 rounded text-xs ${statusClass(l.status)}`}>{l.status}</span>
          </div>
          <p class="text-xs text-stone-500 mt-0.5">{formatDateTimeIst(l.created_at)}</p>
          {l.tour_interest && <p class="mt-2"><span class="text-stone-500">Interested in:</span> {l.tour_interest}</p>}
          {l.message && <p class="mt-1 text-stone-700 whitespace-pre-line">{l.message}</p>}
          {(l.phone || l.email) && (
            <div class="flex flex-wrap gap-2 mt-3">
              {l.phone && <a href={telHref(l.phone)} class={contactBtn}>Call</a>}
              {l.phone && waHref(l.phone) && <a href={waHref(l.phone)} target="_blank" rel="noopener noreferrer" class={contactBtn}>WhatsApp</a>}
              {l.email && <a href={`mailto:${l.email}`} class={contactBtn}>Email</a>}
            </div>
          )}
          {(l.phone || l.email) && <p class="text-xs text-stone-500 mt-2 break-all">{l.phone}{l.phone && l.email ? ' · ' : ''}{l.email}</p>}
          <form method="POST" class="flex gap-2 mt-3">
            <input type="hidden" name="_action" value="status" />
            <input type="hidden" name="leadId" value={l.id} />
            <select name="status" aria-label={`Status for ${l.name}`} class="flex-1 min-h-11 rounded border border-stone-300 px-2">
              {STATUSES.map((st) => <option value={st.value} selected={l.status === st.value}>{st.label}</option>)}
            </select>
            <button type="submit" class="min-h-11 rounded bg-amber-800 text-white px-4">Save</button>
          </form>
        </li>
      ))}
    </ul>
    <div class="hidden md:block bg-white rounded-xl border border-stone-200 overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-stone-50 text-left">
          <tr>
            <th class="px-4 py-2">Added</th>
            <th class="px-4 py-2">Name</th>
            <th class="px-4 py-2">Contact</th>
            <th class="px-4 py-2">Tour interest</th>
            <th class="px-4 py-2">Message</th>
            <th class="px-4 py-2">Status</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody>
          {leads.map((l) => (
            <tr class="border-t border-stone-100 align-top">
              <td class="px-4 py-2 whitespace-nowrap text-stone-500">{formatDateTimeIst(l.created_at)}</td>
              <td class="px-4 py-2">{l.name}</td>
              <td class="px-4 py-2">
                {l.email && <a href={`mailto:${l.email}`} class="text-amber-800 hover:underline">{l.email}</a>}
                {l.email && l.phone ? ' / ' : ''}
                {l.phone && <a href={telHref(l.phone)} class="text-amber-800 hover:underline">{l.phone}</a>}
              </td>
              <td class="px-4 py-2">{l.tour_interest}</td>
              <td class="px-4 py-2 max-w-xs">{l.message}</td>
              <td class="px-4 py-2">
                <span class={`px-2 py-0.5 rounded text-xs ${statusClass(l.status)}`}>{l.status}</span>
              </td>
              <td class="px-4 py-2">
                <form method="POST" class="flex items-center gap-1">
                  <input type="hidden" name="_action" value="status" />
                  <input type="hidden" name="leadId" value={l.id} />
                  <select name="status" aria-label={`Status for ${l.name}`} class="rounded border border-stone-300 px-2 py-1 text-xs">
                    {STATUSES.map((st) => <option value={st.value} selected={l.status === st.value}>{st.label}</option>)}
                  </select>
                  <button type="submit" class="rounded bg-amber-800 text-white px-3 py-1 text-xs">Save</button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    </>
  )}
</AdminLayout>
