---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { MAX_ATTEMPTS, diagnoseMeta, pollMeta } from '../../../lib/meta';
import { capiToken, testMetaCapi } from '../../../lib/metaCapi';
import { formatDateTimeIst } from '../../../lib/format';
import type { D1Like } from '../../../lib/db';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}
const db: D1Like | undefined = env.DB;

let message = '';
let diagnosis: string[] = [];
let capiCheck: string[] = [];
if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  if (String(form.get('_action') ?? '') === 'capi') {
    const code = String(form.get('test_code') ?? '').trim().replace(/[^A-Za-z0-9]/g, '').slice(0, 30);
    try {
      capiCheck = await testMetaCapi(env, code, {
        ip: (Astro.request.headers.get('cf-connecting-ip') ?? '').slice(0, 45),
        userAgent: (Astro.request.headers.get('user-agent') ?? '').slice(0, 400),
      });
    } catch {
      capiCheck = ['The test could not run.'];
    }
  } else if (String(form.get('_action') ?? '') === 'diagnose') {
    try {
      diagnosis = await diagnoseMeta(env, db);
    } catch {
      diagnosis = ['The test could not run.'];
    }
  } else
  try {
    if (db) {
      // A manual retry gets a fresh set of attempts.
      await db.prepare(`UPDATE meta_events SET attempts = 0, updated_at = '1970-01-01T00:00:00.000Z' WHERE status = 'failed'`).bind().run();
      const r = await pollMeta(env, db);
      message = `Retried. ${r.retried} retried events done, ${r.found} new leads found, ${r.failed} still failing.`;
    }
  } catch {
    message = 'That did not work. Check the settings below.';
  }
}

const settings = [
  ['App secret (signs webhooks)', !!env.META_APP_SECRET],
  ['Webhook verify token', !!env.META_VERIFY_TOKEN],
  ['Page access token', !!env.META_PAGE_ACCESS_TOKEN],
  ['Page id', !!env.META_PAGE_ID],
  ['Poll secret (GitHub job)', !!env.META_POLL_SECRET],
] as const;
const capiSource = capiToken(env).source;

let events: { kind: string; status: string; attempts: number; error: string; created_at: string; lead_id: string }[] = [];
let counts = { pending: 0, done: 0, failed: 0 };
let tableMissing = false;
if (db) {
  try {
    events = (await db.prepare(`SELECT kind, status, attempts, error, created_at, lead_id FROM meta_events ORDER BY id DESC LIMIT 25`).bind().all<(typeof events)[number]>()).results;
    const rows = (await db.prepare(`SELECT status, COUNT(*) AS n FROM meta_events GROUP BY status`).bind().all<{ status: string; n: number }>()).results;
    for (const r of rows) if (r.status in counts) counts[r.status as keyof typeof counts] = r.n;
  } catch {
    tableMissing = true;
  }
}
---
<AdminLayout title="Facebook and Instagram leads">
  <p class="mb-2 text-sm"><a href="/admin/leads" class="text-brand-700 hover:underline">&larr; All leads</a></p>
  <h1 class="mb-4 text-2xl font-semibold">Facebook and Instagram leads</h1>

  {tableMissing && <p class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-800">The Meta tables are not in the database yet (schema_meta.sql).</p>}
  {message && <p class="mb-4 rounded-lg bg-green-50 p-3 text-sm text-green-800">{message}</p>}

  <div class="mb-6 grid gap-4 md:grid-cols-2">
    <section class="rounded-xl border border-violet-100 bg-white p-4 text-sm">
      <h2 class="mb-2 font-semibold">Settings</h2>
      <ul class="space-y-1">
        {settings.map(([label, ok]) => <li class="flex justify-between"><span>{label}</span><span class={ok ? 'text-green-700' : 'text-red-700'}>{ok ? 'set' : 'missing'}</span></li>)}
      </ul>
      <p class="mt-2 text-xs text-stone-500">Only whether each is set is shown, never the value. Setup steps are in docs/meta-leads-runbook.md.</p>
    </section>
    <section class="rounded-xl border border-violet-100 bg-white p-4 text-sm">
      <h2 class="mb-2 font-semibold">Events received</h2>
      <p>Done {counts.done} · waiting {counts.pending} · failed {counts.failed}</p>
      <p class="mt-1 text-xs text-stone-500">Failed events are retried automatically every 15 minutes, up to {MAX_ATTEMPTS} times.</p>
      <form method="POST" class="mt-3"><input type="hidden" name="_action" value="retry" /><button class="min-h-11 rounded btn-primary px-4 text-white">Check Meta for leads now</button></form>
      <form method="POST" class="mt-2"><input type="hidden" name="_action" value="diagnose" /><button class="min-h-11 rounded border border-violet-200 bg-white px-4">Run connection test</button></form>
    </section>
  </div>

  {diagnosis.length > 0 && (
    <section class="mb-6 rounded-xl border border-violet-100 bg-white p-4 text-sm">
      <h2 class="mb-2 font-semibold">Connection test</h2>
      <ul class="list-disc space-y-1 pl-5 break-words">{diagnosis.map((line) => <li>{line}</li>)}</ul>
    </section>
  )}

  <section class="mb-6 rounded-xl border border-violet-100 bg-white p-4 text-sm">
    <h2 class="mb-2 font-semibold">Conversions API (server-side Purchase and Lead)</h2>
    <p>Sending with: <span class={capiSource === 'none' ? 'text-red-700' : 'text-green-700'}>{capiSource === 'own' ? 'its own token (META_CAPI_TOKEN)' : capiSource === 'leads' ? 'the leads system-user token' : 'no token, nothing is sent'}</span>{env.META_CAPI_TEST_CODE ? ' · test code ON (events go to Test events only)' : ''}</p>
    <form method="POST" class="mt-3 flex flex-wrap items-center gap-2">
      <input type="hidden" name="_action" value="capi" />
      <input name="test_code" placeholder="Test code, e.g. TEST12345" maxlength="30" class="min-h-11 rounded border border-violet-200 px-3" />
      <button class="min-h-11 rounded border border-violet-200 bg-white px-4">Test Conversions API</button>
    </form>
    <p class="mt-1 text-xs text-stone-500">The code is in Meta Events Manager, the dataset, Test events. Without a code only access is checked; nothing is sent.</p>
    {capiCheck.length > 0 && <ul class="mt-3 list-disc space-y-1 pl-5 break-words">{capiCheck.map((line) => <li>{line}</li>)}</ul>}
  </section>

  <section class="overflow-x-auto rounded-xl border border-violet-100 bg-white text-sm">
    <table class="w-full text-left">
      <thead class="bg-stone-50"><tr><th class="px-3 py-2">When</th><th class="px-3 py-2">Kind</th><th class="px-3 py-2">Status</th><th class="px-3 py-2">Note</th></tr></thead>
      <tbody>
        {events.length === 0 && <tr><td class="px-3 py-3 text-stone-500" colspan="4">Nothing received yet.</td></tr>}
        {events.map((e) => (
          <tr class="border-t border-stone-100">
            <td class="whitespace-nowrap px-3 py-2">{formatDateTimeIst(e.created_at)}</td>
            <td class="px-3 py-2">{e.kind === 'leadgen' ? 'Lead ad' : 'Message'}</td>
            <td class="px-3 py-2">{e.status}{e.attempts > 1 ? ` (${e.attempts} tries)` : ''}</td>
            <td class="px-3 py-2">{e.lead_id ? <a class="text-brand-700 hover:underline" href={`/admin/leads/${e.lead_id}`}>open lead</a> : e.error}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</AdminLayout>
