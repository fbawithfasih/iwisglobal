---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { auditContext, recordAudit } from '../../../lib/audit';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { LEAD_STAGES, LOST_REASONS, CHANNEL_LABELS, scoreBucket, setLeadStage, mergePeople, undoMerge, dismissDuplicate, refreshLeadScore, type LeadStage } from '../../../lib/contacts';
import { STAGE_LABELS, addNote, assignLead, completeFollowUp, getLeadDetail, markContacted, ownerLabel, setFollowUp, takeLead } from '../../../lib/leadsAdmin';
import { waitingLabel } from '../../../lib/leadsAdmin';
import { actorLabel, canDo } from '../../../lib/authz';
import { listStaff } from '../../../lib/staff';
import { formatDateTimeIst } from '../../../lib/format';
import type { D1Like } from '../../../lib/db';
import { erasePerson, personEmails, startDoubleOptIn, unsubscribePerson } from '../../../lib/marketing';
import { telHref, waHref } from '../../../lib/contact';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}
const db: D1Like | undefined = env.DB;
const id = Astro.params.id ?? '';
const actor = actorLabel(Astro.locals.admin);
if (!db || !id) return new Response('Not found', { status: 404 });

// Names for the people who can hold a lead: active team members by email.
const staffList = (await listStaff(db).catch(() => [])).filter((s) => s.status === 'active');
const staffNames: Record<string, string> = Object.fromEntries(staffList.map((s) => [s.email, s.name || s.email]));

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');
  if (action === 'erase' && !canDo(Astro.locals.admin, 'person', 'erase')) error = 'Only the owner can erase a person.';
  else try {
    if (action === 'stage') {
      const stage = String(form.get('stage') ?? '') as LeadStage;
      if ((LEAD_STAGES as readonly string[]).includes(stage)) {
        await setLeadStage(db, id, stage, { by: actor, lostReason: String(form.get('lostReason') ?? 'other') });
        // Moving a lead on means you are working it: take it if nobody else has.
        if (stage === 'contacted' || stage === 'qualified' || stage === 'quote_sent') await takeLead(db, id, actor);
        await refreshLeadScore(db, id);
      }
    } else if (action === 'note') {
      await addNote(db, id, String(form.get('body') ?? ''), actor);
    } else if (action === 'contacted') {
      await markContacted(db, id, actor);
      await setLeadStage(db, id, 'contacted', { by: actor }).catch(() => false);
    } else if (action === 'followup') {
      await setFollowUp(db, id, String(form.get('due') ?? ''), String(form.get('note') ?? ''), actor);
    } else if (action === 'take') {
      const r = await takeLead(db, id, actor);
      if (!r.ok) error = `${ownerLabel(r.heldBy, staffNames)} is already handling this lead.`;
    } else if (action === 'assign') {
      await assignLead(db, id, String(form.get('owner') ?? ''), actor);
    } else if (action === 'done') {
      await completeFollowUp(db, id, Number(form.get('activityId')));
    } else if (action === 'merge') {
      const res = await mergePeople(db, String(form.get('keep') ?? ''), String(form.get('drop') ?? ''), actor);
      if (!res.ok) error = res.error;
      else await recordAudit(db, auditContext(Astro.request, Astro.locals), { action: 'lead.merge', resource: 'person', resourceId: String(form.get('keep') ?? ''), summary: 'Merged two people into one', meta: { dropped: String(form.get('drop') ?? '') } });
    } else if (action === 'undo') {
      const res = await undoMerge(db, Number(form.get('logId')));
      if (!res.ok) error = res.error;
      else await recordAudit(db, auditContext(Astro.request, Astro.locals), { action: 'lead.merge_undo', resource: 'person', resourceId: String(form.get('logId') ?? ''), summary: 'Undid a merge' });
    } else if (action === 'dismiss') {
      await dismissDuplicate(db, Number(form.get('suggestionId')));
    } else if (action === 'resend_optin' || action === 'unsub' || action === 'erase') {
      const lead = await db.prepare(`SELECT person_id, language FROM leads WHERE id = ?`).bind(id).first<{ person_id: string | null; language: string }>();
      const pid = lead?.person_id;
      if (!pid) {
        error = 'This lead is not linked to a person yet.';
      } else if (action === 'resend_optin') {
        const emails = await personEmails(db, pid);
        if (emails.length === 0) error = 'There is no email address on file for this person.';
        else {
          const r = await startDoubleOptIn(env, db, pid, emails[0].value_raw, lead?.language || 'en');
          if (r !== 'sent') error = r === 'already' ? 'This person is already subscribed.' : r === 'blocked' ? 'This address asked not to be emailed (complaint, bounce or deletion) and cannot be re-added here.' : r === 'rate_limited' ? 'Three confirmation emails were already sent in the last hour.' : 'The confirmation email could not be sent.';
        }
      } else if (action === 'unsub') {
        await unsubscribePerson(db, pid, 'manual');
        await recordAudit(db, auditContext(Astro.request, Astro.locals), { action: 'person.unsubscribe', resource: 'person', resourceId: pid, summary: 'Marked unsubscribed on request' });
      } else if (String(form.get('confirm') ?? '').trim().toUpperCase() === 'ERASE') {
        await recordAudit(db, auditContext(Astro.request, Astro.locals), { action: 'person.erase', resource: 'person', resourceId: pid, summary: 'Erased a person (right to be forgotten)' });
        await erasePerson(db, pid, env.IMAGES);
        return Astro.redirect('/admin/leads');
      } else {
        error = 'To erase this person, type ERASE in the box.';
      }
    }
  } catch (err) {
    console.error('admin lead action failed', err instanceof Error ? err.message : 'error');
    error = 'That did not save. Please try again.';
  }
  if (!error) return Astro.redirect(`/admin/leads/${id}`);
}

const d = await getLeadDetail(db, id).catch(() => null);
if (!d) return new Response('Lead not found', { status: 404 });
const l = d.lead;
const bucket = scoreBucket(l.score ?? 0);
const wa = l.phone ? waHref(l.phone) : null;
const open = !['booked', 'converted', 'lost', 'spam'].includes(l.status);
const waiting = waitingLabel(l);
const btn = 'inline-flex min-h-11 items-center rounded border border-violet-200 bg-white px-3 text-sm text-stone-800';
const field = 'rounded border border-violet-200 px-3 py-2';
const kindClass: Record<string, string> = { touchpoint: 'bg-violet-100 text-violet-800', note: 'bg-brand-100 text-brand-700', stage: 'bg-blue-100 text-blue-800', task: 'bg-green-100 text-green-800' };
const marketing: Record<string, string> = { none: 'Not asked', pending: 'Asked, not yet confirmed', subscribed: 'Subscribed', unsubscribed: 'Unsubscribed', bounced: 'Address bounced', complained: 'Marked as spam' };
---
<AdminLayout title={l.name}>
  <p class="mb-2 text-sm"><a href="/admin/leads" class="text-brand-700 hover:underline">&larr; All leads</a></p>
  <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-2xl font-semibold">{l.name}</h1>
      <p class="text-sm text-stone-500">
        {CHANNEL_LABELS[l.channel] ?? l.channel} · added {formatDateTimeIst(l.created_at)}
        {l.first_response_at && <span> · first reply {formatDateTimeIst(l.first_response_at)}</span>}
        {waiting && <span class="font-semibold text-brand-700"> · {waiting}</span>}
      </p>
    </div>
    <div class="flex gap-1">
      <span class="rounded bg-stone-100 px-2 py-0.5 text-xs text-stone-700">{STAGE_LABELS[l.status] ?? l.status}</span>
      {open && <span class={`rounded px-2 py-0.5 text-xs ${bucket === 'hot' ? 'bg-red-100 text-red-800' : bucket === 'warm' ? 'bg-brand-100 text-brand-700' : 'bg-stone-100 text-stone-600'}`}>{bucket} · {l.score}</span>}
    </div>
  </div>

  {error && <p class="notice notice-danger mb-4">{error}</p>}

  {d.duplicates.map((dup) => (
    <div class="mb-4 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm">
      <p class="font-semibold">Possible duplicate: {dup.other_name}</p>
      <p class="text-stone-600">{dup.reason}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <form method="POST">
          <input type="hidden" name="_action" value="merge" />
          <input type="hidden" name="keep" value={l.person_id ?? ''} />
          <input type="hidden" name="drop" value={dup.other_id} />
          <button class="min-h-11 rounded btn-primary px-4 text-white" data-confirm="Merge these two people into this one? You can undo it." data-confirm-label="Merge">Merge into this person</button>
        </form>
        <form method="POST">
          <input type="hidden" name="_action" value="dismiss" />
          <input type="hidden" name="suggestionId" value={dup.id} />
          <button class="min-h-11 rounded border border-violet-200 bg-white px-4">Not the same person</button>
        </form>
      </div>
    </div>
  ))}
  {d.merges.map((m) => (
    <form method="POST" class="mb-4 flex items-center justify-between gap-3 rounded-lg bg-stone-50 p-3 text-sm">
      <span>Merged with another record on {formatDateTimeIst(m.merged_at)}.</span>
      <input type="hidden" name="_action" value="undo" />
      <input type="hidden" name="logId" value={m.id} />
      <button class="rounded border border-violet-200 bg-white px-3 py-1.5">Undo merge</button>
    </form>
  ))}

  <div class="grid gap-6 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-1">
      <section class="rounded-xl border border-violet-100 bg-white p-4 text-sm">
        <h2 class="mb-2 font-semibold">Contact</h2>
        <div class="mb-3 flex flex-wrap gap-2">
          {l.phone && <a href={telHref(l.phone)} class={btn}>Call</a>}
          {wa && <a href={wa} target="_blank" rel="noopener noreferrer" class={btn}>WhatsApp</a>}
          {l.email && <a href={`mailto:${l.email}`} class={btn}>Email</a>}
        </div>
        <ul class="space-y-1 break-all text-stone-700">
          {d.identifiers.map((i) => <li><span class="text-stone-500">{i.type}:</span> {i.value_raw}{i.is_shared ? ' (shared)' : ''}</li>)}
          {d.identifiers.length === 0 && <li>{l.email}{l.email && l.phone ? ' · ' : ''}{l.phone}</li>}
        </ul>
        {d.person && <p class="mt-3 text-xs text-stone-500">Marketing email: {marketing[d.person.marketing_status] ?? d.person.marketing_status}</p>}
        {d.person && (
          <details class="mt-3 text-xs">
            <summary class="cursor-pointer text-stone-600">Email consent and data</summary>
            <div class="mt-2 space-y-2">
              <form method="POST"><input type="hidden" name="_action" value="resend_optin" /><button class="w-full rounded border border-violet-200 bg-white px-3 py-2">Send the confirmation email again</button></form>
              <form method="POST"><input type="hidden" name="_action" value="unsub" /><button class="w-full rounded border border-violet-200 bg-white px-3 py-2" data-confirm="Stop all marketing email to this person?" data-confirm-label="Mark unsubscribed">Mark unsubscribed (they asked us)</button></form>
              {canDo(Astro.locals.admin, 'person', 'erase') && <form method="POST" class="space-y-1 rounded border border-red-200 bg-red-50 p-2">
                <input type="hidden" name="_action" value="erase" />
                <p class="text-red-900">Erase this person: names, contact details, history, consent records and their WhatsApp chats on this site (with photos and voice notes) are deleted. Only a scrambled copy of the email and phone stays so they are never contacted again. The chat stays in the WhatsApp Business app; delete it there too. This cannot be undone.</p>
                <input name="confirm" placeholder="Type ERASE" class="w-full rounded border border-red-300 px-2 py-1" />
                <button class="w-full rounded bg-red-700 px-3 py-2 text-white">Erase</button>
              </form>}
            </div>
          </details>
        )}
        {d.tags.length > 0 && <p class="mt-1 text-xs text-stone-500">Tags: {d.tags.join(', ')}</p>}
      </section>

      <section class="rounded-xl border border-violet-100 bg-white p-4 text-sm">
        <h2 class="mb-2 font-semibold">Enquiry</h2>
        <dl class="space-y-1 text-stone-700">
          {l.tour_interest && <div><dt class="inline text-stone-500">Interested in: </dt><dd class="inline">{l.tour_interest}</dd></div>}
          {l.travel_start && <div><dt class="inline text-stone-500">Dates: </dt><dd class="inline">{l.travel_start}</dd></div>}
          {l.party_size && <div><dt class="inline text-stone-500">Travellers: </dt><dd class="inline">{l.party_size}</dd></div>}
          {l.country && <div><dt class="inline text-stone-500">Country: </dt><dd class="inline">{l.country}</dd></div>}
          {l.language && <div><dt class="inline text-stone-500">Language: </dt><dd class="inline">{l.language}</dd></div>}
          {l.booking_id && <div><dt class="inline text-stone-500">Booking: </dt><dd class="inline"><a class="text-brand-700 hover:underline" href={`/admin/bookings/${l.booking_id}`}>{l.booking_id}</a></dd></div>}
        </dl>
        {l.message && <p class="mt-2 whitespace-pre-line text-stone-700">{l.message}</p>}
        {l.score_reason && <p class="mt-2 text-xs text-stone-500">Score: {l.score_reason}</p>}
      </section>

      <section class="rounded-xl border border-violet-100 bg-white p-4 text-sm">
        <h2 class="mb-2 font-semibold">Handled by</h2>
        <p class="mb-2 text-stone-800">{ownerLabel(l.owner, staffNames)}</p>
        {l.owner === '' && open && (
          <form method="POST" class="mb-2"><input type="hidden" name="_action" value="take" /><button class="min-h-11 w-full rounded btn-primary text-white">Take it</button></form>
        )}
        <form method="POST" class="flex gap-2">
          <input type="hidden" name="_action" value="assign" />
          <select name="owner" class={`min-w-0 flex-1 ${field}`} aria-label="Hand this lead to">
            <option value="" selected={l.owner === ''}>Nobody</option>
            <option value="owner" selected={l.owner === 'owner'}>Owner</option>
            {staffList.map((s) => <option value={s.email} selected={l.owner === s.email}>{s.name || s.email}</option>)}
            {l.owner && l.owner !== 'owner' && !staffNames[l.owner] && <option value={l.owner} selected>{l.owner}</option>}
          </select>
          <button class="min-h-11 rounded border border-violet-200 bg-white px-3">Hand over</button>
        </form>
      </section>

      <section class="rounded-xl border border-violet-100 bg-white p-4 text-sm">
        <h2 class="mb-2 font-semibold">Stage</h2>
        <form method="POST" class="space-y-2">
          <input type="hidden" name="_action" value="stage" />
          <select name="stage" class={`w-full ${field}`} aria-label="Stage">
            {LEAD_STAGES.map((s) => <option value={s} selected={(l.status === 'converted' ? 'booked' : l.status) === s}>{STAGE_LABELS[s]}</option>)}
          </select>
          <select name="lostReason" class={`w-full ${field}`} aria-label="Reason, if lost">
            {LOST_REASONS.map((r) => <option value={r} selected={l.lost_reason === r}>{r.replace(/_/g, ' ')}</option>)}
          </select>
          <p class="text-xs text-stone-500">The reason is saved only when the stage is Lost.</p>
          <button class="min-h-11 w-full rounded btn-primary text-white">Save stage</button>
        </form>
        {l.status === 'new' && (
          <form method="POST" class="mt-2">
            <input type="hidden" name="_action" value="contacted" />
            <button class="min-h-11 w-full rounded border border-violet-200 bg-white">I have replied</button>
          </form>
        )}
      </section>
    </div>

    <div class="space-y-4 lg:col-span-2">
      <section class="rounded-xl border border-violet-100 bg-white p-4 text-sm">
        <h2 class="mb-2 font-semibold">Add a note or set a follow-up</h2>
        <form method="POST" class="mb-4 space-y-2">
          <input type="hidden" name="_action" value="note" />
          <textarea name="body" rows="3" required placeholder="What was said, what was promised..." class={`w-full ${field}`}></textarea>
          <button class="min-h-11 rounded btn-primary px-4 text-white">Save note</button>
        </form>
        <form method="POST" class="flex flex-wrap items-end gap-2">
          <input type="hidden" name="_action" value="followup" />
          <label class="text-xs text-stone-500">Follow up on<input type="date" name="due" required class={`mt-1 block ${field}`} /></label>
          <label class="min-w-48 flex-1 text-xs text-stone-500">Reminder<input name="note" placeholder="Call about the quote" class={`mt-1 block w-full ${field}`} /></label>
          <button class="min-h-11 rounded border border-violet-200 bg-white px-4">Set follow-up</button>
        </form>
      </section>

      <section class="rounded-xl border border-violet-100 bg-white p-4 text-sm">
        <h2 class="mb-3 font-semibold">History</h2>
        {d.timeline.length === 0 ? <p class="text-stone-500">Nothing recorded yet.</p> : (
          <ol class="space-y-3">
            {d.timeline.map((t) => (
              <li class="flex gap-3">
                <span class={`mt-0.5 h-fit shrink-0 rounded px-2 py-0.5 text-xs ${kindClass[t.kind] ?? 'bg-stone-100 text-stone-700'}`}>{t.kind === 'touchpoint' ? 'contact' : t.kind}</span>
                <div class="min-w-0 flex-1">
                  <p class="text-xs text-stone-500">{formatDateTimeIst(t.at)}{t.by && t.by !== 'backfill' && t.by !== 'system' ? ` · ${ownerLabel(t.by, staffNames)}` : ''}</p>
                  <p class="break-words text-stone-800">{t.kind === 'touchpoint' ? t.title : t.detail || t.title}</p>
                  {t.kind === 'touchpoint' && t.detail && <p class="break-words text-xs text-stone-500">{t.detail}</p>}
                  {t.kind === 'task' && (
                    t.done ? <p class="text-xs text-green-700">Done</p> : (
                      <form method="POST" class="mt-1">
                        <input type="hidden" name="_action" value="done" />
                        <input type="hidden" name="activityId" value={t.activityId} />
                        <button class="rounded border border-violet-200 bg-white px-3 py-1 text-xs">Mark done</button>
                      </form>
                    )
                  )}
                </div>
              </li>
            ))}
          </ol>
        )}
      </section>
    </div>
  </div>
</AdminLayout>
