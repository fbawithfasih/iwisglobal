---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../lib/env';
import { isAdminAuthenticated } from '../../lib/requireAdmin';
import { listBookings, updateBookingStatus } from '../../lib/crm';
import { listTours } from '../../lib/tours';
import { computeTicketsToBuy, ticketsOutstanding } from '../../lib/entryTickets';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET))) {
  return Astro.redirect('/admin/login');
}

const db = env.DB;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const bookingId = String(form.get('bookingId') ?? '');
  const status = String(form.get('status') ?? '');
  if (db && bookingId && status) {
    await updateBookingStatus(db, bookingId, status);
  }
  return Astro.redirect('/admin');
}

const statusFilter = Astro.url.searchParams.get('status') ?? undefined;
const bookings = db ? await listBookings(db, { status: statusFilter }) : [];

// "Tickets needed": confirmed bookings whose monument tickets aren't marked
// bought yet (see lib/entryTickets.ts). All tours (drafts too) so older
// bookings of an unpublished tour still resolve.
const toursById = new Map((db ? await listTours(db) : []).map((t) => [t.id, t]));
const ticketsNeeded = new Set(
  bookings
    .filter((b) => {
      const tour = toursById.get(b.tour_id);
      return tour ? ticketsOutstanding(b, computeTicketsToBuy(tour, b)) : false;
    })
    .map((b) => b.id)
);
---
<AdminLayout title="Bookings">
  <h1 class="text-2xl font-semibold mb-6">Bookings</h1>

  <div class="flex gap-2 mb-6 text-sm">
    <a href="/admin" class={`px-3 py-1 rounded ${!statusFilter ? 'bg-amber-800 text-white' : 'bg-white border border-stone-300'}`}>All</a>
    <a href="/admin?status=confirmed" class={`px-3 py-1 rounded ${statusFilter === 'confirmed' ? 'bg-amber-800 text-white' : 'bg-white border border-stone-300'}`}>Confirmed</a>
    <a href="/admin?status=completed" class={`px-3 py-1 rounded ${statusFilter === 'completed' ? 'bg-amber-800 text-white' : 'bg-white border border-stone-300'}`}>Completed</a>
    <a href="/admin?status=cancelled" class={`px-3 py-1 rounded ${statusFilter === 'cancelled' ? 'bg-amber-800 text-white' : 'bg-white border border-stone-300'}`}>Cancelled</a>
  </div>

  {bookings.length === 0 ? (
    <p class="text-stone-500">No bookings found.</p>
  ) : (
    <div class="bg-white rounded-xl border border-stone-200 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-stone-50 text-left">
          <tr>
            <th class="px-4 py-2">Date</th>
            <th class="px-4 py-2">Tour</th>
            <th class="px-4 py-2">Traveler</th>
            <th class="px-4 py-2">Pax</th>
            <th class="px-4 py-2">Amount</th>
            <th class="px-4 py-2">Source</th>
            <th class="px-4 py-2">Status</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody>
          {bookings.map((b) => (
            <tr class="border-t border-stone-100">
              <td class="px-4 py-2">{b.travel_date}</td>
              <td class="px-4 py-2">{b.tour_id}</td>
              <td class="px-4 py-2">
                <a href={`/admin/bookings/${b.id}`} class="text-amber-800 hover:underline">{b.traveler_name}</a>
                {ticketsNeeded.has(b.id) && (
                  <span class="ml-1 px-1.5 py-0.5 rounded text-[11px] bg-amber-100 text-amber-800 whitespace-nowrap">Tickets needed</span>
                )}
              </td>
              <td class="px-4 py-2">{b.travelers}</td>
              <td class="px-4 py-2">
                {b.currency} {(b.amount_paid / 100).toLocaleString('en-IN')}
                {b.payment_type === 'deposit' && (
                  <span class="block text-xs text-amber-700">
                    +{b.currency} {((b.total_amount - b.amount_paid) / 100).toLocaleString('en-IN')} due
                  </span>
                )}
              </td>
              <td class="px-4 py-2">{b.source}</td>
              <td class="px-4 py-2">
                <span class={`px-2 py-0.5 rounded text-xs ${
                  b.status === 'confirmed' ? 'bg-blue-100 text-blue-800' :
                  b.status === 'completed' ? 'bg-green-100 text-green-800' :
                  'bg-red-100 text-red-800'
                }`}>{b.status}</span>
              </td>
              <td class="px-4 py-2">
                <a href={`/admin/bookings/${b.id}`} class="text-stone-500 hover:underline">Manage</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</AdminLayout>
