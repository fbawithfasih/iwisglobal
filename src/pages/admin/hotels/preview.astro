---
// Admin-only test page for hotel booking: the same search as /hotels, but it works
// while hotels are switched off and it only needs the admin sign-in (the admin cookie
// is only sent to /admin addresses, so /hotels itself cannot see it). Guests never reach it.
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import HotelSearch from '../../../components/HotelSearch';
import { resolveEnv } from '../../../lib/env';
import { pageI18n } from '../../../i18n/dictionaries';
import { intlLocale } from '../../../lib/i18n';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { resolveCurrency } from '../../../lib/currency';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}
const { locale, t: dict } = pageI18n(Astro);
const t = dict.hotelBooking;
const currency = resolveCurrency(Astro.url.searchParams, Astro.cookies.get('currency')?.value);
---
<BaseLayout title={t.meta.title} description={t.meta.description} noindex={true} floatingWhatsApp={false}>
  <section class="mx-auto max-w-5xl px-4 py-10 min-[300px]:px-6 md:py-14">
    <p class="notice notice-warn mb-5" role="status">Admin test page. Real searches and real payments, visible only to you. <a href="/admin/hotels" class="font-semibold underline">Back to Hotels settings</a></p>
    <h1 class="font-serif text-3xl font-semibold text-brand-900 md:text-4xl">{t.heading}</h1>
    <p class="mt-3 max-w-3xl text-stone-700">{t.intro}</p>
    <div class="mt-8">
      <HotelSearch client:load t={t} currency={currency} intlLocale={intlLocale(locale)} locale={locale}
        searchUrl="/admin/api/hotels/search" rateUrl="/admin/api/hotels/rate" bookPath="/admin/hotels/book" />
    </div>
  </section>
</BaseLayout>
