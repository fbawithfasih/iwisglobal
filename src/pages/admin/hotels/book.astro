---
// Admin-only "Review and pay" for the test page (see preview.astro).
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import HotelCheckout from '../../../components/HotelCheckout';
import { resolveEnv } from '../../../lib/env';
import { pageI18n } from '../../../i18n/dictionaries';
import { intlLocale } from '../../../lib/i18n';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}
const { locale, t: dict } = pageI18n(Astro);
const t = dict.hotelBooking;
const bookingId = (Astro.url.searchParams.get('b') ?? '').slice(0, 100);
---
<BaseLayout title={t.checkout.heading} description={t.meta.description} noindex={true} floatingWhatsApp={false}>
  <section class="mx-auto max-w-3xl px-4 py-10 min-[300px]:px-6 md:py-14">
    <p class="mb-5 rounded-xl bg-amber-50 p-3 text-sm text-amber-900" role="status">Admin test page. "Pay" is a real Razorpay payment. "Book without payment (test)" books on the Hotelbeds test server and charges nothing.</p>
    <h1 class="font-serif text-3xl font-semibold text-brand-900 md:text-4xl">{t.checkout.heading}</h1>
    <div class="mt-8">
      <HotelCheckout client:load t={t.checkout} bookingId={bookingId} intlLocale={intlLocale(locale)} locale={locale}
        orderUrl="/admin/api/hotels/order" testBookUrl="/admin/api/hotels/test-book" searchPath="/admin/hotels/preview" />
    </div>
  </section>
</BaseLayout>
