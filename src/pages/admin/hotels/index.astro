---
// Hotel booking settings (src/lib/hotelData.ts, hotelContent.ts): the on/off switch,
// markup and exchange rates, hotel filters, and the content refresh from Hotelbeds.
// Nothing here is visible to guests until the switch is on. Never prints any key.
export const prerender = false;

import EmptyState from '../../../components/EmptyState.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { canDo } from '../../../lib/authz';
import { auditContext, recordAudit } from '../../../lib/audit';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import type { D1Like } from '../../../lib/db';
import { loadHotelSettings, saveHotelSettings, setHotelsEnabled } from '../../../lib/hotelData';
import { syncHotelContent } from '../../../lib/hotelContent';
import { checkHotelSettingsForm } from '../../../lib/hotelAdminForm';
import { cancelHotelBookingAndRefund, previewHotelRefund, STUCK_PAID_MS, isTestPayment } from '../../../lib/hotelPayment';
import { formatDateTimeIst, formatMoneyMinor } from '../../../lib/format';
import { setupChecklist, refreshFreshness, bookingMix, type RefreshState } from '../../../lib/hotelsAdmin';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}

const db = env.DB as D1Like | undefined;

if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');
  const text = (name: string) => String(form.get(name) ?? '');
  let result: { ok: boolean; error?: string } = { ok: true };
  let note = '';
  if (!canDo(Astro.locals.admin, 'hotels', action)) result = { ok: false, error: 'Only the owner can change hotel settings.' };
  else try {
    if (action === 'switch_on') {
      result = await setHotelsEnabled(db, true);
      note = 'Hotels are now live. The /hotels page is public.';
    } else if (action === 'switch_off') {
      result = await setHotelsEnabled(db, false);
      note = 'Hotels are switched off. Guests no longer see /hotels.';
    } else if (action === 'save') {
      const values = { markupPercent: text('markupPercent'), fxEurInr: text('fxEurInr'), fxEurUsd: text('fxEurUsd'), minStars: text('minStars') };
      const current = await loadHotelSettings(db);
      const check = checkHotelSettingsForm(values, current.enabled);
      if (!check.ok) {
        result = check;
      } else {
        result = await saveHotelSettings(db, { ...values, excludedCodes: text('excludedCodes') });
        note = 'Settings saved.';
      }
    } else if (action === 'refresh') {
      const synced = await syncHotelContent(env as Record<string, any>, db);
      result = synced;
      if (synced.ok) note = `Content refreshed: ${synced.count} hotels loaded.`;
    } else if (action === 'cancel_booking') {
      const cancelled = await cancelHotelBookingAndRefund(env as Record<string, any>, db, text('bookingId'));
      result = cancelled.ok ? { ok: true } : { ok: false, error: cancelled.error };
      if (cancelled.ok) note = `Booking cancelled. Refunded ${cancelled.refunded}, fee kept ${cancelled.fee}.`;
    }
  } catch (e) {
    result = { ok: false, error: e instanceof Error ? e.message : 'Could not complete that.' };
  }
  if (result.ok && action !== 'refresh') await recordAudit(db, auditContext(Astro.request, Astro.locals), { action: `hotels.${action}`, resource: 'hotels', resourceId: text('id') || text('stopId') || text('bookingId') || undefined, summary: note || undefined });
  const query = new URLSearchParams();
  if (!result.ok) query.set('err', result.error ?? 'Could not complete that.');
  else if (note) query.set('note', note);
  return Astro.redirect(`/admin/hotels${query.size ? `?${query}` : ''}`);
}

const settings = db ? await loadHotelSettings(db) : null;
const countRow = db ? await db.prepare(`SELECT COUNT(*) AS n FROM hotel_content`).bind().first<{ n: number }>() : null;
const hotelCount = countRow?.n ?? 0;
const sync = db
  ? await db.prepare(`SELECT last_run, last_count, last_error FROM hotel_sync WHERE id = 1`).bind().first<{ last_run: string | null; last_count: number | null; last_error: string | null }>()
  : null;

// Bookings that got past checkout, newest first. Quotes nobody paid are left out.
interface BookingListRow {
  id: string; status: string; currency: string; net_cost: number; sell_total: number; refunded: number; payment_id: string;
  holder_name: string; email: string; hb_reference: string; search_json: string; selected_json: string; created_at: string; updated_at: string;
}
const bookings = db
  ? (await db
      .prepare(`SELECT id, status, currency, net_cost, sell_total, refunded, payment_id, holder_name, email, hb_reference, search_json, selected_json, created_at, updated_at FROM hotel_bookings WHERE status != 'quoted' ORDER BY created_at DESC LIMIT 50`)
      .bind()
      .all<BookingListRow>()).results
  : [];
const nowMs = Date.now();
const money = (n: number, cur: string) => formatMoneyMinor(n * 100, cur);
const bookingView = (b: BookingListRow) => {
  let hotel = '';
  let dates = '';
  try { hotel = JSON.parse(b.selected_json).hotelName ?? ''; } catch { /* shown blank */ }
  try { const s = JSON.parse(b.search_json); dates = `${s.checkIn} to ${s.checkOut}`; } catch { /* shown blank */ }
  const stuck = b.status === 'paid' && nowMs - new Date(b.updated_at).getTime() > STUCK_PAID_MS;
  const preview = b.status === 'booked' ? previewHotelRefund(b, new Date()) : null;
  const refundDue = b.status === 'failed' && b.refunded === 0;
  return { hotel, dates, stuck, preview, refundDue, flagged: stuck || b.status === 'failed' };
};

// Presence only; the values themselves are never rendered.
const keysConfigured = Boolean(env.HOTELBEDS_API_KEY) && Boolean(env.HOTELBEDS_SECRET);
const apiKeyState = env.HOTELBEDS_API_KEY ? 'configured' : 'missing';
const secretState = env.HOTELBEDS_SECRET ? 'configured' : 'missing';
let apiHost = 'api.test.hotelbeds.com';
try {
  if (env.HOTELBEDS_BASE_URL) apiHost = new URL(String(env.HOTELBEDS_BASE_URL)).host;
} catch {
  apiHost = 'invalid HOTELBEDS_BASE_URL';
}

const error = Astro.url.searchParams.get('err');
const note = Astro.url.searchParams.get('note');
const btn = 'min-h-11 rounded px-4 text-sm font-medium';
const field = 'w-full min-h-11 rounded border border-violet-200 bg-white px-2 py-1.5 text-sm';
const label = 'block text-xs text-stone-500 mb-1';

// The pictures at the top: what is left before it can go live, how fresh the loaded content is, how the paid bookings stand.
const checklist = settings ? setupChecklist({ enabled: settings.enabled, markupPercent: settings.markupPercent, fxEurInr: settings.fxEurInr, fxEurUsd: settings.fxEurUsd, hotelCount, keysConfigured }) : [];
const stepsDone = checklist.filter((i) => i.done).length;
const fresh = refreshFreshness(sync?.last_run ?? null, sync?.last_error ?? null, nowMs);
const mix = bookingMix(bookings.map((b) => ({ status: b.status, stuck: bookingView(b).stuck })));
const refundsDue = bookings.filter((b) => bookingView(b).refundDue).length;
const needYou = mix.stuck + refundsDue;
const freshText: Record<RefreshState, string> = { never: 'Never loaded', error: 'Last refresh failed', fresh: 'Up to date', soon: 'Refresh soon', old: 'Out of date' };
const freshClass: Record<RefreshState, string> = { never: 'badge-danger', error: 'badge-danger', fresh: 'badge-success', soon: 'badge-warn', old: 'badge-danger' };
const freshBar: Record<RefreshState, string> = { never: 'bg-rose-500', error: 'bg-rose-500', fresh: 'bg-emerald-500', soon: 'bg-orange-400', old: 'bg-rose-500' };
const mixParts = [
  { label: 'Booked', n: mix.booked, bar: 'bg-emerald-500' },
  { label: 'Cancelled', n: mix.cancelled, bar: 'bg-stone-400' },
  { label: 'Paid, waiting', n: mix.waiting, bar: 'bg-sky-500' },
  { label: 'Paid, stuck', n: mix.stuck, bar: 'bg-orange-400' },
  { label: 'Failed', n: mix.failed, bar: 'bg-rose-500' },
];
---
<AdminLayout title="Hotels">
  <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-semibold">Hotels</h1>
      <p class="text-sm text-stone-600">Settings for the hotel booking page. Guests see nothing until you switch it on below.</p>
    </div>
    {settings && <p class={`rounded-full px-4 py-1.5 text-sm font-medium ${settings.enabled ? 'badge-success' : 'badge-warn'}`} role="status">{settings.enabled ? '✓ Live for guests' : 'Off: guests do not see it'}</p>}
  </div>
  {error && <p class="notice notice-danger my-3" role="alert">{error}</p>}
  {note && <p class="notice notice-success my-3" role="status">{note}</p>}

  {settings && (
    <>
      <section aria-label="At a glance" class="mt-2">
        <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
          <a href="#switch" class={`block rounded-xl border p-4 transition hover:-translate-y-0.5 hover:shadow-md ${settings.enabled ? 'tint-success' : stepsDone >= checklist.length - 1 ? 'tint-info' : 'tint-warn'}`}>
            <span class="block text-4xl font-semibold leading-none text-stone-900">{settings.enabled ? 'On' : 'Off'}</span>
            <span class="mt-2 block font-medium text-stone-800">Switch</span>
            <span class="block text-xs text-stone-600">{settings.enabled ? '✓ The /hotels page is public.' : `${stepsDone} of ${checklist.length} steps done before it can go live.`}</span>
          </a>
          <a href="#content" class={`block rounded-xl border p-4 transition hover:-translate-y-0.5 hover:shadow-md ${fresh.state === 'fresh' ? 'tint-success' : fresh.state === 'soon' ? 'tint-warn' : 'tint-danger'}`}>
            <span class="block text-4xl font-semibold leading-none text-stone-900">{hotelCount}</span>
            <span class="mt-2 block font-medium text-stone-800">Hotels loaded</span>
            <span class="block text-xs text-stone-600">{freshText[fresh.state]}{fresh.days !== null ? ` · ${fresh.days === 0 ? 'today' : `${fresh.days} d ago`}` : ''}</span>
          </a>
          <a href="#bookings" class="block rounded-xl border p-4 transition hover:-translate-y-0.5 hover:shadow-md tint-brand">
            <span class="block text-4xl font-semibold leading-none text-stone-900">{mix.booked}</span>
            <span class="mt-2 block font-medium text-stone-800">Hotel bookings</span>
            <span class="block text-xs text-stone-600">{mix.total} paid in all, {mix.cancelled} cancelled.</span>
          </a>
          <a href="#bookings" class={`block rounded-xl border p-4 transition hover:-translate-y-0.5 hover:shadow-md ${needYou ? 'tint-danger' : 'tint-success'}`}>
            <span class="block text-4xl font-semibold leading-none text-stone-900">{needYou}</span>
            <span class="mt-2 block font-medium text-stone-800">Need you</span>
            <span class="block text-xs text-stone-600">{needYou ? 'Paid but not confirmed, or failed with no refund recorded.' : '✓ No stuck payments or refunds due.'}</span>
          </a>
        </div>
      </section>

      <div class="mt-6 grid items-start gap-4 lg:grid-cols-3">
        <section aria-labelledby="setup" class="rounded-xl border border-violet-100 bg-white p-4">
          <h2 id="setup" class="mb-1 text-lg font-semibold">Before it can go live</h2>
          <div class="mb-3 flex items-center gap-2">
            <span class="flex flex-1 gap-1" role="img" aria-label={`${stepsDone} of ${checklist.length} steps done`}>
              {checklist.map((i) => <span class={`h-1.5 flex-1 rounded-full ${i.done ? 'bg-emerald-500' : 'bg-stone-200'}`}></span>)}
            </span>
            <span class="text-xs font-medium text-stone-700">{stepsDone} of {checklist.length}</span>
          </div>
          <ul class="space-y-2 text-sm">
            {checklist.map((i) => (
              <li class="flex gap-2">
                <span class={`mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-xs font-bold ${i.done ? 'badge-success' : 'badge-warn'}`} aria-hidden="true">{i.done ? '✓' : '!'}</span>
                <span><span class={i.done ? 'text-stone-700' : 'font-medium text-stone-900'}>{i.label}</span><span class="sr-only">{i.done ? ', done' : ', still to do'}</span>{!i.done && <span class="block text-xs text-stone-600">{i.hint}</span>}</span>
              </li>
            ))}
          </ul>
        </section>

        <section id="content" aria-labelledby="freshPic" class="scroll-mt-4 rounded-xl border border-violet-100 bg-white p-4">
          <h2 id="freshPic" class="mb-1 text-lg font-semibold">Hotel content</h2>
          <p class="mb-3 text-xs text-stone-600">Names, photos and facilities loaded from Hotelbeds. The bar fills over 30 days.</p>
          <p class="flex items-center justify-between text-sm"><span class="text-stone-800">{hotelCount} hotels</span><span class={`${freshClass[fresh.state]} rounded-full px-2 py-0.5 text-[11px] font-medium`}>{freshText[fresh.state]}</span></p>
          <span class="mt-1 block h-2.5 rounded-full bg-stone-100" aria-hidden="true"><span class={`block h-full rounded-full ${freshBar[fresh.state]}`} style={`width:${fresh.days === null ? 100 : Math.max(4, Math.min(100, Math.round((fresh.days / 30) * 100)))}%`}></span></span>
          <p class="mt-2 text-xs text-stone-700">Last refresh: {sync?.last_run ? formatDateTimeIst(sync.last_run) : 'never'}{sync?.last_count != null ? ` · ${sync.last_count} loaded` : ''}</p>
          {sync?.last_error && <p class="mt-2 rounded-lg tint-danger border px-3 py-2 text-xs text-stone-900" role="alert">Last refresh error: {sync.last_error}</p>}
        </section>

        <section aria-labelledby="mixPic" class="rounded-xl border border-violet-100 bg-white p-4">
          <h2 id="mixPic" class="mb-1 text-lg font-semibold">Hotel bookings by status</h2>
          <p class="mb-3 text-xs text-stone-600">Bookings that got past checkout, newest {bookings.length} shown.</p>
          {mix.total === 0 ? (
            <p class="text-sm text-stone-700">No hotel bookings yet.</p>
          ) : (
            <>
              <div class="flex h-4 w-full gap-0.5 overflow-hidden rounded-full" role="img" aria-label={mixParts.map((p) => `${p.label} ${p.n}`).join(', ')}>
                {mixParts.filter((p) => p.n > 0).map((p) => <span class={`${p.bar} block`} style={`flex:${p.n} 1 0`}></span>)}
              </div>
              <ul class="mt-3 space-y-1.5 text-sm">
                {mixParts.map((p) => <li class="flex items-center justify-between"><span class="inline-flex items-center gap-2"><span class={`h-2.5 w-2.5 rounded-sm ${p.bar}`}></span>{p.label}</span><span class="font-semibold text-stone-900">{p.n}</span></li>)}
              </ul>
            </>
          )}
        </section>
      </div>

      <section id="switch" class="mt-6 scroll-mt-4 rounded-xl border border-violet-100 bg-white p-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-lg font-semibold">
              {settings.enabled ? 'Hotels are live' : 'Hotels are switched off'}
              <StatusBadge tone={settings.enabled ? 'ok' : 'muted'} class="ml-2">{settings.enabled ? 'On' : 'Off'}</StatusBadge>
            </h2>
            <p class="mt-1 text-sm text-brand-700">Switching on makes the /hotels page public to every guest.</p>
            {!settings.enabled && <p class="text-sm text-stone-500">It will not switch on until markup is above 0, the EUR to INR rate is set and hotel content has been loaded.</p>}
          </div>
          <form method="POST">
            {settings.enabled
              ? <button type="submit" name="_action" value="switch_off" data-confirm="Switch this off? Guests will no longer be able to use it until you switch it on again." data-confirm-label="Switch off" class={`${btn} bg-red-700 text-white`}>Switch off now</button>
              : <button type="submit" name="_action" value="switch_on" class={`${btn} bg-green-700 text-white`}>Switch on</button>}
          </form>
        </div>
      </section>

      <details class="mt-6 rounded-xl border border-violet-100 bg-white p-4">
        <summary class="cursor-pointer text-lg font-semibold">Technical details</summary>
        <dl class="mt-2 grid grid-cols-1 gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
          <div class="flex gap-2"><dt class="text-stone-500">Destination code</dt><dd>{settings.destinationCode}</dd></div>
          <div class="flex gap-2"><dt class="text-stone-500">Contract currency</dt><dd>{settings.contractCurrency}</dd></div>
          <div class="flex gap-2"><dt class="text-stone-500">Hotels loaded</dt><dd>{hotelCount}</dd></div>
          <div class="flex gap-2"><dt class="text-stone-500">Last refresh</dt><dd>{sync?.last_run ?? 'never'}</dd></div>
          <div class="flex gap-2"><dt class="text-stone-500">Last refresh count</dt><dd>{sync?.last_count ?? 'none'}</dd></div>
          <div class="flex gap-2"><dt class="text-stone-500">Last refresh error</dt><dd class={sync?.last_error ? 'text-red-700' : ''}>{sync?.last_error || 'none'}</dd></div>
          <div class="flex gap-2"><dt class="text-stone-500">Hotelbeds API key</dt><dd>{apiKeyState}</dd></div>
          <div class="flex gap-2"><dt class="text-stone-500">Hotelbeds secret</dt><dd>{secretState}</dd></div>
          <div class="flex gap-2"><dt class="text-stone-500">Hotelbeds server</dt><dd>{apiHost}</dd></div>
        </dl>
      </details>

      <section class="mt-6 rounded-xl border border-violet-100 bg-white p-4">
        <h2 class="text-lg font-semibold">Test a booking</h2>
        <p class="text-sm text-stone-500 mb-3">Opens the hotel search for you only, even while hotels are switched off. Payments are real, so choose a room with free cancellation and cancel it from the table below.</p>
        <a href="/admin/hotels/preview" class={`${btn} inline-flex items-center btn-primary text-white`}>Open the test search</a>
      </section>

      <section id="bookings" class="mt-6 scroll-mt-4 rounded-xl border border-violet-100 bg-white p-4">
        <h2 class="text-lg font-semibold mb-2">Hotel bookings</h2>
        {bookings.length === 0 && <EmptyState message="No hotel bookings yet" hint="Bookings made on the hotel pages appear here." />}
        {bookings.length > 0 && (
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead><tr class="text-left text-xs text-stone-500"><th class="py-1 pr-3">Status</th><th class="pr-3">Hotel</th><th class="pr-3">Dates</th><th class="pr-3">Guest</th><th class="pr-3 text-right">Sell total</th><th class="pr-3 text-right">Refunded</th><th></th></tr></thead>
              <tbody>
                {bookings.map((b) => {
                  const v = bookingView(b);
                  return (
                    <tr class={`border-t border-stone-100 align-top ${v.flagged ? 'bg-rose-50' : ''}`}>
                      <td class="py-2 pr-3"><StatusBadge tone={b.status === 'booked' ? 'ok' : b.status === 'cancelled' ? 'muted' : 'danger'}>{v.stuck ? 'paid, stuck' : b.status}</StatusBadge></td>
                      <td class="pr-3">{v.hotel}{isTestPayment(b.payment_id) && <span class="badge-warn ml-2 rounded px-1.5 py-0.5 text-xs font-medium">TEST, no payment</span>}<p class="text-xs text-stone-500">{b.hb_reference || 'no Hotelbeds reference'}</p></td>
                      <td class="pr-3 whitespace-nowrap">{v.dates}<p class="text-xs text-stone-500">{formatDateTimeIst(b.created_at)}</p></td>
                      <td class="pr-3">{b.holder_name}<p class="text-xs text-stone-500">{b.email}</p></td>
                      <td class="pr-3 text-right whitespace-nowrap">{money(b.sell_total, b.currency)}</td>
                      <td class="pr-3 text-right whitespace-nowrap">{money(b.refunded, b.currency)}</td>
                      <td class="py-2">
                        {b.status === 'booked' && v.preview && (
                          <form method="POST" data-confirm={`Cancel this booking now? The guest will be refunded ${money(v.preview.refund, b.currency)} and ${money(v.preview.fee, b.currency)} is kept as the cancellation fee. This cannot be undone.`} data-confirm-type="CANCEL" data-confirm-label="Cancel and refund">
                            <input type="hidden" name="bookingId" value={b.id} />
                            <button type="submit" name="_action" value="cancel_booking" class={`${btn} bg-red-700 text-white`}>Cancel and refund</button>
                          </form>
                        )}
                        {v.stuck && <p class="max-w-xs text-xs text-red-700">Paid but not confirmed with Hotelbeds. Check Razorpay and Hotelbeds before doing anything; do not refund until you know.</p>}
                        {b.status === 'failed' && <p class="max-w-xs text-xs text-red-700">{v.refundDue ? 'Not booked. No refund recorded: check Razorpay.' : 'Not booked and refunded.'}</p>}
                        {b.status === 'cancelled' && b.refunded === 0 && <p class="max-w-xs text-xs text-stone-600">Cancelled with nothing refunded. If a refund was due, check Razorpay.</p>}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <section class="mt-6 rounded-xl border border-violet-100 bg-white p-4">
        <h2 class="text-lg font-semibold">Hotel content</h2>
        <p class="text-sm text-stone-500 mb-3">
          Loads names, photos and facilities from Hotelbeds into the site. It can take several seconds, so wait for the result message after pressing the button.
          {!keysConfigured && ' The Hotelbeds keys are missing, so this will fail until they are added in Cloudflare.'}
        </p>
        <form method="POST">
          <button type="submit" name="_action" value="refresh" class={`${btn} btn-primary text-white`}>Refresh content</button>
        </form>
      </section>

      <section class="mt-6 rounded-xl border border-violet-100 bg-white p-4">
        <h2 class="text-lg font-semibold">Pricing and filters</h2>
        <p class="text-sm text-stone-500 mb-3">Numbers only. Markup is added on top of the Hotelbeds price.</p>
        <form method="POST" class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div><label class={label} for="markupPercent">Markup (percent)</label><input id="markupPercent" name="markupPercent" inputmode="decimal" required value={settings.markupPercent} class={field} /></div>
          <div><label class={label} for="fxEurInr">EUR to INR rate</label><input id="fxEurInr" name="fxEurInr" inputmode="decimal" required value={settings.fxEurInr} class={field} /></div>
          <div>
            <label class={label} for="fxEurUsd">EUR to USD rate</label>
            <input id="fxEurUsd" name="fxEurUsd" inputmode="decimal" required value={settings.fxEurUsd} class={field} aria-describedby="usd-note" />
            <p id="usd-note" class="mt-1 text-xs text-stone-500">While this is 0, USD guests will see no hotels.</p>
          </div>
          <div><label class={label} for="minStars">Minimum stars (0 to 5)</label><input id="minStars" name="minStars" inputmode="numeric" required value={settings.minStars} class={field} /></div>
          <div class="sm:col-span-2">
            <label class={label} for="excludedCodes">Excluded hotel codes (comma-separated)</label>
            <input id="excludedCodes" name="excludedCodes" value={settings.excludedCodes.join(', ')} class={field} />
          </div>
          <div class="sm:col-span-2"><button type="submit" name="_action" value="save" class={`${btn} btn-primary text-white`}>Save</button></div>
        </form>
      </section>
    </>
  )}
  {!settings && <p class="mt-6 text-sm text-red-700">The database is not available.</p>}
</AdminLayout>
