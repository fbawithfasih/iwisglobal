---
export const prerender = false;
import { ADMIN_COOKIE, isAdminAuthenticated } from '../../lib/requireAdmin';
import { auditContext, recordAudit } from '../../lib/audit';
import { resolveEnv } from '../../lib/env';
import { revokeSession, STAFF_COOKIE } from '../../lib/staff';

if (Astro.request.method === 'POST') {
  const env = resolveEnv(Astro.locals);
  const staffToken = Astro.cookies.get(STAFF_COOKIE)?.value;
  const ownerCookie = Astro.cookies.get(ADMIN_COOKIE)?.value;
  if (staffToken && env.DB) {
    // Signing out ends the session on the server too, so a copied cookie stops working.
    const { resolveStaffSession } = await import('../../lib/staff');
    const who = await resolveStaffSession(env.DB, staffToken).catch(() => null);
    await revokeSession(env.DB, staffToken).catch(() => {});
    if (who) await recordAudit(env.DB, auditContext(Astro.request, who.email ?? 'owner'), { action: 'auth.logout', resource: 'session', summary: 'Signed out' });
    Astro.cookies.delete(STAFF_COOKIE, { path: '/admin' });
  }
  if (ownerCookie) {
    if (await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET)) {
      await recordAudit(env.DB, auditContext(Astro.request, 'owner'), { action: 'auth.logout', resource: 'session', summary: 'Signed out' });
    }
    Astro.cookies.delete(ADMIN_COOKIE, { path: '/admin' });
  }
  return Astro.redirect('/admin/login');
}
return Astro.redirect('/admin');
---
