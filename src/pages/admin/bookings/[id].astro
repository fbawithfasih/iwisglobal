---
export const prerender = false;

import EmptyState from '../../../components/EmptyState.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { auditContext, recordAudit } from '../../../lib/audit';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { actorLabel } from '../../../lib/authz';
import { listStaff } from '../../../lib/staff';
import { ownerLabel } from '../../../lib/leadsAdmin';
import {
  getBookingById,
  updateBookingStatus,
  updateBookingItinerary,
  addBookingNote,
  listBookingNotes,
  setTicketsPurchased,
  setTicketFile,
  markTicketEmailed,
  markReviewRequested,
} from '../../../lib/crm';
import { getTourById, localizeTour } from '../../../lib/tours';
import { emailLocale, intlLocale } from '../../../lib/i18n';
import { fmt, getDictionary } from '../../../i18n/dictionaries';
import { formatTravelDate, formatMoneyMinor, formatDateTimeIst } from '../../../lib/format';
import { telHref, waHref } from '../../../lib/contact';
import PhoneInput from '../../../components/PhoneInput';
import { computeTicketsToBuy, ASI_BOOKING_URL } from '../../../lib/entryTickets';
import { uploadTicketFile } from '../../../lib/images';
import { sendEntryTicketEmail } from '../../../lib/email';
import {
  requestReview,
  ensureReviewToken,
  reviewUrl,
  reviewWhatsappMessage,
  canBeReviewed,
  getReviewForBooking,
  REVIEW_REQUEST_MESSAGES,
  SITE_URL,
} from '../../../lib/reviews';
import { todayIst } from '../../../lib/availability';
import { balanceLinkUrl, balanceOwed, createBalanceLink, openBalanceLinkFor, paidBalanceLinkFor } from '../../../lib/balancePayment';
import { sendBalanceLinkEmail } from '../../../lib/email';
import { AWAITING_STATUS, CUSTOM_TOUR_ID, cancelCustomTrip, confirmCustomTrip, getCustomTripByBooking, readStoredTrip } from '../../../lib/customTripPayment';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}

const db = env.DB;
const { id } = Astro.params;

if (!db || !id) return Astro.redirect('/admin');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');

  if (action === 'status') {
    await updateBookingStatus(db, id, String(form.get('status') ?? ''));
    await recordAudit(db, auditContext(Astro.request, Astro.locals), { action: 'booking.status', resource: 'booking', resourceId: id, summary: `Set status to ${String(form.get('status') ?? '')}` });
  } else if (action === 'itinerary') {
    await updateBookingItinerary(db, id, {
      pickupTime: String(form.get('pickupTime') ?? ''),
      guideAssigned: String(form.get('guideAssigned') ?? ''),
      vehicle: String(form.get('vehicle') ?? ''),
      driverName: String(form.get('driverName') ?? ''),
      driverPhone: String(form.get('driverPhone') ?? ''),
    });
  } else if (action === 'note') {
    const note = String(form.get('note') ?? '').trim();
    if (note) {
      await addBookingNote(db, id, note, actorLabel(Astro.locals.admin));
      await recordAudit(db, auditContext(Astro.request, Astro.locals), { action: 'booking.note', resource: 'booking', resourceId: id, summary: 'Added a note' });
    }
  } else if (action === 'tickets_purchased') {
    await setTicketsPurchased(db, id, form.get('purchased') === 'on');
  } else if (action === 'ticket_upload' || action === 'ticket_resend') {
    // Upload (optional when resending): store privately, mark bought, then
    // email the file to the customer. The result goes back as ?ticket=...
    let result = 'uploaded';
    try {
      const current = await getBookingById(db, id);
      if (!current) return Astro.redirect('/admin');
      if (!env.IMAGES) throw new Error('File storage is not configured.');
      let key = current.ticket_file_key;
      const file = form.get('ticketFile');
      if (action === 'ticket_upload') {
        if (!(file instanceof File) || file.size === 0) throw new Error('Choose the e-ticket file first.');
        key = (await uploadTicketFile(env.IMAGES, file)).key;
        await setTicketFile(db, id, key);
      }
      if (!key) throw new Error('No e-ticket uploaded yet.');
      const object = await env.IMAGES.get(key);
      if (!object) throw new Error('Stored e-ticket not found.');
      const found = await getTourById(db, current.tour_id);
      const locale = emailLocale(current.locale);
      const tour = found ? await localizeTour(db, found, locale) : null;
      const sent = await sendEntryTicketEmail(env, {
        to: current.traveler_email,
        travelerName: current.traveler_name,
        tourTitle: tour?.title ?? current.tour_id,
        travelDate: current.travel_date,
        bookingId: current.id,
        fileName: `entry-tickets-${current.travel_date}.${key.split('.').pop()}`,
        fileBytes: await new Response(object.body).arrayBuffer(),
        tickets: found ? computeTicketsToBuy(found, current) : [],
        locale,
      });
      if (sent) {
        await markTicketEmailed(db, id);
        result = 'emailed';
      } else {
        result = current.traveler_email ? 'email_failed' : 'no_email';
      }
    } catch (err: any) {
      return Astro.redirect(`/admin/bookings/${id}?ticket=error&msg=${encodeURIComponent(err?.message ?? 'Upload failed')}`);
    }
    return Astro.redirect(`/admin/bookings/${id}?ticket=${result}`);
  } else if (action === 'confirm_custom' || action === 'cancel_custom') {
    // Custom Agra tour: the owner either confirms the trip or cancels it and
    // refunds the deposit in full (src/lib/customTripPayment.ts).
    const found = await getCustomTripByBooking(db, id);
    if (!found) return Astro.redirect(`/admin/bookings/${id}`);
    const done = action === 'confirm_custom' ? await confirmCustomTrip(env, db, found.id) : await cancelCustomTrip(env, db, found.id);
    const result = done.ok ? (action === 'confirm_custom' ? 'confirmed' : 'refunded') : 'error';
    if (done.ok) await recordAudit(db, auditContext(Astro.request, Astro.locals), { action: action === 'confirm_custom' ? 'booking.confirm_custom' : 'booking.cancel_refund', resource: 'booking', resourceId: id, summary: action === 'confirm_custom' ? 'Confirmed a custom trip' : 'Cancelled a custom trip and refunded the deposit' });
    return Astro.redirect(`/admin/bookings/${id}?custom=${result}${done.ok ? '' : `&msg=${encodeURIComponent(done.error)}`}`);
  } else if (action === 'balance_link' || action === 'balance_email' || action === 'balance_whatsapp') {
    // Pay-the-balance link (src/lib/balancePayment.ts): make or reuse the private
    // link, then show it, email it, or open WhatsApp with it.
    const made = await createBalanceLink(db, id);
    if (!made.ok) return Astro.redirect(`/admin/bookings/${id}?balance=error&msg=${encodeURIComponent(made.error)}`);
    const b = made.booking;
    // The guest's language: the link opens the pay page in it and the message is written in it.
    const bLocale = emailLocale(b.locale);
    const url = balanceLinkUrl(made.token, bLocale);
    if (action === 'balance_email') {
      if (!b.traveler_email) return Astro.redirect(`/admin/bookings/${id}?balance=no_email`);
      const found = await getTourById(db, b.tour_id);
      const bTour = found ? await localizeTour(db, found, bLocale) : null;
      const sent = await sendBalanceLinkEmail(env, {
        locale: bLocale,
        to: b.traveler_email,
        name: b.traveler_name,
        tourTitle: bTour?.title ?? getDictionary(bLocale).balance.fallbackTour,
        travelDate: b.travel_date,
        amountMinor: made.amountMinor,
        currency: made.currency,
        url,
      });
      return Astro.redirect(`/admin/bookings/${id}?balance=${sent ? 'emailed' : 'email_failed'}`);
    }
    if (action === 'balance_whatsapp') {
      const first = b.traveler_name.trim().split(/\s+/)[0] || 'there';
      const wa = waHref(
        b.traveler_phone,
        fmt(getDictionary(bLocale).balance.waMessage, {
          name: first,
          amount: formatMoneyMinor(made.amountMinor, made.currency),
          date: formatTravelDate(b.travel_date, intlLocale(bLocale)),
          url,
        })
      );
      if (!wa) return Astro.redirect(`/admin/bookings/${id}?balance=error&msg=${encodeURIComponent('This booking has no phone number.')}`);
      return Astro.redirect(wa, 303);
    }
    return Astro.redirect(`/admin/bookings/${id}?balance=link`);
  } else if (action === 'review_email' || action === 'review_whatsapp') {
    const current = await getBookingById(db, id);
    if (!current) return Astro.redirect('/admin');
    if (action === 'review_email') {
      return Astro.redirect(`/admin/bookings/${id}?review=${await requestReview(env, db, current)}`);
    }
    // WhatsApp: create the private link, record the request, open the chat.
    const wa = waHref(current.traveler_phone, reviewWhatsappMessage(current.traveler_name, reviewUrl(SITE_URL, await ensureReviewToken(db, current))));
    if (!wa || !canBeReviewed(current, todayIst())) return Astro.redirect(`/admin/bookings/${id}?review=too_early`);
    await markReviewRequested(db, id);
    return Astro.redirect(wa, 303);
  }
  return Astro.redirect(`/admin/bookings/${id}`);
}

const booking = await getBookingById(db, id);
if (!booking) return Astro.redirect('/admin');
const notes = await listBookingNotes(db, id);
const staffNames: Record<string, string> = Object.fromEntries((await listStaff(db).catch(() => [])).map((s) => [s.email, s.name || s.email]));

const tour = await getTourById(db, booking.tour_id);
const tickets = tour ? computeTicketsToBuy(tour, booking) : [];
const ticketResult = Astro.url.searchParams.get('ticket');
const ticketMessages: Record<string, { text: string; ok: boolean }> = {
  emailed: { text: 'E-ticket saved and emailed to the customer.', ok: true },
  uploaded: { text: 'E-ticket saved.', ok: true },
  no_email: { text: 'E-ticket saved, but this booking has no email address — send it on WhatsApp.', ok: false },
  email_failed: { text: 'E-ticket saved, but the email did not send (check RESEND_API_KEY). Try "Resend" or send it on WhatsApp.', ok: false },
  error: { text: Astro.url.searchParams.get('msg') ?? 'Something went wrong.', ok: false },
};
const fmtTime = formatDateTimeIst;
const isCustom = booking.tour_id === CUSTOM_TOUR_ID;
const customTrip = isCustom ? await getCustomTripByBooking(db, id) : null;
const customStored = customTrip ? readStoredTrip(customTrip) : null;
const customResult = Astro.url.searchParams.get('custom');
const customMessages: Record<string, { text: string; ok: boolean }> = {
  confirmed: { text: 'Trip confirmed. The guest has been emailed.', ok: true },
  refunded: { text: 'Trip cancelled and the deposit refunded. The guest has been emailed.', ok: true },
  error: { text: Astro.url.searchParams.get('msg') ?? 'Something went wrong.', ok: false },
};
const owed = balanceOwed(booking);
const openLink = owed > 0 ? await openBalanceLinkFor(db, id) : null;
const paidLink = await paidBalanceLinkFor(db, id);
const balanceResult = Astro.url.searchParams.get('balance');
const balanceMessages: Record<string, { text: string; ok: boolean }> = {
  link: { text: 'Balance link ready. Copy it below, or email or WhatsApp it.', ok: true },
  emailed: { text: 'Balance link emailed to the guest.', ok: true },
  email_failed: { text: 'The email did not send (check RESEND_API_KEY). Copy the link or use WhatsApp.', ok: false },
  no_email: { text: 'This booking has no email address. Use WhatsApp or copy the link.', ok: false },
  error: { text: Astro.url.searchParams.get('msg') ?? 'Something went wrong.', ok: false },
};
const hotelModes: Record<string, string> = { own: 'Guest has their own hotel', listed: 'Guest picked a listed hotel', arrange: 'Guest wants us to arrange a hotel' };
const reviewOpen = canBeReviewed(booking, todayIst());
const review = await getReviewForBooking(db, id);
const reviewResult = Astro.url.searchParams.get('review');

// Pickup details for the customer on WhatsApp, built only from what's been
// filled in under Itinerary / logistics (nothing when all three are empty).
const firstName = booking.traveler_name.trim().split(/\s+/)[0] || 'there';
const pickupParts = [
  booking.pickup_time && 'pickup ' + booking.pickup_time,
  booking.vehicle && 'vehicle ' + booking.vehicle,
  booking.guide_assigned && 'guide ' + booking.guide_assigned,
  booking.driver_name && 'driver ' + booking.driver_name + (booking.driver_phone ? ' (' + booking.driver_phone + ')' : ''),
].filter(Boolean);
const pickupMessage = pickupParts.length
  ? 'Hi ' + firstName + ', here are the details for your ' + (tour?.title ?? 'tour') + ' on ' +
    formatTravelDate(booking.travel_date) + ': ' + pickupParts.join(', ') + '. Payment reference: ' + booking.payment_id
  : null;
const pickupWa = pickupMessage && booking.traveler_phone ? waHref(booking.traveler_phone, pickupMessage) : null;
const contactWa = booking.traveler_phone ? waHref(booking.traveler_phone) : null;
const contactBtn = 'inline-flex min-h-11 items-center rounded border border-violet-200 bg-white px-3 text-sm text-stone-800';
const actionBtn = 'min-h-11 rounded btn-primary text-white px-4 text-sm';
// Add-on names for display. IDs gained a "<TOUR_ID>_" prefix when a tour is
// re-saved (tours.ts replaceAddOns), so match both forms; an add-on since
// removed from the tour falls back to its stored id.
const addOnNames = booking.add_on_ids
  .split(',')
  .map((id) => id.trim())
  .filter(Boolean)
  .map((id) => tour?.addOns.find((a) => a.id === id || a.id === `${booking.tour_id}_${id}` || `${booking.tour_id}_${a.id}` === id)?.name ?? id);
---
<AdminLayout title={`Booking ${booking.id}`}>
  <a href="/admin" class="text-sm text-stone-500 hover:underline">&larr; Back to bookings</a>
  <h1 class="text-2xl font-semibold mt-2 mb-6">{booking.traveler_name} — {isCustom ? 'Custom Agra tour' : tour?.title ?? booking.tour_id}</h1>

  <div class="grid md:grid-cols-2 gap-6">
    <div class="bg-white rounded-xl border border-violet-100 p-6 space-y-2 text-sm">
      <h2 class="font-semibold mb-2">Booking details</h2>
      <p><span class="text-stone-500">Date:</span> {formatTravelDate(booking.travel_date)}</p>
      <p><span class="text-stone-500">Travelers:</span> {booking.travelers}</p>
      <p><span class="text-stone-500">Add-ons:</span> {addOnNames.length ? addOnNames.join(', ') : '—'}</p>
      <p><span class="text-stone-500">Email:</span> {booking.traveler_email}</p>
      <p><span class="text-stone-500">Phone:</span> {booking.traveler_phone}</p>
      <p><span class="text-stone-500">Amount paid:</span> {formatMoneyMinor(booking.amount_paid, booking.currency)} ({booking.payment_type === 'deposit' ? '25% deposit' : 'full'})</p>
      {booking.discount_label && booking.discount_amount ? (
        <p><span class="text-stone-500">Discount:</span> {booking.discount_label}, −{formatMoneyMinor(booking.discount_amount, booking.currency)}</p>
      ) : null}
      {booking.payment_type === 'deposit' && (
        <p><span class="text-stone-500">Balance due:</span> {formatMoneyMinor(booking.total_amount - booking.amount_paid, booking.currency)}</p>
      )}
      <p><span class="text-stone-500">Source:</span> {booking.source}</p>
      <p><span class="text-stone-500">Payment ID:</span> {booking.payment_id}</p>
      <p><span class="text-stone-500">Booked on:</span> {fmtTime(booking.created_at)}</p>
      {(booking.traveler_phone || booking.traveler_email) && (
        <div class="flex flex-wrap gap-2 pt-2">
          {booking.traveler_phone && <a href={telHref(booking.traveler_phone)} class={contactBtn}>Call</a>}
          {contactWa && <a href={contactWa} target="_blank" rel="noopener noreferrer" class={contactBtn}>WhatsApp</a>}
          {booking.traveler_email && <a href={`mailto:${booking.traveler_email}`} class={contactBtn}>Email</a>}
        </div>
      )}

      {!isCustom && (
      <form method="POST" class="pt-4 flex items-center gap-2">
        <input type="hidden" name="_action" value="status" />
        <select name="status" aria-label="Booking status" class="min-h-11 rounded border border-violet-200 px-2">
          <option value="confirmed" selected={booking.status === 'confirmed'}>Confirmed</option>
          <option value="completed" selected={booking.status === 'completed'}>Completed</option>
          <option value="cancelled" selected={booking.status === 'cancelled'}>Cancelled</option>
        </select>
        <button type="submit" class={actionBtn}>Update status</button>
      </form>
      )}
    </div>

    {(owed > 0 || paidLink) && (
      <div class="bg-white rounded-xl border border-violet-100 p-6 space-y-3 text-sm">
        <h2 class="font-semibold mb-2">Balance payment</h2>
        {balanceResult && balanceMessages[balanceResult] && (
          <p class={`rounded px-3 py-2 ${balanceMessages[balanceResult].ok ? 'bg-green-50 text-green-800' : 'bg-red-50 text-red-800'}`}>{balanceMessages[balanceResult].text}</p>
        )}
        {owed > 0 ? (
          <>
            <p><span class="text-stone-500">Still to pay:</span> <strong>{formatMoneyMinor(owed, booking.currency)}</strong></p>
            <p class="text-stone-600">Send the guest a private link to pay this online. When they pay, this booking updates to fully paid by itself.</p>
            {openLink && (
              <label class="block">
                <span class="text-stone-500">Guest's payment link</span>
                <input type="text" readonly value={balanceLinkUrl(openLink.id, emailLocale(booking.locale))} onclick="this.select()" class="mt-1 w-full rounded border border-violet-200 px-2 py-2 text-xs" />
              </label>
            )}
            <div class="flex flex-wrap gap-2 pt-1">
              <form method="POST"><input type="hidden" name="_action" value="balance_link" /><button type="submit" class={actionBtn}>{openLink ? 'Show link' : 'Create link'}</button></form>
              <form method="POST"><input type="hidden" name="_action" value="balance_email" /><button type="submit" class={contactBtn}>Email link</button></form>
              <form method="POST"><input type="hidden" name="_action" value="balance_whatsapp" /><button type="submit" class={contactBtn}>WhatsApp link</button></form>
            </div>
          </>
        ) : (
          <p class="text-green-800">Balance of {formatMoneyMinor(paidLink?.amount_minor ?? 0, paidLink?.currency ?? booking.currency)} paid online. This booking is paid in full.</p>
        )}
      </div>
    )}

    {isCustom && (
      <div class="bg-white rounded-xl border border-violet-100 p-6 space-y-3 text-sm md:col-span-2">
        <h2 class="font-semibold mb-2">Custom Agra tour</h2>
        {customResult && customMessages[customResult] && (
          <p class={`rounded px-3 py-2 ${customMessages[customResult].ok ? 'bg-green-50 text-green-800' : 'bg-red-50 text-red-800'}`}>{customMessages[customResult].text}</p>
        )}
        <p>
          <span class="text-stone-500">Status:</span>{' '}
          {booking.status === AWAITING_STATUS ? 'Deposit paid — waiting for you to confirm' : booking.status === 'confirmed' ? 'Confirmed' : booking.status === 'cancelled' ? 'Cancelled (deposit refunded)' : booking.status}
        </p>
        {customStored ? (
          <div class="space-y-2">
            <p><span class="text-stone-500">Dates:</span> {formatTravelDate(customStored.quote.startDate)} to {formatTravelDate(customStored.quote.endDate)}</p>
            <p><span class="text-stone-500">Vehicle:</span> {customStored.quote.vehicle.name} ({customStored.quote.vehicle.seats} seats)</p>
            <p>
              <span class="text-stone-500">Guests:</span> {customStored.quote.travellers.foreign} foreign, {customStored.quote.travellers.indian} Indian,
              {' '}{customStored.quote.travellers.saarc} SAARC/BIMSTEC, {customStored.quote.travellers.children} children
            </p>
            <p>
              <span class="text-stone-500">Hotel:</span> {hotelModes[customStored.input.hotel.mode] ?? customStored.input.hotel.mode}
              {customStored.input.hotel.name ? ` — ${customStored.input.hotel.name}` : ''}
              {customStored.input.hotel.nights ? `, ${customStored.input.hotel.nights} night(s)` : ''}
              {customStored.input.hotel.rooms ? `, ${customStored.input.hotel.rooms} room(s)` : ''}
              {customStored.input.hotel.notes ? `. Notes: ${customStored.input.hotel.notes}` : ''}
              . Quoted and confirmed separately, not charged here.
            </p>
            <ol class="list-decimal pl-5 space-y-1">
              {customStored.quote.days.map((d) => (
                <li>{formatTravelDate(d.date)}: {d.stops.length ? d.stops.map((st) => st.name).join(', ') : 'no stops'}</li>
              ))}
            </ol>
            <p>
              <span class="text-stone-500">Price:</span> vehicle {formatMoneyMinor(customStored.quote.vehicleTotal * 100, booking.currency)}, guide {formatMoneyMinor(customStored.quote.guideTotal * 100, booking.currency)},
              tickets {formatMoneyMinor(customStored.quote.ticketsTotal * 100, booking.currency)}; total {formatMoneyMinor(booking.total_amount, booking.currency)},
              deposit paid {formatMoneyMinor(booking.amount_paid, booking.currency)}, balance {formatMoneyMinor(booking.total_amount - booking.amount_paid, booking.currency)}.
            </p>
          </div>
        ) : (
          <p class="text-red-700">The saved trip details could not be read. Check the custom_trips row {customTrip?.id ?? '(not found)'}.</p>
        )}
        {customTrip && (customTrip.status === 'deposit_paid' || customTrip.status === 'confirmed') && (
          <div class="flex flex-wrap gap-2 pt-2">
            {customTrip.status === 'deposit_paid' && (
              <form method="POST">
                <input type="hidden" name="_action" value="confirm_custom" />
                <button type="submit" class={actionBtn}>Confirm this trip</button>
              </form>
            )}
            <form method="POST" data-confirm="Cancel this trip and refund the full deposit to the guest? This cannot be undone." data-confirm-type="CANCEL" data-confirm-label="Cancel trip and refund">
              <input type="hidden" name="_action" value="cancel_custom" />
              <button type="submit" class="min-h-11 rounded border border-red-300 bg-white px-4 text-sm text-red-700">Cancel and refund deposit</button>
            </form>
          </div>
        )}
      </div>
    )}

    <div class="bg-white rounded-xl border border-violet-100 p-6 space-y-3 text-sm">
      <h2 class="font-semibold mb-2">Itinerary / logistics</h2>
      <form method="POST" class="space-y-3">
        <input type="hidden" name="_action" value="itinerary" />
        <div>
          <label for="pickupTime" class="block text-stone-500 mb-1">Pickup time</label>
          <input id="pickupTime" name="pickupTime" value={booking.pickup_time} class="w-full rounded border border-violet-200 px-3 py-2" placeholder="e.g. 5:30 AM" />
        </div>
        <div>
          <label for="guideAssigned" class="block text-stone-500 mb-1">Guide assigned</label>
          <input id="guideAssigned" name="guideAssigned" aria-label="Guide assigned" value={booking.guide_assigned} class="w-full rounded border border-violet-200 px-3 py-2" />
        </div>
        <div>
          <label for="vehicle" class="block text-stone-500 mb-1">Vehicle</label>
          <input id="vehicle" name="vehicle" value={booking.vehicle} class="w-full rounded border border-violet-200 px-3 py-2" placeholder="e.g. Innova, plate no." />
        </div>
        <fieldset class="space-y-3 rounded-lg border border-violet-100 p-3">
          <legend class="px-1 font-medium text-stone-800">Driver (the guest's first contact at pickup)</legend>
          <div>
            <label for="driverName" class="block text-stone-500 mb-1">Driver name</label>
            <input id="driverName" name="driverName" maxlength="80" value={booking.driver_name ?? ''} class="w-full rounded border border-violet-200 px-3 py-2" placeholder="e.g. Sanjeev Kumar" />
          </div>
          <div>
            <label for="driverPhone" class="block text-stone-500 mb-1">Driver phone</label>
            <PhoneInput client:load tone="admin" id="driverPhone" name="driverPhone" defaultValue={booking.driver_phone || undefined} />
          </div>
          {booking.driver_phone && (
            <div class="flex flex-wrap gap-2">
              <a href={telHref(booking.driver_phone)} class={contactBtn}>Call driver</a>
              {waHref(booking.driver_phone) && <a href={waHref(booking.driver_phone) ?? '#'} target="_blank" rel="noopener noreferrer" class={contactBtn}>WhatsApp driver</a>}
            </div>
          )}
        </fieldset>
        <button type="submit" class={actionBtn}>Save itinerary</button>
      </form>
      {pickupWa ? (
        <a href={pickupWa} target="_blank" rel="noopener noreferrer" class="flex min-h-11 items-center justify-center rounded bg-emerald-700 px-4 font-medium text-white">
          Send pickup details on WhatsApp
        </a>
      ) : pickupMessage ? (
        <p class="text-xs text-stone-500">To send these on WhatsApp, the customer's phone number needs its country code (+).</p>
      ) : null}
    </div>
  </div>

  <div class="bg-white rounded-xl border border-violet-100 p-6 mt-6 text-sm">
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-semibold">Entry tickets</h2>
      {tickets.length > 0 && (
        booking.tickets_purchased_at
          ? <span class="px-2 py-0.5 rounded text-xs bg-green-100 text-green-800">Bought {fmtTime(booking.tickets_purchased_at)}</span>
          : <span class="px-2 py-0.5 rounded text-xs bg-brand-100 text-brand-700">Tickets needed</span>
      )}
    </div>

    {ticketResult && ticketMessages[ticketResult] && (
      <p class={`mb-3 ${ticketMessages[ticketResult].ok ? 'text-green-700' : 'text-red-600'}`}>{ticketMessages[ticketResult].text}</p>
    )}

    {tickets.length === 0 ? (
      <p class="text-stone-500">No monument tickets to buy for this booking (none included in the tour price or chosen as an add-on).</p>
    ) : (
      <div class="space-y-4">
        <div>
          <p class="mb-1">Buy on ASI's site for <strong>{formatTravelDate(booking.travel_date)}</strong>:</p>
          <ul class="list-disc list-inside">
            {tickets.map((t) => <li><strong>{t.quantity} ×</strong> {t.name}</li>)}
          </ul>
          <a href={ASI_BOOKING_URL} target="_blank" rel="noopener noreferrer" class="inline-block mt-2 rounded btn-primary text-white px-3 py-1.5">Open ASI ticket booking ↗</a>
        </div>

        <form method="POST" class="flex items-center gap-2">
          <input type="hidden" name="_action" value="tickets_purchased" />
          <label class="flex items-center gap-2">
            <input type="checkbox" name="purchased" checked={!!booking.tickets_purchased_at} onchange="this.form.submit()" class="h-4 w-4" />
            Tickets bought
          </label>
          <noscript><button type="submit" class="rounded border border-violet-200 px-2 py-0.5">Save</button></noscript>
        </form>

        <form method="POST" enctype="multipart/form-data" class="border-t border-stone-100 pt-4 space-y-2">
          <input type="hidden" name="_action" value="ticket_upload" />
          <label for="ticketFile" class="block text-stone-500">Upload the e-ticket (PDF or image, up to 5MB) — it's emailed to {booking.traveler_email || 'the customer'} automatically</label>
          <input id="ticketFile" type="file" name="ticketFile" accept="application/pdf,image/jpeg,image/png,image/webp" required class="text-sm" />
          <button type="submit" class={actionBtn}>Upload &amp; email</button>
        </form>

        {booking.ticket_file_key && (
          <div class="flex flex-wrap items-center gap-3 text-stone-600">
            <a href={`/admin/bookings/${booking.id}/ticket`} class="text-brand-700 hover:underline">Download e-ticket</a>
            <span>{booking.ticket_emailed_at ? `Emailed ${fmtTime(booking.ticket_emailed_at)}` : 'Not emailed yet'}</span>
            <form method="POST">
              <input type="hidden" name="_action" value="ticket_resend" />
              <button type="submit" class="text-brand-700 hover:underline">Resend email</button>
            </form>
          </div>
        )}
      </div>
    )}
  </div>

  <div class="bg-white rounded-xl border border-violet-100 p-6 mt-6 text-sm">
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-semibold">Review</h2>
      {review ? (
        <span class="px-2 py-0.5 rounded text-xs bg-brand-100 text-brand-700">{'★'.repeat(review.rating)} · {review.status}</span>
      ) : booking.review_requested_at ? (
        <span class="px-2 py-0.5 rounded text-xs bg-stone-100 text-stone-700">Requested {fmtTime(booking.review_requested_at)}</span>
      ) : null}
    </div>
    {reviewResult && REVIEW_REQUEST_MESSAGES[reviewResult] && (
      <p class={`mb-3 ${REVIEW_REQUEST_MESSAGES[reviewResult].ok ? 'text-green-700' : 'text-red-600'}`}>{REVIEW_REQUEST_MESSAGES[reviewResult].text}</p>
    )}
    {review && (
      <div class="mb-4 rounded-lg bg-stone-50 p-3">
        <p class="text-amber-500" aria-label={`${review.rating} out of 5`}>{'★'.repeat(review.rating)}<span class="text-stone-300">{'★'.repeat(5 - review.rating)}</span></p>
        {review.comment && <p class="mt-1 whitespace-pre-line text-stone-700">{review.comment}</p>}
        <a href="/admin/reviews" class="inline-flex min-h-11 items-center text-brand-700 hover:underline">Approve or hide on the Reviews page</a>
      </div>
    )}
    {!reviewOpen ? (
      <p class="text-stone-500">{booking.status === 'cancelled' ? 'Cancelled bookings are not asked for a review.' : `You can ask for a review after the tour (${formatTravelDate(booking.travel_date)}).`}</p>
    ) : review ? null : (
      <div class="flex flex-wrap gap-2">
        <form method="POST">
          <input type="hidden" name="_action" value="review_email" />
          <button type="submit" class={actionBtn} disabled={!booking.traveler_email}>
            {booking.review_requested_at ? 'Request for review again (email)' : 'Request for review (email)'}
          </button>
        </form>
        {contactWa && (
          <form method="POST" target="_blank" onsubmit="setTimeout(() => location.reload(), 1000)">
            <input type="hidden" name="_action" value="review_whatsapp" />
            <button type="submit" class="min-h-11 rounded bg-emerald-700 px-4 text-sm font-medium text-white">Request on WhatsApp</button>
          </form>
        )}
      </div>
    )}
    {reviewOpen && !review && !booking.traveler_email && <p class="mt-2 text-xs text-stone-500">No email on file, so use WhatsApp.</p>}
  </div>

  <div class="bg-white rounded-xl border border-violet-100 p-6 mt-6 text-sm">
    <h2 class="font-semibold mb-3">Notes</h2>
    <form method="POST" class="flex gap-2 mb-4">
      <input type="hidden" name="_action" value="note" />
      <input name="note" placeholder="Add a note…" class="flex-1 rounded border border-violet-200 px-3 py-2" required />
      <button type="submit" class={actionBtn}>Add</button>
    </form>
    {notes.length === 0 ? (
      <EmptyState message="No notes yet" hint="Notes are for the team. Guests never see them." />
    ) : (
      <ul class="space-y-2">
        {notes.map((n) => (
          <li class="border-t border-stone-100 pt-2">
            <p>{n.note}</p>
            <p class="text-xs text-stone-500">{fmtTime(n.created_at)}{n.author ? ` · ${ownerLabel(n.author, staffNames)}` : ''}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</AdminLayout>
