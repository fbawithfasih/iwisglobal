---
// Team: who else can use the admin. Owner only (src/lib/authz.ts). People are invited by email and sign in with Google;
// suspending takes effect on their next click. Nothing here changes the owner's own password sign-in.
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { auditContext, recordAudit } from '../../../lib/audit';
import { getStaff, inviteStaff, listStaff, reactivateStaff, removeStaff, revokeAllSessions, suspendStaff, type StaffUser } from '../../../lib/staff';
import { formatDateTimeIst } from '../../../lib/format';
import type { D1Like } from '../../../lib/db';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}
if (Astro.locals.admin?.role !== 'owner') return new Response('This page is only for the owner.', { status: 403 });
const db: D1Like | undefined = env.DB;
if (!db) return new Response('No database', { status: 503 });

let notice = Astro.url.searchParams.get('notice') ?? '';
let error = '';
let missing = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');
  const id = String(form.get('id') ?? '');
  const ctx = auditContext(Astro.request, Astro.locals);
  const who = Astro.locals.admin?.email ?? 'owner';
  try {
    if (action === 'invite') {
      const r = await inviteStaff(db, { email: String(form.get('email') ?? ''), name: String(form.get('name') ?? ''), role: 'team', invitedBy: who });
      if (!r.ok) error = r.error;
      else {
        await recordAudit(db, ctx, { action: 'team.invite', resource: 'staff', resourceId: r.user.id, summary: 'Invited a team member', meta: { email: r.user.email } });
        notice = `Invited ${r.user.email}. Tell them to open the admin login page and choose "Continue with Google" with that address.`;
      }
    } else if (id) {
      const person = await getStaff(db, id);
      if (!person) error = 'That person no longer exists.';
      else if (action === 'suspend' && (await suspendStaff(db, id))) {
        await recordAudit(db, ctx, { action: 'team.suspend', resource: 'staff', resourceId: id, summary: 'Suspended a team member', meta: { email: person.email } });
        notice = `${person.email} is suspended and signed out everywhere.`;
      } else if (action === 'reactivate' && (await reactivateStaff(db, id))) {
        await recordAudit(db, ctx, { action: 'team.reactivate', resource: 'staff', resourceId: id, summary: 'Reactivated a team member', meta: { email: person.email } });
        notice = `${person.email} can sign in again.`;
      } else if (action === 'sign_out') {
        await revokeAllSessions(db, id);
        await recordAudit(db, ctx, { action: 'team.sign_out', resource: 'staff', resourceId: id, summary: 'Signed a team member out everywhere', meta: { email: person.email } });
        notice = `${person.email} was signed out everywhere.`;
      } else if (action === 'remove' && String(form.get('confirm') ?? '').trim().toUpperCase() === 'REMOVE' && (await removeStaff(db, id))) {
        await recordAudit(db, ctx, { action: 'team.remove', resource: 'staff', resourceId: id, summary: 'Removed a team member', meta: { email: person.email } });
        notice = `${person.email} was removed.`;
      } else if (action === 'remove') {
        error = 'To remove someone, type REMOVE in the box.';
      }
    }
  } catch (err) {
    console.error('team action failed', err instanceof Error ? err.message : 'error');
    error = 'That did not work. Please try again.';
  }
  if (!error) return Astro.redirect(`/admin/team?notice=${encodeURIComponent(notice)}`);
}

let people: StaffUser[] = [];
try {
  people = await listStaff(db);
} catch {
  missing = true;
}
const googleReady = Boolean(env.GOOGLE_CLIENT_ID && env.GOOGLE_CLIENT_SECRET);
const badge: Record<string, string> = { active: 'badge-success', invited: 'badge-info', suspended: 'badge-danger' };
const btn = 'min-h-11 rounded-full px-4 text-sm';
---
<AdminLayout title="Team">
  <h1 class="mb-1 text-2xl font-semibold">Team</h1>
  <p class="mb-4 text-sm text-stone-600">People you have invited to the admin. They sign in with their own Google account, can do everything except this page, the audit log, erasing a person and system settings, and every action they take is recorded under their email.</p>

  {notice && <p role="status" class="mb-4 rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-900">{notice}</p>}
  {error && <p role="alert" class="mb-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800">{error}</p>}

  {missing ? (
    <div class="rounded-xl border bg-white p-4 text-sm">
      <p class="font-semibold">Team accounts are not set up yet.</p>
      <p class="mt-1 text-stone-700">The database tables for staff have not been created. Your own sign-in is unaffected.</p>
    </div>
  ) : (
    <>
      {!googleReady && <p class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">Google sign-in is not configured on this site, so invited people cannot sign in yet.</p>}

      <form method="POST" class="mb-6 grid gap-3 rounded-xl border bg-white p-4 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
        <input type="hidden" name="_action" value="invite" />
        <label class="grid gap-1 text-sm font-medium">Email address (their Google account)
          <input type="email" name="email" required autocomplete="off" class="min-h-11 rounded border border-violet-200 px-3 font-normal" />
        </label>
        <label class="grid gap-1 text-sm font-medium">Name (optional)
          <input name="name" maxlength="100" autocomplete="off" class="min-h-11 rounded border border-violet-200 px-3 font-normal" />
        </label>
        <button class={`btn-primary text-white ${btn}`}>Invite</button>
      </form>

      {people.length === 0 ? (
        <p class="rounded-xl border bg-white p-4 text-sm text-stone-700">No one invited yet.</p>
      ) : (
        <ul class="grid gap-3">
          {people.map((p) => (
            <li class="rounded-xl border bg-white p-4">
              <div class="flex flex-wrap items-center gap-2">
                <p class="font-semibold">{p.name || p.email}</p>
                <span class={`badge ${badge[p.status]}`}>{p.status}</span>
                <span class="badge badge-neutral">{p.role}</span>
              </div>
              <p class="text-sm text-stone-700">{p.email}</p>
              <p class="text-xs text-stone-600">
                {p.status === 'invited' ? `Invited ${formatDateTimeIst(p.invited_at)}. The invite lasts 14 days.` : p.last_login_at ? `Last signed in ${formatDateTimeIst(p.last_login_at)}` : 'Has not signed in yet'}
              </p>
              <div class="mt-3 flex flex-wrap items-center gap-2">
                {p.status === 'suspended' ? (
                  <form method="POST"><input type="hidden" name="_action" value="reactivate" /><input type="hidden" name="id" value={p.id} /><button class={`btn-secondary ${btn}`}>Reactivate</button></form>
                ) : (
                  <form method="POST" data-confirm="Suspend this person? They are signed out everywhere straight away." data-confirm-label="Suspend"><input type="hidden" name="_action" value="suspend" /><input type="hidden" name="id" value={p.id} /><button class={`btn-secondary ${btn}`}>Suspend</button></form>
                )}
                {p.status === 'active' && (
                  <form method="POST" data-confirm="Sign this person out of every device? They will have to sign in again." data-confirm-label="Sign out"><input type="hidden" name="_action" value="sign_out" /><input type="hidden" name="id" value={p.id} /><button class={`btn-secondary ${btn}`}>Sign out everywhere</button></form>
                )}
                <form method="POST" class="flex items-center gap-2">
                  <input type="hidden" name="_action" value="remove" /><input type="hidden" name="id" value={p.id} />
                  <input name="confirm" placeholder="type REMOVE" aria-label={`Type REMOVE to remove ${p.email}`} autocomplete="off" class="min-h-11 w-32 rounded border border-violet-200 px-3 text-sm" />
                  <button class={`btn-danger ${btn}`}>Remove</button>
                </form>
              </div>
            </li>
          ))}
        </ul>
      )}
    </>
  )}
</AdminLayout>
