---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { resolveEnv } from '../../../lib/env';
import { isAdminAuthenticated } from '../../../lib/requireAdmin';
import { createAgraHighlight, listAgraHighlights } from '../../../lib/agraHighlights';
import { uploadAgraHighlightImage } from '../../../lib/images';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET))) {
  return Astro.redirect('/admin/login');
}

const db = env.DB;
let error: string | null = null;

if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  const name = String(form.get('name') ?? '').trim();
  const description = String(form.get('description') ?? '').trim();
  const sortOrder = Number(form.get('sortOrder') ?? 0);

  if (!name) {
    error = 'Name is required.';
  } else {
    try {
      const imageFile = form.get('imageFile');
      let image = String(form.get('image') ?? '').trim();
      if (imageFile instanceof File && imageFile.size > 0) {
        if (!env.IMAGES) throw new Error('Image storage is not configured yet.');
        const uploaded = await uploadAgraHighlightImage(env.IMAGES, imageFile);
        image = uploaded.url;
      }

      await createAgraHighlight(db, {
        name,
        description,
        image,
        sortOrder: Number.isFinite(sortOrder) ? sortOrder : 0,
      });
      return Astro.redirect('/admin/agra-highlights');
    } catch (err: any) {
      error = err?.message || 'Failed to create item.';
    }
  }
}

// Suggest the next sort order so new items append to the end by default.
const existing = db ? await listAgraHighlights(db) : [];
const nextSortOrder = existing.reduce((max, h) => Math.max(max, h.sortOrder), -1) + 1;
---
<AdminLayout title="New Agra Highlight">
  <a href="/admin/agra-highlights" class="text-sm text-stone-500 hover:underline">&larr; Back to Agra highlights</a>
  <h1 class="text-2xl font-semibold mt-2 mb-6">New "thing to do" card</h1>

  {error && <p class="text-red-600 text-sm mb-4">{error}</p>}

  <form method="POST" enctype="multipart/form-data" class="bg-white rounded-xl border border-violet-100 p-6 space-y-4 max-w-xl text-sm">
    <div>
      <label class="block text-stone-500 mb-1">Name *</label>
      <input name="name" required class="w-full rounded border border-violet-200 px-3 py-2" placeholder="e.g. Agra Fort" />
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Description</label>
      <textarea name="description" rows="3" class="w-full rounded border border-violet-200 px-3 py-2" placeholder="One or two sentences shown under the name on the homepage card."></textarea>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Upload image</label>
      <input id="imageFile" type="file" name="imageFile" accept="image/jpeg,image/png,image/webp,image/gif" class="w-full text-sm" />
      <p class="text-xs text-stone-500 mt-1">
        Recommended: <strong>1200 × 900px (4:3 ratio)</strong> — matches the card frame on the homepage exactly, so nothing gets cropped oddly. JPEG/PNG/WebP/GIF, up to 5MB.
      </p>
      <p id="imageOptimizeStatus" class="text-xs text-emerald-700 mt-1"></p>
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Image URL (used only if no file is uploaded above)</label>
      <input name="image" placeholder="https://…" class="w-full rounded border border-violet-200 px-3 py-2" />
    </div>
    <div>
      <label class="block text-stone-500 mb-1">Sort order (lower numbers show first)</label>
      <input type="number" name="sortOrder" value={nextSortOrder} class="w-full rounded border border-violet-200 px-3 py-2" />
    </div>
    <button type="submit" class="rounded btn-primary text-white px-4 py-2">Create</button>
  </form>
</AdminLayout>

<script>
  import { attachImageOptimizer } from '../../../lib/imageOptimizeClient';
  const input = document.getElementById('imageFile') as HTMLInputElement | null;
  const status = document.getElementById('imageOptimizeStatus');
  if (input) attachImageOptimizer(input, status);
</script>
