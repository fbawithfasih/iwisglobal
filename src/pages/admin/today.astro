---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { resolveEnv } from '../../lib/env';
import { isAdminAuthenticated } from '../../lib/requireAdmin';
import { actorLabel } from '../../lib/authz';
import { todayIst } from '../../lib/availability';
import { loadToday } from '../../lib/todayBoard';
import { listTourTicketInfo } from '../../lib/tours';
import { computeTicketsToBuy, ticketsOutstanding } from '../../lib/entryTickets';
import { formatTravelDate } from '../../lib/format';
import { formatDuration } from '../../lib/waInbox';
import { CUSTOM_TOUR_ID } from '../../lib/customTripPayment';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}
const db = env.DB;
const me = actorLabel(Astro.locals.admin);
const today = todayIst();

let board = null;
let tours: Awaited<ReturnType<typeof listTourTicketInfo>> = [];
let loadError = false;
if (db) {
  try {
    // The board and the tour list are independent: one round trip, not two in a row.
    [board, tours] = await Promise.all([loadToday(db, { today, me }), listTourTicketInfo(db).catch(() => [])]);
  } catch (err) {
    console.error('today board failed', err instanceof Error ? err.message : 'error');
    loadError = true;
  }
}
const toursById = new Map(tours.map((t) => [t.id, t]));
const tourName = (id: string) => (id === CUSTOM_TOUR_ID ? 'Custom Agra tour' : toursById.get(id)?.title ?? id);
const ticketsToBuy = (b: NonNullable<typeof board>['trips'][number]) => {
  const tour = toursById.get(b.tour_id);
  return tour ? ticketsOutstanding(b, computeTicketsToBuy(tour, b)) : false;
};
const shown = (part: 'trips' | 'chats' | 'leads', n: number) => (board?.failed.includes(part) ? '–' : n);
const days = board ? [{ label: 'Today', ymd: board.today }, { label: 'Tomorrow', ymd: board.tomorrow }] : [];
const tile = 'block rounded-xl border border-violet-100 bg-white p-4 transition-colors hover:border-violet-300';
// A "needs you" tile takes a soft tint only while it has something to do; at zero it stays plain white and calm.
const counted = (tone: 'warn' | 'info' | 'success', n: number | string) =>
  typeof n === 'number' && n > 0 ? `block rounded-xl border p-4 transition-colors hover:border-violet-300 tint-${tone}` : tile;
---
<AdminLayout title="Today">
  <h1 class="text-2xl font-semibold">Today</h1>
  <p class="mb-6 text-sm text-stone-600">{formatTravelDate(today)} (India time). Every number below is a count of the list it opens.</p>

  {!db && <p class="notice notice-danger my-3" role="alert">Database not available.</p>}
  {loadError && <p class="notice notice-danger my-3" role="alert">Could not load today's board. The other pages still work; try again in a moment.</p>}

  {board && board.failed.length > 0 && (
    <p class="notice notice-warn my-3" role="alert">
      Could not load {board.failed.map((f) => ({ trips: 'trips and bookings', chats: 'WhatsApp chats', leads: 'leads' })[f]).join(', ')}. Those numbers show a dash below, not zero. The other pages still work.
    </p>
  )}

  {board && (
    <>
      <section aria-labelledby="needs-you" class="mb-8">
        <h2 id="needs-you" class="mb-3 text-lg font-semibold">Needs you now</h2>
        <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
          <a href="/admin/whatsapp?tab=attention" class={counted('warn', shown('chats', board.chatsWaiting.total))}>
            <span class="block text-3xl font-semibold text-stone-900">{shown('chats', board.chatsWaiting.total)}</span>
            <span class="block font-medium text-stone-800">WhatsApp chats waiting</span>
            <span class="block text-xs text-stone-500">The guest wrote last and nobody has replied{board.chatsHandedOff > 0 ? `. ${board.chatsHandedOff} handed to a person` : ''}.</span>
          </a>
          <a href="/admin/leads?view=unanswered" class={counted('warn', shown('leads', board.leadsUnanswered.total))}>
            <span class="block text-3xl font-semibold text-stone-900">{shown('leads', board.leadsUnanswered.total)}</span>
            <span class="block font-medium text-stone-800">Leads with no reply</span>
            <span class="block text-xs text-stone-500">Leads still at New.</span>
          </a>
          <a href="/admin/leads?view=followups" class={counted('info', shown('leads', board.followUpsDue))}>
            <span class="block text-3xl font-semibold text-stone-900">{shown('leads', board.followUpsDue)}</span>
            <span class="block font-medium text-stone-800">Follow-ups due</span>
            <span class="block text-xs text-stone-500">Open leads whose follow-up date has come, anyone's.</span>
          </a>
          <a href="/admin?view=awaiting" class={counted('success', shown('trips', board.awaitingConfirmation))}>
            <span class="block text-3xl font-semibold text-stone-900">{shown('trips', board.awaitingConfirmation)}</span>
            <span class="block font-medium text-stone-800">Bookings to confirm</span>
            <span class="block text-xs text-stone-500">Custom trips waiting for you.</span>
          </a>
        </div>
      </section>

      <section aria-labelledby="trips" class="mb-8">
        <h2 id="trips" class="mb-3 text-lg font-semibold">Tours running</h2>
        <div class="grid gap-4 md:grid-cols-2">
          {days.map((d) => {
            const list = board.trips.filter((t) => t.travel_date === d.ymd);
            return (
              <div>
                <h3 class="mb-2 text-sm font-semibold text-stone-700">{d.label} <span class="font-normal text-stone-500">· {formatTravelDate(d.ymd)} · {list.length} {list.length === 1 ? 'trip' : 'trips'}</span></h3>
                {list.length === 0 ? (
                  <EmptyState message={`No confirmed trips ${d.label.toLowerCase()}`} />
                ) : (
                  <ul class="space-y-2">
                    {list.map((b) => (
                      <li>
                        <a href={`/admin/bookings/${b.id}`} class={tile}>
                          <span class="flex items-start justify-between gap-3">
                            <span class="font-semibold text-stone-900">{b.traveler_name} <span class="font-normal text-stone-500">· {b.travelers} pax</span></span>
                            <span class="shrink-0 text-sm text-stone-700">{b.pickup_time || 'pickup not set'}</span>
                          </span>
                          <span class="block text-sm text-stone-700">{tourName(b.tour_id)}</span>
                          <span class="block text-xs text-stone-500">
                            Guide: {b.guide_assigned || 'not assigned'} · Vehicle: {b.vehicle || 'not assigned'}
                          </span>
                          <span class="block text-xs text-stone-500">
                            Driver: {b.driver_name || 'not assigned'}{b.driver_phone ? ` · ${b.driver_phone}` : ''}
                          </span>
                          {(!b.guide_assigned || !b.driver_name || !b.pickup_time || ticketsToBuy(b) || b.total_amount > b.amount_paid) && (
                            <span class="mt-1 block">
                              {!b.pickup_time && <span class="badge-warn mr-1 rounded px-1.5 py-0.5 text-[11px]">Set pickup time</span>}
                              {!b.guide_assigned && <span class="badge-warn mr-1 rounded px-1.5 py-0.5 text-[11px]">Assign guide</span>}
                              {!b.driver_name && <span class="badge-warn mr-1 rounded px-1.5 py-0.5 text-[11px]">Assign driver</span>}
                              {ticketsToBuy(b) && <span class="badge-warn mr-1 rounded px-1.5 py-0.5 text-[11px]">Tickets needed</span>}
                              {b.total_amount > b.amount_paid && <span class="badge-warn mr-1 rounded px-1.5 py-0.5 text-[11px]">Balance due</span>}
                            </span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            );
          })}
        </div>
      </section>

      <div class="mb-8 grid gap-6 md:grid-cols-2">
        <section aria-labelledby="waiting">
          <h2 id="waiting" class="mb-3 text-lg font-semibold">Longest waiting</h2>
          {board.chatsWaiting.top.length === 0 && board.leadsUnanswered.top.length === 0 ? (
            <EmptyState message="Nobody is waiting for a reply" />
          ) : (
            <ul class="space-y-2">
              {board.chatsWaiting.top.map((c) => (
                <li>
                  <a href={`/admin/whatsapp?c=${encodeURIComponent(c.id)}`} class={tile}>
                    <span class="font-medium text-stone-900">{c.profile_name || 'WhatsApp guest'}</span>
                    <span class="block text-xs text-stone-500">WhatsApp · waiting {formatDuration(c.waitingMs)}</span>
                  </a>
                </li>
              ))}
              {board.leadsUnanswered.top.map((l) => (
                <li>
                  <a href={`/admin/leads/${l.id}`} class={tile}>
                    <span class="font-medium text-stone-900">{l.name || 'New lead'}</span>
                    <span class="block text-xs text-stone-500">{l.channel} · waiting {formatDuration(Date.now() - Date.parse(l.created_at))}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>

        <section aria-labelledby="mine">
          <h2 id="mine" class="mb-3 text-lg font-semibold">Mine</h2>
          <div class="mb-3 grid grid-cols-2 gap-3">
            <a href="/admin/leads?view=mine" class={tile}>
              <span class="block text-2xl font-semibold text-stone-900">{shown('leads', board.myLeads)}</span>
              <span class="block text-sm text-stone-700">My open leads</span>
            </a>
            <a href="/admin/whatsapp?tab=mine" class={tile}>
              <span class="block text-2xl font-semibold text-stone-900">{shown('chats', board.myChats)}</span>
              <span class="block text-sm text-stone-700">My chats</span>
            </a>
          </div>
          <h3 class="mb-2 text-sm font-semibold text-stone-700">My follow-ups due</h3>
          {board.myFollowUps.length === 0 ? (
            <EmptyState message="No follow-ups due" hint="Leads you hold with a follow-up date that has come show here." />
          ) : (
            <ul class="space-y-2">
              {board.myFollowUps.map((f) => (
                <li>
                  <a href={`/admin/leads/${f.id}`} class={tile}>
                    <span class="font-medium text-stone-900">{f.name || 'Lead'}</span>
                    <span class="block text-xs text-stone-500">{f.overdueDays > 0 ? `${f.overdueDays} ${f.overdueDays === 1 ? 'day' : 'days'} overdue` : 'due today'}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      </div>
    </>
  )}
</AdminLayout>
