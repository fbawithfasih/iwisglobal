---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { resolveEnv } from '../../lib/env';
import { isAdminAuthenticated } from '../../lib/requireAdmin';
import { actorLabel } from '../../lib/authz';
import { todayIst } from '../../lib/availability';
import { loadToday, addDays } from '../../lib/todayBoard';
import { loadTrends, readiness, urgency, summarise, WEEK_DAYS, type TodayTrends } from '../../lib/todayTrends';
import { listTourTicketInfo } from '../../lib/tours';
import { computeTicketsToBuy, ticketsOutstanding } from '../../lib/entryTickets';
import { formatTravelDate } from '../../lib/format';
import { formatDuration } from '../../lib/waInbox';
import { CUSTOM_TOUR_ID } from '../../lib/customTripPayment';

const env = resolveEnv(Astro.locals);
if (!(await isAdminAuthenticated(Astro.cookies, env.ADMIN_SESSION_SECRET, Astro.locals))) {
  return Astro.redirect('/admin/login');
}
const db = env.DB;
const me = actorLabel(Astro.locals.admin);
const today = todayIst();

let board = null;
let trends: TodayTrends | null = null;
let tours: Awaited<ReturnType<typeof listTourTicketInfo>> = [];
let loadError = false;
if (db) {
  try {
    // The board, the pictures and the tour list are independent: one round trip, not three in a row.
    [board, trends, tours] = await Promise.all([loadToday(db, { today, me }), loadTrends(db, { today }), listTourTicketInfo(db).catch(() => [])]);
  } catch (err) {
    console.error('today board failed', err instanceof Error ? err.message : 'error');
    loadError = true;
  }
}
const toursById = new Map(tours.map((t) => [t.id, t]));
const tourName = (id: string) => (id === CUSTOM_TOUR_ID ? 'Custom Agra tour' : toursById.get(id)?.title ?? id);
type Trip = NonNullable<typeof trends>['week'][number];
const ticketsToBuy = (b: Trip) => {
  const tour = toursById.get(b.tour_id);
  return tour ? ticketsOutstanding(b, computeTicketsToBuy(tour, b)) : false;
};
const shown = (part: 'trips' | 'chats' | 'leads', n: number) => (board?.failed.includes(part) ? '–' : n);

// Greeting by the hour in India. Only a real name is used, never the word "Owner".
const hour = Number(new Intl.DateTimeFormat('en-GB', { hour: 'numeric', hourCycle: 'h23', timeZone: 'Asia/Kolkata' }).format(new Date()));
const greeting = hour < 12 ? 'Good morning' : hour < 17 ? 'Good afternoon' : 'Good evening';
const adminName = Astro.locals.admin?.name ?? '';
const first = adminName && adminName !== 'Owner' && !adminName.includes('@') ? adminName.split(/\s+/)[0] : '';

// The four "needs you" tiles. Each keeps its own colour while it has work, and turns green with a tick at zero.
const oldestChat = board?.chatsWaiting.top[0]?.waitingMs ?? 0;
const oldestLead = board?.leadsUnanswered.top[0] ? Date.now() - Date.parse(board.leadsUnanswered.top[0].created_at) : 0;
const icons = {
  chat: 'M21 12a8 8 0 0 1-11.5 7.2L4 20l1-4.3A8 8 0 1 1 21 12Z',
  lead: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM19 8v6M22 11h-6',
  clock: 'M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  confirm: 'M9 12l2 2 4-4M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3Z',
  check: 'M5 13l4 4L19 7',
};
const tiles = board
  ? [
      { href: '/admin/whatsapp?tab=attention', n: shown('chats', board.chatsWaiting.total), tone: 'warn', icon: icons.chat, label: 'WhatsApp chats waiting', hint: `The guest wrote last and nobody has replied${board.chatsHandedOff > 0 ? `. ${board.chatsHandedOff} handed to a person` : ''}.`, oldest: oldestChat },
      { href: '/admin/leads?view=unanswered', n: shown('leads', board.leadsUnanswered.total), tone: 'danger', icon: icons.lead, label: 'Leads with no reply', hint: 'Leads still at New.', oldest: oldestLead },
      { href: '/admin/leads?view=followups', n: shown('leads', board.followUpsDue), tone: 'info', icon: icons.clock, label: 'Follow-ups due', hint: "Open leads whose follow-up date has come, anyone's.", oldest: 0 },
      { href: '/admin?view=awaiting', n: shown('trips', board.awaitingConfirmation), tone: 'brand', icon: icons.confirm, label: 'Bookings to confirm', hint: 'Custom trips waiting for you.', oldest: 0 },
    ]
  : [];
const open = tiles.reduce((t, x) => t + (typeof x.n === 'number' ? x.n : 0), 0);

// The week: one column per day, each with the trips and how ready they are.
const week = trends ? Array.from({ length: WEEK_DAYS }, (_, i) => addDays(today, i)) : [];
const dayLabel = (ymd: string, i: number) => (i === 0 ? 'Today' : i === 1 ? 'Tomorrow' : new Intl.DateTimeFormat('en-GB', { weekday: 'short', timeZone: 'UTC' }).format(new Date(`${ymd}T00:00:00Z`)));
const dayShort = (ymd: string) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(new Date(`${ymd}T00:00:00Z`));
const tripsOn = (ymd: string) => (trends?.week ?? []).filter((t) => t.travel_date === ymd);
const ready = (b: Trip) => readiness(b, ticketsToBuy(b));
const columns = week.map((ymd, i) => {
  const list = tripsOn(ymd);
  const toPrepare = list.filter((b) => ready(b).missing.length > 0).length;
  const pax = list.reduce((t, b) => t + b.travelers, 0);
  const tip = list.length === 0 ? `${dayLabel(ymd, i)} ${dayShort(ymd)}: no trips` : `${dayLabel(ymd, i)} ${dayShort(ymd)}: ${list.length} ${list.length === 1 ? 'trip' : 'trips'}, ${pax} guests${toPrepare ? `, ${toPrepare} to prepare` : ', all ready'}`;
  return { ymd, i, list, toPrepare, pax, tip };
});
const maxTrips = Math.max(1, ...columns.map((c) => c.list.length));
const weekTotal = columns.reduce((t, c) => t + c.list.length, 0);
const weekPrep = columns.reduce((t, c) => t + c.toPrepare, 0);

// Enquiries and bookings per day, handed to the page script as JSON so the 7 / 14 day switch needs no reload.
const flow = trends && !trends.failed.includes('flow') ? trends.days : null;
const flow14 = flow ? summarise(flow, 14) : null;

// Longest waiting: chats and leads in one list with a bar for how long, coloured by how late it is.
const waiting = board
  ? [
      ...board.chatsWaiting.top.map((c) => ({ href: `/admin/whatsapp?c=${encodeURIComponent(c.id)}`, name: c.profile_name || 'WhatsApp guest', kind: 'WhatsApp', ms: c.waitingMs })),
      ...board.leadsUnanswered.top.map((l) => ({ href: `/admin/leads/${l.id}`, name: l.name || 'New lead', kind: l.channel, ms: Date.now() - Date.parse(l.created_at) })),
    ].sort((a, b) => b.ms - a.ms).slice(0, 6)
  : [];
const urgencyText = { calm: 'Under 1 h', soon: '1 to 4 h', late: 'Over 4 h' } as const;
const urgencyClass = { calm: 'badge-success', soon: 'badge-warn', late: 'badge-danger' } as const;
const barClass = { calm: 'bg-emerald-500', soon: 'bg-orange-400', late: 'bg-rose-500' } as const;

// What to do about each missing item, in the words the badges have always used.
const todo: Record<string, string> = { 'Pickup time': 'Set pickup time', Guide: 'Assign guide', Driver: 'Assign driver', Tickets: 'Tickets needed', Balance: 'Balance due' };
const tile = 'block rounded-xl border border-violet-100 bg-white p-4 transition hover:-translate-y-0.5 hover:border-violet-300 hover:shadow-md';
---
<AdminLayout title="Today">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-semibold">{greeting}{first ? `, ${first}` : ''}</h1>
      <p class="text-sm text-stone-600">{formatTravelDate(today)} (India time). Every number below is a count of the list it opens.</p>
    </div>
    {board && (
      <p class={`rounded-full px-4 py-1.5 text-sm font-medium ${open > 0 ? 'badge-warn' : 'badge-success'}`} role="status">
        {open > 0 ? `${open} ${open === 1 ? 'thing needs' : 'things need'} you` : 'Nothing needs you right now'}
      </p>
    )}
  </div>

  {!db && <p class="notice notice-danger my-3" role="alert">Database not available.</p>}
  {loadError && <p class="notice notice-danger my-3" role="alert">Could not load today's board. The other pages still work; try again in a moment.</p>}

  {board && board.failed.length > 0 && (
    <p class="notice notice-warn my-3" role="alert">
      Could not load {board.failed.map((f) => ({ trips: 'trips and bookings', chats: 'WhatsApp chats', leads: 'leads' })[f]).join(', ')}. Those numbers show a dash below, not zero. The other pages still work.
    </p>
  )}

  {board && (
    <>
      <section aria-labelledby="needs-you" class="mb-8">
        <h2 id="needs-you" class="mb-3 text-lg font-semibold">Needs you now</h2>
        <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
          {tiles.map((t) => {
            const clear = typeof t.n === 'number' && t.n === 0;
            return (
              <a href={t.href} class={`group block rounded-xl border p-4 transition hover:-translate-y-0.5 hover:shadow-md ${clear ? 'tint-success' : `tint-${t.tone}`}`}>
                <span class="flex items-start justify-between gap-2">
                  <span class="block text-4xl font-semibold leading-none text-stone-900">{t.n}</span>
                  <span class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full ${clear ? 'badge-success' : `badge-${t.tone}`}`} aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={clear ? icons.check : t.icon} /></svg>
                  </span>
                </span>
                <span class="mt-2 block font-medium text-stone-800">{t.label}</span>
                <span class="block text-xs text-stone-600">{clear ? 'All clear.' : t.hint}</span>
                {!clear && t.oldest > 0 && <span class="mt-2 inline-block rounded-full bg-white/70 px-2 py-0.5 text-[11px] font-medium text-stone-700">Longest wait {formatDuration(t.oldest)}</span>}
              </a>
            );
          })}
        </div>
      </section>
    </>
  )}

  {trends && (
    <section aria-labelledby="trips" class="mb-8">
      <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="trips" class="text-lg font-semibold">The week ahead</h2>
        <p class="text-sm text-stone-600">
          {trends.failed.includes('week') ? 'Could not load the trips. Try again in a moment.' : `${weekTotal} ${weekTotal === 1 ? 'trip' : 'trips'} in the next 7 days${weekPrep ? `, ${weekPrep} still to prepare` : weekTotal ? ', all ready' : ''}`}
        </p>
      </div>
      <div class="rounded-xl border border-violet-100 bg-white p-3 sm:p-4">
        <div id="week" role="group" aria-label="Trips in the next 7 days. Choose a day to list its trips below." class="grid grid-cols-7 gap-1 sm:gap-2">
          {columns.map((c) => (
            <button type="button" data-day={c.ymd} data-tip={c.tip} aria-label={c.tip} aria-pressed={c.i === 0 ? 'true' : 'false'} class="wk group flex min-h-11 flex-col items-center rounded-lg border border-transparent px-1 pb-2 pt-1 text-center transition hover:bg-violet-50">
              <span class="text-lg font-semibold leading-none text-stone-900 sm:text-xl">{c.list.length}</span>
              <span class="wk-well mt-2 flex h-20 w-full items-end justify-center sm:h-24" aria-hidden="true">
                <span class={`wk-bar block w-3/5 max-w-10 rounded-t-md ${c.list.length === 0 ? 'bg-violet-100' : c.toPrepare ? 'bg-orange-400' : 'bg-emerald-500'}`} style={`height:${c.list.length === 0 ? 3 : Math.max(10, Math.round((c.list.length / maxTrips) * 100))}%`}></span>
              </span>
              <span class="mt-1 text-xs font-semibold text-stone-800">{c.i === 1 ? <><span class="sm:hidden">Tmrw</span><span class="hidden sm:inline">Tomorrow</span></> : dayLabel(c.ymd, c.i)}</span>
              <span class="text-[11px] text-stone-600">{dayShort(c.ymd)}</span>
              <span class={`mt-1 text-[11px] font-medium ${c.list.length === 0 ? 'text-stone-500' : c.toPrepare ? 'text-orange-800' : 'text-emerald-800'}`}>
                {c.list.length === 0 ? <><span class="sm:hidden">–</span><span class="hidden sm:inline">No trips</span></> : c.toPrepare ? <><span class="sm:hidden">⚠ {c.toPrepare}</span><span class="hidden sm:inline">⚠ {c.toPrepare} to prep</span></> : <><span class="sm:hidden">✓</span><span class="hidden sm:inline">✓ Ready</span></>}
              </span>
            </button>
          ))}
        </div>
        <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-violet-100 pt-3 text-xs text-stone-600">
          <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-emerald-500"></span>Everything ready</span>
          <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-orange-400"></span>Something to prepare (pickup, guide, driver, tickets or balance)</span>
          <span>Bar height is the number of trips.</span>
        </p>
      </div>

      <div class="mt-4" id="day-panels">
        {columns.map((c) => (
          <div data-panel={c.ymd} hidden={c.i !== 0} role="region" aria-label={`Trips on ${formatTravelDate(c.ymd)}`}>
            <h3 class="mb-2 text-sm font-semibold text-stone-700">{dayLabel(c.ymd, c.i)} <span class="font-normal text-stone-500">· {formatTravelDate(c.ymd)} · {c.list.length} {c.list.length === 1 ? 'trip' : 'trips'}{c.pax ? ` · ${c.pax} guests` : ''}</span></h3>
            {c.list.length === 0 ? (
              <EmptyState message={`No confirmed trips ${c.i === 0 ? 'today' : c.i === 1 ? 'tomorrow' : `on ${dayShort(c.ymd)}`}`} />
            ) : (
              <ul class="grid gap-2 lg:grid-cols-2">
                {c.list.map((b) => {
                  const r = ready(b);
                  return (
                    <li>
                      <a href={`/admin/bookings/${b.id}`} class={tile}>
                        <span class="flex items-start justify-between gap-3">
                          <span class="font-semibold text-stone-900">{b.traveler_name} <span class="font-normal text-stone-500">· {b.travelers} pax</span></span>
                          <span class="shrink-0 text-sm font-medium text-stone-700">{b.pickup_time || 'pickup not set'}</span>
                        </span>
                        <span class="block text-sm text-stone-700">{tourName(b.tour_id)}</span>
                        <span class="block text-xs text-stone-500">Guide: {b.guide_assigned || 'not assigned'} · Vehicle: {b.vehicle || 'not assigned'}</span>
                        <span class="block text-xs text-stone-500">Driver: {b.driver_name || 'not assigned'}{b.driver_phone ? ` · ${b.driver_phone}` : ''}</span>
                        <span class="mt-2 flex items-center gap-2">
                          <span class="flex flex-1 gap-1" role="img" aria-label={`${r.done} of ${r.total} ready`}>
                            {Array.from({ length: r.total }, (_, k) => <span class={`h-1.5 flex-1 rounded-full ${k < r.done ? (r.missing.length ? 'bg-orange-400' : 'bg-emerald-500') : 'bg-stone-200'}`}></span>)}
                          </span>
                          <span class={`text-xs font-medium ${r.missing.length ? 'text-orange-800' : 'text-emerald-800'}`}>{r.missing.length ? `${r.done} of ${r.total} ready` : '✓ Ready'}</span>
                        </span>
                        {r.missing.length > 0 && (
                          <span class="mt-1.5 block">
                            {r.missing.map((m) => <span class="badge-warn mr-1 rounded px-1.5 py-0.5 text-[11px]">{todo[m] ?? m}</span>)}
                          </span>
                        )}
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  {board && (
    <div class="mb-8 grid gap-6 lg:grid-cols-5">
      <section aria-labelledby="flow" class="viz lg:col-span-3">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <h2 id="flow" class="text-lg font-semibold">Enquiries and bookings</h2>
          {flow && (
            <div role="group" aria-label="Period" class="inline-flex rounded-lg border border-violet-200 bg-white p-0.5 text-sm">
              <button type="button" data-range="7" aria-pressed="false" class="rng min-h-9 rounded-md px-3">7 days</button>
              <button type="button" data-range="14" aria-pressed="true" class="rng min-h-9 rounded-md px-3">14 days</button>
            </div>
          )}
        </div>
        {!flow ? (
          <p class="notice notice-warn" role="alert">Could not load the enquiry and booking counts. Try again in a moment.</p>
        ) : (
          <div class="rounded-xl border border-violet-100 bg-white p-4">
            <div class="grid grid-cols-2 gap-3">
              <div class="rounded-lg tint-brand border p-3">
                <p class="text-xs font-medium text-stone-700"><span class="mr-1.5 inline-block h-2.5 w-2.5 rounded-sm align-middle" style="background:var(--s1)"></span>Enquiries</p>
                <p class="text-3xl font-semibold text-stone-900" id="flow-leads">{flow14?.leads}</p>
                <p class="text-xs text-stone-600" id="flow-leads-delta"></p>
              </div>
              <div class="rounded-lg tint-warn border p-3">
                <p class="text-xs font-medium text-stone-700"><span class="mr-1.5 inline-block h-2.5 w-2.5 rounded-sm align-middle" style="background:var(--s2)"></span>Bookings</p>
                <p class="text-3xl font-semibold text-stone-900" id="flow-bookings">{flow14?.bookings}</p>
                <p class="text-xs text-stone-600" id="flow-bookings-delta"></p>
              </div>
            </div>
            <div id="flow-chart" class="mt-4"></div>
            <noscript><p class="mt-2 text-xs text-stone-600">The chart needs JavaScript. The table below has the same numbers.</p></noscript>
            <details class="mt-3 text-sm">
              <summary class="cursor-pointer text-stone-700">Show as a table</summary>
              <div class="mt-2 max-h-64 overflow-auto">
                <table class="w-full text-left text-xs">
                  <caption class="sr-only">Enquiries and bookings per day, last 28 days</caption>
                  <thead class="text-stone-600"><tr><th scope="col" class="py-1 pr-3">Day</th><th scope="col" class="py-1 pr-3">Enquiries</th><th scope="col" class="py-1">Bookings</th></tr></thead>
                  <tbody>
                    {[...flow].reverse().map((d) => <tr class="border-t border-violet-50"><th scope="row" class="py-1 pr-3 font-normal">{formatTravelDate(d.day)}</th><td class="py-1 pr-3">{d.leads}</td><td class="py-1">{d.bookings}</td></tr>)}
                  </tbody>
                </table>
              </div>
            </details>
            <p class="mt-2 text-xs text-stone-600">Counted by India day. Enquiries leave out spam; bookings are paid and confirmed ones, not cancelled.</p>
          </div>
        )}
      </section>

      <section aria-labelledby="waiting" class="lg:col-span-2">
        <h2 id="waiting" class="mb-3 flex min-h-9 items-center text-lg font-semibold">Longest waiting</h2>
        {waiting.length === 0 ? (
          <EmptyState message="Nobody is waiting for a reply" hint="Chats and new leads with no reply show here, longest first." />
        ) : (
          <ul class="space-y-2">
            {waiting.map((w) => {
              const u = urgency(w.ms);
              return (
                <li>
                  <a href={w.href} class={tile}>
                    <span class="flex items-center justify-between gap-2">
                      <span class="truncate font-medium text-stone-900">{w.name}</span>
                      <span class={`${urgencyClass[u]} shrink-0 rounded-full px-2 py-0.5 text-[11px] font-medium`}>{urgencyText[u]}</span>
                    </span>
                    <span class="mt-1 block text-xs text-stone-600">{w.kind} · waiting {formatDuration(w.ms)}</span>
                    <span class="mt-2 block h-1.5 overflow-hidden rounded-full bg-stone-100" aria-hidden="true">
                      <span class={`block h-full rounded-full ${barClass[u]}`} style={`width:${Math.max(4, Math.min(100, Math.round((w.ms / 86_400_000) * 100)))}%`}></span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
        <p class="mt-2 text-xs text-stone-600">The bar fills over 24 hours.</p>
      </section>
    </div>

    <section aria-labelledby="mine" class="mb-8">
      <h2 id="mine" class="mb-3 text-lg font-semibold">Mine</h2>
      <div class="grid gap-3 sm:grid-cols-3">
        <a href="/admin/leads?view=mine" class={`block rounded-xl border p-4 transition hover:-translate-y-0.5 hover:shadow-md tint-brand`}>
          <span class="block text-3xl font-semibold text-stone-900">{shown('leads', board.myLeads)}</span>
          <span class="block text-sm text-stone-700">My open leads</span>
        </a>
        <a href="/admin/whatsapp?tab=mine" class={`block rounded-xl border p-4 transition hover:-translate-y-0.5 hover:shadow-md tint-success`}>
          <span class="block text-3xl font-semibold text-stone-900">{shown('chats', board.myChats)}</span>
          <span class="block text-sm text-stone-700">My chats</span>
        </a>
        <div class={`rounded-xl border p-4 ${board.myFollowUps.length ? 'tint-info' : 'tint-success'}`}>
          <h3 class="text-sm font-semibold text-stone-800">My follow-ups due</h3>
          {board.myFollowUps.length === 0 ? (
            <p class="mt-1 text-sm text-stone-700">✓ None due. Leads you hold with a follow-up date that has come show here.</p>
          ) : (
            <ul class="mt-1 space-y-1">
              {board.myFollowUps.map((f) => (
                <li>
                  <a href={`/admin/leads/${f.id}`} class="flex items-center justify-between gap-2 text-sm text-stone-900 hover:underline">
                    <span class="truncate font-medium">{f.name || 'Lead'}</span>
                    <span class="shrink-0 text-xs text-stone-700">{f.overdueDays > 0 ? `${f.overdueDays} ${f.overdueDays === 1 ? 'day' : 'days'} overdue` : 'due today'}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>
  )}

  <div id="viz-tip" role="tooltip" hidden class="pointer-events-none fixed z-50 max-w-xs rounded-lg border border-violet-200 bg-white px-3 py-2 text-xs text-stone-800 shadow-lg"></div>
  {flow && <script type="application/json" id="flow-data" set:html={JSON.stringify(flow)} />}
</AdminLayout>

<style is:global>
  /* Chart colours: the two series are violet and orange, checked for colour-blind safety and contrast with the dataviz validator. */
  .viz { --s1: #6250d6; --s2: #eb6834; }
  .wk[aria-pressed='true'] { background: #f5f3ff; border-color: #a78bfa; }
  .rng[aria-pressed='true'] { background: var(--brand-700); color: #fff; }
  .rng:not([aria-pressed='true']) { color: #44403c; }
  #flow-chart svg { display: block; width: 100%; height: auto; }
  #flow-chart .hit { fill: transparent; cursor: pointer; }
  #flow-chart .hit:hover, #flow-chart .hit.on { fill: #6250d6; fill-opacity: 0.07; }
  @media (prefers-reduced-motion: no-preference) {
    .wk-bar { transform-origin: bottom; animation: wk-grow 0.5s ease-out both; }
    @keyframes wk-grow { from { transform: scaleY(0.1); opacity: 0.4; } to { transform: scaleY(1); opacity: 1; } }
    #flow-chart .col { transform-origin: bottom; transform-box: fill-box; animation: wk-grow 0.45s ease-out both; }
  }
</style>

<script is:inline>
  (function () {
    // ---- one tooltip for everything on the page. Text goes in with textContent, never as HTML.
    var tip = document.getElementById('viz-tip');
    function showTip(lines, x, y) {
      if (!tip) return;
      tip.textContent = '';
      lines.forEach(function (l, i) {
        var p = document.createElement('p');
        if (l.key) { var k = document.createElement('span'); k.style.cssText = 'display:inline-block;width:12px;height:3px;border-radius:2px;margin-right:6px;vertical-align:middle;background:' + l.key; p.appendChild(k); }
        var v = document.createElement('span'); v.textContent = l.value; v.style.fontWeight = '600'; p.appendChild(v);
        if (l.label) { var t = document.createElement('span'); t.textContent = ' ' + l.label; t.style.color = '#57534e'; p.appendChild(t); }
        if (i === 0 && !l.key && lines.length > 1) { p.style.marginBottom = '2px'; }
        tip.appendChild(p);
      });
      tip.hidden = false;
      var w = tip.offsetWidth, h = tip.offsetHeight;
      tip.style.left = Math.max(8, Math.min(window.innerWidth - w - 8, x + 12)) + 'px';
      tip.style.top = Math.max(8, Math.min(window.innerHeight - h - 8, y - h - 12)) + 'px';
    }
    function hideTip() { if (tip) tip.hidden = true; }

    // ---- the week: pick a day to list its trips. The tooltip text is the same sentence a screen reader gets from the button.
    var week = document.getElementById('week');
    if (week) {
      var cols = Array.prototype.slice.call(week.querySelectorAll('.wk'));
      var panels = document.querySelectorAll('[data-panel]');
      var pick = function (btn, focus) {
        cols.forEach(function (c) { c.setAttribute('aria-pressed', c === btn ? 'true' : 'false'); });
        panels.forEach(function (p) { p.hidden = p.getAttribute('data-panel') !== btn.getAttribute('data-day'); });
        if (focus) btn.focus();
      };
      cols.forEach(function (c, i) {
        c.addEventListener('click', function () { pick(c, false); });
        c.addEventListener('pointermove', function (e) { showTip([{ value: c.getAttribute('data-tip') }], e.clientX, e.clientY); });
        c.addEventListener('pointerleave', hideTip);
        c.addEventListener('blur', hideTip);
        c.addEventListener('keydown', function (e) {
          var n = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? cols.length - 1 : -1;
          if (n >= 0 && n < cols.length) { e.preventDefault(); pick(cols[n], true); }
        });
      });
    }

    // ---- enquiries and bookings per day, drawn from the 28 days in the page. Grouped columns, one axis, a table below for the same numbers.
    var holder = document.getElementById('flow-chart');
    var dataEl = document.getElementById('flow-data');
    if (!holder || !dataEl) return;
    var days = JSON.parse(dataEl.textContent);
    var NS = 'http://www.w3.org/2000/svg';
    var C1 = '#6250d6', C2 = '#eb6834';
    var range = 14;
    var el = function (name, attrs, parent) { var n = document.createElementNS(NS, name); for (var k in attrs) n.setAttribute(k, attrs[k]); if (parent) parent.appendChild(n); return n; };
    var fmt = function (ymd) { return new Date(ymd + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }); };
    var longFmt = function (ymd) { return new Date(ymd + 'T00:00:00Z').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }); };
    var sum = function (rows, k) { return rows.reduce(function (t, r) { return t + r[k]; }, 0); };
    var delta = function (cur, prev, n) {
      var d = cur - prev;
      return (d === 0 ? 'Same as' : (d > 0 ? '▲ ' + d + ' more than' : '▼ ' + -d + ' fewer than')) + ' the previous ' + n + ' days (' + prev + ')';
    };
    // Rounded top corners only, so a column stands on the baseline.
    var bar = function (x, y, w, h) {
      var r = Math.min(4, w / 2, h);
      return 'M' + x + ',' + (y + h) + 'V' + (y + r) + 'Q' + x + ',' + y + ' ' + (x + r) + ',' + y + 'H' + (x + w - r) + 'Q' + (x + w) + ',' + y + ' ' + (x + w) + ',' + (y + r) + 'V' + (y + h) + 'Z';
    };
    function draw() {
      var rows = days.slice(-range), prev = days.slice(-2 * range, -range);
      document.getElementById('flow-leads').textContent = sum(rows, 'leads');
      document.getElementById('flow-bookings').textContent = sum(rows, 'bookings');
      document.getElementById('flow-leads-delta').textContent = delta(sum(rows, 'leads'), sum(prev, 'leads'), range);
      document.getElementById('flow-bookings-delta').textContent = delta(sum(rows, 'bookings'), sum(prev, 'bookings'), range);
      var W = 640, H = 230, L = 30, R = 6, T = 10, B = 26;
      var max = Math.max(3, Math.max.apply(null, rows.map(function (r) { return Math.max(r.leads, r.bookings); })));
      var top = max <= 4 ? max : Math.ceil(max / 2) * 2;
      var y = function (v) { return T + (H - T - B) * (1 - v / top); };
      var gw = (W - L - R) / rows.length, bw = Math.min(16, gw * 0.34);
      holder.textContent = '';
      var svg = el('svg', { viewBox: '0 0 ' + W + ' ' + H, role: 'img', 'aria-label': 'Enquiries and bookings per day over the last ' + range + ' days. The same numbers are in the table below.' }, holder);
      [0, top / 2, top].forEach(function (v) {
        el('line', { x1: L, x2: W - R, y1: y(v), y2: y(v), stroke: v === 0 ? '#a8a29e' : '#e7e5e4', 'stroke-width': 1 }, svg);
        var t = el('text', { x: L - 6, y: y(v) + 4, 'text-anchor': 'end', 'font-size': 11, fill: '#57534e' }, svg); t.textContent = Math.round(v);
      });
      var every = rows.length > 8 ? 2 : 1;
      rows.forEach(function (r, i) {
        var gx = L + gw * i, cx = gx + gw / 2;
        var g = el('g', {}, svg);
        el('rect', { class: 'hit', x: gx, y: T, width: gw, height: H - T - B, 'data-i': i }, g);
        [[r.leads, C1, cx - bw - 1], [r.bookings, C2, cx + 1]].forEach(function (s) {
          if (s[0] > 0) { var p = el('path', { class: 'col', d: bar(s[2], y(s[0]), bw, y(0) - y(s[0])), fill: s[1], 'pointer-events': 'none' }, g); }
        });
        if ((rows.length - 1 - i) % every === 0) {
          var lab = el('text', { x: cx, y: H - 8, 'text-anchor': 'middle', 'font-size': 11, fill: '#57534e' }, svg);
          lab.textContent = i === rows.length - 1 ? 'Today' : fmt(r.day);
        }
        var hit = g.firstChild;
        var show = function (e) {
          var b = hit.getBoundingClientRect();
          var x = e.clientX != null ? e.clientX : b.left + b.width / 2, yy = e.clientY != null ? e.clientY : b.top;
          showTip([{ value: longFmt(r.day) }, { key: C1, value: r.leads, label: r.leads === 1 ? 'enquiry' : 'enquiries' }, { key: C2, value: r.bookings, label: r.bookings === 1 ? 'booking' : 'bookings' }], x, yy);
          hit.classList.add('on');
        };
        hit.addEventListener('pointermove', show);
        hit.addEventListener('pointerleave', function () { hideTip(); hit.classList.remove('on'); });
      });
    }
    document.querySelectorAll('.rng').forEach(function (b) {
      b.addEventListener('click', function () {
        range = Number(b.getAttribute('data-range'));
        document.querySelectorAll('.rng').forEach(function (o) { o.setAttribute('aria-pressed', o === b ? 'true' : 'false'); });
        hideTip();
        draw();
      });
    });
    draw();
  })();
</script>
