---
// Cookie consent for the Meta Pixel (Instagram/Facebook retargeting). The
// pixel sets advertising cookies, so it loads only after the visitor taps
// Accept (UK PECR; see /privacy). Rejecting keeps the site working as
// before. The choice is kept in a first-party `cookie_consent` cookie for
// 180 days; "Cookie settings" in the footer reopens the banner.
//
// Pages queue pixel events before (or without) consent:
//   (window.iwisPixelQueue = window.iwisPixelQueue || []).push(['ViewContent', {...}, { eventID }])
// They're sent only if the visitor accepts, and dropped otherwise.
---
<div
  id="cookie-consent"
  role="region"
  aria-label="Cookie choice"
  hidden
  class="fixed inset-x-0 bottom-0 z-[60] border-t border-stone-200 bg-white px-4 pt-4 shadow-[0_-4px_16px_rgba(28,25,23,0.12)] sm:inset-x-auto sm:bottom-4 sm:left-4 sm:max-w-md sm:rounded-2xl sm:border"
  style="padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));"
>
  <p class="text-sm text-stone-700">
    Can we use Meta advertising cookies? They let us show our tours to you on Instagram and Facebook after
    your visit. The site works the same either way.
    <a href="/privacy#cookies" class="text-brand-800 underline">Privacy Policy</a>
  </p>
  <div class="mt-3 flex gap-2">
    <button type="button" data-consent="denied" class="flex-1 min-h-11 rounded-full border border-stone-300 bg-white px-4 text-sm font-semibold text-stone-800 hover:border-stone-400 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-200">
      Reject
    </button>
    <button type="button" data-consent="granted" class="flex-1 min-h-11 rounded-full bg-brand-700 px-4 text-sm font-semibold text-white hover:bg-brand-800 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300">
      Accept
    </button>
  </div>
</div>

<script>
  // "Ads Pixel for Shopify Facebook Ad" dataset in the IWIS GLOBAL business
  // portfolio, reused for iwisglobal.com. Pixel IDs are public by design.
  const META_PIXEL_ID = '179602460825688';
  const COOKIE = 'cookie_consent';
  const MAX_AGE = 60 * 60 * 24 * 180;

  type QueuedEvent = [string, Record<string, unknown>?, { eventID?: string }?];
  declare global {
    interface Window {
      fbq?: any;
      _fbq?: any;
      iwisPixelQueue?: QueuedEvent[];
    }
  }

  const banner = document.getElementById('cookie-consent');
  const readChoice = () => document.cookie.match(new RegExp(`(?:^|; )${COOKIE}=(granted|denied)`))?.[1] ?? null;
  const saveChoice = (value: 'granted' | 'denied') => {
    document.cookie = `${COOKIE}=${value}; Max-Age=${MAX_AGE}; Path=/; SameSite=Lax; Secure`;
  };

  // Meta's standard loader, run only after consent.
  const loadPixel = () => {
    if (window.fbq) return;
    const n: any = (window.fbq = function (...args: unknown[]) {
      n.callMethod ? n.callMethod(...args) : n.queue.push(args);
    });
    window._fbq = n;
    n.push = n;
    n.loaded = true;
    n.version = '2.0';
    n.queue = [];
    const s = document.createElement('script');
    s.async = true;
    s.src = 'https://connect.facebook.net/en_US/fbevents.js';
    document.head.appendChild(s);
    window.fbq('init', META_PIXEL_ID);
    window.fbq('track', 'PageView');
  };

  // Send whatever pages queued, and anything queued later.
  const sendQueued = () => {
    const queue = window.iwisPixelQueue || [];
    for (const [name, params, options] of queue) window.fbq('track', name, params || {}, options || {});
    window.iwisPixelQueue = { push: ([name, params, options]: QueuedEvent) => window.fbq('track', name, params || {}, options || {}) } as any;
  };

  // Withdrawing consent: stop sending and clear Meta's cookies.
  const clearMetaCookies = () => {
    for (const name of ['_fbp', '_fbc']) {
      document.cookie = `${name}=; Max-Age=0; Path=/`;
      document.cookie = `${name}=; Max-Age=0; Path=/; Domain=.${location.hostname.replace(/^www\./, '')}`;
    }
  };

  const apply = (choice: string | null) => {
    if (choice === 'granted') {
      loadPixel();
      sendQueued();
    }
  };

  banner?.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((button) =>
    button.addEventListener('click', () => {
      const choice = button.dataset.consent as 'granted' | 'denied';
      saveChoice(choice);
      banner.hidden = true;
      if (choice === 'granted') {
        apply(choice);
      } else {
        window.fbq?.('consent', 'revoke');
        clearMetaCookies();
      }
    })
  );

  document.querySelectorAll('[data-cookie-settings]').forEach((el) =>
    el.addEventListener('click', () => {
      if (banner) {
        banner.hidden = false;
        banner.querySelector<HTMLButtonElement>('[data-consent="granted"]')?.focus();
      }
    })
  );

  const choice = readChoice();
  if (choice) apply(choice);
  else if (banner) banner.hidden = false;
</script>
