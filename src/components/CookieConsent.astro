---
// Cookie consent for Google Analytics, the Meta Pixel and Metricool. None
// sets cookies until the visitor taps Accept (UK PECR; see /privacy):
// Google's consent defaults are set to denied in BaseLayout's <head>, and
// the Meta Pixel and Metricool tracker don't load at all. Rejecting keeps the site working as before. The choice is kept in a first-party `cookie_consent` cookie for
// 180 days; "Cookie settings" in the footer reopens the banner.
//
// Pages queue pixel events before (or without) consent:
//   (window.iwisPixelQueue = window.iwisPixelQueue || []).push(['ViewContent', {...}, { eventID }])
// They're sent only if the visitor accepts, and dropped otherwise.
import { pageI18n } from '../i18n/dictionaries';
const { t } = pageI18n(Astro);
---
<div
  id="cookie-consent"
  role="region"
  aria-label={t.cookie.region}
  hidden
  class="fixed inset-x-0 bottom-0 z-[60] rounded-t-2xl border-t-4 border-brand-600 bg-white px-4 pt-3 shadow-[0_-8px_24px_rgba(76,29,149,0.18)] sm:inset-x-auto sm:bottom-5 sm:left-5 sm:max-w-md lg:[&:not([hidden])]:flex lg:max-w-3xl lg:items-center lg:gap-6 lg:px-6 lg:pt-4 2xl:bottom-8 2xl:left-8 2xl:max-w-4xl 2xl:gap-8 2xl:px-8 2xl:pt-5 min-[2200px]:left-1/2 min-[2200px]:max-w-5xl min-[2200px]:-translate-x-1/2 min-[2200px]:px-10 min-[2200px]:pt-6 sm:rounded-2xl sm:border sm:border-t-4 sm:border-brand-100 sm:border-t-brand-600 sm:shadow-[0_12px_32px_rgba(76,29,149,0.25)]"
  style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));"
>
  <p class="text-[13px] leading-snug text-stone-700 sm:text-sm sm:leading-normal lg:flex-1 2xl:text-base min-[2200px]:text-lg">
    {t.cookie.message}
    <a href="/privacy#cookies" class="font-medium text-brand-800 underline">{t.cookie.details}</a>
  </p>
  <div class="mt-2.5 flex gap-2 sm:mt-3 lg:mt-0 lg:shrink-0">
    <button type="button" data-consent="denied" class="flex-1 lg:flex-none lg:px-6 2xl:px-8 min-h-11 2xl:min-h-12 2xl:text-base min-[2200px]:min-h-14 min-[2200px]:text-lg rounded-full border border-brand-200 bg-white px-4 text-sm font-semibold text-brand-900 hover:bg-brand-50 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-200">
      {t.cookie.reject}
    </button>
    <button type="button" data-consent="granted" class="flex-1 lg:flex-none lg:px-8 2xl:px-10 min-h-11 2xl:min-h-12 2xl:text-base min-[2200px]:min-h-14 min-[2200px]:text-lg rounded-full bg-gradient-to-r from-brand-900 via-brand-700 to-brand-600 px-4 text-sm font-semibold text-white shadow-md shadow-brand-900/20 hover:brightness-110 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-300">
      {t.cookie.accept}
    </button>
  </div>
</div>

<script>
  // "Ads Pixel for Shopify Facebook Ad" dataset in the IWIS GLOBAL business
  // portfolio, reused for iwisglobal.com. Pixel IDs are public by design.
  const META_PIXEL_ID = '179602460825688';
  const COOKIE = 'cookie_consent';
  const MAX_AGE = 60 * 60 * 24 * 180;

  type QueuedEvent = [string, Record<string, unknown>?, { eventID?: string }?];
  declare global {
    interface Window {
      fbq?: any;
      gtag?: (...args: unknown[]) => void;
      _fbq?: any;
      iwisPixelQueue?: QueuedEvent[];
    }
  }

  const banner = document.getElementById('cookie-consent');
  const readChoice = () => document.cookie.match(new RegExp(`(?:^|; )${COOKIE}=(granted|denied)`))?.[1] ?? null;
  const saveChoice = (value: 'granted' | 'denied') => {
    document.cookie = `${COOKIE}=${value}; Max-Age=${MAX_AGE}; Path=/; SameSite=Lax; Secure`;
  };

  // Meta's standard loader, run only after consent.
  const loadPixel = () => {
    if (window.fbq) return;
    const n: any = (window.fbq = function (...args: unknown[]) {
      n.callMethod ? n.callMethod(...args) : n.queue.push(args);
    });
    window._fbq = n;
    n.push = n;
    n.loaded = true;
    n.version = '2.0';
    n.queue = [];
    const s = document.createElement('script');
    s.async = true;
    s.src = 'https://connect.facebook.net/en_US/fbevents.js';
    document.head.appendChild(s);
    window.fbq('init', META_PIXEL_ID);
    window.fbq('track', 'PageView');
  };

  // Metricool's web tracker (their standard snippet), run only after consent.
  const METRICOOL_HASH = '860620e00517a44a2e296fb43e355688';
  const loadMetricool = () => {
    if (document.querySelector('script[data-metricool]')) return;
    const s = document.createElement('script');
    s.async = true;
    s.src = 'https://tracker.metricool.com/resources/be.js';
    s.dataset.metricool = '';
    s.onload = () => (window as unknown as { beTracker?: { t(o: { hash: string }): void } }).beTracker?.t({ hash: METRICOOL_HASH });
    document.head.appendChild(s);
  };

  // Send whatever pages queued, and anything queued later.
  const sendQueued = () => {
    const queue = window.iwisPixelQueue || [];
    for (const [name, params, options] of queue) window.fbq('track', name, params || {}, options || {});
    window.iwisPixelQueue = { push: ([name, params, options]: QueuedEvent) => window.fbq('track', name, params || {}, options || {}) } as any;
  };

  // Tells the Google tag the visitor's choice.
  const updateGoogleConsent = (value: 'granted' | 'denied') =>
    window.gtag?.('consent', 'update', {
      analytics_storage: value,
      ad_storage: value,
      ad_user_data: value,
      ad_personalization: value,
    });

  // Withdrawing consent: stop sending and clear Google's and Meta's cookies.
  const clearTrackingCookies = () => {
    const names = document.cookie
      .split('; ')
      .map((c) => c.split('=')[0])
      .filter((name) => name === '_fbp' || name === '_fbc' || name === '_ga' || name.startsWith('_ga_') || name.startsWith('_gcl_'));
    const domain = location.hostname.replace(/^www\./, '');
    for (const name of names) {
      document.cookie = `${name}=; Max-Age=0; Path=/`;
      document.cookie = `${name}=; Max-Age=0; Path=/; Domain=.${domain}`;
    }
  };

  const apply = (choice: string | null) => {
    if (choice === 'granted') {
      loadPixel();
      sendQueued();
      loadMetricool();
    }
  };

  banner?.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((button) =>
    button.addEventListener('click', () => {
      const choice = button.dataset.consent as 'granted' | 'denied';
      saveChoice(choice);
      banner.hidden = true;
      updateGoogleConsent(choice);
      if (choice === 'granted') {
        apply(choice);
      } else {
        window.fbq?.('consent', 'revoke');
        clearTrackingCookies();
      }
    })
  );

  document.querySelectorAll('[data-cookie-settings]').forEach((el) =>
    el.addEventListener('click', () => {
      if (banner) {
        banner.hidden = false;
        banner.querySelector<HTMLButtonElement>('[data-consent="granted"]')?.focus();
      }
    })
  );

  const choice = readChoice();
  if (choice) apply(choice);
  else if (banner) banner.hidden = false;
</script>
