---
import { pageI18n } from '../i18n/dictionaries';
// Consumer Protection (E-Commerce) Rules, 2020, rule 4(4)–(5): the site must
// show the grievance officer's name, designation and contact details, and
// complaints must be acknowledged within 48 hours and resolved within one
// month. Shown on /terms and /contact.
const { t } = pageI18n(Astro);
---


<h2 class="text-lg font-semibold mb-2" set:html={t.grievance.k1} />
<p class="text-stone-700 mb-6" set:html={t.grievance.k2} />
