---
import { getAvailability } from '../lib/availability';
import { resolveFromPrice, CURRENCY_SYMBOLS, type Currency } from '../lib/currency';
import type { ParsedTour } from '../lib/tours';

interface Props {
  tour: ParsedTour;
  currency: Currency;
  // Lazy by default (cards are mostly below the fold); pass "eager" for a
  // card that is the page's main image, e.g. the first card on /tours.
  loading?: 'lazy' | 'eager';
}

const { tour, currency, loading = 'lazy' } = Astro.props;
const availability = getAvailability();
// Cheapest available per-person rate (the largest-group tier when the tour
// has pricing tiers) — see backlog 0.2. Kept in sync with tours/[slug].astro's
// "From" price via the same resolveFromPrice helper.
const price = resolveFromPrice(tour, currency);
---
<a
  href={`/tours/${tour.slug}`}
  class="group block"
>
  <div class="aspect-[4/3] bg-brand-50 rounded-xl overflow-hidden">
    {tour.image ? (
      <img src={tour.image} alt={tour.title} loading={loading} decoding="async" class="w-full h-full object-cover transition group-hover:opacity-90" />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-brand-300 text-sm">No image yet</div>
    )}
  </div>

  <div class="pt-3">
    <h3 class="text-lg font-semibold mb-1 group-hover:underline">{tour.title}</h3>

    <div class="flex items-center justify-between mb-1.5">
      <span class="text-[11px] font-semibold uppercase tracking-wide text-brand-700 border-b-2 border-brand-600 pb-0.5">
        {availability.label}
      </span>
      <p class="text-lg font-semibold text-stone-900">
        {CURRENCY_SYMBOLS[price.currency]}{price.amount.toLocaleString(price.currency === 'USD' ? 'en-US' : 'en-IN')}
        <span class="text-xs font-normal text-stone-500">/person</span>
      </p>
    </div>

    <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-stone-500">
      <span>{tour.durationLabel}</span>
      {tour.pickupIncluded && <span>· Hotel pickup</span>}
      {tour.privateTour && <span>· Private tour</span>}
      {tour.guideLanguage && <span>· {tour.guideLanguage} guide</span>}
      <span>· Free cancellation</span>
    </div>
  </div>
</a>
