---
import { todayIst } from '../lib/availability';
import { resizedSrcset, uploadedImageSize } from '../lib/resizedImages';
import { resolveEnv } from '../lib/env';
import { liveAutomaticOffersForRequest, offerBadge } from '../lib/offers';
import { resolveFromPrice, CURRENCY_SYMBOLS, type Currency } from '../lib/currency';
import type { ParsedTour } from '../lib/tours';
import ShortlistButton from './ShortlistButton';
import { pageI18n, languageName, fmt } from '../i18n/dictionaries';

interface Props {
  tour: ParsedTour;
  currency: Currency;
  // Lazy by default (cards are mostly below the fold); pass "eager" for a
  // card that is the page's main image, e.g. the first card on /tours.
  loading?: 'lazy' | 'eager';
  // The page already lists what every tour has (pickup, private, guide,
  // free cancellation), so the card shows only what differs.
  sharedFactsShown?: boolean;
  // h3 when the card sits under a section heading (homepage, /agra);
  // h2 on /tours, where the cards sit directly under the page's h1.
  headingLevel?: 'h2' | 'h3';
}

const { tour, currency, loading = 'lazy', sharedFactsShown = false, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const { t } = pageI18n(Astro);
const tc = t.tourCard;
// Cheapest available per-person rate (the largest-group tier when the tour
// has pricing tiers) — see backlog 0.2. Kept in sync with tours/[slug].astro's
// "From" price via the same resolveFromPrice helper.
const price = resolveFromPrice(tour, currency);
// Automatic offer running on this tour, if any (src/lib/offers.ts).
const db = resolveEnv(Astro.locals).DB;
const badge = db ? offerBadge(await liveAutomaticOffersForRequest(db, Astro.request, todayIst()), tour.id, currency) : null;
---
<!-- The heart is a sibling of the link, not inside it: a button inside an
     anchor is invalid and would be activated by the card click. -->
<div class="relative h-full">
<a
  href={`/tours/${tour.slug}`}
  class="group flex h-full flex-col"
>
  <div class="aspect-[4/3] bg-brand-50 rounded-xl overflow-hidden">
    {tour.image ? (
      <img src={tour.image} srcset={resizedSrcset(tour.image)} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" {...uploadedImageSize(tour.image)} alt={tour.title} loading={loading} decoding="async" class="w-full h-full object-cover transition group-hover:opacity-90" />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-brand-300 text-sm">{tc.noImage}</div>
    )}
  </div>

  <div class="flex flex-1 flex-col pt-3">
    {badge && (
      <p class="mb-1.5 inline-block rounded-full bg-amber-300 px-2.5 py-0.5 text-xs font-semibold text-brand-950 shadow-sm">{badge}</p>
    )}
    <Heading class="text-lg font-semibold mb-1.5 group-hover:underline">{tour.title}</Heading>

    <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-stone-500">
      <span>{tour.durationLabel}</span>
      {!sharedFactsShown && tour.pickupIncluded && <span>· {tc.hotelPickup}</span>}
      {!sharedFactsShown && tour.privateTour && <span>· {tc.privateTour}</span>}
      {!sharedFactsShown && tour.guideLanguage && <span>· {fmt(tc.guide, { lang: languageName(t, tour.guideLanguage) })}</span>}
      {/* Only when tickets are built into the price (not a pre-ticked add-on),
          so the "From" price really covers them. */}
      {tour.entryTicketsInPrice.length > 0 ? (
        <span class="font-medium text-brand-700">· {tc.ticketsIncluded}</span>
      ) : (
        <span>· {tc.ticketsExtra}</span>
      )}
      {!sharedFactsShown && <span>· {tc.freeCancel}</span>}
    </div>

    <!-- Footer pinned to the bottom of every card so prices and buttons line
         up across a row, whatever the title length. The whole card is the
         link, so "Book now" is a styled label, not a nested link. -->
    <div class="mt-auto flex flex-wrap items-center justify-between gap-x-3 gap-y-2 pt-3">
      <p class="whitespace-nowrap text-base font-semibold text-stone-900 sm:text-lg">
        {/* The cheapest rate (largest-group tier), so it's a "From" price. */}
        <span class="text-xs font-normal text-stone-500">{tc.from}</span>
        {CURRENCY_SYMBOLS[price.currency]}{price.amount.toLocaleString(price.currency === 'USD' ? 'en-US' : 'en-IN')}
        <span class="text-xs font-normal text-stone-500">{tc.perPerson}</span>
      </p>
      <span class="inline-flex shrink-0 items-center rounded-full bg-brand-700 px-3.5 py-1.5 text-xs font-semibold text-white transition group-hover:bg-brand-800">
        {tc.bookNow}
      </span>
    </div>
  </div>
</a>
<div class="absolute right-2 top-2"><ShortlistButton client:visible slug={tour.slug} title={tour.title} t={t.shortlist} /></div>
</div>
