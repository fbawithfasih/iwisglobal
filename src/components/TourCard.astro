---
import { getAvailability, todayIst } from '../lib/availability';
import { resizedSrcset } from '../lib/resizedImages';
import { resolveEnv } from '../lib/env';
import { liveAutomaticOffersForRequest, offerBadge } from '../lib/offers';
import { resolveFromPrice, CURRENCY_SYMBOLS, type Currency } from '../lib/currency';
import type { ParsedTour } from '../lib/tours';

interface Props {
  tour: ParsedTour;
  currency: Currency;
  // Lazy by default (cards are mostly below the fold); pass "eager" for a
  // card that is the page's main image, e.g. the first card on /tours.
  loading?: 'lazy' | 'eager';
  // The page already lists what every tour has (pickup, private, guide,
  // free cancellation), so the card shows only what differs.
  sharedFactsShown?: boolean;
  // h3 when the card sits under a section heading (homepage, /agra);
  // h2 on /tours, where the cards sit directly under the page's h1.
  headingLevel?: 'h2' | 'h3';
}

const { tour, currency, loading = 'lazy', sharedFactsShown = false, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const availability = getAvailability();
// Cheapest available per-person rate (the largest-group tier when the tour
// has pricing tiers) — see backlog 0.2. Kept in sync with tours/[slug].astro's
// "From" price via the same resolveFromPrice helper.
const price = resolveFromPrice(tour, currency);
// Automatic offer running on this tour, if any (src/lib/offers.ts).
const db = resolveEnv(Astro.locals).DB;
const badge = db ? offerBadge(await liveAutomaticOffersForRequest(db, Astro.request, todayIst()), tour.id, currency) : null;
---
<a
  href={`/tours/${tour.slug}`}
  class="group block"
>
  <div class="aspect-[4/3] bg-brand-50 rounded-xl overflow-hidden">
    {tour.image ? (
      <img src={tour.image} srcset={resizedSrcset(tour.image)} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" alt={tour.title} loading={loading} decoding="async" class="w-full h-full object-cover transition group-hover:opacity-90" />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-brand-300 text-sm">No image yet</div>
    )}
  </div>

  <div class="pt-3">
    {badge && (
      <p class="mb-1.5 inline-block rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800">{badge}</p>
    )}
    <Heading class="text-lg font-semibold mb-1 group-hover:underline">{tour.title}</Heading>

    <!-- Wraps to two lines on narrow cards (the homepage carousel) rather
         than breaking the label or "/person" mid-phrase. -->
    <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 mb-1.5">
      <span class="whitespace-nowrap text-[11px] font-semibold uppercase tracking-wide text-brand-700 border-b-2 border-brand-600 pb-0.5">
        {availability.label}
      </span>
      <p class="whitespace-nowrap text-lg font-semibold text-stone-900">
        {/* The cheapest rate (largest-group tier), so it's a "From" price. */}
        <span class="text-xs font-normal text-stone-500">From</span>
        {CURRENCY_SYMBOLS[price.currency]}{price.amount.toLocaleString(price.currency === 'USD' ? 'en-US' : 'en-IN')}
        <span class="text-xs font-normal text-stone-500">/person</span>
      </p>
    </div>

    <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-stone-500">
      <span>{tour.durationLabel}</span>
      {!sharedFactsShown && tour.pickupIncluded && <span>· Hotel pickup</span>}
      {!sharedFactsShown && tour.privateTour && <span>· Private tour</span>}
      {!sharedFactsShown && tour.guideLanguage && <span>· {tour.guideLanguage} guide</span>}
      {/* Only when tickets are built into the price (not a pre-ticked add-on),
          so the "From" price really covers them. */}
      {tour.entryTicketsInPrice.length > 0 ? (
        <span class="font-medium text-brand-700">· Entry tickets included</span>
      ) : (
        <span>· Entry tickets extra</span>
      )}
      {!sharedFactsShown && <span>· Free cancellation</span>}
    </div>
  </div>
</a>
