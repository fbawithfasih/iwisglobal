---
// The live countdown offer (offers.window_minutes, e.g. the Quick-Book Deal) as a coupon ticket on the home page.
// Display only: the visitor's clock starts on a tour page and create-order decides the real discount.
// Renders nothing when no countdown offer is live.
import { resolveEnv } from '../lib/env';
import { todayIst } from '../lib/availability';
import { liveAutomaticOffersForRequest, liveCountdownOffer, offerBadgeValue, offerConditions } from '../lib/offers';
import type { Currency } from '../lib/currency';
import { pageI18n, fmt } from '../i18n/dictionaries';

interface Props {
  currency: Currency;
  class?: string;
}

const { t } = pageI18n(Astro);
const to = t.offers;
const db = resolveEnv(Astro.locals).DB;
const offer = db ? liveCountdownOffer(await liveAutomaticOffersForRequest(db, Astro.request, todayIst())) : null;
const value = offer ? offerBadgeValue(offer, Astro.props.currency) : '';
const n = offer?.windowMinutes ?? 0;
---
{offer && (
  <div id="deal" class:list={['deal-ticket relative scroll-mt-24 flex overflow-hidden rounded-2xl text-white shadow-xl shadow-rose-700/25', Astro.props.class]}>
    <!-- The stub: the discount, big. -->
    <div class="relative flex w-28 shrink-0 flex-col items-center justify-center bg-gradient-to-b from-amber-300 to-amber-400 px-3 py-5 text-rose-950 sm:w-36">
      <span class="text-4xl font-extrabold leading-none tracking-tight sm:text-5xl">{value}</span>
      <span class="mt-1 text-xs font-bold tracking-[0.2em]">{to.offBadge}</span>
      <span class="mt-3 inline-flex items-center gap-1 rounded-full bg-rose-950/10 px-2 py-0.5 text-[11px] font-bold">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="h-3.5 w-3.5"><circle cx="12" cy="13" r="8" /><path d="M12 9v4l2 2M9 2h6" /></svg>
        {n} min
      </span>
    </div>
    <!-- Perforation between stub and body, with a notch top and bottom. -->
    <div aria-hidden="true" class="relative w-0 border-l-2 border-dashed border-white/60">
      <span class="absolute -left-3 -top-3 h-6 w-6 rounded-full bg-[var(--deal-notch,#fafaf9)]"></span>
      <span class="absolute -bottom-3 -left-3 h-6 w-6 rounded-full bg-[var(--deal-notch,#fafaf9)]"></span>
    </div>
    <div class="relative min-w-0 flex-1 bg-gradient-to-br from-rose-600 via-rose-600 to-accent-600 p-4 sm:p-5">
      <span aria-hidden="true" class="deal-shine pointer-events-none absolute inset-0"></span>
      <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-amber-200">{to.promoKicker}</p>
      <p class="mt-0.5 font-serif text-xl font-semibold leading-tight sm:text-2xl">{offer.name}</p>
      <p class="mt-1.5 text-sm leading-snug text-white">{fmt(to.promoBody ?? '', { n, value })}</p>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2">
        <a href="/tours" class="inline-flex min-h-11 items-center gap-1 rounded-full bg-white px-4 text-sm font-bold text-rose-700 shadow-sm transition hover:bg-amber-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          {to.promoCta} <span aria-hidden="true">→</span>
        </a>
        <span class="inline-block text-xs text-white/90 first-letter:uppercase">{offerConditions(offer, {}, to)}</span>
      </div>
      <p class="mt-2 text-[11px] leading-snug text-white/80">{fmt(to.promoNote ?? '', { n })}</p>
    </div>
  </div>
)}

<style>
  /* A soft light sweep across the ticket every few seconds; off for reduced motion. */
  .deal-shine {
    background: linear-gradient(110deg, transparent 35%, rgba(255, 255, 255, 0.22) 50%, transparent 65%);
    transform: translateX(-100%);
    animation: deal-shine 5s ease-in-out 1.5s infinite;
  }
  @keyframes deal-shine {
    0%, 60% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .deal-shine { animation: none; display: none; }
  }
</style>
