---
// One status pill for every admin list. The tone sets the colours (the .badge-* tokens in AdminLayout), so the same
// meaning looks the same everywhere: ok = live/done, info = scheduled/upcoming, warn = needs a look, danger = failed/stuck,
// muted = off/draft/ended.
interface Props {
  tone?: 'ok' | 'info' | 'warn' | 'danger' | 'muted';
  class?: string;
}
const { tone = 'muted', class: extra = '' } = Astro.props;
const cls = { ok: 'badge-success', info: 'badge-info', warn: 'badge-warn', danger: 'badge-danger', muted: 'badge-neutral' }[tone];
---
<span class={`${cls} inline-flex shrink-0 items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${extra}`}><slot /></span>
