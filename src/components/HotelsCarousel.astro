---
// "Top hotels to stay in Agra": a swipeable row like the things-to-do one on
// the homepage. The arrows are wired by the carousel script in index.astro
// (any [data-carousel] on the page). Data and its source: src/lib/agraHotels.ts.
import { pageI18n, fmt } from '../i18n/dictionaries';
import { intlLocale } from '../lib/i18n';
import { formatMoneyMinor } from '../lib/format';
import { AGRA_HOTELS, HOTELS_CHECKED_ON, hotelAvgPrice } from '../lib/agraHotels';
import type { Currency } from '../lib/currency';

interface Props {
  currency: Currency;
}
const { currency } = Astro.props;
const { locale, t } = pageI18n(Astro);
const checked = new Date(`${HOTELS_CHECKED_ON}T00:00:00Z`).toLocaleDateString(intlLocale(locale), { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const nf = new Intl.NumberFormat(intlLocale(locale));
const price = (avgInr: number) => {
  const p = hotelAvgPrice(avgInr, currency);
  return formatMoneyMinor(p.amount * 100, p.currency);
};
const arrowBtn = 'h-9 w-9 rounded-full border border-brand-200 text-brand-700 bg-white flex items-center justify-center hover:bg-brand-50 transition disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent';
---
<section class="max-w-5xl mx-auto px-6 pb-12 md:pb-16" aria-labelledby="hotels-title">
  <div data-carousel>
    <div class="flex items-center justify-between mb-6">
      <h2 id="hotels-title" class="border-l-4 border-brand-500 pl-3 text-2xl font-serif font-semibold text-brand-900">{t.hotels.title}</h2>
      <div class="hidden md:flex items-center gap-2">
        <button type="button" data-carousel-prev aria-label={t.common.previous} class={arrowBtn}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button type="button" data-carousel-next aria-label={t.common.next} class={arrowBtn}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>
    <ul data-carousel-row class="carousel-row flex gap-5 overflow-x-auto snap-x snap-mandatory scroll-px-6 scroll-smooth pb-2 -mx-6 px-6 list-none">
      {AGRA_HOTELS.map((hotel, i) => (
        <li class="w-64 sm:w-72 shrink-0 snap-start">
          <a href="/blog/premium-and-luxury-hotels-in-agra" class="group flex h-full flex-col overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-md shadow-brand-900/10 transition hover:shadow-lg">
            <div class="relative bg-gradient-to-br from-brand-900 via-brand-700 to-brand-600 px-4 py-5 text-white">
              <span class="inline-block rounded-full bg-white/15 px-2.5 py-0.5 text-[11px] font-semibold tracking-wide text-brand-100">{fmt(t.hotels.rank, { n: hotel.rank })}</span>
              <p class="mt-3 flex items-center gap-1.5 text-3xl font-serif font-semibold leading-none">
                <span class="text-amber-300" aria-hidden="true">★</span>{hotel.rating.toFixed(1)}
              </p>
              <p class="mt-1 text-xs text-brand-100">{fmt(t.hotels.reviews, { n: nf.format(hotel.reviews) })}</p>
            </div>
            <div class="flex flex-1 flex-col p-4">
              <h3 class="font-serif text-lg font-semibold leading-snug text-brand-900 group-hover:underline">{hotel.name}</h3>
              <p class="mt-2 flex-1 text-sm text-stone-600">{t.hotels.desc[i]}</p>
              <p class="mt-3 text-sm font-semibold text-brand-800">{fmt(t.hotels.avg, { price: price(hotel.avgInr) })}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-4 flex justify-center gap-3 md:hidden">
      <button type="button" data-carousel-prev aria-label={t.common.previous} class="h-11 w-11 rounded-full border border-brand-200 text-brand-700 bg-white flex items-center justify-center hover:bg-brand-50 transition disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-white">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button type="button" data-carousel-next aria-label={t.common.next} class="h-11 w-11 rounded-full border border-brand-200 text-brand-700 bg-white flex items-center justify-center hover:bg-brand-50 transition disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-white">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
    <p class="mt-4 text-xs text-stone-500">
      {fmt(t.hotels.note, { date: checked })}
      <a href="/blog/premium-and-luxury-hotels-in-agra" class="ml-1 font-semibold text-brand-800 underline">{t.hotels.seeAll} →</a>
    </p>
  </div>
</section>
