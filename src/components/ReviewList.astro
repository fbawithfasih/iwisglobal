---
// Approved guest reviews (src/lib/reviews.ts), on tour pages and /reviews.
import { displayComment, type Review } from '../lib/reviews';
import { pageI18n } from '../i18n/dictionaries';

interface Props {
  reviews: Review[];
  // Tour names, for /reviews where reviews from every tour are listed.
  tourNames?: Map<string, string>;
}

const { reviews, tourNames } = Astro.props;
const month = (ymd: string) =>
  new Date(`${ymd}T00:00:00Z`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const { t } = pageI18n(Astro);
---

<ul class="space-y-4">
  {reviews.map((r) => (
    <li class="rounded-2xl border border-brand-100 bg-gradient-to-br from-brand-50/60 to-white p-5 shadow-sm shadow-brand-900/5">
      <p class="text-lg leading-none text-amber-500" role="img" aria-label={`${r.rating} out of 5 stars`}>
        {'★'.repeat(r.rating)}<span class="text-brand-200">{'★'.repeat(5 - r.rating)}</span>
      </p>
      {displayComment(r.comment) && <p class="mt-3 whitespace-pre-line text-stone-700">{displayComment(r.comment)}</p>}
      <p class="mt-3 text-sm text-stone-500">
        <span class="font-semibold text-brand-900">{r.displayName}</span>
        {tourNames?.get(r.tourId) && <> · {tourNames.get(r.tourId)}</>} · traveled {month(r.travelDate)}
      </p>
    </li>
  ))}
</ul>
