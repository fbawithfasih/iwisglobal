---
// Approved guest reviews (src/lib/reviews.ts), on tour pages and /reviews.
import type { Review } from '../lib/reviews';

interface Props {
  reviews: Review[];
  // Tour names, for /reviews where reviews from every tour are listed.
  tourNames?: Map<string, string>;
}

const { reviews, tourNames } = Astro.props;
const month = (ymd: string) =>
  new Date(`${ymd}T00:00:00Z`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<ul class="space-y-4">
  {reviews.map((r) => (
    <li class="rounded-2xl border border-stone-200 bg-white p-5">
      <p class="text-lg leading-none text-amber-500" role="img" aria-label={`${r.rating} out of 5 stars`}>
        {'★'.repeat(r.rating)}<span class="text-stone-300">{'★'.repeat(5 - r.rating)}</span>
      </p>
      {r.comment && <p class="mt-3 whitespace-pre-line text-stone-700">{r.comment}</p>}
      <p class="mt-3 text-sm text-stone-500">
        <span class="font-medium text-stone-700">{r.displayName}</span>
        {tourNames?.get(r.tourId) && <> · {tourNames.get(r.tourId)}</>} · traveled {month(r.travelDate)}
      </p>
    </li>
  ))}
</ul>
