---
// Title row for every admin list: the heading, an optional count, an optional intro line, and the main action on the right.
interface Props {
  title: string;
  count?: number;
  intro?: string;
  href?: string;
  action?: string;
  class?: string;
}
const { title, count, intro, href, action, class: spacing = 'mb-6' } = Astro.props;
---
<div class={spacing}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold">{title}{count !== undefined && <span class="ml-2 text-base font-normal text-stone-500">({count})</span>}</h1>
    {href && action && <a href={href} class="btn-primary inline-flex min-h-11 items-center rounded px-4 text-sm text-white">{action}</a>}
    <slot name="actions" />
  </div>
  {intro && <p class="mt-2 max-w-3xl text-sm text-stone-500">{intro}</p>}
</div>
