---
// The Founding Guest offer (src/lib/catalog.ts), shown on listing pages.
// Display only: create-order decides the real discount at payment time.
// Renders nothing once the spots are used.
import { resolveEnv } from '../lib/env';
import { countBookingsForRequest } from '../lib/db';
import { FOUNDING_GUEST_SLOT_CAP, FOUNDING_GUEST_DISCOUNT_RATE } from '../lib/catalog';
import { pageI18n, fmt } from '../i18n/dictionaries';

interface Props {
  class?: string;
}

const { t } = pageI18n(Astro);
const tf = t.founding;
const db = resolveEnv(Astro.locals).DB;
const slotsLeft = db ? Math.max(0, FOUNDING_GUEST_SLOT_CAP - (await countBookingsForRequest(db, Astro.request))) : 0;
const percent = Math.round(FOUNDING_GUEST_DISCOUNT_RATE * 100);
const claimed = FOUNDING_GUEST_SLOT_CAP - slotsLeft;
const claimedPercent = Math.round((claimed / FOUNDING_GUEST_SLOT_CAP) * 100);
---
{slotsLeft > 0 && (
  <div
    role="note"
    class:list={['relative max-w-2xl overflow-hidden rounded-2xl bg-gradient-to-br from-brand-900 via-brand-700 to-brand-600 p-4 text-white shadow-lg shadow-brand-900/25 sm:p-5', Astro.props.class]}
  >
    <!-- Soft decorative circles; purely visual. -->
    <span aria-hidden="true" class="pointer-events-none absolute -right-10 -top-12 h-36 w-36 rounded-full bg-white/10"></span>
    <span aria-hidden="true" class="pointer-events-none absolute -bottom-14 right-16 h-28 w-28 rounded-full bg-amber-300/10"></span>

    <div class="relative flex items-center gap-4">
      <span class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-full bg-amber-300 leading-none text-brand-950 shadow-md ring-4 ring-white/20">
        <span class="text-xl font-extrabold">{percent}%</span>
        <span class="mt-0.5 text-[10px] font-bold tracking-widest">{tf.off}</span>
      </span>
      <div class="min-w-0">
        <p class="font-serif text-xl font-semibold leading-tight sm:text-2xl">{tf.title}</p>
        <p class="mt-1 text-sm leading-snug text-brand-50">
          {fmt(tf.body, { percent, cap: FOUNDING_GUEST_SLOT_CAP })}
        </p>
      </div>
    </div>

    <div class="relative mt-4">
      <div class="flex items-center justify-between text-xs font-semibold">
        <span class="text-amber-200">{slotsLeft === 1 ? tf.oneSpot : fmt(tf.spotsLeft, { n: slotsLeft })}</span>
        <span class="text-brand-100">{fmt(tf.claimed, { n: claimed, cap: FOUNDING_GUEST_SLOT_CAP })}</span>
      </div>
      <div
        role="progressbar"
        aria-label={tf.progressAria}
        aria-valuemin="0"
        aria-valuemax={FOUNDING_GUEST_SLOT_CAP}
        aria-valuenow={claimed}
        class="mt-1.5 h-2 overflow-hidden rounded-full bg-white/20"
      >
        <div class="h-full rounded-full bg-gradient-to-r from-amber-300 to-amber-400" style={`width: ${Math.max(claimedPercent, 4)}%`}></div>
      </div>
    </div>
  </div>
)}
