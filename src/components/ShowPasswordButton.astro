---
// "Show password" toggle for a password field, placed below the field rather
// than inside it: Safari puts its own "Strong Password" label (and its key
// icon) inside the right end of password fields, where an in-field button
// sat underneath it and couldn't be clicked. Used by /login, /signup and
// /reset-password.
interface Props {
  for: string; // the password input's id
  class?: string;
}
const { for: inputId, class: className } = Astro.props;
---
<button
  type="button"
  data-toggle-password={inputId}
  aria-controls={inputId}
  aria-pressed="false"
  class:list={['inline-flex min-h-11 items-center text-sm font-medium text-brand-800 hover:underline cursor-pointer', className]}
>
  Show password
</button>

<script>
  // Hard to spot typos on a phone keyboard, so the password can be shown.
  document.querySelectorAll<HTMLButtonElement>('[data-toggle-password]').forEach((btn) => {
    const input = document.getElementById(btn.dataset.togglePassword!) as HTMLInputElement | null;
    if (!input) return;
    btn.addEventListener('click', () => {
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      btn.textContent = show ? 'Hide password' : 'Show password';
      btn.setAttribute('aria-pressed', String(show));
    });
  });
</script>
