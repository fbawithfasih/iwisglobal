---
import type { Currency } from '../lib/currency';

interface Props {
  currency: Currency;
}

const { currency } = Astro.props;
const path = Astro.url.pathname;
---
<div class="inline-flex rounded-full border border-brand-200 p-0.5 text-xs">
  <a
    href={`${path}?currency=INR`}
    aria-current={currency === 'INR' ? 'true' : undefined}
    class={`px-3 py-2 rounded-full transition ${currency === 'INR' ? 'bg-brand-800 text-white' : 'text-stone-600 hover:text-brand-800'}`}
  >
    ₹ INR
  </a>
  <a
    href={`${path}?currency=USD`}
    aria-current={currency === 'USD' ? 'true' : undefined}
    class={`px-3 py-2 rounded-full transition ${currency === 'USD' ? 'bg-brand-800 text-white' : 'text-stone-600 hover:text-brand-800'}`}
  >
    $ USD
  </a>
</div>
