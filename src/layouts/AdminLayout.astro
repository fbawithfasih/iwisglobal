---
import { canAccessPath } from '../lib/authz';
import { takeFlash } from '../lib/flash';

interface Props {
  title: string;
}
const { title } = Astro.props;

const path = Astro.url.pathname;
const me = Astro.locals.admin;
// A one-time "Saved" style message left by the action the person just did (src/lib/flash.ts).
const flash = takeFlash(Astro.cookies);
const isReport = path.startsWith('/admin/leads/report');

// One list drives the sidebar (desktop) and the slide-over drawer (phone): they are the same element.
type NavItem = { href: string; label: string; active: boolean };
const allSections: { label: string; items: NavItem[] }[] = [
  {
    label: 'Work',
    items: [
      { href: '/admin/today', label: 'Today', active: path === '/admin/today' },
      { href: '/admin', label: 'Bookings', active: path === '/admin' || path.startsWith('/admin/bookings/') },
      { href: '/admin/leads', label: 'Leads', active: path.startsWith('/admin/leads') && !isReport },
      { href: '/admin/whatsapp', label: 'WhatsApp', active: path.startsWith('/admin/whatsapp') },
      { href: '/admin/custom-trips', label: 'Custom trips', active: path.startsWith('/admin/custom-trips') },
    ],
  },
  {
    label: 'Sell',
    items: [
      { href: '/admin/tours', label: 'Tours', active: path.startsWith('/admin/tours') },
      { href: '/admin/hotels', label: 'Hotels', active: path.startsWith('/admin/hotels') },
      { href: '/admin/offers', label: 'Offers', active: path === '/admin/offers' || path.startsWith('/admin/offers/') },
      { href: '/admin/private-offers', label: 'Private offers', active: path.startsWith('/admin/private-offers') },
    ],
  },
  {
    label: 'Marketing',
    items: [
      { href: '/admin/campaigns', label: 'Campaigns', active: path.startsWith('/admin/campaigns') },
      { href: '/admin/blog', label: 'Blog', active: path.startsWith('/admin/blog') },
      { href: '/admin/agra-highlights', label: 'Agra Highlights', active: path.startsWith('/admin/agra-highlights') },
      { href: '/admin/reviews', label: 'Reviews', active: path.startsWith('/admin/reviews') },
      { href: '/admin/leads/report', label: 'Lead report', active: isReport },
    ],
  },
  {
    label: 'System',
    items: [
      { href: '/admin/overview', label: 'Owner overview', active: path.startsWith('/admin/overview') },
      { href: '/admin/team', label: 'Team', active: path.startsWith('/admin/team') },
      { href: '/admin/audit', label: 'Audit log', active: path.startsWith('/admin/audit') },
    ],
  },
];
// Links a person cannot use are not shown. Hiding is only tidiness: the middleware refuses the pages anyway (src/lib/adminGate.ts).
const sections = allSections
  .map((g) => ({ ...g, items: g.items.filter((i) => !me || canAccessPath(me, i.href)) }))
  .filter((g) => g.items.length > 0);
const itemClass = (active: boolean) =>
  active
    ? 'flex items-center rounded-lg bg-white/15 px-3 py-2 font-semibold text-white'
    : 'flex items-center rounded-lg px-3 py-2 text-violet-100 transition-colors hover:bg-white/10 hover:text-white';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <!-- Lets the admin be added to an iPhone/Android Home Screen and open full screen. -->
    <link rel="manifest" href="/admin.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="IWIS Admin" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#4c1d95" />
    <title>{title} — IWIS Global Admin</title>
    <style is:global>
      @tailwind base;
      @tailwind components;
      @tailwind utilities;

      /* Design tokens (docs/platform/IWIS_PRODUCT_BLUEPRINT.md section 5). Brand is the site's violet. */
      :root {
        --brand-950: #2e1065;
        --brand-900: #4c1d95;
        --brand-700: #6d28d9;
        --brand-300: #a78bfa; /* fills, borders and focus rings on dark only; never text */
        --bg: #f7f5ff;
        --surface: #ffffff;
        --text: #1e1b2e;
        --text-muted: #64748b;
        /* Pastel meanings. -bg is the pill/border fill, -soft the quiet tile or notice background, -ink the dark text that sits on them. */
        --info-bg: #dbeafe; --info-soft: #eff6ff; --info-ink: #1e3a8a;
        --success-bg: #d1fae5; --success-soft: #ecfdf5; --success-ink: #065f46;
        --warn-bg: #ffedd5; --warn-soft: #fff7ed; --warn-ink: #9a3412;
        --danger-bg: #ffe4e6; --danger-soft: #fff1f2; --danger-ink: #9f1239;
        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 16px;
        --motion: 180ms;
      }
      @media (prefers-reduced-motion: reduce) {
        * { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; scroll-behavior: auto !important; }
      }
      /* Visible keyboard focus everywhere: violet ring on light, white ring inside the dark sidebar. */
      :focus-visible { outline: 2px solid var(--brand-700); outline-offset: 2px; }
      #admin-sidebar :focus-visible { outline-color: #fff; }
      .skip-link { position: absolute; left: 0.75rem; top: -4rem; z-index: 60; border-radius: var(--radius-md); background: #fff; padding: 0.5rem 1rem; font-weight: 600; color: var(--brand-900); box-shadow: 0 4px 14px rgba(0,0,0,.2); }
      .skip-link:focus { top: 0.75rem; }
      /* Sidebar: a slide-over drawer below 1024px (hidden from keyboard and screen readers while closed), fixed column above. */
      #admin-sidebar { transform: translateX(-100%); visibility: hidden; transition: transform var(--motion) ease, visibility 0s linear var(--motion); }
      #admin-sidebar[data-open='true'] { transform: none; visibility: visible; transition: transform var(--motion) ease; }
      @media (min-width: 1024px) {
        #admin-sidebar { transform: none; visibility: visible; transition: none; }
      }
      /* Shared admin component classes. Pages use these and the brand / violet scale; amber is kept only for warning notes. */
      /* Written after Tailwind's utilities so it wins ties (a page's own rounded / px classes still apply to size and spacing). */
      .btn-primary {
        background-image: linear-gradient(to right, var(--brand-900), var(--brand-700), #7c3aed);
        background-color: var(--brand-700);
        border-radius: 9999px;
        box-shadow: 0 4px 10px rgba(76, 29, 149, 0.2);
        transition: filter var(--motion);
      }
      .btn-primary:hover { filter: brightness(1.1); }
      .btn-secondary {
        border: 1px solid #ddd6fe;
        border-radius: 9999px;
        background: var(--surface);
        color: var(--brand-900);
        transition: background-color var(--motion);
      }
      .btn-secondary:hover { background: #f5f3ff; }
      .btn-danger {
        border-radius: 9999px;
        background: #be123c;
        color: #fff;
        transition: filter var(--motion);
      }
      .btn-danger:hover { filter: brightness(1.1); }
      /* Status badges: dark text on a pastel fill (contrast of each pair is checked in /admin/style-guide). */
      .badge { display: inline-block; border-radius: 9999px; padding: 0.125rem 0.625rem; font-size: 0.75rem; font-weight: 600; line-height: 1.25rem; }
      .badge-info { background: var(--info-bg); color: var(--info-ink); }
      .badge-success { background: var(--success-bg); color: var(--success-ink); }
      .badge-warn { background: var(--warn-bg); color: var(--warn-ink); }
      .badge-danger { background: var(--danger-bg); color: var(--danger-ink); }
      /* Quiet tinted surfaces for tiles (.tint-*) and notices (.notice-*). Written after the page-wide card rule so they win its border. */
      .tint-info { background: var(--info-soft); border-color: var(--info-bg) !important; }
      .tint-success { background: var(--success-soft); border-color: var(--success-bg) !important; }
      .tint-warn { background: var(--warn-soft); border-color: var(--warn-bg) !important; }
      .tint-danger { background: var(--danger-soft); border-color: var(--danger-bg) !important; }
      #toast[hidden] { display: none; } /* the flex utility on the toast would otherwise beat the hidden attribute */
      .notice { border: 1px solid; border-radius: 0.75rem; padding: 0.75rem; font-size: 0.875rem; }
      .notice-info { background: var(--info-soft); border-color: var(--info-bg); color: var(--info-ink); }
      .notice-success { background: var(--success-soft); border-color: var(--success-bg); color: var(--success-ink); }
      .notice-warn { background: var(--warn-soft); border-color: var(--warn-bg); color: var(--warn-ink); }
      .notice-danger { background: var(--danger-soft); border-color: var(--danger-bg); color: var(--danger-ink); }
      .badge-neutral { background: #ede9fe; color: var(--brand-900); }
      /* Page-wide defaults every admin page relies on (card edge and shadow, heading colour, form fields, the AA-contrast grey). */
      body { background: var(--bg); }
      main h1 { color: var(--brand-950); }
      main .rounded-xl { border-radius: 1rem; }
      main .bg-white.border,
      main .bg-white.border-violet-100 { border-color: #ede9fe; box-shadow: 0 1px 2px rgba(76, 29, 149, 0.06); }
      /* Tailwind stone-500 on the page background is 4.4:1, just under the 4.5:1 AA line; this is 5.3:1. */
      main .text-stone-500 { color: #6a645f; }
      main .bg-stone-50 { background-color: #faf9ff; }
      main input.border:not([type='checkbox']):not([type='radio']),
      main select.border,
      main textarea.border { border-color: #ddd6fe; border-radius: 0.5rem; }
      main input.border:focus,
      main select.border:focus,
      main textarea.border:focus { outline: none; border-color: #8b5cf6; box-shadow: 0 0 0 2px #c4b5fd; }
      main .hover\:underline:hover { text-decoration: underline; }
      /* Phones: 16px form text, or iOS zooms in on every field tap.
         !important so it also beats per-field size utilities (text-xs etc). */
      @media (max-width: 767px) {
        main input:not([type='checkbox']):not([type='radio']):not([type='file']),
        main select,
        main textarea {
          font-size: 16px !important;
        }
      }
    </style>
  </head>
  <body class="min-h-screen text-stone-900">
    <a href="#main" class="skip-link">Skip to main content</a>
    <div id="notif-panel" hidden role="region" aria-label="Waiting for you" class="fixed left-3 right-3 top-16 z-50 rounded-xl border border-violet-100 bg-white p-4 text-sm text-stone-900 shadow-xl lg:left-[18.5rem] lg:right-auto lg:top-3 lg:w-80">
      <p class="font-semibold text-brand-900">Waiting for you</p>
      <ul data-notif-list class="mt-2 grid gap-1"></ul>
      <p data-notif-empty class="mt-2 text-stone-700">Nothing is waiting for you right now.</p>
      <a href="/admin/today" class="mt-3 inline-block font-medium text-brand-700 underline">Open Today</a>
    </div>
    <div data-notif-live class="sr-only" role="status" aria-live="polite"></div>
    <div class="lg:flex">
      <div id="admin-overlay" class="fixed inset-0 z-30 hidden bg-black/40 lg:hidden" aria-hidden="true"></div>
      <nav id="admin-sidebar" aria-label="Admin" class="fixed inset-y-0 left-0 z-40 flex w-72 flex-col overflow-y-auto bg-gradient-to-b from-brand-950 via-brand-900 to-brand-900 text-sm text-violet-100 shadow-xl lg:sticky lg:top-0 lg:h-screen lg:w-60 lg:shrink-0 lg:shadow-none">
        <div class="flex items-center justify-between px-4 py-4">
          <a href="/admin" class="rounded-full bg-white px-3 py-1 font-semibold text-brand-900">IWIS Admin</a>
          <button id="nav-close" type="button" class="rounded-full border border-white/30 px-3 py-1 text-white lg:hidden" aria-label="Close menu">Close</button>
          <button type="button" data-notif-toggle aria-expanded="false" aria-controls="notif-panel" aria-label="Waiting for you" class="relative hidden rounded-full border border-white/30 p-2 text-white transition-colors hover:bg-white/10 lg:inline-flex">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
            <span data-notif-badge hidden class="absolute -right-1.5 -top-1.5 min-w-5 rounded-full bg-rose-700 px-1.5 text-center text-xs font-bold leading-5 text-white"></span>
          </button>
        </div>
        <form method="get" action="/admin/search" role="search" class="px-3 pb-3">
          <label for="admin-search" class="sr-only">Search guests, bookings, leads and chats</label>
          <input id="admin-search" type="search" name="q" maxlength="80" placeholder="Search guests…" title="Press / to search from anywhere" autocomplete="off" class="w-full rounded-lg border border-white/25 bg-white/10 px-3 py-2 text-white placeholder:text-violet-200 focus:bg-white/20" />
        </form>
        <div class="flex-1 px-3 pb-4">
          {sections.map((g) => (
            <div class="mt-3 first:mt-0">
              <p class="px-3 pb-1 text-xs font-semibold uppercase tracking-wide text-violet-300">{g.label}</p>
              <ul class="grid gap-0.5">
                {g.items.map((i) => <li><a href={i.href} aria-current={i.active ? 'page' : undefined} class={itemClass(i.active)}>{i.label}</a></li>)}
              </ul>
            </div>
          ))}
        </div>
        <div class="grid gap-1 border-t border-white/10 px-3 py-3">
          {me && (
            <p class="px-3 pb-1 text-xs text-violet-200" aria-label="Signed in as">
              <span class="block truncate font-semibold text-white">{me.name || me.email || 'Owner'}</span>
              <span>{me.role === 'owner' ? 'Owner' : 'Team'}{me.email && me.name && me.name !== me.email ? ` · ${me.email}` : ''}</span>
            </p>
          )}
          <a href="/admin/bookings/new" class="rounded-lg border border-white/30 px-3 py-2 text-center text-white transition-colors hover:bg-white/10">+ Manual Booking</a>
          <form method="POST" action="/admin/logout">
            <button type="submit" class="w-full cursor-pointer rounded-lg px-3 py-2 text-left text-violet-100 transition-colors hover:bg-white/10 hover:text-white">Log out</button>
          </form>
        </div>
      </nav>
      <div class="min-w-0 flex-1">
        <header class="sticky top-0 z-20 flex items-center gap-2 bg-brand-900 px-3 py-3 text-sm text-white shadow-md lg:hidden">
          <button id="nav-toggle" type="button" aria-expanded="false" aria-controls="admin-sidebar" class="rounded-full border border-white/30 px-4 py-1.5 font-semibold">Menu</button>
          <a href="/admin" class="hidden whitespace-nowrap font-semibold min-[430px]:inline">IWIS Admin</a>
          <a href="/admin/search" class="ml-auto whitespace-nowrap rounded-full border border-white/30 px-3 py-1">Search</a>
          <button type="button" data-notif-toggle aria-expanded="false" aria-controls="notif-panel" aria-label="Waiting for you" class="relative rounded-full border border-white/30 p-1.5 text-white">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
            <span data-notif-badge hidden class="absolute -right-1.5 -top-1.5 min-w-5 rounded-full bg-rose-700 px-1.5 text-center text-xs font-bold leading-5 text-white"></span>
          </button>
          <a href="/admin/bookings/new" class="whitespace-nowrap rounded-full border border-white/30 px-3 py-1">+ Booking</a>
        </header>
        <main id="main" tabindex="-1" class="mx-auto max-w-6xl px-4 py-8 sm:px-6 focus:outline-none">
          <slot />
        </main>
      </div>
    </div>
    <div class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex justify-center px-4">
      <div id="toast" data-flash={flash ?? ''} role="status" aria-live="polite" hidden class="notice notice-success pointer-events-auto flex max-w-md items-center gap-3 shadow-lg">
        <span aria-hidden="true">&#10003;</span>
        <span data-toast-text class="font-medium"></span>
        <button type="button" data-toast-close class="-my-2 -mr-2 min-h-11 min-w-11 rounded px-2 text-sm underline">Dismiss</button>
      </div>
    </div>
    <script>
      // Shows the one-time message the last action left, then hides it after a few seconds (or on Dismiss or Esc).
      // The text goes into a live region that already exists, so a screen reader announces it.
      const toast = document.getElementById('toast');
      const message = toast?.dataset.flash;
      if (toast && message) {
        const text = toast.querySelector<HTMLElement>('[data-toast-text]')!;
        const hide = () => { toast.hidden = true; };
        window.setTimeout(() => { text.textContent = message; toast.hidden = false; }, 50);
        window.setTimeout(hide, 5000);
        toast.querySelector('[data-toast-close]')?.addEventListener('click', hide);
        document.addEventListener('keydown', (e) => e.key === 'Escape' && !toast.hidden && hide());
      }
    </script>
    <dialog id="confirm-dialog" aria-labelledby="confirm-title" class="w-[min(28rem,calc(100vw-2rem))] rounded-xl border border-violet-200 bg-white p-0 text-stone-800 shadow-xl backdrop:bg-black/40">
      <form method="dialog" class="space-y-3 p-5">
        <h2 id="confirm-title" class="text-base font-semibold text-stone-900">Are you sure?</h2>
        <p data-confirm-message class="text-sm text-stone-700"></p>
        <div data-confirm-typed class="hidden space-y-1">
          <label for="confirm-typed" class="block text-sm text-stone-700">Type <strong data-confirm-word></strong> to confirm</label>
          <input id="confirm-typed" autocomplete="off" class="min-h-11 w-full rounded border border-red-300 px-3 text-sm" />
        </div>
        <div class="flex flex-wrap justify-end gap-2 pt-1">
          <button value="cancel" class="btn-secondary min-h-11 rounded px-4 text-sm">Cancel</button>
          <button type="button" data-confirm-ok class="btn-danger min-h-11 rounded px-4 text-sm">Confirm</button>
        </div>
      </form>
    </dialog>
    <script>
      // One confirmation for every risky button. Put data-confirm="what will happen" on a button (or a form); add
      // data-confirm-type="WORD" to make the person type a word first (for things that cannot be undone) and
      // data-confirm-label="Delete" to name the button. Cancel or Esc leaves everything as it was.
      const dlg = document.getElementById('confirm-dialog') as HTMLDialogElement | null;
      if (dlg && typeof dlg.showModal === 'function') {
        const msg = dlg.querySelector<HTMLElement>('[data-confirm-message]')!;
        const typedBox = dlg.querySelector<HTMLElement>('[data-confirm-typed]')!;
        const word = dlg.querySelector<HTMLElement>('[data-confirm-word]')!;
        const input = dlg.querySelector<HTMLInputElement>('#confirm-typed')!;
        const ok = dlg.querySelector<HTMLButtonElement>('[data-confirm-ok]')!;
        let pending: { form: HTMLFormElement; submitter: HTMLElement | null; opener: HTMLElement | null } | null = null;
        let approved = new WeakSet<HTMLFormElement>();
        const need = () => (typedBox.classList.contains('hidden') ? '' : (word.textContent ?? ''));
        const sync = () => { ok.disabled = need() !== '' && input.value.trim().toUpperCase() !== need().toUpperCase(); };
        input.addEventListener('input', sync);
        document.addEventListener('submit', (e) => {
          const form = e.target as HTMLFormElement;
          if (approved.has(form)) { approved.delete(form); return; }
          const submitter = (e as SubmitEvent).submitter as HTMLElement | null;
          const holder = submitter?.closest<HTMLElement>('[data-confirm]') ?? form.closest<HTMLElement>('[data-confirm]');
          const text = holder?.dataset.confirm;
          if (!holder || !text) return;
          e.preventDefault();
          e.stopPropagation();
          pending = { form, submitter, opener: submitter ?? (document.activeElement as HTMLElement | null) };
          msg.textContent = text;
          const type = holder.dataset.confirmType ?? '';
          typedBox.classList.toggle('hidden', !type);
          word.textContent = type;
          input.value = '';
          ok.textContent = holder.dataset.confirmLabel ?? 'Confirm';
          sync();
          dlg.showModal();
          (type ? input : ok).focus();
        }, true);
        ok.addEventListener('click', () => {
          const p = pending;
          pending = null;
          dlg.close('ok');
          if (!p) return;
          approved.add(p.form);
          p.form.requestSubmit(p.submitter as HTMLElement | null as HTMLButtonElement | null);
        });
        dlg.addEventListener('close', () => {
          if (dlg.returnValue !== 'ok') pending?.opener?.focus();
          pending = null;
          dlg.returnValue = '';
        });
      }
    </script>
    <script>
      // Phone drawer: opens from the Menu button, closes on Close, overlay click, Escape, or choosing a link.
      const sidebar = document.getElementById('admin-sidebar');
      const overlay = document.getElementById('admin-overlay');
      const toggle = document.getElementById('nav-toggle');
      const closeBtn = document.getElementById('nav-close');
      const setOpen = (open: boolean) => {
        sidebar?.setAttribute('data-open', String(open));
        overlay?.classList.toggle('hidden', !open);
        toggle?.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
        if (open) (sidebar?.querySelector('a[aria-current="page"], a') as HTMLElement | null)?.focus();
        else toggle?.focus({ preventScroll: true });
      };
      toggle?.addEventListener('click', () => setOpen(sidebar?.getAttribute('data-open') !== 'true'));
      closeBtn?.addEventListener('click', () => setOpen(false));
      overlay?.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', (e) => e.key === 'Escape' && sidebar?.getAttribute('data-open') === 'true' && setOpen(false));
      // Resizing up to desktop while the drawer is open must not leave the page scroll-locked.
      window.matchMedia('(min-width: 1024px)').addEventListener('change', (m) => m.matches && sidebar?.getAttribute('data-open') === 'true' && setOpen(false));
    </script>
    <script>
      // Admin text boxes grow to fit their content (never below their rows=
      // height), so long itineraries/add-ons aren't a scroll-inside-a-scroll
      // on phones.
      const grow = (t: HTMLTextAreaElement) => {
        t.style.height = 'auto';
        t.style.height = `${t.scrollHeight + 2}px`;
      };
      document.querySelectorAll<HTMLTextAreaElement>('main textarea').forEach((t) => {
        grow(t);
        t.addEventListener('input', () => grow(t));
      });
    </script>
    <script>
      // "/" jumps to the search box, unless the person is already typing in a field.
      document.addEventListener('keydown', (e) => {
        if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
        const t = e.target as HTMLElement | null;
        if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
        const box = document.getElementById('admin-search') as HTMLInputElement | null;
        if (!box || box.offsetParent === null) return;
        e.preventDefault();
        box.focus();
        box.select();
      });
        </script>
    <script>
      // The bell: a live count of work that is waiting (see src/lib/notifications.ts). Refreshes about once a minute while
      // the page is visible. Everything shown is set with textContent, never as HTML.
      const panel = document.getElementById('notif-panel') as HTMLElement | null;
      const list = panel?.querySelector<HTMLElement>('[data-notif-list]');
      const emptyNote = panel?.querySelector<HTMLElement>('[data-notif-empty]');
      const live = document.querySelector<HTMLElement>('[data-notif-live]');
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-notif-toggle]'));
      const baseTitle = document.title;
      let lastTotal: number | null = null;
      let lastFetch = 0;
      let stopped = false;

      const setOpen = (open: boolean, focus = true) => {
        if (!panel) return;
        panel.hidden = !open;
        buttons.forEach((b) => b.setAttribute('aria-expanded', String(open)));
        if (open && focus) panel.querySelector<HTMLElement>('a')?.focus();
      };
      buttons.forEach((b) => b.addEventListener('click', () => setOpen(!!panel?.hidden)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && panel && !panel.hidden) {
          setOpen(false);
          buttons.find((b) => b.offsetParent !== null)?.focus();
        }
      });
      document.addEventListener('click', (e) => {
        const t = e.target as Node;
        if (panel && !panel.hidden && !panel.contains(t) && !buttons.some((b) => b.contains(t))) setOpen(false);
      });
      // Tabbing away from the panel closes it too, so it never stays open behind where the keyboard is now.
      document.addEventListener('focusin', (e) => {
        const t = e.target as Node;
        if (panel && !panel.hidden && !panel.contains(t) && !buttons.some((b) => b.contains(t))) setOpen(false);
      });

      type Item = { key: string; label: string; count: number; detail: string; href: string };
      const render = (data: { total: number; items: Item[] }) => {
        const total = data.total;
        buttons.forEach((b) => {
          const badge = b.querySelector<HTMLElement>('[data-notif-badge]');
          if (badge) {
            badge.hidden = total === 0;
            badge.textContent = total > 99 ? '99+' : String(total);
          }
          b.setAttribute('aria-label', total === 0 ? 'Waiting for you: nothing' : `Waiting for you: ${total}`);
        });
        document.title = total > 0 ? `(${total}) ${baseTitle}` : baseTitle;
        if (list && emptyNote) {
          list.replaceChildren(
            ...data.items.map((i) => {
              const li = document.createElement('li');
              const a = document.createElement('a');
              a.href = i.href;
              a.className = 'block rounded-lg px-2 py-1.5 hover:bg-violet-50';
              const strong = document.createElement('span');
              strong.className = 'block font-medium';
              strong.textContent = i.label;
              a.append(strong);
              if (i.detail) {
                const d = document.createElement('span');
                d.className = 'block text-xs text-stone-700';
                d.textContent = i.detail;
                a.append(d);
              }
              li.append(a);
              return li;
            })
          );
          emptyNote.hidden = data.items.length > 0;
        }
        // Tell screen-reader users when something new arrives, not on every refresh.
        if (live && lastTotal !== null && total > lastTotal) live.textContent = `${total - lastTotal} new ${total - lastTotal === 1 ? 'thing is' : 'things are'} waiting for you`;
        lastTotal = total;
      };

      const refresh = async () => {
        if (stopped || document.hidden) return;
        lastFetch = Date.now();
        try {
          const res = await fetch('/admin/api/notifications', { credentials: 'same-origin', cache: 'no-store' });
          if (res.status === 401) { stopped = true; return; } // signed out: stop asking
          if (!res.ok) return;
          const data = await res.json();
          if (!data.failed) render(data);
        } catch {
          /* offline or a hiccup: keep what is shown */
        }
      };
      if (buttons.length) {
        setTimeout(refresh, 400);
        setInterval(refresh, 60_000);
        document.addEventListener('visibilitychange', () => { if (!document.hidden && Date.now() - lastFetch > 30_000) refresh(); });
      }
    </script>
  </body>
</html>
