---
interface Props {
  title: string;
}
const { title } = Astro.props;

const path = Astro.url.pathname;
const navLinkClass = (active: boolean) =>
  active
    ? 'rounded-full bg-white/20 px-3 py-1 font-semibold text-white'
    : 'rounded-full px-3 py-1 text-violet-200 transition hover:bg-white/10 hover:text-white';
const isBookings = path === '/admin' || path.startsWith('/admin/bookings/');
const isTours = path.startsWith('/admin/tours');
const isLeads = path.startsWith('/admin/leads');
const isAgraHighlights = path.startsWith('/admin/agra-highlights');
const isReviews = path.startsWith('/admin/reviews');
const isBlog = path.startsWith('/admin/blog');
const isOffers = path === '/admin/offers' || path.startsWith('/admin/offers/');
const isPrivateOffers = path.startsWith('/admin/private-offers');
const isWhatsapp = path.startsWith('/admin/whatsapp');
const isCustomTrips = path.startsWith('/admin/custom-trips');
const isHotels = path.startsWith('/admin/hotels');

// Daily work stays on the bar; the rest is grouped so the menu fits on one line.
type NavItem = { href: string; label: string; active: boolean };
const top: NavItem[] = [
  { href: '/admin', label: 'Bookings', active: isBookings },
  { href: '/admin/leads', label: 'Leads', active: isLeads },
  { href: '/admin/whatsapp', label: 'WhatsApp', active: isWhatsapp },
];
const groups: { label: string; items: NavItem[] }[] = [
  {
    label: 'Sell',
    items: [
      { href: '/admin/tours', label: 'Tours', active: isTours },
      { href: '/admin/hotels', label: 'Hotels', active: isHotels },
      { href: '/admin/custom-trips', label: 'Custom trips', active: isCustomTrips },
      { href: '/admin/offers', label: 'Offers', active: isOffers },
      { href: '/admin/private-offers', label: 'Private offers', active: isPrivateOffers },
    ],
  },
  {
    label: 'Content',
    items: [
      { href: '/admin/agra-highlights', label: 'Agra Highlights', active: isAgraHighlights },
      { href: '/admin/blog', label: 'Blog', active: isBlog },
      { href: '/admin/reviews', label: 'Reviews', active: isReviews },
    ],
  },
];
const dropLink = (active: boolean) =>
  active ? 'block rounded-lg bg-violet-100 px-3 py-2 font-semibold text-brand-900' : 'block rounded-lg px-3 py-2 text-stone-700 hover:bg-violet-50';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <!-- Lets the admin be added to an iPhone/Android Home Screen and open full screen. -->
    <link rel="manifest" href="/admin.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="IWIS Admin" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#4c1d95" />
    <title>{title} — IWIS Global Admin</title>
    <style is:global>
      @tailwind base;
      @tailwind components;
      @tailwind utilities;
      /* Violet admin theme, applied here so every admin page picks it up
         without editing each one. Colours are Tailwind's violet scale (the
         site's "brand"). The pages' amber primary buttons and links become
         violet; inputs and cards get violet borders. */
      body { background: #f7f5ff; }
      main h1 { color: #2e1065; }
      main .rounded-xl { border-radius: 1rem; }
      main .bg-white.border,
      main .bg-white.border-stone-200 { border-color: #ede9fe; box-shadow: 0 1px 2px rgba(76, 29, 149, 0.06); }
      main .border-stone-200 { border-color: #ede9fe; }
      main .border-stone-300 { border-color: #ddd6fe; }
      main .bg-stone-50 { background-color: #faf9ff; }
      main input.border:not([type='checkbox']):not([type='radio']),
      main select.border,
      main textarea.border { border-color: #ddd6fe; border-radius: 0.5rem; }
      main input.border:focus,
      main select.border:focus,
      main textarea.border:focus { outline: none; border-color: #8b5cf6; box-shadow: 0 0 0 2px #c4b5fd; }
      main .bg-amber-800 {
        background-image: linear-gradient(to right, #4c1d95, #6d28d9, #7c3aed);
        background-color: #6d28d9;
        border-radius: 9999px;
        box-shadow: 0 4px 10px rgba(76, 29, 149, 0.2);
        transition: filter 0.15s;
      }
      main .bg-amber-800:hover { filter: brightness(1.1); }
      main .text-amber-800 { color: #6d28d9; }
      main .bg-amber-100 { background-color: #ede9fe; }
      main .hover\:underline:hover { text-decoration: underline; }
      /* Phones: 16px form text, or iOS zooms in on every field tap.
         !important so it also beats per-field size utilities (text-xs etc). */
      @media (max-width: 767px) {
        main input:not([type='checkbox']):not([type='radio']):not([type='file']),
        main select,
        main textarea {
          font-size: 16px !important;
        }
      }
    </style>
  </head>
  <body class="text-stone-900 min-h-screen">
    <!-- Desktop: daily links plus Sell / Content dropdowns. Phone: brand + Menu button that opens a grouped panel. -->
    <nav id="admin-nav" class="bg-gradient-to-r from-brand-950 via-brand-900 to-brand-800 text-sm text-violet-100 shadow-md shadow-brand-950/20">
      <div class="flex items-center gap-x-2 px-4 py-3 md:px-6">
        <a href="/admin" class="mr-2 rounded-full bg-white px-3 py-1 font-semibold text-brand-900">IWIS Admin</a>
        <div class="hidden items-center gap-x-2 md:flex">
          {top.map((i) => <a href={i.href} aria-current={i.active ? 'page' : undefined} class={navLinkClass(i.active)}>{i.label}</a>)}
          {groups.map((g) => (
            <details class="nav-group relative">
              <summary class={`${navLinkClass(g.items.some((i) => i.active))} flex cursor-pointer list-none items-center gap-1 [&::-webkit-details-marker]:hidden`}>
                {g.label}<span aria-hidden="true" class="text-xs">▾</span>
              </summary>
              <div class="absolute left-0 top-full z-30 mt-2 min-w-[12rem] rounded-xl border border-violet-100 bg-white p-1.5 shadow-lg">
                {g.items.map((i) => <a href={i.href} aria-current={i.active ? 'page' : undefined} class={dropLink(i.active)}>{i.label}</a>)}
              </div>
            </details>
          ))}
        </div>
        <a href="/admin/bookings/new" class="ml-auto hidden rounded-full border border-white/30 px-3 py-1 text-violet-100 transition hover:bg-white/10 hover:text-white md:inline-block">+ Manual Booking</a>
        <form method="POST" action="/admin/logout" class="hidden md:block">
          <button type="submit" class="cursor-pointer rounded-full px-3 py-1 text-violet-200 transition hover:bg-white/10 hover:text-white">Log out</button>
        </form>
        <button id="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-panel" class="ml-auto rounded-full border border-white/30 px-4 py-1.5 font-semibold text-white md:hidden">Menu</button>
      </div>
      <div id="nav-panel" class="hidden border-t border-white/10 px-4 pb-4 pt-3 md:hidden">
        <div class="grid gap-1">
          {top.map((i) => <a href={i.href} aria-current={i.active ? 'page' : undefined} class={`${navLinkClass(i.active)} py-2`}>{i.label}</a>)}
        </div>
        {groups.map((g) => (
          <div class="mt-3">
            <p class="px-3 pb-1 text-xs font-semibold uppercase tracking-wide text-violet-300">{g.label}</p>
            <div class="grid gap-1">
              {g.items.map((i) => <a href={i.href} aria-current={i.active ? 'page' : undefined} class={`${navLinkClass(i.active)} py-2`}>{i.label}</a>)}
            </div>
          </div>
        ))}
        <div class="mt-4 flex items-center gap-2 border-t border-white/10 pt-3">
          <a href="/admin/bookings/new" class="rounded-full border border-white/30 px-4 py-2 text-white">+ Manual Booking</a>
          <form method="POST" action="/admin/logout" class="ml-auto">
            <button type="submit" class="cursor-pointer rounded-full px-4 py-2 text-violet-200">Log out</button>
          </form>
        </div>
      </div>
    </nav>
    <main class="max-w-6xl mx-auto px-6 py-8">
      <slot />
    </main>
    <script>
      // Phone menu button, and the desktop dropdowns: one open at a time, closed by an outside click or Escape.
      const toggle = document.getElementById('nav-toggle');
      const panel = document.getElementById('nav-panel');
      toggle?.addEventListener('click', () => {
        const open = panel?.classList.toggle('hidden') === false;
        toggle.setAttribute('aria-expanded', String(open));
      });
      const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>('#admin-nav .nav-group'));
      const closeGroups = (except?: Element | null) => groups.forEach((g) => g !== except && (g.open = false));
      groups.forEach((g) => g.addEventListener('toggle', () => g.open && closeGroups(g)));
      document.addEventListener('click', (e) => closeGroups((e.target as Element).closest('.nav-group')));
      document.addEventListener('keydown', (e) => e.key === 'Escape' && closeGroups());
    </script>
    <script>
      // Admin text boxes grow to fit their content (never below their rows=
      // height), so long itineraries/add-ons aren't a scroll-inside-a-scroll
      // on phones.
      const grow = (t: HTMLTextAreaElement) => {
        t.style.height = 'auto';
        t.style.height = `${t.scrollHeight + 2}px`;
      };
      document.querySelectorAll<HTMLTextAreaElement>('main textarea').forEach((t) => {
        grow(t);
        t.addEventListener('input', () => grow(t));
      });
    </script>
  </body>
</html>
