---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — IWIS Global Admin</title>
    <style is:global>
      @tailwind base;
      @tailwind components;
      @tailwind utilities;
    </style>
  </head>
  <body class="bg-stone-100 text-stone-900 min-h-screen">
    <nav class="bg-stone-900 text-stone-100 px-6 py-3 flex items-center gap-6 text-sm">
      <a href="/admin" class="font-semibold">IWIS Admin</a>
      <a href="/admin" class="hover:underline">Bookings</a>
      <a href="/admin/tours" class="hover:underline">Tours</a>
      <a href="/admin/leads" class="hover:underline">Leads</a>
      <a href="/admin/bookings/new" class="hover:underline">+ Manual Booking</a>
      <form method="POST" action="/admin/logout" class="ml-auto">
        <button type="submit" class="hover:underline">Log out</button>
      </form>
    </nav>
    <main class="max-w-6xl mx-auto px-6 py-8">
      <slot />
    </main>
  </body>
</html>
