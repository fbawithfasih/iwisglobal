---
import { resolveEnv } from '../lib/env';
import { getSessionCustomerId } from '../lib/requireCustomer';
import { resolveLocale, LOCALES } from '../lib/i18n';
import { isLocalizedPath, localizedPath } from '../lib/localizedPaths.mjs';
import { getDictionary } from '../i18n/dictionaries';
import LocaleSwitcher from '../components/LocaleSwitcher.astro';
import GlobeLogo from '../components/GlobeLogo.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { consentRequired, requestCountry } from '../lib/consentRegion';
import CompareTray from '../components/CompareTray';
import SocialLinks from '../components/SocialLinks.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { SOCIAL_PROFILES } from '../lib/social';
import { hasApprovedReviewsForRequest } from '../lib/reviews';
// Heading font, self-hosted (was a render-blocking Google Fonts stylesheet on
// two extra origins). Only the Latin file is preloaded; other scripts'
// subsets download on demand via unicode-range.
import '@fontsource-variable/source-serif-4/wght.css';
import serifLatinUrl from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';

interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  // Ordered from the homepage down to (but not including) the current page
  // — e.g. [{ name: 'Tours', path: '/tours' }] on a tour detail page. Every
  // page's own title is appended as the final crumb, so schema can't drift
  // from the <title> actually rendered. Omit on top-level pages (home,
  // /tours, /help, etc.) — a single-item trail has no SEO/AEO value.
  breadcrumbs?: BreadcrumbItem[];
  // For pages with no search value (login, signup, booking confirmation)
  // that Google still finds through header/footer links.
  noindex?: boolean;
  // false on pages with their own WhatsApp button or a short form the
  // floating one would cover (contact, confirmation, sign-in pages…).
  floatingWhatsApp?: boolean;
  // Private pages whose URL is a secret (private offers): no third-party
  // analytics, advertising or tracking script, and no cookie banner (it only
  // exists to load the Meta Pixel and Metricool after consent).
  noTracking?: boolean;
  // The page has its own signup form, so the footer one is left out (the two would share element ids).
  hideNewsletter?: boolean;
}

const {
  title,
  // Backlog 2.5 — query-first, brand-last, same principle as title tags.
  description = 'Private, professional Taj Mahal & Agra tours, booked online — IWIS Global. Same-day trips from Delhi with your own guide and car.',
  // Backlog 0.6 — was the square logo on a summary_large_image card, which
  // Facebook/Twitter/LinkedIn crop awkwardly. og-image.jpg is a proper
  // 1200×630 crop of the hero photo.
  image = '/og-image.jpg',
  breadcrumbs,
  noindex = false,
  floatingWhatsApp = true,
  noTracking = false,
  hideNewsletter = false,
} = Astro.props;

// The cookie banner and "wait for Accept" apply in the EU/EEA, UK and Switzerland only (src/lib/consentRegion.ts).
// HTML pages are not cached at the edge, so this is decided for each visitor.
const askConsent = consentRequired(requestCountry(Astro.request, (Astro.locals as { runtime?: { cf?: { country?: string } } }).runtime?.cf));

const TRACKING_COMMENTS: string[] = ['<!-- Google consent defaults, before the Google tag loads: analytics and\n         ad cookies stay off until the visitor taps Accept on the cookie\n         banner (CookieConsent.astro), which remembers the choice in the\n         cookie_consent cookie. -->', "<!-- Google tag (gtag.js), loaded after the page has finished loading (and the\n         browser is idle) so its 190 KB of script doesn't compete with the first\n         paint. The calls below queue in dataLayer, and consent updates and\n         events from the page queue behind them, until the tag arrives. -->", "<!-- Ahrefs Web Analytics: cookie-free page-view counts (Ahrefs states it needs no\n         consent), so unlike GA, Meta and Metricool it isn't held back for the cookie\n         banner. Skipped on private pages (login, account, ...), which are noindex. -->"];

// ?lang= / ?currency= are switcher links that set a cookie; the page they
// render is a duplicate of the bare URL. Google indexed /?lang=es as its own
// page despite the canonical (the text differs), splitting the homepage.
const robotsNoindex =
  noindex || Astro.url.searchParams.has('lang') || Astro.url.searchParams.has('currency');

// BreadcrumbList JSON-LD — a gap shared with activities.marriott.com (it has
// none either), but cheap to add here given pages already carry a title and
// (for nested pages) a natural parent section.
const breadcrumbJsonLd = breadcrumbs && breadcrumbs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { name: 'Home', path: '/' },
        ...breadcrumbs,
        { name: title.split(' — ')[0], path: Astro.url.pathname },
      ].map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.name,
        item: new URL(crumb.path, Astro.site ?? 'https://www.iwisglobal.com').toString(),
      })),
    }
  : null;
// Pages with per-language URLs (/es/…) get a canonical for their own language
// and hreflang links to every language version.
const basePath = Astro.locals.canonicalPath ?? Astro.url.pathname;
const hasLanguageUrls = isLocalizedPath(basePath);
const pageLocale = Astro.locals.locale ?? 'en';
const siteOrigin = (Astro.site ?? new URL('https://www.iwisglobal.com')).toString();
const alternates = hasLanguageUrls
  ? LOCALES.map((l) => ({ code: l.code, href: new URL(localizedPath(basePath, l.code), siteOrigin).toString() }))
  : [];
const canonicalURL = Astro.site
  ? new URL(hasLanguageUrls ? localizedPath(basePath, pageLocale) : Astro.url.pathname, Astro.site)
  : Astro.url.pathname;
const ogImageURL = Astro.site ? new URL(image, Astro.site).toString() : image;

const env = resolveEnv(Astro.locals);
const isSignedIn = !!(await getSessionCustomerId(Astro.cookies, env.CUSTOMER_SESSION_SECRET));
// Footer links to /reviews only once there's an approved review to show.
const showReviewsLink = env.DB ? await hasApprovedReviewsForRequest(env.DB, Astro.request) : false;

const locale = Astro.locals.locale ?? resolveLocale(Astro.url.searchParams, Astro.cookies.get('lang')?.value);
if (Astro.url.searchParams.get('lang')) {
  Astro.cookies.set('lang', locale, { path: '/', maxAge: 60 * 60 * 24 * 365 });
}
const t = getDictionary(locale);

// Backlog 2.9 — unique wa.me ref per page, so a WhatsApp lead can be traced
// back to where it started (product-marketing-context.md §9's WhatsApp
// attribution gap). HOME for the homepage, TOUR-<slug> for a tour page,
// the pathname otherwise.
function whatsappRef(location: string): string {
  const path = Astro.url.pathname;
  const page = path === '/' ? 'HOME' : path.replace(/^\/|\/$/g, '').replace(/\//g, '-').toUpperCase();
  return `${location}-${page}`;
}

// Backlog 2.1. "IWIS Global" alone collides with a German industrial chain
// manufacturer and an unrelated Amazon storefront of the same name. The
// disambiguation lives in disambiguatingDescription, not name: name is the
// brand string Google matches for brand queries, so it must be exactly
// "IWIS Global" (a sentence there weakened the "iwis global" entity).
//
// sameAs: the live Google Business Profile share link (given by the user)
// and our confirmed social profiles (src/lib/social.ts) — don't invent
// others. Address, legalName and taxID match /about and /contact;
// legalName and taxID are as shown on the public GST register.
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'TravelAgency'],
  '@id': 'https://www.iwisglobal.com/#organization',
  name: 'IWIS Global',
  legalName: 'IWIS Global',
  taxID: '09AAIFI6799J1ZH',
  alternateName: 'iwisglobal',
  disambiguatingDescription: 'A Taj Mahal and Agra tour operator based in Agra, India',
  url: 'https://www.iwisglobal.com',
  logo: 'https://www.iwisglobal.com/logo.png',
  image: 'https://www.iwisglobal.com/logo.png',
  telephone: '+91 6399226633',
  email: 'info@iwisglobal.com',
  // WhatsApp/phone/email support hours, as stated on /contact: 8 AM–10 PM
  // India time, every day (Fridays too, though no tours run then).
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: '+91 6399226633',
    email: 'info@iwisglobal.com',
    hoursAvailable: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '08:00',
      closes: '22:00',
    },
  },
  sameAs: ['https://share.google/UoeRHRhy0YWsmUpKh', ...SOCIAL_PROFILES.map((p) => p.url)],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'A-5, First Floor, ESSAR Mughal Residency, Jyoti Nagar, Shaheed Nagar',
    addressLocality: 'Agra',
    postalCode: '282001',
    addressRegion: 'Uttar Pradesh',
    addressCountry: 'IN',
  },
  areaServed: {
    '@type': 'City',
    name: 'Agra',
  },
};

// Google reads the site name shown on search results from WebSite markup on
// the homepage only.
//
// dateModified: a freshness signal for AI/Google crawlers, since the
// homepage has no visible "last updated" line. Hand-maintained like the
// legal pages' lastUpdated — bump it when the homepage's content changes
// (not for unrelated site-wide edits).
const HOMEPAGE_DATE_MODIFIED = '2026-09-28';
const websiteJsonLd = Astro.url.pathname === '/'
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'IWIS Global',
      alternateName: 'iwisglobal',
      url: 'https://www.iwisglobal.com/',
      dateModified: HOMEPAGE_DATE_MODIFIED,
      publisher: { '@id': 'https://www.iwisglobal.com/#organization' },
    }
  : null;
---
<!doctype html>
<html lang={locale} class="scroll-smooth" data-consent-region={askConsent ? '1' : '0'}>
  <head>
    {!noTracking && <Fragment set:html={TRACKING_COMMENTS[0]} />}
    {!noTracking && (
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      // The visitor's own choice wins; without one, analytics and ads wait for Accept only in the consent region.
      var consentChoice = document.cookie.match(/(?:^|; )cookie_consent=(granted|denied)/);
      var consentState = consentChoice ? consentChoice[1] : (document.documentElement.getAttribute('data-consent-region') === '0' ? 'granted' : 'denied');
      gtag('consent', 'default', {
        analytics_storage: consentState,
        ad_storage: consentState,
        ad_user_data: consentState,
        ad_personalization: consentState,
      });
    </script>
    )}
    {!noTracking && <Fragment set:html={TRACKING_COMMENTS[1]} />}
    {!noTracking && (
    <script is:inline>
      gtag('js', new Date());

      gtag('config', 'G-3CCCVSYT7D');
      (function () {
        function load() {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-3CCCVSYT7D';
          document.head.appendChild(s);
        }
        function later() {
          if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 3000 });
          else setTimeout(load, 1500);
        }
        if (document.readyState === 'complete') later();
        else window.addEventListener('load', later, { once: true });
      })();
    </script>
    )}
    {!noTracking && <Fragment set:html={TRACKING_COMMENTS[2]} />}
    {!noindex && !noTracking && <script is:inline async src="https://analytics.ahrefs.com/analytics.js" data-key="E2hZqQs3rehWC6n7B5T+Cw"></script>}
    {!noTracking && (
    <script is:inline>
      // First visit of the session: remember where the visitor came from. It stays in this tab's
      // sessionStorage and is sent only if they submit the enquiry form (src/components/EnquiryForm.astro),
      // book, or start a WhatsApp chat (a short "via google/paid/<campaign>" in the prefilled text).
      (function () {
        try {
          if (sessionStorage.getItem('iwis_first_touch')) return;
          var q = new URLSearchParams(location.search);
          var t = {
            source: q.get('utm_source') || '', medium: q.get('utm_medium') || '', campaign: q.get('utm_campaign') || '',
            utmContent: q.get('utm_content') || '', utmTerm: q.get('utm_term') || '',
            fbclid: q.get('fbclid') || '', gclid: q.get('gclid') || '',
            referrer: document.referrer ? new URL(document.referrer).hostname : '',
            landingPage: location.pathname
          };
          sessionStorage.setItem('iwis_first_touch', JSON.stringify(t));
        } catch (e) {}
      })();
    </script>
    )}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Icon set made from the IWIS globe mark (logo-globe.png) on a white tile:
         the full logo with its wordmark is unreadable at the 16–48px sizes
         browsers and Google results use. The ?v= tag makes browsers re-fetch
         after a change, since they cache favicons for a long time. -->
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/png" href="/icon-192.png?v=2" sizes="192x192" />
    <link rel="icon" type="image/png" href="/favicon-48.png?v=2" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <meta name="theme-color" content="#6d28d9" />
    <meta name="generator" content={Astro.generator} />
    <style is:global>
      @tailwind base;
      @tailwind components;
      @tailwind utilities;
    </style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <slot name="head" />
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    {robotsNoindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <!-- One of the signals Google uses for the site name shown above the URL. -->
    <meta property="og:site_name" content="IWIS Global" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <!-- Pinterest website claim (Pinterest business account). -->
    <meta name="p:domain_verify" content="a469947eb399df092262ab86abbc91a5" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    {websiteJsonLd && <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />}
    {breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}

    <link rel="preload" href={serifLatinUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-stone-50 text-stone-900 antialiased">
    <header id="site-header" class="tv-scale sticky top-0 z-40 border-b border-brand-100 bg-white/90 backdrop-blur-sm transition-[box-shadow,height] duration-200">
      <div class="site-header-inner max-w-5xl 2xl:max-w-6xl min-[2200px]:max-w-7xl mx-auto px-6 h-16 2xl:h-20 min-[2200px]:h-24 flex items-center justify-between transition-[height] duration-200">
        <a href="/" class="flex items-center gap-2 md:gap-2.5 min-w-0">
          <GlobeLogo class="site-logo h-11 w-11 md:h-[3.25rem] md:w-[3.25rem] 2xl:h-16 2xl:w-16 min-[2200px]:h-[4.5rem] min-[2200px]:w-[4.5rem] transition-[width,height] duration-200" />
          <span class="text-lg md:text-xl 2xl:text-2xl min-[2200px]:text-3xl font-serif font-semibold tracking-tight truncate">IWIS Global</span>
        </a>
        <nav class="hidden md:flex items-center gap-6 2xl:gap-8 min-[2200px]:gap-10">
          <a href="/tours" class="rounded-full px-3 py-1.5 text-sm 2xl:text-base min-[2200px]:text-lg font-medium text-stone-600 transition hover:bg-brand-50 hover:text-brand-800">{t.nav.tours}</a>
          <a href="/blog" class="rounded-full px-3 py-1.5 text-sm 2xl:text-base min-[2200px]:text-lg font-medium text-stone-600 transition hover:bg-brand-50 hover:text-brand-800">{t.nav.blog}</a>
          <a href="/help" class="rounded-full px-3 py-1.5 text-sm 2xl:text-base min-[2200px]:text-lg font-medium text-stone-600 transition hover:bg-brand-50 hover:text-brand-800">{t.nav.help}</a>
          {isSignedIn ? (
            <>
              <a href="/account/bookings" class="rounded-full px-3 py-1.5 text-sm 2xl:text-base min-[2200px]:text-lg font-medium text-stone-600 transition hover:bg-brand-50 hover:text-brand-800">{t.nav.myBookings}</a>
              <form method="POST" action="/auth/logout">
                <button type="submit" class="text-sm font-medium text-stone-600 hover:text-brand-800 transition cursor-pointer">{t.nav.signOut}</button>
              </form>
            </>
          ) : (
            <a href="/login" class="rounded-full bg-gradient-to-r from-brand-900 via-brand-700 to-brand-600 px-4 py-1.5 2xl:px-6 2xl:py-2 min-[2200px]:px-8 min-[2200px]:py-2.5 text-sm 2xl:text-base min-[2200px]:text-lg font-semibold text-white shadow-md shadow-brand-900/20 transition hover:brightness-110">{t.nav.signIn}</a>
          )}
          <LocaleSwitcher />
        </nav>
        <button
          type="button"
          id="mobile-nav-trigger"
          class="md:hidden flex items-center justify-center h-9 w-9 shrink-0 rounded-full text-brand-800 hover:bg-brand-50 transition"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="mobile-nav-panel"
          aria-label={t.chat.menu}
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-6 w-6" aria-hidden="true">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
      <div id="mobile-nav-panel" class="hidden md:hidden border-t border-brand-100 bg-white px-4 py-3 space-y-1 shadow-lg shadow-brand-900/10">
        <a href="/tours" class="block rounded-xl px-3 py-2.5 text-sm font-medium text-stone-700 transition hover:bg-brand-50 hover:text-brand-800">{t.nav.tours}</a>
        <a href="/blog" class="block rounded-xl px-3 py-2.5 text-sm font-medium text-stone-700 transition hover:bg-brand-50 hover:text-brand-800">{t.nav.blog}</a>
        <a href="/help" class="block rounded-xl px-3 py-2.5 text-sm font-medium text-stone-700 transition hover:bg-brand-50 hover:text-brand-800">{t.nav.help}</a>
        {isSignedIn ? (
          <>
            <a href="/account/bookings" class="block rounded-xl px-3 py-2.5 text-sm font-medium text-stone-700 transition hover:bg-brand-50 hover:text-brand-800">{t.nav.myBookings}</a>
            <form method="POST" action="/auth/logout">
              <button type="submit" class="rounded-xl px-3 py-2.5 text-sm font-medium text-stone-700 transition hover:bg-brand-50 hover:text-brand-800 cursor-pointer">{t.nav.signOut}</button>
            </form>
          </>
        ) : (
          <a href="/login" class="block rounded-xl px-3 py-2.5 text-sm font-medium text-stone-700 transition hover:bg-brand-50 hover:text-brand-800">{t.nav.signIn}</a>
        )}
        <div class="mt-2 border-t border-brand-100 px-3 pt-3">
          <LocaleSwitcher uid="m" />
        </div>
      </div>
    </header>
    <slot />

    <footer class="tv-scale bg-gradient-to-b from-brand-900 to-brand-950 text-violet-100">
      <div class="max-w-5xl 2xl:max-w-6xl min-[2200px]:max-w-7xl mx-auto px-6 py-12 2xl:py-16 min-[2200px]:py-24 grid grid-cols-1 gap-10 sm:grid-cols-2 md:grid-cols-3">
        <div>
          <a href="/" class="flex items-center gap-2.5 mb-4">
            <span class="flex h-10 w-10 min-[2200px]:h-14 min-[2200px]:w-14 items-center justify-center rounded-full bg-white shadow-md shadow-brand-950/30"><GlobeLogo class="h-8 w-8 min-[2200px]:h-11 min-[2200px]:w-11" animate={false} /></span>
            <span class="text-base min-[2200px]:text-2xl font-serif font-semibold tracking-tight text-white">IWIS Global</span>
          </a>
          <p class="text-sm 2xl:text-base min-[2200px]:text-lg text-violet-300 leading-relaxed max-w-[240px] 2xl:max-w-xs min-[2200px]:max-w-sm">
            {t.footer.tagline}
          </p>
          <SocialLinks class="mt-3 -ml-3 [&_a]:text-violet-200 [&_a:hover]:text-white min-[2200px]:[&_svg]:h-7 min-[2200px]:[&_svg]:w-7" />
          {!noTracking && !hideNewsletter && <NewsletterSignup />}
        </div>

        <div>
          <h2 class="text-xs 2xl:text-sm min-[2200px]:text-base font-semibold tracking-wide text-violet-300 uppercase mb-4">{t.footer.getHelp}</h2>
          <ul class="space-y-3 min-[2200px]:space-y-4 text-sm 2xl:text-base min-[2200px]:text-lg">
            <li>
              <a
                href={`https://wa.me/916399226633?text=${encodeURIComponent(`Hi! I have a question. (ref: ${whatsappRef('FOOTER')})`)}`}
                target="_blank"
                rel="noopener noreferrer"
                data-wa-ref={whatsappRef('FOOTER')}
                class="flex items-center gap-2 text-violet-100 hover:text-white transition"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4 shrink-0" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8M8 14h5m-9 6 2.5-2.5H18a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 .5 1.3" />
                </svg>
                WhatsApp +91 63992 26633
              </a>
            </li>
            <li>
              <a href="mailto:info@iwisglobal.com" class="flex items-center gap-2 text-violet-100 hover:text-white transition">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4 shrink-0" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                  <path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6" />
                </svg>
                info@iwisglobal.com
              </a>
            </li>
            <li>
              <a href="/help" class="flex items-center gap-2 text-violet-100 hover:text-white transition">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4 shrink-0" aria-hidden="true">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 1.5-2 1.7-2 3.5M12 17h.01" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {t.footer.helpFaqs}
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h2 class="text-xs 2xl:text-sm min-[2200px]:text-base font-semibold tracking-wide text-violet-300 uppercase mb-4">{t.footer.explore}</h2>
          <ul class="space-y-3 min-[2200px]:space-y-4 text-sm 2xl:text-base min-[2200px]:text-lg">
            <li><a href="/tours" class="text-violet-100 hover:text-white transition">{t.footer.allTours}</a></li>
            <li><a href="/agra" class="text-violet-100 hover:text-white transition">{t.footer.thingsToDo}</a></li>
            <li><a href="/guides" class="text-violet-100 hover:text-white transition">{t.footer.guides}</a></li>
            <li><a href="/about" class="text-violet-100 hover:text-white transition">{t.footer.about}</a></li>
            <li><a href="/no-commission-pledge" class="text-violet-100 hover:text-white transition">{t.footer.pledge}</a></li>
            {showReviewsLink && <li><a href="/reviews" class="text-violet-100 hover:text-white transition">{t.footer.reviews}</a></li>}
          </ul>
        </div>
      </div>

      <div class="border-t border-white/10">
        <!-- pb-24 on phones: keeps the last line clear of the floating WhatsApp button. -->
        <div class="max-w-5xl 2xl:max-w-6xl min-[2200px]:max-w-7xl mx-auto px-6 pt-6 pb-24 md:pb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-xs 2xl:text-sm min-[2200px]:text-base text-violet-300">
          <!-- Policy links: Razorpay's card-network activation checks for all
               five (Terms, Privacy, Cancellation & Refund, Shipping, Contact). -->
          <nav aria-label={t.footer.legalNav} class="flex flex-wrap gap-x-4 gap-y-2">
            <a href="/terms" class="hover:text-white transition">{t.footer.terms}</a>
            <a href="/privacy" class="hover:text-white transition">{t.footer.privacy}</a>
            <a href="/cancellation-refund-policy" class="hover:text-white transition">{t.footer.cancellation}</a>
            <a href="/shipping-policy" class="hover:text-white transition">{t.footer.shipping}</a>
            <a href="/contact" class="hover:text-white transition">{t.footer.contact}</a>
            <button type="button" data-cookie-settings class="hover:text-white transition">{t.footer.cookieSettings}</button>
          </nav>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <p>&copy; {new Date().getFullYear()} IWIS Global</p>
            <p class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-3.5 w-3.5" aria-hidden="true">
                <rect x="5" y="11" width="14" height="9" rx="1.5"></rect>
                <path stroke-linecap="round" d="M8 11V8a4 4 0 0 1 8 0v3" />
              </svg>
              {t.footer.secured}
            </p>
          </div>
        </div>
      </div>
    </footer>

    {floatingWhatsApp && (
      <a
        href={`https://wa.me/916399226633?text=${encodeURIComponent(`Hi! I'd like to know more about your Agra tours. (ref: ${whatsappRef('FLOATING')})`)}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.chat.aria}
        data-wa-ref={whatsappRef('FLOATING')}
        class="group fixed bottom-5 right-5 z-50 flex h-14 min-w-14 items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#2ee06f] to-[#128c7e] text-white shadow-lg shadow-emerald-900/30 ring-4 ring-white transition hover:scale-105 hover:shadow-xl sm:px-5 [@media(max-height:500px)]:!px-0"
      >
        <span aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 rounded-full bg-[#25D366]/40 motion-safe:animate-ping [animation-duration:2.5s]"></span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7 shrink-0">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.09c-.24.68-1.4 1.3-1.93 1.36-.5.06-1.02.25-3.4-.71-2.87-1.16-4.72-4.08-4.86-4.27-.14-.19-1.16-1.55-1.16-2.95 0-1.41.74-2.1 1-2.39.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.42-.07.65.5.24.58.82 2 .89 2.14.07.14.12.31.02.5-.1.19-.15.31-.29.48-.14.17-.3.38-.43.51-.14.14-.29.29-.13.57.17.29.75 1.24 1.61 2 1.11.99 2.04 1.3 2.33 1.44.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.38-.24.65-.14.26.1 1.68.79 1.97.94.29.14.48.21.55.34.07.12.07.71-.17 1.4Z" />
        </svg>
        <span class="hidden text-sm font-semibold sm:inline [@media(max-height:500px)]:!hidden">{t.chat.label}</span>
      </a>
    )}

    <CompareTray client:idle t={t.tray} />
    {!noTracking && <CookieConsent />}
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  /* Phones: hide the floating WhatsApp button while someone types in the
     booking form (set by BookingWidget), so it doesn't cover the fields. */
  @media (max-width: 767px) {
    body.booking-typing a[data-wa-ref^='FLOATING'] {
      display: none;
    }
  }
  /* The saved-tours tray steps aside while a page's own sticky booking bar is
     showing (MobileActionBar toggles these body classes). */
  body.has-action-bar .iwis-tray,
  body.has-action-bar-lg .iwis-tray {
    display: none;
  }
  body {
    margin: 0;
    padding: 0;
  }
  html {
    scroll-behavior: smooth;
  }
  /* Landscape phones and other very short screens: a sticky header would take
     a sixth of the height, so let it scroll away. */
  @media (max-height: 500px) and (max-width: 1023px) {
    #site-header {
      position: static;
    }
  }
  /* Smart TVs and other big screens with no mouse (a remote or touch only),
     read from across a room: scale the header, footer and tour pages up. A
     desktop has a fine pointer, so it is not affected. Above 2200px (a 4K TV
     that reports its full pixel width) the ultrawide sizes already apply.
     Browsers without CSS zoom just keep the normal size. */
  @media (min-width: 1700px) and (max-width: 2199px) and (not (any-pointer: fine)) {
    .tv-scale {
      zoom: 1.3;
    }
  }
  /* Keyboard and remote-control (d-pad) navigation: show clearly which link or
     button has focus on devices without a mouse. */
  @media (not (any-pointer: fine)) {
    :focus-visible {
      outline: 4px solid #7c3aed;
      outline-offset: 3px;
    }
  }
  #site-header.is-scrolled {
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
  }
  #site-header.is-scrolled .site-header-inner {
    height: 3.25rem;
  }
  #site-header.is-scrolled .site-logo {
    width: 2.5rem;
    height: 2.5rem;
  }
  /* Large monitors: the header is taller to begin with, so it settles taller. */
  @media (min-width: 1536px) {
    #site-header.is-scrolled .site-header-inner {
      height: 4rem;
    }
    #site-header.is-scrolled .site-logo {
      width: 3rem;
      height: 3rem;
    }
  }
  @media (min-width: 2200px) {
    #site-header.is-scrolled .site-header-inner {
      height: 5rem;
    }
    #site-header.is-scrolled .site-logo {
      width: 3.75rem;
      height: 3.75rem;
    }
  }
</style>

<script>
  import { sourceTag, withSourceTag } from '../lib/waSourceTag';

  // Mirrors LocaleSwitcher.astro's own open/close/click-outside/Escape
  // pattern for consistency.
  const mobileNavTrigger = document.getElementById('mobile-nav-trigger');
  const mobileNavPanel = document.getElementById('mobile-nav-panel');
  if (mobileNavTrigger && mobileNavPanel) {
    const closeMobileNav = () => {
      mobileNavPanel.classList.add('hidden');
      mobileNavTrigger.setAttribute('aria-expanded', 'false');
    };
    const openMobileNav = () => {
      mobileNavPanel.classList.remove('hidden');
      mobileNavTrigger.setAttribute('aria-expanded', 'true');
    };
    mobileNavTrigger.addEventListener('click', () => {
      mobileNavPanel.classList.contains('hidden') ? openMobileNav() : closeMobileNav();
    });
    document.addEventListener('click', (e) => {
      if (!mobileNavTrigger.contains(e.target as Node) && !mobileNavPanel.contains(e.target as Node)) closeMobileNav();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMobileNav();
    });
  }

  const header = document.getElementById('site-header');
  if (header) {
    const updateScrolled = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 12);
    };
    updateScrolled();
    window.addEventListener('scroll', updateScrolled, { passive: true });
  }

  // Backlog 2.8/2.9 — Google Analytics events, product-marketing-context.md §9.

  // whatsapp_clicked: delegated so it covers every wa.me link site-wide
  // (footer, floating button, and any page-specific ones like /help's),
  // as long as it carries data-wa-ref.
  // A visitor who came from an ad keeps that source when they start a WhatsApp chat: the link's
  // prefilled "(ref: ...)" gets " · via google/paid/<campaign>" (src/lib/waSourceTag.ts), read
  // back by the WhatsApp webhook. Done on pointerdown too, so a long-press or new-tab open has it.
  const tagWhatsAppLink = (e: Event) => {
    const a = (e.target as Element)?.closest?.('a[href*="wa.me/"]') as HTMLAnchorElement | null;
    if (!a) return;
    try {
      a.href = withSourceTag(a.href, sourceTag(JSON.parse(sessionStorage.getItem('iwis_first_touch') || 'null')));
    } catch {}
  };
  document.addEventListener('pointerdown', tagWhatsAppLink, true);
  document.addEventListener('click', tagWhatsAppLink, true);

  document.addEventListener('click', (e) => {
    const link = (e.target as Element)?.closest?.('[data-wa-ref]');
    if (!link) return;
    window.gtag?.('event', 'whatsapp_clicked', { ref: link.getAttribute('data-wa-ref') });
    // Meta's "Contact" standard event (queued, sent only after cookie consent).
    (window.iwisPixelQueue = window.iwisPixelQueue || []).push(['Contact', { content_name: 'WhatsApp', content_category: link.getAttribute('data-wa-ref') ?? '' }]);
  });

  // currency_switched / language_switched: only when someone picks a
  // different option in the switcher menu (LocaleSwitcher.astro), not when a
  // link such as a Google Ads landing URL arrives with ?currency=.
  document.addEventListener('click', (e) => {
    const option = (e.target as Element)?.closest?.('[data-switch]');
    if (!option || option.hasAttribute('data-current')) return;
    const value = option.getAttribute('data-value');
    if (option.getAttribute('data-switch') === 'currency') window.gtag?.('event', 'currency_switched', { currency: value });
    else window.gtag?.('event', 'language_switched', { language: value });
  });
</script>
