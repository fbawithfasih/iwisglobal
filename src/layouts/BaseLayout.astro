---
import { resolveEnv } from '../lib/env';
import { getSessionCustomerId } from '../lib/requireCustomer';
import { resolveLocale } from '../lib/i18n';
import { getDictionary } from '../i18n/dictionaries';
import LocaleSwitcher from '../components/LocaleSwitcher.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'IWIS Global — professional, private Taj Mahal & Agra tours, booked online. Same-day trips from Delhi and multi-day Agra itineraries.',
  image = '/logo.png',
} = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url.pathname;
const ogImageURL = Astro.site ? new URL(image, Astro.site).toString() : image;

const env = resolveEnv(Astro.locals);
const isSignedIn = !!(await getSessionCustomerId(Astro.cookies, env.CUSTOMER_SESSION_SECRET));

const locale = resolveLocale(Astro.url.searchParams, Astro.cookies.get('lang')?.value);
if (Astro.url.searchParams.get('lang')) {
  Astro.cookies.set('lang', locale, { path: '/', maxAge: 60 * 60 * 24 * 365 });
}
const t = getDictionary(locale);
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: 'IWIS Global',
  url: 'https://www.iwisglobal.com',
  logo: 'https://www.iwisglobal.com/logo.png',
  areaServed: 'Agra, India',
};
---
<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="theme-color" content="#6d28d9" />
    <meta name="generator" content={Astro.generator} />
    <style is:global>
      @tailwind base;
      @tailwind components;
      @tailwind utilities;
    </style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Cormorant+Garamond:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-stone-50 text-stone-900 antialiased">
    <header id="site-header" class="sticky top-0 z-40 border-b border-stone-200 bg-white/90 backdrop-blur-sm transition-[box-shadow,height] duration-200">
      <div class="site-header-inner max-w-5xl mx-auto px-6 h-16 flex items-center justify-between transition-[height] duration-200">
        <a href="/" class="flex items-center gap-2.5">
          <img src="/logo.png" alt="IWIS Global" class="h-9 w-9 object-contain" />
          <span class="text-lg font-semibold tracking-tight">IWIS Global</span>
        </a>
        <nav class="flex items-center gap-6">
          <a href="/tours" class="text-sm font-medium text-stone-600 hover:text-brand-800 transition">{t.nav.tours}</a>
          <a href="/help" class="text-sm font-medium text-stone-600 hover:text-brand-800 transition">{t.nav.help}</a>
          {isSignedIn ? (
            <>
              <a href="/account/bookings" class="text-sm font-medium text-stone-600 hover:text-brand-800 transition">{t.nav.myBookings}</a>
              <form method="POST" action="/auth/logout">
                <button type="submit" class="text-sm font-medium text-stone-600 hover:text-brand-800 transition cursor-pointer">{t.nav.signOut}</button>
              </form>
            </>
          ) : (
            <a href="/login" class="text-sm font-medium text-stone-600 hover:text-brand-800 transition">{t.nav.signIn}</a>
          )}
          <LocaleSwitcher />
        </nav>
      </div>
    </header>
    <slot />

    <footer class="border-t border-stone-200 bg-white">
      <div class="max-w-5xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-stone-500">
        <p>&copy; {new Date().getFullYear()} IWIS Global</p>
        <div class="flex items-center gap-6">
          <a href="/privacy" class="hover:text-brand-800 transition">Privacy Policy</a>
          <a href="/terms" class="hover:text-brand-800 transition">Terms of Service</a>
        </div>
      </div>
    </footer>

    <a
      href="https://wa.me/916399226633?text=Hi!%20I'd%20like%20to%20know%20more%20about%20your%20Agra%20tours."
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat with us on WhatsApp"
      class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition hover:scale-105 hover:shadow-xl"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.09c-.24.68-1.4 1.3-1.93 1.36-.5.06-1.02.25-3.4-.71-2.87-1.16-4.72-4.08-4.86-4.27-.14-.19-1.16-1.55-1.16-2.95 0-1.41.74-2.1 1-2.39.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.42-.07.65.5.24.58.82 2 .89 2.14.07.14.12.31.02.5-.1.19-.15.31-.29.48-.14.17-.3.38-.43.51-.14.14-.29.29-.13.57.17.29.75 1.24 1.61 2 1.11.99 2.04 1.3 2.33 1.44.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.38-.24.65-.14.26.1 1.68.79 1.97.94.29.14.48.21.55.34.07.12.07.71-.17 1.4Z" />
      </svg>
    </a>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    padding: 0;
  }
  html {
    scroll-behavior: smooth;
  }
  #site-header.is-scrolled {
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
  }
  #site-header.is-scrolled .site-header-inner {
    height: 3.25rem;
  }
</style>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    const updateScrolled = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 12);
    };
    updateScrolled();
    window.addEventListener('scroll', updateScrolled, { passive: true });
  }
</script>
