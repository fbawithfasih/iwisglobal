---
import { resolveEnv } from '../lib/env';
import { getSessionCustomerId } from '../lib/requireCustomer';
import { resolveLocale } from '../lib/i18n';
import { getDictionary } from '../i18n/dictionaries';
import LocaleSwitcher from '../components/LocaleSwitcher.astro';
import { listTours } from '../lib/tours';

interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  // Ordered from the homepage down to (but not including) the current page
  // — e.g. [{ name: 'Tours', path: '/tours' }] on a tour detail page. Every
  // page's own title is appended as the final crumb, so schema can't drift
  // from the <title> actually rendered. Omit on top-level pages (home,
  // /tours, /help, etc.) — a single-item trail has no SEO/AEO value.
  breadcrumbs?: BreadcrumbItem[];
  // For pages with no search value (login, signup, booking confirmation)
  // that Google still finds through header/footer links.
  noindex?: boolean;
}

const {
  title,
  // Backlog 2.5 — query-first, brand-last, same principle as title tags.
  description = 'Private, professional Taj Mahal & Agra tours, booked online — IWIS Global. Same-day trips from Delhi and multi-day Agra itineraries.',
  // Backlog 0.6 — was the square logo on a summary_large_image card, which
  // Facebook/Twitter/LinkedIn crop awkwardly. og-image.jpg is a proper
  // 1200×630 crop of the hero photo.
  image = '/og-image.jpg',
  breadcrumbs,
  noindex = false,
} = Astro.props;

// ?lang= / ?currency= are switcher links that set a cookie; the page they
// render is a duplicate of the bare URL. Google indexed /?lang=es as its own
// page despite the canonical (the text differs), splitting the homepage.
const robotsNoindex =
  noindex || Astro.url.searchParams.has('lang') || Astro.url.searchParams.has('currency');

// BreadcrumbList JSON-LD — a gap shared with activities.marriott.com (it has
// none either), but cheap to add here given pages already carry a title and
// (for nested pages) a natural parent section.
const breadcrumbJsonLd = breadcrumbs && breadcrumbs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { name: 'Home', path: '/' },
        ...breadcrumbs,
        { name: title.split(' — ')[0], path: Astro.url.pathname },
      ].map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.name,
        item: new URL(crumb.path, Astro.site ?? 'https://www.iwisglobal.com').toString(),
      })),
    }
  : null;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url.pathname;
const ogImageURL = Astro.site ? new URL(image, Astro.site).toString() : image;

const env = resolveEnv(Astro.locals);
const isSignedIn = !!(await getSessionCustomerId(Astro.cookies, env.CUSTOMER_SESSION_SECRET));
const footerTours = env.DB ? (await listTours(env.DB, { status: 'published' })).slice(0, 5) : [];

const locale = resolveLocale(Astro.url.searchParams, Astro.cookies.get('lang')?.value);
if (Astro.url.searchParams.get('lang')) {
  Astro.cookies.set('lang', locale, { path: '/', maxAge: 60 * 60 * 24 * 365 });
}
const t = getDictionary(locale);

// Backlog 2.9 — unique wa.me ref per page, so a WhatsApp lead can be traced
// back to where it started (product-marketing-context.md §9's WhatsApp
// attribution gap). HOME for the homepage, TOUR-<slug> for a tour page,
// the pathname otherwise.
function whatsappRef(location: string): string {
  const path = Astro.url.pathname;
  const page = path === '/' ? 'HOME' : path.replace(/^\/|\/$/g, '').replace(/\//g, '-').toUpperCase();
  return `${location}-${page}`;
}

// Backlog 2.1. "IWIS Global" alone collides with a German industrial chain
// manufacturer and an unrelated Amazon storefront of the same name. The
// disambiguation lives in disambiguatingDescription, not name: name is the
// brand string Google matches for brand queries, so it must be exactly
// "IWIS Global" (a sentence there weakened the "iwis global" entity).
//
// sameAs: the live Google Business Profile share link (given by the user).
// Add any other confirmed social profiles here as they're set up — don't
// invent them. Same reasoning for address: only locality/region/country
// are confirmed facts (product-marketing-context.md §1); no street address
// or postal code exists yet (also blocks backlog 0.5's /about page).
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'TravelAgency'],
  '@id': 'https://www.iwisglobal.com/#organization',
  name: 'IWIS Global',
  alternateName: 'iwisglobal',
  disambiguatingDescription: 'A Taj Mahal and Agra tour operator based in Agra, India',
  url: 'https://www.iwisglobal.com',
  logo: 'https://www.iwisglobal.com/logo.png',
  image: 'https://www.iwisglobal.com/logo.png',
  telephone: '+91 6399226633',
  email: 'info@iwisglobal.com',
  sameAs: ['https://share.google/UoeRHRhy0YWsmUpKh'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'A-5, First Floor, Essar Mughal Apartment, Jyoti Nagar, Shaheed Nagar',
    addressLocality: 'Agra',
    postalCode: '282001',
    addressRegion: 'Uttar Pradesh',
    addressCountry: 'IN',
  },
  areaServed: {
    '@type': 'City',
    name: 'Agra',
  },
};

// Google reads the site name shown on search results from WebSite markup on
// the homepage only.
const websiteJsonLd = Astro.url.pathname === '/'
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'IWIS Global',
      alternateName: 'iwisglobal',
      url: 'https://www.iwisglobal.com/',
      publisher: { '@id': 'https://www.iwisglobal.com/#organization' },
    }
  : null;
---
<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-KCCT2CSW');</script>
    <!-- End Google Tag Manager -->
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-3CCCVSYT7D"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-3CCCVSYT7D');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Dedicated "IG" icon set: the full logo.png washed out to a blank
         circle at the 16–48px sizes browsers and Google results use. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="icon" type="image/png" href="/favicon-48.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#6d28d9" />
    <meta name="generator" content={Astro.generator} />
    <style is:global>
      @tailwind base;
      @tailwind components;
      @tailwind utilities;
    </style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {robotsNoindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <!-- One of the signals Google uses for the site name shown above the URL. -->
    <meta property="og:site_name" content="IWIS Global" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    {websiteJsonLd && <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />}
    {breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Cormorant+Garamond:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-stone-50 text-stone-900 antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KCCT2CSW"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <header id="site-header" class="sticky top-0 z-40 border-b border-stone-200 bg-white/90 backdrop-blur-sm transition-[box-shadow,height] duration-200">
      <div class="site-header-inner max-w-5xl mx-auto px-6 h-16 flex items-center justify-between transition-[height] duration-200">
        <a href="/" class="flex items-center gap-2 md:gap-2.5 min-w-0">
          <img src="/logo.png" alt="IWIS Global" class="h-9 w-9 md:h-11 md:w-11 object-contain shrink-0" />
          <span class="text-lg md:text-xl font-serif font-semibold tracking-tight truncate">IWIS Global</span>
        </a>
        <nav class="hidden md:flex items-center gap-6">
          <a href="/tours" class="text-sm font-medium text-stone-600 hover:text-brand-800 transition">{t.nav.tours}</a>
          <a href="/help" class="text-sm font-medium text-stone-600 hover:text-brand-800 transition">{t.nav.help}</a>
          {isSignedIn ? (
            <>
              <a href="/account/bookings" class="text-sm font-medium text-stone-600 hover:text-brand-800 transition">{t.nav.myBookings}</a>
              <form method="POST" action="/auth/logout">
                <button type="submit" class="text-sm font-medium text-stone-600 hover:text-brand-800 transition cursor-pointer">{t.nav.signOut}</button>
              </form>
            </>
          ) : (
            <a href="/login" class="text-sm font-medium text-stone-600 hover:text-brand-800 transition">{t.nav.signIn}</a>
          )}
          <LocaleSwitcher />
        </nav>
        <button
          type="button"
          id="mobile-nav-trigger"
          class="md:hidden flex items-center justify-center h-9 w-9 shrink-0 rounded-lg text-stone-600 hover:bg-stone-100 transition"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="mobile-nav-panel"
          aria-label="Menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-6 w-6" aria-hidden="true">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
      <div id="mobile-nav-panel" class="hidden md:hidden border-t border-stone-200 bg-white px-6 py-4 space-y-3">
        <a href="/tours" class="block text-sm font-medium text-stone-700 hover:text-brand-800 transition">{t.nav.tours}</a>
        <a href="/help" class="block text-sm font-medium text-stone-700 hover:text-brand-800 transition">{t.nav.help}</a>
        {isSignedIn ? (
          <>
            <a href="/account/bookings" class="block text-sm font-medium text-stone-700 hover:text-brand-800 transition">{t.nav.myBookings}</a>
            <form method="POST" action="/auth/logout">
              <button type="submit" class="text-sm font-medium text-stone-700 hover:text-brand-800 transition cursor-pointer">{t.nav.signOut}</button>
            </form>
          </>
        ) : (
          <a href="/login" class="block text-sm font-medium text-stone-700 hover:text-brand-800 transition">{t.nav.signIn}</a>
        )}
        <div class="pt-2 border-t border-stone-100">
          <LocaleSwitcher />
        </div>
      </div>
    </header>
    <slot />

    <footer class="border-t border-stone-200 bg-white">
      <div class="max-w-5xl mx-auto px-6 py-14 grid gap-10 sm:grid-cols-2 md:grid-cols-4">
        <div>
          <a href="/" class="flex items-center gap-2.5 mb-4">
            <img src="/logo.png" alt="IWIS Global" class="h-8 w-8 object-contain" />
            <span class="text-base font-semibold tracking-tight">IWIS Global</span>
          </a>
          <p class="text-sm text-stone-500 leading-relaxed max-w-[220px]">
            Private, professional Taj Mahal &amp; Agra tours — booked online, guided in person.
          </p>
        </div>

        <div>
          <h3 class="text-xs font-semibold tracking-wide text-stone-400 uppercase mb-4">Get help</h3>
          <ul class="space-y-3 text-sm">
            <li>
              <a href="/help" class="flex items-center gap-2 text-stone-600 hover:text-brand-800 transition">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4 shrink-0" aria-hidden="true">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 1.5-2 1.7-2 3.5M12 17h.01" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Help center
              </a>
            </li>
            <li>
              <a
                href={`https://wa.me/916399226633?text=${encodeURIComponent(`Hi! I have a question. (ref: ${whatsappRef('FOOTER')})`)}`}
                target="_blank"
                rel="noopener noreferrer"
                data-wa-ref={whatsappRef('FOOTER')}
                class="flex items-center gap-2 text-stone-600 hover:text-brand-800 transition"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4 shrink-0" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8M8 14h5m-9 6 2.5-2.5H18a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 .5 1.3" />
                </svg>
                WhatsApp us
              </a>
            </li>
            <li>
              <a href="mailto:info@iwisglobal.com" class="flex items-center gap-2 text-stone-600 hover:text-brand-800 transition">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4 shrink-0" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                  <path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6" />
                </svg>
                info@iwisglobal.com
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h3 class="text-xs font-semibold tracking-wide text-stone-400 uppercase mb-4">Tours</h3>
          <ul class="space-y-3 text-sm">
            {footerTours.map((tour) => (
              <li>
                <a href={`/tours/${tour.slug}`} class="text-stone-600 hover:text-brand-800 transition">{tour.title}</a>
              </li>
            ))}
            <li>
              <a href="/agra" class="text-stone-600 hover:text-brand-800 transition">Agra Attractions Guide</a>
            </li>
            <li>
              <a href="/tours" class="text-brand-700 font-medium hover:text-brand-900 transition">View all tours →</a>
            </li>
          </ul>
        </div>

        <div>
          <h3 class="text-xs font-semibold tracking-wide text-stone-400 uppercase mb-4">IWIS Global</h3>
          <ul class="space-y-3 text-sm">
            <li><a href="/about" class="text-stone-600 hover:text-brand-800 transition">About</a></li>
            <li><a href="/contact" class="text-stone-600 hover:text-brand-800 transition">Contact Us</a></li>
            <li><a href="/guides" class="text-stone-600 hover:text-brand-800 transition">Guides</a></li>
            <li><a href="/blog" class="text-stone-600 hover:text-brand-800 transition">Blog</a></li>
            <li><a href="/reviews" class="text-stone-600 hover:text-brand-800 transition">Reviews</a></li>
            <li><a href="/no-commission-pledge" class="text-stone-600 hover:text-brand-800 transition">No-Commission Pledge</a></li>
            <li><a href="/privacy" class="text-stone-600 hover:text-brand-800 transition">Privacy Policy</a></li>
            <li><a href="/terms" class="text-stone-600 hover:text-brand-800 transition">Terms of Service</a></li>
            <li><a href="/cancellation-refund-policy" class="text-stone-600 hover:text-brand-800 transition">Cancellation &amp; Refunds</a></li>
            <li><a href="/shipping-policy" class="text-stone-600 hover:text-brand-800 transition">Shipping &amp; Exchange</a></li>
          </ul>
        </div>
      </div>

      <div class="border-t border-stone-200">
        <div class="max-w-5xl mx-auto px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-stone-500">
          <p>&copy; {new Date().getFullYear()} IWIS Global</p>
          <p class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-3.5 w-3.5" aria-hidden="true">
              <rect x="5" y="11" width="14" height="9" rx="1.5"></rect>
              <path stroke-linecap="round" d="M8 11V8a4 4 0 0 1 8 0v3" />
            </svg>
            Payments secured by Razorpay
          </p>
        </div>
      </div>
    </footer>

    <a
      href={`https://wa.me/916399226633?text=${encodeURIComponent(`Hi! I'd like to know more about your Agra tours. (ref: ${whatsappRef('FLOATING')})`)}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat with us on WhatsApp"
      data-wa-ref={whatsappRef('FLOATING')}
      class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition hover:scale-105 hover:shadow-xl"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.09c-.24.68-1.4 1.3-1.93 1.36-.5.06-1.02.25-3.4-.71-2.87-1.16-4.72-4.08-4.86-4.27-.14-.19-1.16-1.55-1.16-2.95 0-1.41.74-2.1 1-2.39.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.42-.07.65.5.24.58.82 2 .89 2.14.07.14.12.31.02.5-.1.19-.15.31-.29.48-.14.17-.3.38-.43.51-.14.14-.29.29-.13.57.17.29.75 1.24 1.61 2 1.11.99 2.04 1.3 2.33 1.44.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.38-.24.65-.14.26.1 1.68.79 1.97.94.29.14.48.21.55.34.07.12.07.71-.17 1.4Z" />
      </svg>
    </a>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    padding: 0;
  }
  html {
    scroll-behavior: smooth;
  }
  #site-header.is-scrolled {
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
  }
  #site-header.is-scrolled .site-header-inner {
    height: 3.25rem;
  }
</style>

<script>
  // Mirrors LocaleSwitcher.astro's own open/close/click-outside/Escape
  // pattern for consistency.
  const mobileNavTrigger = document.getElementById('mobile-nav-trigger');
  const mobileNavPanel = document.getElementById('mobile-nav-panel');
  if (mobileNavTrigger && mobileNavPanel) {
    const closeMobileNav = () => {
      mobileNavPanel.classList.add('hidden');
      mobileNavTrigger.setAttribute('aria-expanded', 'false');
    };
    const openMobileNav = () => {
      mobileNavPanel.classList.remove('hidden');
      mobileNavTrigger.setAttribute('aria-expanded', 'true');
    };
    mobileNavTrigger.addEventListener('click', () => {
      mobileNavPanel.classList.contains('hidden') ? openMobileNav() : closeMobileNav();
    });
    document.addEventListener('click', (e) => {
      if (!mobileNavTrigger.contains(e.target as Node) && !mobileNavPanel.contains(e.target as Node)) closeMobileNav();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMobileNav();
    });
  }

  const header = document.getElementById('site-header');
  if (header) {
    const updateScrolled = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 12);
    };
    updateScrolled();
    window.addEventListener('scroll', updateScrolled, { passive: true });
  }

  // Backlog 2.8/2.9 — dataLayer events, product-marketing-context.md §9.
  window.dataLayer = window.dataLayer || [];

  // whatsapp_clicked: delegated so it covers every wa.me link site-wide
  // (footer, floating button, and any page-specific ones like /help's),
  // as long as it carries data-wa-ref.
  document.addEventListener('click', (e) => {
    const link = (e.target as Element)?.closest?.('[data-wa-ref]');
    if (link) window.dataLayer.push({ event: 'whatsapp_clicked', ref: link.getAttribute('data-wa-ref') });
  });

  // currency_switched / language_switched: the switcher does a full
  // navigation to `?currency=X` / `?lang=X`, so the param is present on the
  // destination page's first load — exactly the signal to fire on.
  const params = new URLSearchParams(location.search);
  const switchedCurrency = params.get('currency');
  if (switchedCurrency) window.dataLayer.push({ event: 'currency_switched', currency: switchedCurrency });
  const switchedLang = params.get('lang');
  if (switchedLang) window.dataLayer.push({ event: 'language_switched', language: switchedLang });
</script>
